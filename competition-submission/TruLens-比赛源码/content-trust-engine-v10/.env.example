QWEN_API_KEY=
# Model defaults to qwen3.8-flash; only override these if needed.
# QWEN_MODEL=qwen3.8-flash
# QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional DeepSeek request timeout override, in seconds (default: 60).
# PROVIDER_TIMEOUT_SECONDS=120
# Legacy image-forensics experiment settings; ignored by the default main engine.
NFA_VIT_SPACE_URL=
HF_TOKEN=
# Experimental LOTA whole-image signal; it is not calibrated as an AI probability.
LOTA_WEIGHTS_PATH=models/LOTA/Network_best.pth
LOTA_DEVICE=auto
# Experimental model swap candidate; install the official source under models/FerretNet.
FERRETNET_REPO_PATH=models/FerretNet
FERRETNET_WEIGHTS_PATH=models/FerretNet/checkpoints/4cls_ckpt/ferretnet-b-median-3.pth
FERRETNET_DEVICE=auto
# Optional local TruFor manipulation/localization signal. Install with:
# python -m pip install -e '.[trufor_local]'
TRUFOR_ENABLED=false
TRUFOR_REPO_PATH=models/TruFor/TruFor_train_test
TRUFOR_CHECKPOINT_PATH=models/TruFor/TruFor_train_test/pretrained_models/trufor.pth.tar
TRUFOR_DEVICE=cpu
# Optional C2PA manifest inspection and EXIF extraction for local image files.
# Install with: python -m pip install -e '.[provenance]'
