# ---------------------------------------------------------------------------
# TruLens backend configuration
# Copy to `.env` and adjust. Values here are safe development defaults.
# ---------------------------------------------------------------------------

# App
APP_NAME=TruLens
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# Comma-free JSON list for CORS origins (pydantic parses lists as JSON)
CORS_ORIGINS=["*"]

# Database ---------------------------------------------------------------
# Development (async SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./storage/trulens.db
# Production (PostgreSQL via docker-compose):
# DATABASE_URL=postgresql+asyncpg://trulens:trulens@db:5432/trulens
SQL_ECHO=false

# Storage
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# LLM --------------------------------------------------------------------
# mock  -> deterministic local provider, no API key required (default)
# openai -> any OpenAI-compatible endpoint (OpenAI / Azure / DeepSeek / Qwen ...)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Master switch: when false agents run pure rule-based heuristics (deterministic)
ENABLE_LLM=false

# Trust engine (Applied-AI delivery: content-trust-engine-v10) -------------
# Docker: the engine is already baked into the default image target — just set
# TRUST_ENGINE_ENABLED=true and fill in the keys below.
# Local dev, from the backend/ directory:
#     pip install -r requirements-engine.txt
#     pip install -e ../content-trust-engine-v10
# Leaving TRUST_ENGINE_ENABLED=false keeps the demo independent of both
# credentials and the engine package.
TRUST_ENGINE_ENABLED=false

# DeepSeek powers the text / comment / account-history / explanation roles.
# Without it the engine still runs those dimensions in local-rule mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Vision provider (image semantic + cross-modal consistency) ---
# GLM (Zhipu) drives the image role and takes precedence over Qwen.
# With no vision key at all the image dimension reports "unavailable" —
# the engine never invents a verdict it cannot support.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Must be a multimodal model — the image (R) role sends the picture itself.
# Verified working: glm-5.3-flashx (also glm-4.6v-flash / glm-4.5v).
GLM_MODEL=glm-5.3-flashx
GLM_TIMEOUT_SECONDS=180
GLM_MAX_TOKENS=4096
# raw      -> Zhipu-native raw base64 in image_url (default; matches Zhipu docs)
# data_uri -> the engine's original "data:image/...;base64," form
GLM_IMAGE_URL_FORMAT=raw
# Free GLM tiers rate-limit hard (HTTP 429). 0 would let a 429 bubble up and make
# the image dimension report "unavailable"; retries back off and honour Retry-After.
GLM_MAX_RETRIES=3

# Qwen-VL — optional fallback, used ONLY when GLM_API_KEY is empty.
QWEN_API_KEY=
# Legacy DashScope alias still accepted by the engine.
DASHSCOPE_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.8-flash
QWEN_VL_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Xiaohongshu link ingestion — paste a note URL, get a four-dimension report.
#
# Needs Chrome + `pip install -r requirements-xhs.txt`. Enable it, then crawl
# any note:  python scripts/xhs_smoke_test.py "<note url>" --analyze
#
# Public note links can usually be fetched without login. A complete share link
# containing xsec_token is more reliable. Some notes or risk-control responses
# may still redirect to a login/security page; only then run scripts/xhs_login.py
# once. The saved session is kept in XHS_USER_DATA_PATH and reused later.
# ---------------------------------------------------------------------------
XHS_ENABLED=false
XHS_TIMEOUT_SECONDS=240
XHS_MAX_COMMENTS=80
XHS_USER_DATA_PATH=./storage/chrome-profile
# Set true to run Chrome without a visible window (a logged-in profile is then
# required, since you cannot sign in headlessly).
XHS_HEADLESS=false
# Optional, most reliable for demos: attach to a Chrome you already logged into,
# started with --remote-debugging-port=9222.
# XHS_LOCAL_PORT=9222
