type PromiseData = (typeof whyTrustContent.promises)[number];

function EvidencePromiseDemo({ data, replayKey, reducedMotion }: { data: Extract<PromiseData, { id: "evidence" }>; replayKey: number; reducedMotion: boolean }) {
  return (
    <div className="promise-demo evidence-promise-demo" key={replayKey}>
      <small className="promise-example">{whyTrustContent.exampleLabel}</small>
      <motion.p animate={{ opacity: 1, y: 0 }} initial={reducedMotion ? false : { opacity: 0, y: 8 }} transition={{ duration: reducedMotion ? 0 : 0.35 }}>
        {data.conclusion}
      </motion.p>
      <div className="evidence-signal-row">
        {data.signals.map((signal, index) => (
          <div className="evidence-signal-step" key={signal.label}>
            {index > 0 && (
              <motion.i
                animate={{ scaleX: 1 }}
                initial={reducedMotion ? false : { scaleX: 0 }}
                transition={{ delay: reducedMotion ? 0 : 0.65 + index * 0.62, duration: reducedMotion ? 0 : 0.38 }}
              />
            )}
            <motion.span
              animate={{ opacity: 1, scale: 1, y: 0 }}
              className={`signal-${signal.tone}`}
              initial={reducedMotion ? false : { opacity: 0, scale: 0.82, y: 7 }}
              transition={{ delay: reducedMotion ? 0 : 0.35 + index * 0.62, duration: reducedMotion ? 0 : 0.42, type: "spring", bounce: 0.22 }}
            >
              <b />{signal.label}
            </motion.span>
          </div>
        ))}
      </div>
    </div>
  );
}

function RestraintPromiseDemo({ data, replayKey, reducedMotion }: { data: Extract<PromiseData, { id: "restraint" }>; replayKey: number; reducedMotion: boolean }) {
  return (
    <div className="promise-demo restraint-promise-demo" key={replayKey}>
      <small className="promise-example">{whyTrustContent.exampleLabel}</small>
      <div className="restraint-dimensions">
        {data.dimensions.map((dimension, index) => (
          <motion.span
            animate={dimension === "S" ? { opacity: 1, filter: "grayscale(0)" } : { opacity: 0.32, filter: "grayscale(1)" }}
            className={`restraint-${dimension.toLowerCase()}`}
            initial={reducedMotion || dimension === "S" ? false : { opacity: 1, filter: "grayscale(0)" }}
            key={dimension}
            transition={{ delay: reducedMotion ? 0 : 0.65 + index * 0.58, duration: reducedMotion ? 0 : 0.45 }}
          >
            {dimension}
          </motion.span>
        ))}
      </div>
      <motion.small
        animate={{ opacity: 1, y: 0 }}
        className="unavailable-note"
        initial={reducedMotion ? false : { opacity: 0, y: 5 }}
        transition={{ delay: reducedMotion ? 0 : 2.45, duration: reducedMotion ? 0 : 0.35 }}
      >
        {data.unavailable}
      </motion.small>
      <motion.div
        animate={{ opacity: 1, y: 0 }}
        className="restraint-score"
        initial={reducedMotion ? false : { opacity: 0, y: 8 }}
        transition={{ delay: reducedMotion ? 0 : 2.8, duration: reducedMotion ? 0 : 0.4 }}
      >
        <span>{data.scoreLabel} <strong>{data.score}</strong></span>
        <small>{data.scoreNote}</small>
      </motion.div>
    </div>
  );
}

function AppealPromiseDemo({ data, replayKey, reducedMotion }: { data: Extract<PromiseData, { id: "appeal" }>; replayKey: number; reducedMotion: boolean }) {
  return (
    <div className="promise-demo appeal-promise-demo" key={replayKey}>
      <small className="promise-example">{whyTrustContent.exampleLabel}</small>
      <motion.p animate={{ opacity: 1, y: 0 }} className="appeal-user" initial={reducedMotion ? false : { opacity: 0, y: 7 }} transition={{ duration: reducedMotion ? 0 : 0.38 }}>
        {data.userMessage}
      </motion.p>
      <motion.div
        animate={{ opacity: 1, y: 0 }}
        className="appeal-agent"
        initial={reducedMotion ? false : { opacity: 0, y: 7 }}
        transition={{ delay: reducedMotion ? 0 : 0.9, duration: reducedMotion ? 0 : 0.4 }}
      >
        <span>
          <motion.i animate={{ width: "100%" }} initial={reducedMotion ? false : { width: "0%" }} transition={{ delay: reducedMotion ? 0 : 1.25, duration: reducedMotion ? 0 : 1.35, ease: "linear" }}>
            {data.agentMessage}
          </motion.i>
        </span>
        <b>
          <motion.i animate={{ scaleX: 1 }} initial={reducedMotion ? false : { scaleX: 0 }} transition={{ delay: reducedMotion ? 0 : 2.7, duration: reducedMotion ? 0 : 0.95, ease: [0.22, 0.7, 0.2, 1] }} />
        </b>
      </motion.div>
    </div>
  );
}

function PromiseCard({ data }: { data: PromiseData }) {
  const cardRef = useRef<HTMLElement>(null);
  const reducedMotion = Boolean(useReducedMotion());
  const playedRef = useRef(false);
  const [replayKey, setReplayKey] = useState(0);

  useEffect(() => {
    const card = cardRef.current;
    if (!card || reducedMotion) return;
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !playedRef.current) {
        playedRef.current = true;
        setReplayKey((key) => key + 1);
        observer.disconnect();
      }
    }, { threshold: 0.35 });
    observer.observe(card);
    return () => observer.disconnect();
  }, [reducedMotion]);

  const replay = () => {
    if (!reducedMotion) setReplayKey((key) => key + 1);
  };

  return (
    <article
      className="promise-card"
      onClick={replay}
      onKeyDown={(event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          replay();
        }
      }}
      onMouseEnter={replay}
      ref={cardRef}
      tabIndex={0}
    >
      <span className="promise-card-label"><b>{data.number}</b><i />{data.label}</span>
      {data.id === "evidence" && <EvidencePromiseDemo data={data} reducedMotion={reducedMotion} replayKey={replayKey} />}
      {data.id === "restraint" && <RestraintPromiseDemo data={data} reducedMotion={reducedMotion} replayKey={replayKey} />}
      {data.id === "appeal" && <AppealPromiseDemo data={data} reducedMotion={reducedMotion} replayKey={replayKey} />}
      <div className="promise-card-copy">
        <h3>{data.title}</h3>
        <p>{data.description}</p>
      </div>
    </article>
  );
}

function TrustVerificationBand() {
  const data = whyTrustContent.verification;
  const hasUnfilledPlaceholder = [data.sample, data.metric].some((value) => /\{[A-Z_]+\}/.test(value));
  if (hasUnfilledPlaceholder) return null;
  return (
    <section className="trust-verification-band">
      <div>
        <div className="verification-weights">
          {data.weights.map((weight) => <i className={`weight-${weight.code.toLowerCase()}`} key={weight.code} style={{ flex: weight.value }}>{weight.code} {weight.value}%</i>)}
        </div>
        <small>{data.caption}</small>
      </div>
      <p><span>{data.sample}</span><strong>{data.metric}</strong></p>
    </section>
  );
}

function WhyTrustSection() {
  const scrollToComposer = () => {
    window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    window.setTimeout(() => document.getElementById("hero-trust-input")?.focus(), 650);
  };

  return (
    <section className="why-trust-section" id="why-trust">
      <div className="why-trust-shell">
        <header className="why-trust-heading">
          <span>{whyTrustContent.eyebrow}</span>
          <h2>{whyTrustContent.title}<em>{whyTrustContent.emphasis}</em></h2>
          <p>{whyTrustContent.subtitle}</p>
        </header>
        <div className="promise-card-grid">
          {whyTrustContent.promises.map((promise) => <PromiseCard data={promise} key={promise.id} />)}
        </div>
        <TrustVerificationBand />
        <button className="why-trust-back" onClick={scrollToComposer}>{whyTrustContent.backToTop}</button>
      </div>
    </section>
  );
}

