interface RecentRunRecord {
  id: string;
  taskId: string;
  title: string;
  createdAt: string;
  trustScore: number;
  trustLabel: string;
  activeDimensions: DimensionCode[];
  report: ReportRead;
  sample: SampleRead | null;
}

const allDimensions: DimensionCode[] = ["T", "R", "U", "S"];
const RECENT_RUNS_STORAGE_KEY = "trulens-recent-runs-v1";

function loadRecentRuns(): RecentRunRecord[] {
  try {
    const raw = window.localStorage.getItem(RECENT_RUNS_STORAGE_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed
      .filter((item): item is RecentRunRecord =>
        Boolean(item?.id && item?.taskId && item?.report?.task_id && typeof item?.title === "string"),
      )
      .slice(0, 8);
  } catch {
    return [];
  }
}

function deriveRecentTitle(prompt: string, filename: string): string {
  if (filename.trim()) return filename.trim().slice(0, 30);
  const cleaned = prompt
    .replace(/https?:\/\/\S+/gi, "")
    .replace(/[【】]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (!cleaned) return "内容真实性核验";
  return cleaned.length > 24 ? `${cleaned.slice(0, 24)}…` : cleaned;
}

function recentDateLabel(iso: string): string {
  const created = new Date(iso);
  const elapsed = Date.now() - created.getTime();
  if (!Number.isFinite(elapsed) || elapsed < 60_000) return "刚刚";
  if (elapsed < 3_600_000) return `${Math.max(1, Math.floor(elapsed / 60_000))} 分钟前`;
  if (elapsed < 86_400_000) return `${Math.max(1, Math.floor(elapsed / 3_600_000))} 小时前`;
  return created.toLocaleDateString("zh-CN", { month: "numeric", day: "numeric" });
}

function inferDimensions(prompt: string, filename: string): DimensionCode[] {
  const content = `${prompt} ${filename}`.toLowerCase();
  const normalizedPrompt = prompt.trim().toLowerCase();
  const mentionsComments = /评论|评论区|留言|回复|comment/.test(content);
  const mentionsAccount = /账号|帐号|博主|主页|历史内容|account|profile/.test(content);
  const mentionsImage = /配图|图片|图像|照片|视觉|对比图|image|photo/.test(content);
  const requestsFullAnalysis = /全部|完整|多模态|整篇帖子|小红书笔记|full/.test(content);
  const hasAnyLink =
    /(?:https?:\/\/|www\.)\S+|(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}(?:\/\S*)?/.test(normalizedPrompt);

  if (hasAnyLink) return allDimensions;
  if (requestsFullAnalysis && filename) return allDimensions;
  if (mentionsComments) return ["U", "S"];
  if (mentionsAccount) return ["T", "S"];
  if (mentionsImage) return ["R", "S"];
  if (filename) return ["R", "S"];
  return ["S"];
}

