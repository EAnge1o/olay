  { code: "S", title: "文本真实性", en: "Safety", score: 91, status: "安全", tone: "green", text: "未使用绝对化功效承诺，色号、持妆与肤质描述均保留了个人体验边界。", evidence: ["无医疗功效宣称", "含个体差异说明", "合作标识清晰"] },
];

