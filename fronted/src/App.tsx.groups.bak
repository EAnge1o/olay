type LearnClue = (typeof learnContent.clues)[number];
type LearnRound = (typeof learnContent.rounds)[number];

function LearnClueExample({ clue }: { clue: LearnClue }) {
  if (clue.code === "T") {
    return (
      <div className="learn-account-example">
        {clue.example.labels.map((label, index) => <span className={index > 1 ? "dense" : ""} key={label}>{label}</span>)}
        <small>{clue.example.note}</small>
      </div>
    );
  }
  if (clue.code === "R") {
    return (
      <div className="learn-image-example">
        <div><span>BEFORE</span></div><div><span>AFTER</span></div>
        {clue.example.labels.map((label, index) => <i className={`learn-image-callout callout-${index + 1}`} key={label}>{label}</i>)}
        <small>{learnContent.exampleLabel}</small>
      </div>
    );
  }
  if (clue.code === "U") {
    return (
      <div className="learn-comment-example">
        {clue.example.comments.map((comment, index) => <span className={index < 3 ? "similar" : ""} key={comment}>{comment}</span>)}
        <svg aria-hidden="true" viewBox="0 0 420 150"><path d="M15 19 C380 25 380 62 15 68 C380 72 380 108 15 116" /></svg>
      </div>
    );
  }
  const parts = clue.example.text.split(clue.example.highlight);
  return (
    <div className="learn-copy-example">
      <p>{parts[0]}<mark>{clue.example.highlight}</mark>{parts[1]}</p>
      <small>{clue.example.note}</small>
    </div>
  );
}

function LearnClueCard({ clue, index }: { clue: LearnClue; index: number }) {
  const reducedMotion = Boolean(useReducedMotion());
  return (
    <motion.article
      className={`learn-clue-card clue-${clue.code.toLowerCase()}`}
      initial={reducedMotion ? false : { opacity: 0, y: 14 }}
      transition={{ duration: reducedMotion ? 0 : 0.5, delay: reducedMotion ? 0 : index * 0.04 }}
      viewport={{ amount: 0.2, once: true }}
      whileInView={{ opacity: 1, y: 0 }}
    >
      <header><span>{clue.code}</span><h3>{clue.title}</h3></header>
      <ul>{clue.points.map((point) => <li key={point}>{point}</li>)}</ul>
      {"reminder" in clue && <p className="learn-reminder">{clue.reminder}</p>}
      <LearnClueExample clue={clue} />
    </motion.article>
  );
}

function QuizRound({
  focusOnMount = false,
  index,
  nextLabel = learnContent.quizSection.next,
  onComplete,
  onNext,
  resetKey,
  round,
}: {
  focusOnMount?: boolean;
  index: number;
  nextLabel?: string;
  onComplete: (index: number, score: number | null) => void;
  onNext: () => void;
  resetKey: number;
  round: LearnRound;
}) {
  const headerRef = useRef<HTMLElement>(null);
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const [revealed, setRevealed] = useState(false);
  const total = round.items.filter((item) => item.suspicious).length;
  const found = round.items.filter((item, itemIndex) => item.suspicious && selected.has(itemIndex)).length;

  useEffect(() => {
    setSelected(new Set());
    setRevealed(false);
  }, [resetKey]);

  useEffect(() => {
    if (focusOnMount) headerRef.current?.focus({ preventScroll: true });
  }, []);

  const toggle = (itemIndex: number) => {
    if (revealed) return;
    setSelected((current) => {
      const next = new Set(current);
      if (next.has(itemIndex)) next.delete(itemIndex);
      else next.add(itemIndex);
      return next;
    });
  };

  const reveal = () => {
    setRevealed(true);
    onComplete(index, found);
  };

  const itemClass = (item: LearnRound["items"][number], itemIndex: number) => [
    selected.has(itemIndex) ? "selected" : "",
    revealed && item.suspicious ? "answer" : "",
    revealed && item.suspicious && !selected.has(itemIndex) ? "missed" : "",
  ].filter(Boolean).join(" ");

  return (
    <article className={`learn-quiz-round round-${round.kind}`}>
      <header ref={headerRef} tabIndex={-1}><span>{round.label}</span><small>{index + 1} / {learnContent.rounds.length}</small></header>
      <div className="round-progress">{learnContent.rounds.map((item, dotIndex) => <i className={dotIndex <= index ? "active" : ""} key={item.id} />)}</div>
      {round.kind === "image" ? (
        <div className="quiz-image-sample">
          {round.samples.map((label, sampleIndex) => (
            <div className={`sample-${sampleIndex}`} key={label}>
              <img alt={`${round.image.alt} · ${label}`} src={round.image.src} />
              <span>{label}</span>
              <small>虚构样本</small>
            </div>
          ))}
          {round.items.map((item, itemIndex) => (
            <button
              aria-label={`选择图片线索：${item.text}`}
              aria-pressed={selected.has(itemIndex)}
              className={itemClass(item, itemIndex)}
              key={item.text}
              onClick={() => toggle(itemIndex)}
              style={{ left: `${item.x}%`, top: `${item.y}%` }}
            >
              <i /><span>{revealed ? item.explanation : item.text}</span>
            </button>
          ))}
        </div>
      ) : (
        <div className={`quiz-select-list ${round.kind === "comments" ? "comment-select-list" : ""}`}>
          {round.items.map((item, itemIndex) => (
            <button
              aria-label={`选择${round.kind === "comments" ? "评论" : "句子"}：${item.text}`}
              aria-pressed={selected.has(itemIndex)}
              className={itemClass(item, itemIndex)}
              key={item.text}
              onClick={() => toggle(itemIndex)}
            >
              <span>{item.text}</span>
              {revealed && item.suspicious && <small>{item.explanation}</small>}
            </button>
          ))}
          {round.kind === "comments" && revealed && (
            <svg aria-hidden="true" className="quiz-comment-curve" viewBox="0 0 500 300"><path d="M18 30 C470 35 470 85 18 91 C470 96 470 190 18 194" /></svg>
          )}
        </div>
      )}
      {revealed && (
        <div aria-live="polite" className="round-answer">
          <strong>{learnContent.quizSection.found.replace("{FOUND}", String(found)).replace("{TOTAL}", String(total))}</strong>
          {"answerNote" in round && <p>{round.answerNote}</p>}
        </div>
      )}
      <footer>
        {!revealed ? (
          <button className="round-reveal" onClick={reveal}>{learnContent.quizSection.reveal}</button>
        ) : (
          <>
            <button onClick={() => { setSelected(new Set()); setRevealed(false); onComplete(index, null); }}>{learnContent.quizSection.retry}</button>
            <button className="round-next" onClick={onNext}>{nextLabel}</button>
          </>
        )}
      </footer>
    </article>
  );
}

function LearnResult({
  focusOnMount = false,
  found,
  onReset,
}: {
  focusOnMount?: boolean;
  found: number;
  onReset: () => void;
}) {
  const reducedMotion = Boolean(useReducedMotion());
  const titleRef = useRef<HTMLElement>(null);
  useEffect(() => {
    if (focusOnMount) titleRef.current?.focus({ preventScroll: true });
  }, []);
  const resultText = learnContent.result.bands.find((band) => found >= band.min)?.text ?? learnContent.result.bands[2].text;
  const scrollToComposer = () => {
    window.scrollTo({ top: 0, behavior: reducedMotion ? "auto" : "smooth" });
    window.setTimeout(() => document.getElementById("hero-trust-input")?.focus(), reducedMotion ? 0 : 650);
  };
  return (
    <motion.section
      animate={{ opacity: 1, y: 0 }}
      className="learn-result"
      initial={reducedMotion ? false : { opacity: 0, y: 18 }}
      transition={{ duration: reducedMotion ? 0 : 0.5 }}
    >
      <span>{learnContent.result.label}</span>
      <strong ref={titleRef} tabIndex={-1}>{learnContent.result.title.replace("{FOUND}", String(found))}</strong>
      <h3>{resultText}</h3>
      <p>{learnContent.result.summary}</p>
      <small>{learnContent.result.source}</small>
      {learnContent.result.sourceCheck && <i aria-hidden="true">{learnContent.result.sourceCheck}</i>}
      <b>{learnContent.result.prompt}</b>
      <button className="learn-result-primary" onClick={scrollToComposer}>{learnContent.result.primary}</button>
      <button className="learn-result-reset" onClick={onReset}>{learnContent.result.reset}</button>
    </motion.section>
  );
}

function LearnSection() {
  const cluesRef = useRef<HTMLElement>(null);
  const quizRef = useRef<HTMLElement>(null);
  const stageRef = useRef<HTMLDivElement>(null);
  const reducedMotion = Boolean(useReducedMotion());
  const [progress, setProgress] = useState(0);
  // 0–2: the round on screen; RESULT_STEP: the summary. Rounds swap in place, one at a time.
  const RESULT_STEP = learnContent.rounds.length;
  const [currentRound, setCurrentRound] = useState(0);
  const [interacted, setInteracted] = useState(false);
  const [stageMinHeight, setStageMinHeight] = useState(0);
  const [scores, setScores] = useState<Array<number | null>>([null, null, null]);
  const [resetKey, setResetKey] = useState(0);
  const complete = scores.every((score) => score !== null);
  const found = scores.reduce<number>((sum, score) => sum + (score ?? 0), 0);

  // The clues and the quiz now sit in the normal page flow, so progress follows the page scroll.
  useEffect(() => {
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.45;
      const quizTop = quizRef.current?.getBoundingClientRect().top ?? Infinity;
      setProgress(quizTop < line ? (currentRound === RESULT_STEP ? 2 : 1) : 0);
    };
    const onScroll = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    return () => {
      window.cancelAnimationFrame(frame);
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    };
  }, [currentRound]);

  // The stage only grows (tallest round / answer seen so far), so swapping rounds never
  // makes the card snap shorter. Re-measured from scratch when the width changes.
  useEffect(() => {
    const stage = stageRef.current;
    if (!stage) return;
    let width = stage.offsetWidth;
    const observer = new ResizeObserver(() => {
      const content = stage.firstElementChild as HTMLElement | null;
      if (!content) return;
      const widthChanged = stage.offsetWidth !== width;
      width = stage.offsetWidth;
      setStageMinHeight((current) => (widthChanged ? content.offsetHeight : Math.max(current, content.offsetHeight)));
    });
    const observeContent = () => {
      observer.disconnect();
      observer.observe(stage);
      if (stage.firstElementChild) observer.observe(stage.firstElementChild);
    };
    observeContent();
    const mutation = new MutationObserver(observeContent);
    mutation.observe(stage, { childList: true });
    return () => {
      observer.disconnect();
      mutation.disconnect();
    };
  }, []);

  const goToStep = (step: number) => {
    setInteracted(true);
    setCurrentRound(step);
  };

  const scrollToBlock = (element: HTMLElement | null) => {
    if (!element) return;
    window.scrollTo({
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      top: element.getBoundingClientRect().top + window.scrollY - 96,
    });
  };

  const resetAll = () => {
    setScores([null, null, null]);
    setResetKey((key) => key + 1);
    goToStep(0);
  };

  return (
    <section className="learn-section" id="learn">
      <div className="learn-layout">
        <aside className="learn-intro">
          <span>{learnContent.eyebrow}</span>
          <h2>{learnContent.title}<em>{learnContent.emphasis}</em></h2>
          <p>{learnContent.subtitle}</p>
          <nav aria-label="学习进度">
            {learnContent.progress.map((label, index) => (
              <button className={progress === index ? "active" : progress > index ? "complete" : ""} key={label} onClick={() => {
                if (index === 0) scrollToBlock(cluesRef.current);
                if (index === 1) scrollToBlock(quizRef.current);
                if (index === 2 && complete) {
                  goToStep(RESULT_STEP);
                  scrollToBlock(quizRef.current);
                }
              }}>
                <i /><span>{label}</span>
              </button>
            ))}
          </nav>
        </aside>
        <div className="learn-card-wrap">
          <div className="learn-scroll-card">
            <div className="learn-card-content">
              <section className="learn-clues" ref={cluesRef}>
                <span className="learn-section-label">{learnContent.clueSection.label}</span>
                <p className="learn-section-intro">{learnContent.clueSection.intro}</p>
                <div className="learn-clue-list">
                  {learnContent.clues.map((clue, index) => <LearnClueCard clue={clue} index={index} key={clue.code} />)}
                </div>
                <p className="learn-clue-closing">{learnContent.clueSection.closing}</p>
              </section>
              <section className="learn-quiz" ref={quizRef}>
                <span className="learn-section-label">{learnContent.quizSection.label}</span>
                <h2>{learnContent.quizSection.title}</h2>
                <p>{learnContent.quizSection.description}</p>
                <div
                  className="learn-round-stage"
                  ref={stageRef}
                  style={{ minHeight: stageMinHeight || undefined }}
                >
                  <AnimatePresence initial={false} mode="wait">
                    <motion.div
                      animate={{ opacity: 1, x: 0 }}
                      className="learn-round-slide"
                      exit={reducedMotion ? { opacity: 1 } : { opacity: 0, x: -16 }}
                      initial={reducedMotion ? false : { opacity: 0, x: 16 }}
                      key={currentRound === RESULT_STEP ? `result-${resetKey}` : `round-${currentRound}-${resetKey}`}
                      transition={{ duration: reducedMotion ? 0 : 0.26, ease: [0.22, 0.7, 0.2, 1] }}
                    >
                      {currentRound === RESULT_STEP ? (
                        <LearnResult focusOnMount={interacted} found={found} onReset={resetAll} />
                      ) : (
                        <QuizRound
                          focusOnMount={interacted}
                          index={currentRound}
                          nextLabel={currentRound === learnContent.rounds.length - 1 ? "查看结果" : learnContent.quizSection.next}
                          onComplete={(roundIndex, score) => setScores((current) => current.map((value, scoreIndex) => scoreIndex === roundIndex ? score : value))}
                          onNext={() => {
                            if (currentRound < learnContent.rounds.length - 1) goToStep(currentRound + 1);
                            else if (complete) goToStep(RESULT_STEP);
                          }}
                          resetKey={resetKey}
                          round={learnContent.rounds[currentRound]}
                        />
                      )}
                    </motion.div>
                  </AnimatePresence>
                </div>
              </section>
            </div>
          </div>
          <i className="learn-fade learn-fade-top" /><i className="learn-fade learn-fade-bottom" />
        </div>
      </div>
      <footer className="learn-footer">{learnContent.footer}</footer>
    </section>
  );
}

const faqContent = {
  eyebrow: "QUESTIONS & ANSWERS",
  title: "FAQ",
  subtitle: "关于 TruLens 的使用、结果和边界，这里先把常见问题说清楚。",
  groups: [
    {
      title: "一、它是什么、怎么用",
      items: [
        {
          question: "TruLens 是什么？能帮我做什么？",
          answer: "TruLens 是一个帮你判断美妆种草笔记是否可信的 AI 智能体。你把笔记丢进来，它从账号、图片、评论、文案四个角度看一遍，给你一个可信度分数，并把每个判断的依据摊开给你看。",
        },
        {
          question: "我需要提供什么？只给文字也行吗？",
          answer: "可以提供笔记链接、复制的文字或截图，三种都行，也可以组合着给。你给什么，我们就分析什么。只给文字，就只分析文案。",
        },
      ],
    },
    {
      title: "二、怎么理解结果",
      items: [
        {
          question: "84 分是什么意思？高可信就一定是真的吗？",
          answer: "分数是对这篇笔记在当前可见信息下的可信度评估，不是真伪判决。分数高代表没发现明显问题，但仍可能有值得留意的地方，所以请一并看报告里标出的留意项和每个维度的证据。",
        },
      ],
    },
    {
      title: "三、它的边界",
      items: [
        {
          question: "TruLens 会判错吗？",
          answer: "会。任何自动检测都可能漏掉或误判。所以我们不只给分数，还给证据，数据不足时不硬判，你不同意时也可以反驳。",
        },
        {
          question: "为什么不直接告诉我“真”还是“假”？",
          answer: "因为一个“真或假”的结论，对一篇真假混杂的笔记并不诚实。很多笔记是真的在分享，只是图被修得过头，或者评论里混了几条模板。我们给的是可信度和依据，让你自己判断。",
        },
        {
          question: "TruLens 能告诉我这个产品好不好用、适不适合我的皮肤吗？",
          answer: "不能。TruLens 判断的是这篇笔记可不可信，不是产品功效评测，也不是医疗建议，更不会替你决定买不买。",
        },
      ],
    },
    {
      title: "四、隐私与数据",
      items: [
        {
          question: "我提交的内容会被保存吗？",
          answer: "会保存在本次演示环境的本地数据库与上传目录中，用于生成和查看报告。当前版本还没有提供自助删除入口，正式上线前需要补充数据保留期限与删除流程。",
        },
      ],
    },
    {
      title: "五、追问和反驳",
      items: [
        {
          question: "报告出来之后，我还能做什么？",
          answer: "你可以基于这篇笔记继续追问，比如“为什么图片这一项扣分”，回答会标明用到了哪几个维度。如果你不同意某个判断，可以补充理由、上传证据并选择对应维度；当前版本会记录这些材料并展示复核过程，不会自动改动已经生成的分数。",
        },
      ],
    },
  ],
} as const;

type FAQItemData = (typeof faqContent.groups)[number]["items"][number];

function FAQItem({ index, item }: { index: number; item: FAQItemData }) {
  const [open, setOpen] = useState(false);
  const reducedMotion = Boolean(useReducedMotion());
  const answerId = `faq-answer-${index}`;
  return (
    <article className={`faq-item ${open ? "open" : ""}`}>
      <button aria-controls={answerId} aria-expanded={open} onClick={() => setOpen((current) => !current)}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <strong>{item.question}</strong>
        <i aria-hidden="true"><b /><b /></i>
      </button>
      <AnimatePresence initial={false}>
        {open && (
          <motion.div
            animate={{ height: "auto", opacity: 1 }}
            className="faq-answer"
            exit={{ height: 0, opacity: 0 }}
            id={answerId}
            initial={reducedMotion ? false : { height: 0, opacity: 0 }}
            transition={{ duration: reducedMotion ? 0 : 0.28, ease: [0.22, 0.7, 0.2, 1] }}
          >
            <p>{item.answer}</p>
          </motion.div>
        )}
      </AnimatePresence>
    </article>
  );
}

function FAQSection() {
  let itemIndex = 0;
  return (
    <section className="faq-section" id="faq">
      <header className="faq-heading">
        <span>{faqContent.eyebrow}</span>
        <h2>{faqContent.title}</h2>
        <p>{faqContent.subtitle}</p>
      </header>
      <div className="faq-shell">
        {faqContent.groups.map((group) => (
          <section className="faq-group" key={group.title}>
            <h3>{group.title}</h3>
            <div>
              {group.items.map((item) => {
                const currentIndex = itemIndex;
                itemIndex += 1;
                return <FAQItem index={currentIndex} item={item} key={item.question} />;
              })}
            </div>
          </section>
        ))}
      </div>
    </section>
  );
}

const footerContent = {
  explore: {
    title: "EXPLORE",
    links: [
      { label: "产品介绍", target: "how-journey" },
      { label: "信任依据", target: "why-trust" },
      { label: "美妆鉴别指南", target: "learn" },
      { label: "常见问题 FAQ", target: "faq" },
    ],
  },
  information: {
    title: "INFORMATION",
    links: ["隐私政策", "使用说明", "联系我们"],
  },
  copyright: "© 2026 TruLens. All rights reserved.",
  statement: "Made for more mindful beauty choices.",
} as const;

function LandingFooter() {
  const scrollTo = (target: string) => {
    document.getElementById(target)?.scrollIntoView({
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      block: "start",
    });
  };
  return (
    <footer className="landing-footer">
      <div className="landing-footer-main">
        <div className="landing-footer-brand-area">
          <button className="landing-footer-brand" onClick={() => window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" })}>
            <img alt="TruLens" src="/trulens-nav-logo.png" />
          </button>
          <input aria-label="输入要鉴别的内容" placeholder="我今天帮你鉴别什么？" />
        </div>
        <nav aria-label="页脚探索导航" className="landing-footer-column">
          <strong>{footerContent.explore.title}</strong>
          {footerContent.explore.links.map((link) => (
            <button key={link.target} onClick={() => scrollTo(link.target)}>{link.label}</button>
          ))}
        </nav>
        <div className="landing-footer-column landing-footer-information">
          <strong>{footerContent.information.title}</strong>
          {footerContent.information.links.map((link) => <span key={link}>{link}</span>)}
        </div>
      </div>
      <div className="landing-footer-bottom">
        <span>{footerContent.copyright}</span>
        <span>{footerContent.statement}</span>
      </div>
    </footer>
  );
}

function Home({
  onCreator,
  onStart,
  onSubmit,
  onTeam,
}: {
  onCreator: () => void;
  onStart: () => void;
  onSubmit: (prompt: string, filename: string, example: boolean) => void;
  onTeam: () => void;
}) {

  return (
    <main className="home">
      <LandingNavigation onStart={onStart} onTeam={onTeam} />

      <TruLensHero onSubmit={onSubmit} />

      <HowNarrative onStart={onStart} />

      <WhyTrustSection />

      <WhoUsesSection onCreator={onCreator} onTeam={onTeam} onVerify={onStart} />

      <LearnSection />

      <FAQSection />

      <LandingFooter />
    </main>
  );
}

function Sidebar({
  active,
  activeTask,
  archivedScore,
  activeRecentId,
  collapsed,
  historyCleared,
  recentRuns,
  onNew,
  onLive,
  onLogout,
  onRecent,
  onResetAgent,
  onReport,
  onTask,
  onTaskReport,
  onToggle,
}: {
  active: Screen;
  activeTask: RecentTask;
  archivedScore: number | null;
  activeRecentId: string | null;
  collapsed: boolean;
  historyCleared: boolean;
  recentRuns: RecentRunRecord[];
  onNew: () => void;
  onLive: () => void;
  onLogout: () => void;
  onRecent: (id: string) => void;
  onResetAgent: () => void;
  onReport: (task: RecentTask) => void;
  onTask: (task: RecentTask) => void;
  onTaskReport: (taskId: string) => void;
  onToggle: () => void;
}) {
  const [accountMenuOpen, setAccountMenuOpen] = useState(false);
  const [accountDialog, setAccountDialog] = useState<"help" | "reset" | "add" | "logout" | null>(null);
  const [accountInput, setAccountInput] = useState("");
  const [accountAdded, setAccountAdded] = useState(false);
  const [searchOpen, setSearchOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [searchCategory, setSearchCategory] = useState<"all" | "reports">("all");
  const searchInputRef = useRef<HTMLInputElement>(null);
  const [reportLibrary, setReportLibrary] = useState<Array<{
    taskId: string;
    title: string;
    date: string;
    status: string;
    score: number;
  }>>([]);
  useEffect(() => {
    void getTeamQueue()
      .then((data) => {
        setReportLibrary(
          data.items.map((item) => ({
            taskId: item.task_id,
            title: item.title,
            date: recentDateLabel(item.created_at),
            status: item.risk_level === "high" ? "高风险" : item.risk_level === "medium" ? "中风险" : "高可信",
            score: Math.round(item.score),
          })),
        );
      })
      .catch(() => setReportLibrary([]));
  }, []);
  const searchableTasks = reportLibrary.filter(
    (item) => !recentRuns.some((run) => run.taskId === item.taskId),
  );
  const filteredSearchTasks = historyCleared
    ? []
    : searchableTasks.filter((item) =>
      `${item.title} ${item.date} ${item.status}`.toLowerCase().includes(searchQuery.trim().toLowerCase()),
    );
  const filteredRecentRuns = historyCleared
    ? []
    : recentRuns.filter((item) =>
      `${item.title} ${recentDateLabel(item.createdAt)} ${item.trustLabel}`
        .toLowerCase()
        .includes(searchQuery.trim().toLowerCase()),
    );
  const searchResultCount = filteredRecentRuns.length + filteredSearchTasks.length;

  useEffect(() => {
    if (!accountDialog) return;
    const closeOnEscape = (event: KeyboardEvent) => {
      if (event.key === "Escape") setAccountDialog(null);
    };
    window.addEventListener("keydown", closeOnEscape);
    return () => window.removeEventListener("keydown", closeOnEscape);
  }, [accountDialog]);

  useEffect(() => {
    if (!searchOpen) return;
    searchInputRef.current?.focus();
    const closeOnEscape = (event: KeyboardEvent) => {
      if (event.key === "Escape") setSearchOpen(false);
    };
    window.addEventListener("keydown", closeOnEscape);
    return () => window.removeEventListener("keydown", closeOnEscape);
  }, [searchOpen]);

  const openDialog = (dialog: Exclude<typeof accountDialog, null>) => {
    setAccountMenuOpen(false);
    setAccountDialog(dialog);
    if (dialog === "add") {
      setAccountInput("");
      setAccountAdded(false);
    }
  };

  return (
    <aside className={`sidebar ${collapsed ? "collapsed" : ""}`}>
      <div className="side-top">
        <Logo />
        <div className="side-top-actions">
          <button
            aria-label="搜索历史对话和报告"
            className="icon-button sidebar-search-button"
            onClick={() => {
              setAccountMenuOpen(false);
              setSearchQuery("");
              setSearchCategory("all");
              setSearchOpen(true);
            }}
            title="搜索"
          >
            <Icon size={18}>
              <circle cx="11" cy="11" r="6.5" stroke="currentColor" strokeWidth="1.5" />
              <path d="m16 16 4 4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" />
            </Icon>
          </button>
          <button
            aria-label={collapsed ? "展开侧栏" : "收起侧栏"}
            aria-pressed={collapsed}
            className="icon-button mobile-hide sidebar-toggle"
            onClick={onToggle}
            title={collapsed ? "展开侧栏" : "收起侧栏"}
          >
            <Icon size={18}>
              <path d="M4 5h16M4 12h10M4 19h16" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" />
            </Icon>
          </button>
        </div>
      </div>
      <button className="new-analysis" onClick={onNew}>
        <span>
          <Sparkle size={17} /> 新建鉴别
        </span>
        <small>⌘ K</small>
      </button>
      <button
        className="sidebar-report-library"
        onClick={() => {
          setAccountMenuOpen(false);
          setSearchQuery("");
          setSearchCategory("reports");
          setSearchOpen(true);
        }}
        title="报告库"
      >
        <span>
          <Icon size={17}>
            <path d="M6 3h9l3 3v15H6V3Z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.4" />
            <path d="M15 3v4h3M9 11h6M9 14h6M9 17h4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.3" />
          </Icon>
          报告库
        </span>
        <small>{historyCleared ? 0 : recentRuns.length + searchableTasks.length}</small>
      </button>
      <button
        className="sidebar-report-library"
        onClick={() => {
          setAccountMenuOpen(false);
          setSearchOpen(false);
          onLive();
        }}
        title="实时核验（调用真实后端）"
      >
        <span>
          <Icon size={17}>
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" />
            <circle cx="12" cy="12" r="4.2" stroke="currentColor" strokeWidth="1.5" />
          </Icon>
          实时核验
        </span>
        <small>live</small>
      </button>
      <button
        className="sidebar-help-guide"
        onClick={() => openDialog("help")}
        title="帮助指引"
      >
        <span>
          <Icon size={17}>
            <circle cx="12" cy="12" r="9" stroke="currentColor" strokeWidth="1.4" />
            <path d="M9.7 9.2a2.5 2.5 0 1 1 3.1 2.4c-.6.3-.8.8-.8 1.5M12 16.7v.1" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" />
          </Icon>
          帮助指引
        </span>
      </button>
      <div className="side-label">最近任务</div>
      <div className="history">
        {historyCleared ? (
          <p className="history-empty">暂无检测记录</p>
        ) : (
          <>
            {recentRuns.map((run) => (
              <button
                className={activeRecentId === run.id && active === "result" ? "active" : ""}
                key={run.id}
                onClick={() => onRecent(run.id)}
              >
                <span className="history-thumb purple">{Math.round(run.trustScore)}</span>
                <span>
                  <strong>{run.title}</strong>
                  <small>{recentDateLabel(run.createdAt)} · {run.trustLabel}</small>
                </span>
              </button>
            ))}
            <button className={!activeRecentId && activeTask === "makeup" && (active === "chat" || active === "result") ? "active" : ""} onClick={() => onTask("makeup")}>
              <span className="history-thumb">
                <img alt="" src={postImage} />
              </span>
              <span>
                <strong>秋冬奶油肌底妆分享</strong>
                <small>{archivedScore ? `今天 · 已归档 · ${archivedScore} 分` : "今天 · 高可信"}</small>
              </span>
            </button>
            <button className={!activeRecentId && activeTask === "serum" && (active === "chat" || active === "result") ? "active" : ""} onClick={() => onTask("serum")}>
              <span className="history-thumb purple">
                <Sparkle size={15} />
              </span>
              <span>
                <strong>热门精华测评合集</strong>
                <small>昨天 · 存在风险</small>
              </span>
            </button>
            <button className={!activeRecentId && activeTask === "whitening" && (active === "chat" || active === "result") ? "active" : ""} onClick={() => onTask("whitening")}>
              <span className="history-thumb blue">S</span>
              <span>
                <strong>七天美白挑战</strong>
                <small>3 天前 · 疑似营销</small>
              </span>
            </button>
          </>
        )}
      </div>
      {searchOpen && (
        <div
          aria-modal="true"
          className="global-search-backdrop"
          onMouseDown={(event) => {
            if (event.currentTarget === event.target) setSearchOpen(false);
          }}
          role="dialog"
        >
          <div className="global-search-dialog">
            <header className="global-search-header">
              <div className="global-search-input">
                <Icon size={21}>
                  <circle cx="11" cy="11" r="6.5" stroke="currentColor" strokeWidth="1.5" />
                  <path d="m16 16 4 4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" />
                </Icon>
                <input
                  aria-label="搜索历史对话和报告"
                  onChange={(event) => setSearchQuery(event.target.value)}
                  placeholder="搜索历史对话或报告…"
                  ref={searchInputRef}
                  value={searchQuery}
                />
                {searchQuery && <button aria-label="清空搜索" onClick={() => setSearchQuery("")}>×</button>}
              </div>
              <button aria-label="关闭搜索" className="global-search-close" onClick={() => setSearchOpen(false)}>
                <Icon size={20}><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
              </button>
            </header>

            <div className="global-search-tabs" role="tablist">
              <button
                aria-selected={searchCategory === "all"}
                className={searchCategory === "all" ? "active" : ""}
                onClick={() => setSearchCategory("all")}
                role="tab"
              >
                <span>
                  <Icon size={18}><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.4" /></Icon>
                </span>
                <strong>全部</strong>
                <small>历史对话</small>
              </button>
              <button
                aria-selected={searchCategory === "reports"}
                className={searchCategory === "reports" ? "active" : ""}
                onClick={() => setSearchCategory("reports")}
                role="tab"
              >
                <span>
                  <Icon size={18}><path d="M6 3h9l3 3v15H6V3Z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.4" /><path d="M15 3v4h3M9 11h6M9 14h6M9 17h4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.3" /></Icon>
                </span>
                <strong>报告库</strong>
                <small>历史报告合集</small>
              </button>
            </div>

            <div className="global-search-results">
              <div className="global-search-result-heading">
                <span>{searchCategory === "all" ? "历史对话" : "报告库"}</span>
                <small>{searchResultCount} 项结果</small>
              </div>
              {searchResultCount ? (
                <>
                  {filteredRecentRuns.map((run) => (
                    <button
                      className="global-search-result"
                      key={`recent-${run.id}`}
                      onClick={() => {
                        setSearchOpen(false);
                        onRecent(run.id);
                      }}
                    >
                      <span className="global-search-result-icon report">
                        <Icon size={18}><path d="M6 3h9l3 3v15H6V3Z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.4" /><path d="M9 11h6M9 14h6M9 17h4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.3" /></Icon>
                      </span>
                      <span>
                        <strong>{run.title}</strong>
                        <small>{recentDateLabel(run.createdAt)} · {run.trustLabel}</small>
                      </span>
                      <b>{Math.round(run.trustScore)}<small>/100</small></b>
                      <i>›</i>
                    </button>
                  ))}
                  {filteredSearchTasks.map((item) => (
                    <button
                      className="global-search-result"
                      key={`library-${item.taskId}`}
                      onClick={() => {
                        setSearchOpen(false);
                        onTaskReport(item.taskId);
                      }}
                    >
                      <span className="global-search-result-icon report">
                        <Icon size={18}><path d="M6 3h9l3 3v15H6V3Z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.4" /><path d="M9 11h6M9 14h6M9 17h4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.3" /></Icon>
                      </span>
                      <span>
                        <strong>{item.title}</strong>
                        <small>{item.date} · {item.status}</small>
                      </span>
                      <b>{item.score}<small>/100</small></b>
                      <i>›</i>
                    </button>
                  ))}
                </>
              ) : (
                <div className="global-search-empty">
                  <Icon size={24}><circle cx="11" cy="11" r="6.5" stroke="currentColor" strokeWidth="1.4" /><path d="m16 16 4 4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.4" /></Icon>
                  <strong>没有找到相关内容</strong>
                  <small>尝试搜索任务名称、日期或核验状态</small>
                </div>
              )}
            </div>
            <footer className="global-search-footer"><span><kbd>Esc</kbd> 关闭</span><span>点击结果即可打开</span></footer>
          </div>
        </div>
      )}
      {accountMenuOpen && <button aria-label="关闭账户菜单" className="account-menu-scrim" onClick={() => setAccountMenuOpen(false)} />}
      {accountMenuOpen && (
        <div className="account-menu">
          <button className="account-menu-reset" onClick={() => openDialog("reset")}>
            <span className="account-menu-icon">
              <Icon size={20}><path d="M19 8a7 7 0 1 0 .2 7.6M19 4v4h-4" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
            </span>
            <span><strong>重置 Agent</strong><small>清空聊天与检测历史</small></span>
          </button>
          <div className="account-menu-divider" />
          <button onClick={() => openDialog("add")}>
            <span className="account-menu-icon">
              <Icon size={20}><circle cx="12" cy="12" r="8.5" stroke="currentColor" strokeWidth="1.5" /><path d="M12 8v8M8 12h8" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
            </span>
            <span><strong>添加账号</strong><small>绑定另一个登录账号</small></span>
          </button>
          <button onClick={() => openDialog("logout")}>
            <span className="account-menu-icon">
              <Icon size={20}><path d="M10 5H5v14h5M14 8l4 4-4 4M9 12h9" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" /></Icon>
            </span>
            <span><strong>退出登录</strong><small>退出当前个人账户</small></span>
          </button>
        </div>
      )}
      <div className="side-bottom">
        <button
          aria-expanded={accountMenuOpen}
          className={accountMenuOpen ? "account-trigger active" : "account-trigger"}
          onClick={() => setAccountMenuOpen((open) => !open)}
        >
          <span className="avatar">YZ</span>
          <span>
            <strong>Yuzuki</strong>
            <small>个人账户</small>
          </span>
          <span className="dots">
            <Icon size={18}><circle cx="12" cy="12" r="3" stroke="currentColor" strokeWidth="1.5" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
          </span>
        </button>
      </div>

      {accountDialog && (
        <div
          aria-modal="true"
          className="account-dialog-backdrop"
          onMouseDown={(event) => {
            if (event.currentTarget === event.target) setAccountDialog(null);
          }}
          role="dialog"
        >
          <div className={`account-dialog ${accountDialog === "help" ? "account-dialog-wide" : ""}`}>
            <button aria-label="关闭弹窗" className="account-dialog-close" onClick={() => setAccountDialog(null)}>×</button>
            {accountDialog === "help" && (
              <>
                <span className="account-dialog-tag">HELP CENTER</span>
                <h2>帮助指引</h2>
                <p>快速了解如何使用 TruLens 完成一次内容核验。</p>
                <div className="help-guide">
                  <section>
                    <h3>使用教程</h3>
                    <ol>
                      <li><span>1</span><div><strong>提供内容</strong><small>粘贴种草链接，或上传需要核验的图片。</small></div></li>
                      <li><span>2</span><div><strong>等待四维核验</strong><small>TruLens 从账号、图片、评论和宣传维度检查证据。</small></div></li>
                      <li><span>3</span><div><strong>阅读报告</strong><small>查看 Trust Score、逐项依据和购买建议。</small></div></li>
                    </ol>
                  </section>
                  <section className="help-faq">
                    <h3>FAQ</h3>
                    <details><summary>链接无法识别怎么办？</summary><p>请确认链接可公开访问，也可以补充截图或原始文案。</p></details>
                    <details><summary>Agent 的核查结论可以当作最终定论吗？</summary><p>TruLens Agent 是辅助核验工具，AI 存在误判、信息遗漏风险，不能直接作为事实定论，重要内容建议交叉查阅权威原始来源。</p></details>
                    <details><summary>数据不足会怎样显示？</summary><p>缺失维度会明确标注“数据不足”，不会由 AI 自动补全。</p></details>
                  </section>
                </div>
              </>
            )}
            {accountDialog === "reset" && (
              <>
                <span className="account-dialog-tag">RESET AGENT</span>
                <h2>重置 TruLens Agent？</h2>
                <p>这会清空当前聊天信息和所有检测历史。操作完成后无法恢复。</p>
                <div className="reset-summary"><span>聊天内容</span><strong>全部清空</strong><span>检测历史</span><strong>全部清空</strong></div>
                <div className="account-dialog-actions">
                  <button onClick={() => setAccountDialog(null)}>取消</button>
                  <button className="danger" onClick={() => { onResetAgent(); setAccountDialog(null); }}>确认重置</button>
                </div>
              </>
            )}
            {accountDialog === "add" && (
              <>
                <span className="account-dialog-tag">ADD ACCOUNT</span>
                <h2>添加账号</h2>
                <p>输入邮箱，将另一个账号添加到当前设备。</p>
                {accountAdded ? (
                  <div className="account-added"><span>✓</span><strong>账号已添加</strong><small>{accountInput}</small></div>
                ) : (
                  <>
                    <label className="account-input-label">邮箱地址<input onChange={(event) => setAccountInput(event.target.value)} placeholder="name@example.com" type="email" value={accountInput} /></label>
                    <div className="account-dialog-actions">
                      <button onClick={() => setAccountDialog(null)}>取消</button>
                      <button disabled={!accountInput.includes("@")} onClick={() => setAccountAdded(true)}>添加账号</button>
                    </div>
                  </>
                )}
              </>
            )}
            {accountDialog === "logout" && (
              <>
                <span className="account-dialog-tag">SIGN OUT</span>
                <h2>退出当前账户？</h2>
                <p>退出后将返回首页，本地检测记录不会被删除。</p>
                <div className="account-dialog-actions">
                  <button onClick={() => setAccountDialog(null)}>取消</button>
                  <button className="danger" onClick={() => { onLogout(); setAccountDialog(null); }}>退出登录</button>
                </div>
              </>
            )}
          </div>
        </div>
      )}
    </aside>
  );
}

const suggestionItems = [
  ["鉴别配图真实性", "上传截图或粘贴帖子链接"],
  ["分析博主的历史可信度", "输入主页链接，检索长期行为"],
  ["检查产品功效宣传", "识别夸大、误导与安全风险"],
];

function Composer({
  accountUrl,
  compact = false,
  filename,
  onAccountUrl,
  onFile,
  onPickFile,
  onPauseToggle,
  onSubmit,
  pauseDisabled = false,
  paused = false,
  preset = "",
}: {
  accountUrl?: string;
  compact?: boolean;
  filename: string;
  onAccountUrl?: (value: string) => void;
  onFile: (name: string) => void;
  /** Hands the real File to the caller so it can actually be uploaded. */
  onPickFile?: (file: File | null) => void;
  onPauseToggle?: () => void;
  onSubmit: (prompt: string) => void;
  pauseDisabled?: boolean;
  paused?: boolean;
  preset?: string;
}) {
  const [value, setValue] = useState("");
  const [accountError, setAccountError] = useState("");
  const inputRef = useRef<HTMLInputElement>(null);
  const accountInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    setValue(preset);
  }, [preset]);

  const noteLink = looksLikeXhsLink(value) ? value : "";
  const accountValue = (accountUrl ?? "").trim();
  const validAccountUrl = /xiaohongshu\.com\/user\/profile\/|xhslink\.(com|cn)/i.test(accountValue);
  const accountMissing = Boolean(!compact && noteLink && !validAccountUrl);
  const noteUrl = value.match(/https?:\/\/[^\s，,、）)]+/)?.[0] ?? "";

  const pasteAccountUrl = async () => {
    try {
      const clipboard = await navigator.clipboard.readText();
      const profileUrl = clipboard.match(
        /https?:\/\/[^\s，,、）)]*xiaohongshu\.com\/user\/profile\/[0-9a-zA-Z]+(?:\?[^\s，,、）)]*)?/i,
      )?.[0] ?? clipboard.trim();
      onAccountUrl?.(profileUrl);
      setAccountError("");
      accountInputRef.current?.focus();
    } catch {
      setAccountError("无法读取剪贴板，请手动粘贴账号主页链接。");
      accountInputRef.current?.focus();
    }
  };

  const submit = () => {
    if (accountMissing) {
      setAccountError("使用笔记链接进行四维核验时，请同时填写有效的账号主页链接。");
      return;
    }
    if (value.trim() || filename) {
      onSubmit(value.trim() || "请帮我鉴别这篇美妆种草帖子是否由 AI 造假");
      setValue("");
    }
  };

  return (
    <div className={`composer ${compact ? "composer-compact" : ""}`}>
      <textarea
        aria-label="输入鉴别需求"
        onChange={(event) => setValue(event.target.value)}
        onKeyDown={(event) => {
          if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            submit();
          }
        }}
        placeholder={compact ? "继续追问这份报告…" : "粘贴帖子链接，或告诉我你想鉴别什么…"}
        rows={compact ? 1 : 3}
        value={value}
      />
      {!compact && (
        <label className="composer-account-field">
          <span>账号主页 · 使用笔记链接时必填</span>
          <input
            aria-label="账号主页链接"
            aria-required={Boolean(noteLink)}
            onChange={(event) => {
              setAccountError("");
              onAccountUrl?.(event.target.value);
            }}
            placeholder="https://www.xiaohongshu.com/user/profile/…"
            ref={accountInputRef}
            value={accountUrl ?? ""}
          />
        </label>
      )}
      {!compact && noteLink && (
        <section className="composer-account-method" aria-label="获取账号主页链接的方法">
          <header>
            <strong>账号主页链接从哪里来？</strong>
            <span className={validAccountUrl ? "ready" : ""}><i />{validAccountUrl ? "已识别" : "待填写"}</span>
          </header>
          <ol>
            <li><b>1</b><span>打开笔记，点击作者头像进入主页</span></li>
            <li><b>2</b><span>在主页右上角点击「分享」→「复制链接」</span></li>
            <li><b>3</b><span>回到这里粘贴以 <code>/user/profile/</code> 开头的链接</span></li>
          </ol>
          <div className="composer-account-method-actions">
            {noteUrl && (
              <button onClick={() => window.open(noteUrl, "_blank", "noopener,noreferrer")} type="button">
                打开笔记
                <Icon size={13}><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
              </button>
            )}
            <button onClick={() => void pasteAccountUrl()} type="button">粘贴账号链接</button>
          </div>
        </section>
      )}
      {!compact && accountError && <p className="composer-account-error">{accountError}</p>}
      {filename && (
        <div className="file-chip">
          <span className="file-preview"><img alt="" src={postImage} /></span>
          <span><strong>{filename}</strong><small>已准备进行图像取证</small></span>
          <button aria-label="移除附件" onClick={() => { onFile(""); onPickFile?.(null); }}>×</button>
        </div>
      )}
      <div className="composer-actions">
        <div>
          <input
            accept="image/*"
            hidden
            onChange={(event) => {
              const file = event.target.files?.[0] ?? null;
              onFile(file?.name || "");
              onPickFile?.(file);
            }}
            ref={inputRef}
            type="file"
          />
          <button className="tool-button" onClick={() => inputRef.current?.click()} title="上传图片">
            <Icon size={18}>
              <path d="M12 4v16M4 12h16" stroke="currentColor" strokeLinecap="round" strokeWidth="1.6" />
            </Icon>
          </button>
          {!compact && (
            <button className="tool-button" title="粘贴链接">
              <Icon size={18}>
                <path d="m9.5 14.5 5-5M7.3 16.7l-1 1a3.5 3.5 0 0 1-5-5l3.2-3.2a3.5 3.5 0 0 1 5 0M16.7 7.3l1-1a3.5 3.5 0 1 1 5 5l-3.2 3.2a3.5 3.5 0 0 1-5 0" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" />
              </Icon>
            </button>
          )}
          {!compact && <span className="composer-hint">支持图片、链接与文案</span>}
        </div>
        <div className="composer-submit-actions">
          {compact && onPauseToggle && (
            <button
              aria-label={pauseDisabled ? "当前回答已完成" : paused ? "继续生成" : "暂停生成"}
              className={paused ? "composer-pause paused" : "composer-pause"}
              disabled={pauseDisabled}
              onClick={onPauseToggle}
              title={pauseDisabled ? "当前回答已完成" : paused ? "继续生成" : "暂停生成"}
            >
              <Icon size={21}>
                {paused ? (
                  <path d="m8 5 11 7-11 7V5Z" fill="currentColor" />
                ) : (
                  <>
                    <circle cx="12" cy="12" r="8" stroke="currentColor" strokeWidth="1.8" />
                    <rect fill="currentColor" height="6" rx="1.2" width="6" x="9" y="9" />
                  </>
                )}
              </Icon>
            </button>
          )}
          <button className="send-button" disabled={(!value.trim() && !filename) || accountMissing} onClick={submit}>
            <Arrow size={18} />
          </button>
        </div>
      </div>
    </div>
  );
}

const NEW_ANALYSIS_EXAMPLE_TEXT = "最近换季皮肤有点干，连续使用这款精华 14 天后，我个人感觉保湿度有所提升。本文为自费购买，具体效果会因肤质和使用方式不同。";

function NewAnalysisForm({
  accountUrl,
  onAccountUrl,
  creatorPreset = "",
  initialMode = "link",
  onFile,
  onSubmitCreator,
  onSubmitLink,
  onSubmitManual,
  preset = "",
  workspaceMode = "verify",
}: {
  accountUrl: string;
  creatorPreset?: string;
  initialMode?: "link" | "manual" | "creator";
  onAccountUrl: (value: string) => void;
  onFile: (name: string) => void;
  onSubmitCreator: (input: CreatorReportInput) => void;
  onSubmitLink: (noteUrl: string, accountUrl: string) => void;
  onSubmitManual: (input: { text: string; image: File | null; comments: string; accountHistory: string }) => void;
  preset?: string;
  workspaceMode?: "verify" | "creator";
}) {
  const [verifyMode, setVerifyMode] = useState<"link" | "manual">(initialMode === "manual" ? "manual" : "link");
  const mode: "link" | "manual" | "creator" = workspaceMode === "creator" ? "creator" : verifyMode;
  const [noteLink, setNoteLink] = useState(preset);
  const [manualText, setManualText] = useState("");
  const [manualFile, setManualFile] = useState<File | null>(null);
  const [manualComments, setManualComments] = useState("");
  const [manualAccountHistory, setManualAccountHistory] = useState("");
  const [supplementOpen, setSupplementOpen] = useState(false);
  const [creatorDraft, setCreatorDraft] = useState(creatorPreset);
  const [creatorImages, setCreatorImages] = useState<Array<{ id: string; name: string; url: string; file: File }>>([]);
  const [creatorCollaboration, setCreatorCollaboration] = useState(false);
  const [creatorCategory, setCreatorCategory] = useState("护肤");
  const [preview, setPreview] = useState("");
  const [error, setError] = useState("");
  const fileInputRef = useRef<HTMLInputElement>(null);
  const creatorFileInputRef = useRef<HTMLInputElement>(null);
  const accountInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    setNoteLink(preset);
  }, [preset]);

  useEffect(() => {
    if (!creatorPreset) return;
    setCreatorDraft(creatorPreset);
  }, [creatorPreset]);

  useEffect(() => {
    if (initialMode !== "creator") setVerifyMode(initialMode);
  }, [initialMode]);

  useEffect(() => () => {
    if (preview) URL.revokeObjectURL(preview);
  }, [preview]);

  const noteReady = looksLikeXhsLink(noteLink);
  const accountReady = /xiaohongshu\.com\/user\/profile\/|xhslink\.(com|cn)/i.test(accountUrl.trim());
  const linkReady = noteReady && accountReady;
  const manualReady = Boolean(manualText.trim() || manualFile);
  const creatorReady = Boolean(creatorDraft.trim() || creatorImages.length);

  const selectFile = (file: File | null) => {
    if (preview) URL.revokeObjectURL(preview);
    setManualFile(file);
    setPreview(file ? URL.createObjectURL(file) : "");
    onFile(file?.name ?? "");
  };

  const addCreatorImages = (files: File[]) => {
    const room = Math.max(0, 9 - creatorImages.length);
    const next = files
      .filter((file) => file.type.startsWith("image/"))
      .slice(0, room)
      .map((file) => ({
        id: `${file.name}-${file.lastModified}-${Math.random()}`,
        name: file.name,
        url: URL.createObjectURL(file),
        file,
      }));
    if (next.length) {
      setCreatorImages((current) => [...current, ...next]);
      setError("");
    }
  };

  const removeCreatorImage = (id: string) => {
    setCreatorImages((current) => {
      const target = current.find((image) => image.id === id);
      if (target) URL.revokeObjectURL(target.url);
      return current.filter((image) => image.id !== id);
    });
  };

  const loadExample = () => {
    setVerifyMode("manual");
    setManualText(NEW_ANALYSIS_EXAMPLE_TEXT);
    setError("");
  };

  const submit = () => {
    setError("");
    if (mode === "link") {
      if (!noteReady) {
        setError("请填写有效的小红书笔记链接。");
        return;
      }
      if (!accountReady) {
        setError("请填写有效的账号主页链接，两个链接缺一不可。");
        return;
      }
      onSubmitLink(noteLink.trim(), accountUrl.trim());
      return;
    }

    if (mode === "creator") {
      if (!creatorReady) {
        setError("请填写草稿文案或上传配图。");
        return;
      }
      onSubmitCreator({
        draft: creatorDraft.trim() || "请检查这些待发布配图",
        images: creatorImages,
        isCollaboration: creatorCollaboration,
        category: creatorCategory,
        isExample: false,
      });
      return;
    }

    if (looksLikeXhsLink(manualText)) {
      setError("检测到笔记链接。请切换到「链接核验」，并同时填写账号主页链接。");
      return;
    }
    if (!manualReady) {
      setError("请填写文案或上传图片。");
      return;
    }
    onSubmitManual({
      text: manualText.trim(),
      image: manualFile,
      comments: manualComments.trim(),
      accountHistory: manualAccountHistory.trim(),
    });
  };

  return (
    <div className={`composer new-analysis-composer mode-${mode}`}>
      {mode !== "creator" && (
        <div className="analysis-mode-switch" role="group" aria-label="核验方式">
          <button
            aria-pressed={mode === "link"}
            className={mode === "link" ? "active" : ""}
            onClick={() => { setVerifyMode("link"); setError(""); }}
            type="button"
          >
            链接核验
          </button>
          <button
            aria-pressed={mode === "manual"}
            className={mode === "manual" ? "active" : ""}
            onClick={() => { setVerifyMode("manual"); setError(""); }}
            type="button"
          >
            文案 / 图片核验
          </button>
        </div>
      )}

      {mode === "link" ? (
        <>
          <div className="new-analysis-link-fields">
            <label className="new-analysis-field">
              <span>笔记链接</span>
              <input
                aria-label="笔记链接"
                onChange={(event) => { setNoteLink(event.target.value); setError(""); }}
                onKeyDown={(event) => { if (event.key === "Enter") submit(); }}
                placeholder="粘贴公开可访问的笔记链接"
                value={noteLink}
              />
            </label>
            <label className="new-analysis-field">
              <span>作者主页链接 <small>必填</small></span>
              <input
                aria-label="作者主页链接"
                onChange={(event) => { onAccountUrl(event.target.value); setError(""); }}
                onKeyDown={(event) => { if (event.key === "Enter") submit(); }}
                placeholder="粘贴作者主页链接，用于账号可信度"
                ref={accountInputRef}
                value={accountUrl}
              />
            </label>
          </div>
        </>
      ) : mode === "manual" ? (
        <>
          <div className="new-analysis-manual">
            <label className="new-analysis-field">
              <span>文案 <small>可选</small></span>
              <textarea
                aria-label="待核验文案"
                onChange={(event) => { setManualText(event.target.value); setError(""); }}
                placeholder="粘贴需要核验的种草文案…"
                rows={4}
                value={manualText}
              />
            </label>
            <div className="new-analysis-upload">
              <input
                accept="image/jpeg,image/png,image/webp"
                hidden
                onChange={(event) => selectFile(event.target.files?.[0] ?? null)}
                ref={fileInputRef}
                type="file"
              />
              {manualFile ? (
                <span className="new-analysis-file">
                  {preview && <img alt="" src={preview} />}
                  <span><strong>{manualFile.name}</strong><small>图片将进入 R 维图片真实性分析</small></span>
                  <button aria-label="移除图片" onClick={() => selectFile(null)} type="button">×</button>
                </span>
              ) : (
                <button className="new-analysis-upload-button" onClick={() => fileInputRef.current?.click()} type="button">
                  <Icon size={18}><path d="M12 4v16M4 12h16" stroke="currentColor" strokeLinecap="round" strokeWidth="1.6" /></Icon>
                  上传图片
                  <small>JPG / PNG / WebP</small>
                </button>
              )}
            </div>
          </div>
          <div className={`new-analysis-supplements ${supplementOpen ? "open" : ""}`}>
            <button
              aria-expanded={supplementOpen}
              className="new-analysis-supplement-toggle"
              onClick={() => setSupplementOpen((open) => !open)}
              type="button"
            >
              <span>＋ 补充评论与账号历史（可选）</span>
              <small>{supplementOpen ? "收起" : "展开"}</small>
            </button>
            {supplementOpen && (
              <div className="new-analysis-supplement-grid">
                <label className="new-analysis-field">
                  <span><b>U</b> 评论 <em>每行一条</em></span>
                  <textarea
                    aria-label="补充评论"
                    onChange={(event) => setManualComments(event.target.value)}
                    placeholder={"好用\n同敏感肌，用了一周没有刺痛，但眼周有点干"}
                    rows={4}
                    value={manualComments}
                  />
                </label>
                <label className="new-analysis-field">
                  <span><b>T</b> 账号历史 <em>JSON · ≥3 篇才评分</em></span>
                  <textarea
                    aria-label="补充账号历史"
                    onChange={(event) => setManualAccountHistory(event.target.value)}
                    placeholder={'{"handle":"账号名","posts":[{"text":"换季护肤记录","published_at":"2026-09-01T09:00:00Z"}]}'}
                    rows={4}
                    value={manualAccountHistory}
                  />
                </label>
              </div>
            )}
            <div className="new-analysis-dimension-preview" aria-label="预计启用维度">
              <span>本次预计启用</span>
              {[
                ["S", Boolean(manualText.trim()), "文案"],
                ["R", Boolean(manualFile), "图片"],
                ["U", Boolean(manualComments.trim()), "评论"],
                ["T", Boolean(manualAccountHistory.trim()), "账号"],
              ].map(([code, enabled, label]) => (
                <b className={enabled ? "enabled" : ""} key={String(code)}>{code} {label}</b>
              ))}
            </div>
          </div>
        </>
      ) : (
        <div className="new-analysis-creator">
          <label className="new-analysis-field">
            <span><b>01</b> 草稿文案 <em>可选</em></span>
            <textarea
              aria-label="创作者草稿文案"
              maxLength={3000}
              onChange={(event) => { setCreatorDraft(event.target.value); setError(""); }}
              placeholder="粘贴你准备发布的笔记文案…"
              rows={5}
              value={creatorDraft}
            />
          </label>
          <div className="new-analysis-upload creator-upload">
            <input
              accept="image/*"
              hidden
              multiple
              onChange={(event) => addCreatorImages(Array.from(event.target.files ?? []))}
              ref={creatorFileInputRef}
              type="file"
            />
            <button
              className="new-analysis-upload-button"
              disabled={creatorImages.length >= 9}
              onClick={() => creatorFileInputRef.current?.click()}
              type="button"
            >
              <Icon size={18}><path d="M12 4v16M4 12h16" stroke="currentColor" strokeLinecap="round" strokeWidth="1.6" /></Icon>
              上传待发布配图
              <small>{creatorImages.length} / 9 · 首张进入 R 维</small>
            </button>
            {creatorImages.length > 0 && (
              <div className="creator-preview-grid">
                {creatorImages.map((image) => (
                  <figure key={image.id}>
                    <img alt={image.name} src={image.url} />
                    <button aria-label={`删除${image.name}`} onClick={() => removeCreatorImage(image.id)} type="button">×</button>
                  </figure>
                ))}
              </div>
            )}
          </div>
          <div className="creator-form-options">
            <label>
              <input checked={creatorCollaboration} onChange={(event) => setCreatorCollaboration(event.target.checked)} type="checkbox" />
              这篇是合作或赠品
            </label>
            <label>
              <span>品类</span>
              <select onChange={(event) => setCreatorCategory(event.target.value)} value={creatorCategory}>
                <option>护肤</option>
                <option>彩妆</option>
                <option>其他</option>
              </select>
            </label>
          </div>
        </div>
      )}

      {error && <p className="new-analysis-error">{error}</p>}
      <div className="new-analysis-actions">
        <span>
          {mode === "link"
            ? "笔记链接与作者主页链接均需填写"
            : mode === "creator"
              ? "草稿文案与配图至少提供一项"
              : "文案与图片至少提供一项"}
        </span>
        {mode !== "creator" && (
          <button className="new-analysis-example" onClick={loadExample} type="button">载入示例</button>
        )}
        <button
          className="new-analysis-submit"
          disabled={mode === "link" ? !linkReady : mode === "creator" ? !creatorReady : !manualReady}
          onClick={submit}
          type="button"
        >
          开始核验
          <span><Arrow size={16} /></span>
        </button>
      </div>
    </div>
  );
}

function Workspace({
  accountUrl,
  creatorPreset = "",
  filename,
  initialMode = "link",
  onAccountUrl,
  onFile,
  onPickFile,
  onHome,
  onSubmitCreator,
  onSubmitLink,
  onSubmitManual,
  preset = "",
}: {
  accountUrl: string;
  creatorPreset?: string;
  filename: string;
  initialMode?: "link" | "manual" | "creator";
  onAccountUrl: (value: string) => void;
  onFile: (name: string) => void;
  onPickFile?: (file: File | null) => void;
  onHome: () => void;
  onSubmitCreator: (input: CreatorReportInput) => void;
  onSubmitLink: (noteUrl: string, accountUrl: string) => void;
  onSubmitManual: (input: { text: string; image: File | null; comments: string; accountHistory: string }) => void;
  preset?: string;
}) {
  const [workspaceMode, setWorkspaceMode] = useState<"verify" | "creator">(initialMode === "creator" ? "creator" : "verify");

  useEffect(() => {
    setWorkspaceMode(initialMode === "creator" ? "creator" : "verify");
  }, [initialMode]);

  useEffect(() => {
    if (creatorPreset) setWorkspaceMode("creator");
  }, [creatorPreset]);

  return (
    <section className="workspace">
      <div className="workspace-orb orb-left" />
      <div className="workspace-orb orb-right" />
      <header className="workspace-header">
        <div className="workspace-status-group">
          <button aria-label="返回首页" className="workspace-home" onClick={onHome} title="返回首页">
            <Icon size={22}>
              <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" />
            </Icon>
          </button>
        </div>
        <div aria-label="核验模式" className="workspace-mode-switch">
          <button className={workspaceMode === "verify" ? "active" : ""} onClick={() => setWorkspaceMode("verify")} type="button">核验别人的笔记</button>
          <button className={workspaceMode === "creator" ? "active" : ""} onClick={() => setWorkspaceMode("creator")} type="button">我是创作者 · 发布前自检</button>
        </div>
      </header>
      <div className="workspace-center">
        <div className="agent-symbol"><Sparkle size={29} /></div>
        <p className="hello">你好，我是 TruLens</p>
        <h2>今天想鉴别什么？</h2>
        <p className="workspace-intro">上传美妆种草内容，我会从账号、图像、评论和文案四个维度寻找 AI 生成与营销造假痕迹。</p>
        <NewAnalysisForm
          accountUrl={accountUrl}
          creatorPreset={creatorPreset}
          initialMode={initialMode}
          onAccountUrl={onAccountUrl}
          onFile={onFile}
          onSubmitCreator={onSubmitCreator}
          onSubmitLink={onSubmitLink}
          onSubmitManual={onSubmitManual}
          preset={preset}
          workspaceMode={workspaceMode}
        />
        <div className="suggestions" />
      </div>
    </section>
  );
}

function AnalysisSteps({
  done,
  activeDimensions,
  paused,
  liveAgents,
  liveMode,
}: {
  done: boolean;
  activeDimensions: DimensionCode[];
  paused: boolean;
  /** Real per-dimension status from `/api/status`; omitted in demo mode. */
  liveAgents?: AgentStatusItem[];
  /** Suppress story-deck verdicts while a real backend run is in flight. */
  liveMode?: boolean;
}) {
  const [expandedRole, setExpandedRole] = useState<string | null>(null);
  const [elapsedSeconds, setElapsedSeconds] = useState(0);
  const liveAgentsByCode = new Map<string, AgentStatusItem>(
    (liveAgents ?? []).map((item) => [item.code, item]),
  );
  const roles = [
    {
      code: "T",
      role: "账号侦探",
      dimension: "Trustworthiness",
      weight: 25,
      score: 82,
      verdict: "可信",
      thinking: "正在回溯 286 篇历史内容与商业合作轨迹…",
      thinkingLabels: ["我正在冷静思考", "让我核对一下", "事实不会说谎"],
      insight: "账号持续运营 2.3 年，商业内容占比 18%，身份与发布节奏稳定。",
      evidence: ["历史内容连续，无集中删帖", "商业合作均有明确标识", "互动增长曲线未见突变"],
    },
    {
      code: "R",
      role: "视觉取证师",
      dimension: "Reality",
      weight: 30,
      score: 88,
      verdict: "轻度修饰",
      thinking: "正在比对皮肤纹理、边缘结构与光影方向…",
      thinkingLabels: ["我在快速扫图", "有异常，抓到了", "我再确认一遍"],
      insight: "面中存在两处生成式细化痕迹，但产品主体与整体光影保持真实。",
      evidence: ["局部毛孔纹理重复", "产品边缘连续自然", "环境光线方向一致"],
    },
    {
      code: "U",
      role: "口碑观察员",
      dimension: "User Voice",
      weight: 20,
      score: 74,
      verdict: "需留意",
      thinking: "正在聚类评论语义、发布时间与互动关系…",
      thinkingLabels: ["我在听大家说", "我在头脑风暴中", "慢慢拼出共识"],
      insight: "12% 的短评存在相似句式，其余评论具有具体问题与真实讨论特征。",
      evidence: ["有效评论 168 条", "同质短评占比 12%", "未发现批量账号联动"],
    },
    {
      code: "S",
      role: "宣传安全官",
      dimension: "Safety",
      weight: 25,
      score: 91,
      verdict: "安全",
      thinking: "正在核验功效承诺、广告表达与风险边界…",
      thinkingLabels: ["正在严谨审阅", "我按规范核验", "准备出具意见"],
      insight: "未发现绝对化功效承诺，合作标识清晰，个人体验边界完整。",
      evidence: ["无医疗功效宣称", "包含个体差异说明", "品牌合作标识清晰"],
    },
  ];
  const activeRoles = roles
    .filter((item) => activeDimensions.includes(item.code as DimensionCode))
    .map((item) => {
      // Live scores override the demo ones as soon as /api/status reports them.
      // `assessed: null` => no live data yet (keep the story-deck animation);
      // `false` => the backend ran the dimension but had nothing to judge, so
      // the card must read "暂不评分" instead of showing a number.
      const live = liveAgentsByCode.get(item.code);
      if (!live) return { ...item, assessed: null as boolean | null };
      if (!live.assessed || live.trust_score == null) {
        return { ...item, assessed: false as boolean | null, verdict: "暂不评分" };
      }
      return {
        ...item,
        assessed: true as boolean | null,
        score: Math.round(live.trust_score),
        verdict: live.trust_label ?? item.verdict,
      };
    });
  const scoredRoles = activeRoles.filter((item) => item.assessed !== false);
  const activeWeightTotal = activeRoles.reduce((total, item) => total + item.weight, 0);
  const analysisScore = Math.round(
    scoredRoles.reduce((total, item) => total + item.score, 0) / (scoredRoles.length || 1),
  );
  const dimensionWord = ["", "单", "双", "三", "四"][activeRoles.length];

  useEffect(() => {
    if (done || paused) return;
    const timer = window.setInterval(() => {
      setElapsedSeconds((current) => Math.min(10, current + 0.1));
    }, 100);
    return () => window.clearInterval(timer);
  }, [done, paused]);

  const thinkingStage = Math.min(2, Math.floor(elapsedSeconds / 1.8));
  const reasoningStage = done ? 4 : Math.min(4, Math.floor(elapsedSeconds / 2));
  const reasoningFlow = [
    [`调用${activeRoles.length}个分析视角`, `正在唤醒 ${activeRoles.map((item) => item.code).join(" / ")} 分析角色`],
    [`生成${dimensionWord}维评分`, "正在校准各维度分数与证据权重"],
    ["发现关键风险", "正在定位可能改变消费判断的核心风险"],
    ["内部推理", "Reasoning · 正在消解不同证据之间的冲突"],
    ["生成最终报告", "正在组织可解释结论与决策依据"],
  ];
  const debateMessages = [
    ["T", "账号侦探", "提出判断", "账号轨迹稳定，现有证据不支持系统性造假。"],
    ["R", "视觉取证师", "提出异议", "我不同意完全放行。两处生成式修饰必须降低图像证据权重。"],
    ["U", "口碑观察员", "补充证据", "评论里确有相似话术，但多数反馈具体，暂不足以否定整篇内容。"],
    ["S", "宣传安全官", "形成裁定", "综合各方证据，建议保留风险说明后判定为高可信。"],
  ];
  const activeDebateMessages = debateMessages.filter(([code]) => activeDimensions.includes(code as DimensionCode));
  const debateDuration = 4 / activeDebateMessages.length;
  const debateIndex = Math.min(activeDebateMessages.length - 1, Math.floor(Math.max(0, elapsedSeconds - 4) / debateDuration));
  const activeDebate = activeDebateMessages[debateIndex];
  const debateFocus = activeDimensions.includes("R")
    ? "图像修饰是否足以改变宣传安全维度的判断？"
    : activeDimensions.includes("U")
      ? "评论异常是否足以推翻文案本身的安全性？"
      : "账号历史信号与当前宣传表达是否相互一致？";

  return (
    <div className={`trus-council ${done ? "is-complete" : "is-thinking"} ${paused ? "is-paused" : ""}`}>
      <div className="council-header">
        <div className="council-avatars">
          {activeRoles.map((item) => (
            <span className={`council-avatar role-${item.code.toLowerCase()}`} key={item.code}>
              <img alt="" src={roleAvatarByCode[item.code as DimensionCode]} />
              <i>{item.code}</i>
            </span>
          ))}
        </div>
        <div className="council-title">
          <span>TRUS REASONING COUNCIL</span>
          <strong>你的 AI 信任评审团正在讨论</strong>
          <small>{done ? `${activeRoles.length} 个角色已完成验证，点击角色查看证据` : `${activeRoles.length} 个角色正在分析当前输入`}</small>
        </div>
        <div className="council-state">
          <i />
          {done ? `${activeRoles.length} / ${activeRoles.length} 完成 · ${elapsedSeconds.toFixed(1)} 秒` : paused ? `已暂停 · ${elapsedSeconds.toFixed(1)} 秒` : `已思考 ${elapsedSeconds.toFixed(1)} 秒`}
        </div>
      </div>

      <div className="reasoning-flow">
        <div className="reasoning-flow-steps">
          {reasoningFlow.map(([label], index) => (
            <div
              className={index < reasoningStage || done ? "completed" : index === reasoningStage ? "active" : ""}
              key={label}
            >
              <span>{index < reasoningStage || done ? "✓" : index + 1}</span>
              <small>{label}</small>
            </div>
          ))}
        </div>
        <p key={reasoningStage}>
          <Sparkle size={13} />
          {done ? "推理链已完成，最终报告已生成" : reasoningFlow[reasoningStage][1]}
        </p>
      </div>

      <div className="council-columns">
        <span>分析视角与观点</span>
        <span>权重</span>
        <span>判断</span>
      </div>

      <div className="council-roles">
        {activeRoles.map((item, index) => (
          <div className={`council-role-wrap ${expandedRole === item.code ? "expanded" : ""}`} key={item.code}>
            <button
              className={`council-role role-${item.code.toLowerCase()}`}
              onClick={() => setExpandedRole((current) => current === item.code ? null : item.code)}
              style={{ "--role-delay": `${index * 120}ms` } as React.CSSProperties}
            >
              <span className="role-persona">
                <span className="role-avatar">
                  <img alt={`${item.role}角色`} src={roleAvatarByCode[item.code as DimensionCode]} />
                  <i>{item.code}</i>
                </span>
                <span>
                  <strong>{item.code === "S" ? "文案检查官" : item.role}</strong>
                  <small>{item.code === "S" ? "Script" : item.dimension}</small>
                  <p>{done ? liveMode ? "该维度已完成，证据与结论见完整报告。" : item.insight : item.thinking}</p>
                </span>
              </span>
              <span className="role-weight">{Math.round((item.weight / activeWeightTotal) * 100)}%</span>
              <span className="role-judgement">
                {liveMode && item.assessed === null ? (
                  <><i /><small>核验中</small></>
                ) : done ? (
                  <><strong>{item.assessed === false ? "—" : item.score}</strong><small>{item.verdict}</small></>
                ) : reasoningStage >= 1 ? (
                  <><strong>{item.assessed === false ? "—" : item.score}</strong><small>{item.thinkingLabels[thinkingStage]}</small></>
                ) : (
                  <><i /><small>{item.thinkingLabels[thinkingStage]}</small></>
                )}
              </span>
              <span className="role-chevron">⌄</span>
            </button>
            <div className="role-progress"><i style={{ "--role-score": `${liveMode && item.assessed === null ? 0 : item.assessed === false ? 0 : item.score}%` } as React.CSSProperties} /></div>
            {expandedRole === item.code && (
              <div className="role-evidence">
                <span>证据链</span>
                {item.evidence.map((evidence) => <p key={evidence}>✓ {evidence}</p>)}
              </div>
            )}
          </div>
        ))}
      </div>

      {!liveMode && reasoningStage >= 2 && reasoningStage < 4 && activeDebateMessages.length > 1 && (
        <div className="expert-debate">
          <div className="debate-header">
            <span><i /> EXPERT DISCUSSION</span>
            <div className="debate-cast">
              {activeDebateMessages.map(([code], index) => (
                <i className={index === debateIndex ? "active" : index < debateIndex ? "heard" : ""} key={code}>
                  {code}
                </i>
              ))}
            </div>
            <small>{debateIndex + 1} / {activeDebateMessages.length}</small>
          </div>
          <div className={`debate-message role-${activeDebate[0].toLowerCase()}`} key={debateIndex}>
            <span className="debate-avatar">
              <img alt={`${activeDebate[1]}头像`} src={roleAvatarByCode[activeDebate[0] as DimensionCode]} />
              <i>{activeDebate[0]}</i>
            </span>
            <div>
              <span><strong>{activeDebate[1]}</strong><small>{activeDebate[2]}</small></span>
              <p>“{activeDebate[3]}”</p>
            </div>
          </div>
          <div className="debate-focus">
            <span>争议焦点</span>
            {debateFocus}
          </div>
        </div>
      )}

      {!liveMode && reasoningStage >= 2 && reasoningStage < 4 && activeDebateMessages.length === 1 && (
        <div className="reasoning-finding stage-3">
          <span>INDEPENDENT REVIEW</span>
          <p>{activeDebate[3]}</p>
        </div>
      )}

      {reasoningStage >= 4 && (!liveMode || done) && (
        <div className="debate-consensus">
          <span><Sparkle size={13} /> {activeRoles.length > 1 ? `${activeRoles.length} 位专家达成共识` : `${activeRoles[0].role}完成独立审查`}</span>
          <p>{activeRoles.length > 1 ? "已结合当前可用模态完成交叉验证，并生成对应维度的可信度报告。" : "当前输入仅支持单维度判断，报告会明确标注证据范围。"}</p>
        </div>
      )}

      <div className="council-result">
        <div>
          {activeRoles.map((item, index) => (
            <span key={item.code}>
              {index > 0 && (item.code === "R" ? <span className="fg-inline-italic">+</span> : <i>+</i>)}
              <span>{item.code} {item.code === "R" || item.code === "U" ? 25 : Math.round((item.weight / activeWeightTotal) * 100)}%</span>
            </span>
          ))}
        </div>
        <div>
          <small>{done ? "加权结果" : `等待交叉验证 · ${elapsedSeconds.toFixed(1)}s`}</small>
          {done ? <><strong>{analysisScore}</strong><span>{analysisScore >= 80 ? "高可信" : "需留意"}</span></> : <span className="council-loading"><i /><i /><i /></span>}
        </div>
      </div>
    </div>
  );
}

const initialQuickFollowups = [
  "哪些图片区域可能经过 AI 修饰？",
  "评论区有哪些异常话术？",
  "这个博主长期可信吗？",
  "我该购买吗",
];

const appealPrompt = "我想申诉或辩解当前核验结论";
const appealOptions: Array<{
  code: DimensionCode;
  label: string;
  role: string;
  reply: string;
}> = [
  {
    code: "R",
    label: "视觉取证不准",
    role: "视觉专家",
    reply: "收到您的申诉！视觉专家 R 正在重新对该区域进行局部像素频域分析……正在剥离环境光影干扰……请稍候。",
  },
  {
    code: "T",
    label: "账号侦测误判",
    role: "账号专家",
    reply: "收到您的申诉！账号专家 T 正在重新回溯主页简介、历史动态与商业合作轨迹……正在排除账号成长周期带来的误判……请稍候。",
  },
  {
    code: "U",
    label: "评论区误伤",
    role: "评论专家",
    reply: "收到您的申诉！评论专家 U 正在重新聚类评论句式、发布时间与互动关系……正在区分真实共鸣与协同传播……请稍候。",
  },
  {
    code: "S",
    label: "文案检查误判",
    role: "文案专家",
    reply: "收到您的申诉！文案专家 S 正在重新核对原文语境、体验边界与功效主张……正在排除修辞表达造成的误判……请稍候。",
  },
];

function getInitialQuickFollowups(activeDimensions: DimensionCode[]) {
  if (activeDimensions.length === 1) {
    return ["文案中有哪些夸大表达？", "是否存在绝对化宣传？", "这段文案足以支持决策吗？", "还需要补充什么证据？"];
  }
  if (activeDimensions.includes("U")) {
    return ["哪些评论最像批量生成的？", "评论与文案结论一致吗？", "真实用户主要在讨论什么？", "评论区整体可信吗？"];
  }
  if (activeDimensions.includes("T")) {
    return ["这个博主长期可信吗？", "商业合作比例高吗？", "历史内容有没有异常？", "账号与文案是否一致？"];
  }
  return ["哪些图片区域可能经过 AI 修饰？", "图片与文案结论一致吗？", "有没有整图生成痕迹？", "当前证据足够可信吗？"];
}

function getNextQuickFollowups(question?: string) {
  if (!question) return initialQuickFollowups;
  if (question.includes("图片区域") || question.includes("AI 修饰")) {
    return [
      "这些修饰会影响产品效果判断吗？",
      "能进一步解释脸颊区域的异常吗？",
      "这是普通美化还是 AI 造假？",
      "我还需要查看哪些原图？",
    ];
  }
  if (question.includes("效果") || question.includes("美化") || question.includes("原图")) {
    return [
      "这项图像风险会如何影响帖子可信度？",
      "如果图片可信度降低，我该如何决策？",
      "哪些证据能够抵消这项风险？",
      "评论是否支持图片中的结论？",
    ];
  }
  if (question.includes("评论") || question.includes("话术")) {
    return [
      "哪些评论最像批量生成的？",
      "真实用户主要在意什么问题？",
      "评论异常会影响可信分吗？",
      "结合图片给我最终建议",
    ];
  }
  if (question.includes("博主") || question.includes("账号")) {
    return [
      "她的商业合作比例高吗？",
      "历史内容有没有前后矛盾？",
      "哪些账号行为值得警惕？",
      "结合本篇内容给出可信结论",
    ];
  }
  if (question.includes("购买") || question.includes("最终建议") || question.includes("相差")) {
    return [
      "哪些证据最影响这次购买决定？",
      "如果只看可信度，我该如何选择？",
      "当前还缺少什么关键证据？",
      "帮我总结这次决策的风险等级",
    ];
  }
  return [
    "这条证据的置信度是多少？",
    "还有其他风险需要注意吗？",
    "它会如何影响购买决定？",
    "帮我总结当前结论",
  ];
}

function ContextualFollowupAnswer({ question }: { question: string }) {
  let title = "已结合当前报告继续核验";
  let answer = "这条新问题与已有的账号、图像、评论和文案证据进行了交叉验证。目前没有出现足以推翻原结论的新风险信号。";
  let facts = ["与原始证据一致", "未发现新增高风险项", "综合可信度保持稳定"];

  if (question.includes("影响产品效果")) {
    title = "会影响对遮瑕力的判断，但不影响色号参考";
    answer = "AI 细化主要抹平了面中毛孔和轻微卡粉，因此画面会高估底妆的柔焦与遮瑕表现。产品色号、光泽方向和整体服帖度没有明显被改变。";
    facts = ["遮瑕表现可能被高估", "色号参考仍有效", "建议查看 4 小时持妆图"];
  } else if (question.includes("脸颊区域")) {
    title = "异常来自过度均匀的高频皮肤纹理";
    answer = "真实皮肤的毛孔、绒毛和细小纹理通常具有随机变化；该区域出现重复频率和方向高度一致的纹理，同时没有对应的光影起伏。";
    facts = ["纹理周期重复", "毛孔方向一致", "缺少自然光影起伏"];
  } else if (question.includes("普通美化") || question.includes("AI 造假")) {
    title = "更接近 AI 辅助美化，而非整图造假";
    answer = "人物结构、产品边缘和环境光线都保持连续，异常只集中在局部皮肤纹理。这说明工具可能用于精修肤质，而不是重新生成产品效果。";
    facts = ["主体结构真实", "局部生成式精修", "未改变产品形态"];
  } else if (question.includes("哪些原图") || question.includes("确认什么")) {
    title = "优先补充三类未经精修的证据";
    answer = "自然光近景、四小时后的持妆图，以及包含鼻翼与下颌边缘的视频帧，最能验证遮瑕、卡粉和真实皮肤纹理。";
    facts = ["自然光近景", "四小时持妆图", "连续视频原帧"];
  } else if (question.includes("评论")) {
    title = "评论区存在少量同质话术，但未形成批量水评";
    answer = "约 12% 的短评使用了相似的情绪词和购买号召，发布时间也较集中；其余评论包含肤质差异、使用时长和具体问题，整体仍有真实讨论特征。";
    facts = ["相似短评 12%", "真实提问占多数", "未发现大规模账号联动"];
  } else if (question.includes("帖子可信度") || question.includes("图像风险")) {
    title = "图像证据折损会降低结论强度，但不会让整篇帖子失信";
    answer = "当前图像维度的异常只影响视觉展示证据，账号轨迹、评论结构和文案安全性仍提供独立支持。因此综合可信度会小幅下降，而不是直接变成“不可信”。";
    facts = ["视觉证据权重下降", "其他模态仍可验证", "综合结论保持中高可信"];
  } else if (
    question.includes("购买") ||
    question.includes("决策") ||
    question.includes("风险等级") ||
    question.includes("只看可信度") ||
    question.includes("关键证据")
  ) {
    title = "帖子可以作为参考，但不足以单独支持购买决定";
    answer = "账号历史和文本表达提供了正向可信信号，局部图像修饰则降低了展示证据的可靠性。更稳妥的决策方式，是把这篇帖子作为一个信息来源，并等待其他独立内容对关键结论形成交叉验证。";
    facts = ["整体可信度较高", "图像证据存在折损", "需要独立来源交叉验证"];
  }

  return (
    <div className="contextual-answer">
      <span className="contextual-answer-tag">FOLLOW-UP INSIGHT</span>
      <strong>{title}</strong>
      <p>{answer}</p>
      <div>{facts.map((fact) => <span key={fact}>✓ {fact}</span>)}</div>
    </div>
  );
}

function ArgueReviewFlow({
  evidenceName,
  explanation,
  onArchive,
  onViewReport,
  option,
}: {
  evidenceName: string;
  explanation: string;
  onArchive: (score: number) => void;
  onViewReport: (score: number) => void;
  option: (typeof appealOptions)[number];
}) {
  const [stage, setStage] = useState(0);
  const [archived, setArchived] = useState(false);
  const endRef = useRef<HTMLDivElement>(null);
  const accepted = option.code === "R" || option.code === "S";
  const oldScore = 84;
  const newScore = option.code === "R" ? 93 : option.code === "S" ? 90 : oldScore;
  const decisionCopy = option.code === "R"
    ? "感谢纠错，经二次复核，该区域确系环境强反光与底妆高光叠加，并非 AI 生成式修饰。我们已降低原异常信号权重，并对视觉取证结论作出修正。"
    : option.code === "S"
      ? "感谢补充。结合完整上下文后，原文属于个人体验描述而非确定性功效承诺，文案风险等级已下调。"
      : option.code === "U"
        ? "您的申诉部分成立：部分短评可能来自真实用户的品牌共识，但评论区仍存在明显的同质化传播痕迹，因此综合信任分维持原样，建议重点关注评论风险。"
        : "您的申诉部分成立：账号的高关注数不足以单独证明互关增长，但历史内容中的产品推荐密度依然较高，因此综合信任分维持原样，并优化账号风险提示。";
  const thinkingLabels = [
    `正在仅调用 ${option.role} ${option.code} 接收申诉材料`,
    `${option.role} ${option.code} 正在独立重检争议证据`,
    "单维复核完成，T / R / U / S 圆桌会议已启动",
    "四位专家正在交换反证并重新校准权重",
    "圆桌会诊结束，重新评估报告已生成",
  ];

  useEffect(() => {
    if (stage >= 4) return;
    const timer = window.setTimeout(() => setStage((current) => current + 1), stage >= 2 ? 1700 : 1300);
    return () => window.clearTimeout(timer);
  }, [stage]);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
  }, [stage]);

  return (
    <div className="argue-consultation">
      <div className="argue-consultation-head">
        <div>
          <span>ARGUE COUNCIL · 重新会诊</span>
          <strong>{stage < 2 ? `${option.role}正在单独复核“${option.label}”` : stage < 4 ? "四位专家正在进行圆桌会议" : "重新评估报告已生成"}</strong>
          {explanation && <small>用户补充：“{explanation}”</small>}
          {evidenceName && <small>新增证据：{evidenceName}</small>}
        </div>
        <span className="argue-live"><i /> {stage < 4 ? "会诊中" : "已完成"}</span>
      </div>

      <div className="argue-council-cast">
        {(["T", "R", "U", "S"] as DimensionCode[]).map((code) => (
          <span className={`${code === option.code ? "lead" : ""} ${code === option.code || stage >= 2 ? "active" : ""}`} key={code}>
            <img alt={`${code} 专家`} src={roleAvatarByCode[code]} />
            <i>{code}</i>
          </span>
        ))}
        <div>
          <span>{thinkingLabels[stage]}</span>
          <small>{Math.min(100, 18 + stage * 22)}% · 正在重新计算证据权重</small>
        </div>
      </div>

      <div className="argue-thinking-flow">
        {["专属专家接单", "单维证据复核", "四专家圆桌会议", "生成重评报告"].map((label, index) => (
          <span className={stage > index ? "complete" : stage === index ? "active" : ""} key={label}>
            <i>{stage > index ? "✓" : index + 1}</i>{label}
          </span>
        ))}
      </div>

      {stage >= 1 && (
        <div className={`argue-expert-feedback role-${option.code.toLowerCase()}`}>
          <span>
            <img alt={`${option.role} ${option.code}`} src={roleAvatarByCode[option.code]} />
            <i>{option.code}</i>
          </span>
          <div><small>{option.role} · 单专家二次取证</small><p>{option.reply}</p></div>
        </div>
      )}

      {stage >= 2 && stage < 4 && (
        <div className="argue-roundtable-note">
          <span><Sparkle size={13} /> ROUND TABLE</span>
          <p>专项复核结果已提交圆桌。T / R / U / S 正在从账号、图像、评论与文案四个维度重新评估其对综合信任分的影响。</p>
        </div>
      )}

      {stage >= 4 && (
        <div className={`argue-final-decision ${accepted ? "accepted" : "partial"}`}>
          <header>
            <div>
              <span>重新评估报告 · {accepted ? "申诉已采纳" : "申诉部分成立"}</span>
              <strong>{accepted ? "AI 已修正原核验结论" : "保留原分数，风险提示已优化"}</strong>
            </div>
            <div className="argue-score-change">
              <span>{oldScore}</span><i>→</i><strong>{newScore}</strong><small>/100</small>
            </div>
          </header>
          <p>{decisionCopy}</p>
          <div className="argue-decision-meta">
            <span>复核编号 TL-A-{option.code}-0618</span>
            <span>原始报告与申诉过程已保留</span>
          </div>
          <div className="argue-final-actions">
            <button
              className={archived ? "archived" : ""}
              disabled={archived}
              onClick={() => {
                setArchived(true);
                onArchive(newScore);
              }}
            >
              {archived ? "✓ 已保存到报告库" : "保存到报告库"}
              {!archived && <Arrow size={16} />}
            </button>
            <button className="view-revised-report" onClick={() => onViewReport(newScore)}>
              查看新报告 <Arrow size={16} />
            </button>
          </div>
        </div>
      )}
      <div ref={endRef} />
    </div>
  );
}

function Chat({
  prompt,
  filename,
  isExampleSubmission,
  activeDimensions,
  live,
  onArchiveReport,
  onFile,
  onHome,
  onResult,
  onTechnicalViewChange,
  onViewRevisedReport,
  technicalView,
}: {
  prompt: string;
  filename: string;
  isExampleSubmission: boolean;
  activeDimensions: DimensionCode[];
  /** The real pipeline run. When absent the scripted demo animation plays alone. */
  live?: LiveRun;
  onArchiveReport: (score: number) => void;
  onFile: (name: string) => void;
  onHome: () => void;
  onResult: () => void;
  onTechnicalViewChange: (enabled: boolean) => void;
  onViewRevisedReport: (score: number) => void;
  technicalView: boolean;
}) {
  const [done, setDone] = useState(false);
  const [paused, setPaused] = useState(false);
  const [quickPrompt, setQuickPrompt] = useState("");
  const [followups, setFollowups] = useState<Array<{ id: number; question: string; answered: boolean; detail?: string; evidenceName?: string }>>([]);
  const [appealDraftCode, setAppealDraftCode] = useState<DimensionCode | null>(null);
  const [appealExplanation, setAppealExplanation] = useState("");
  const [appealEvidenceName, setAppealEvidenceName] = useState("");
  const [shareOpen, setShareOpen] = useState(false);
  const chatEndRef = useRef<HTMLDivElement>(null);
  const replyTimerRef = useRef<number | null>(null);
  const analysisRemainingRef = useRef(10000);
  const analysisStartedAtRef = useRef(0);
  const followupRemainingRef = useRef(1100);
  const followupStartedAtRef = useRef(0);
  const latestFollowup = followups[followups.length - 1];
  const hasAppealed = followups.some((followup) => followup.question === appealPrompt);
  const selectedAppeal = appealOptions.find((option) =>
    followups.some((followup) => followup.question === option.label),
  );
  const isGenerating = !done || Boolean(latestFollowup && !latestFollowup.answered);
  const isArgueFlow = hasAppealed && (!latestFollowup || latestFollowup.question === appealPrompt || Boolean(selectedAppeal));
  const quickFollowups = isArgueFlow
    ? []
    : latestFollowup && !latestFollowup.answered
    ? []
    : latestFollowup
      ? getNextQuickFollowups(latestFollowup.question)
      : getInitialQuickFollowups(activeDimensions);
  const expertNames: Record<DimensionCode, string> = {
    T: "账号侦探",
    R: "视觉取证师",
    U: "口碑观察员",
    S: "宣传安全官",
  };
  const scoreByDimension: Record<DimensionCode, number> = { T: 82, R: 88, U: 74, S: 91 };
  const liveAgents = live?.agents ?? [];
  const liveAgentsByCode = new Map<string, AgentStatusItem>(
    liveAgents.map((item) => [item.code, item]),
  );
  const liveReport = live?.report ?? null;
  const liveReady = Boolean(live?.phase === "done" && liveReport);
  const liveActive = Boolean(live && live.phase !== "idle");
  const liveFailed = live?.phase === "error";
  const processStage = done ? 3 : liveAgents.length ? 2 : 1;
  // The real verdict wins the moment it exists; until then the demo numbers keep
  // the animation populated so nothing renders empty while polling.
  const analysisScore = liveReport
    ? Math.round(liveReport.trust_score)
    : Math.round(activeDimensions.reduce((total, code) => total + scoreByDimension[code], 0) / activeDimensions.length);
  const analysisSummary = liveReport
    ? `可信度 ${Math.round(liveReport.trust_score)}/100 · ${liveReport.trust_label}（已核验 ${liveReport.assessed_dimensions.length}/4 个维度）`
    : activeDimensions.includes("R")
      ? "图像主体可信，但存在轻度 AI 修饰痕迹"
      : activeDimensions.includes("U")
        ? "评论整体可参考，但存在少量相似话术"
        : activeDimensions.includes("T")
          ? "账号轨迹稳定，宣传表达未见明显风险"
          : "文案表达整体安全，未见高风险宣传承诺";
  useEffect(() => {
    // A real backend run owns completion. The scripted countdown is only for
    // the static fallback, otherwise it would reveal demo scores while the
    // actual evidence pipeline is still running.
    if (liveActive || paused || done) return;
    analysisStartedAtRef.current = Date.now();
    const timer = window.setTimeout(() => {
      analysisRemainingRef.current = 0;
      setDone(true);
    }, analysisRemainingRef.current);
    return () => {
      window.clearTimeout(timer);
      analysisRemainingRef.current = Math.max(
        0,
        analysisRemainingRef.current - (Date.now() - analysisStartedAtRef.current),
      );
    };
  }, [liveActive, paused, done]);

  // `onResult` is an inline closure from App, so it changes identity every App
  // render (which the polling triggers). Keep it in a ref and depend only on the
  // boolean, otherwise this effect would re-arm its timer on every poll and the
  // jump to the report would never fire.
  const onResultRef = useRef(onResult);
  useEffect(() => {
    onResultRef.current = onResult;
  });

  // Snapshot at mount: if the run had ALREADY finished before this Chat mounted
  // (i.e. the user navigated back from the report), don't jump again — otherwise
  // pressing "返回" from the report would bounce straight back to it.
  const readyAtMountRef = useRef(liveReady);

  useEffect(() => {
    // The real pipeline finished: end the scripted animation immediately and
    // jump to the report instead of waiting out the remaining demo time.
    if (!liveReady) return;
    analysisRemainingRef.current = 0;
    setDone(true);
    if (readyAtMountRef.current) return;
    const timer = window.setTimeout(() => onResultRef.current(), 900);
    return () => window.clearTimeout(timer);
  }, [liveReady]);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
  }, [done, followups]);

  useEffect(() => {
    if (!latestFollowup || latestFollowup.answered || paused) return;
    const followupId = latestFollowup.id;
    followupStartedAtRef.current = Date.now();
    replyTimerRef.current = window.setTimeout(() => {
      followupRemainingRef.current = 0;
      setFollowups((current) =>
        current.map((item) => item.id === followupId ? { ...item, answered: true } : item),
      );
    }, followupRemainingRef.current);
    return () => {
      if (replyTimerRef.current) window.clearTimeout(replyTimerRef.current);
      followupRemainingRef.current = Math.max(
        0,
        followupRemainingRef.current - (Date.now() - followupStartedAtRef.current),
      );
    };
  }, [latestFollowup, paused]);

  const sendFollowup = (question: string, detail?: string, evidenceName?: string) => {
    const cleanQuestion = question.trim();
    if (!cleanQuestion || (latestFollowup && !latestFollowup.answered)) return;
    if (replyTimerRef.current) window.clearTimeout(replyTimerRef.current);
    setQuickPrompt("");
    setPaused(false);
    followupRemainingRef.current = 1100;
    const id = Date.now();
    setFollowups((current) => [...current, { id, question: cleanQuestion, answered: false, detail, evidenceName }]);
  };

  const submitAppeal = () => {
    const option = appealOptions.find((item) => item.code === appealDraftCode);
    if (!option) return;
    sendFollowup(option.label, appealExplanation.trim(), appealEvidenceName);
    setAppealDraftCode(null);
    setAppealExplanation("");
    setAppealEvidenceName("");
  };

  return (
    <section className="chat">
      <header className="chat-header">
        <div className="chat-header-main">
          <button aria-label="返回首页" className="chat-home-button" onClick={onHome} title="返回首页">
            <Icon size={22}>
              <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" />
            </Icon>
          </button>
          <div className="chat-header-title">
            <strong>{activeDimensions.length === 1 ? "文案安全性鉴别" : `${activeDimensions.length} 维内容鉴别`}</strong>
            <small>{liveFailed ? "实时核验失败" : paused && isGenerating ? "生成已暂停" : !done ? liveActive ? "实时核验进行中…" : `正在调用 ${activeDimensions.map((code) => expertNames[code]).join("、")}…` : latestFollowup && !latestFollowup.answered ? "正在生成追问回答…" : "分析完成"}</small>
          </div>
        </div>
        <div className="chat-header-actions">
          <TechnicalViewToggle enabled={technicalView} onChange={onTechnicalViewChange} />
          <div className="share-wrap">
            <button className="header-share" onClick={() => setShareOpen((open) => !open)}>
              <Icon size={17}>
                <circle cx="18" cy="5" r="2.2" stroke="currentColor" strokeWidth="1.5" />
                <circle cx="6" cy="12" r="2.2" stroke="currentColor" strokeWidth="1.5" />
                <circle cx="18" cy="19" r="2.2" stroke="currentColor" strokeWidth="1.5" />
                <path d="m8 11 8-5M8 13l8 5" stroke="currentColor" strokeWidth="1.5" />
              </Icon>
              分享
            </button>
            {shareOpen && <ShareMenu onClose={() => setShareOpen(false)} />}
          </div>
        </div>
      </header>
      <div className="chat-scroll">
        {!liveActive && (
          <div className="demo-version-banner">
            <Sparkle size={14} />
            <span><strong>演示版本</strong>以下为示例结果，并非对你输入内容的判断</span>
          </div>
        )}
        <div className="user-message">
          <div>
            <p>{prompt}</p>
            {filename && (
              <span className="message-attachment">
                <img alt="待分析美妆帖子预览" src={postImage} />
                <span><strong>{filename}</strong><small>{isExampleSubmission ? "示例 · 演示附件" : "图片内容 · 已上传"}</small></span>
              </span>
            )}
          </div>
          <span className="avatar user-avatar">YZ</span>
        </div>

        <div className="agent-message">
          <span className="agent-avatar"><Sparkle size={17} /></span>
          <div className="agent-content">
            <div className="agent-name">TruLens <span>多模态鉴别 Agent</span></div>
            <p>收到。根据当前输入，我将调用 {activeDimensions.map((code) => expertNames[code]).join("和")}，只分析有足够证据支持的维度。</p>
            {live?.error && (
              <p className="live-error">
                实时核验未完成：{live.error}
                {live.taskId && (
                  <>
                    <br />
                    任务编号：{live.taskId}。如果任务已在后台完成，请刷新后从「最近任务」重新打开。
                    <button
                      className="live-resume-button"
                      onClick={() => void live.resume()}
                      type="button"
                    >
                      重新获取结果
                    </button>
                  </>
                )}
              </p>
            )}
            <AnalysisProcessProgress
              creatorMode={false}
              done={done}
              stage={processStage}
              technicalView={technicalView}
            />
            <AnalysisSteps activeDimensions={activeDimensions} done={done} paused={paused} liveAgents={liveAgents} liveMode={liveActive} />
            {!done && !liveFailed ? (
              <div className={`thinking ${paused ? "paused" : ""}`}><i /><i /><i /> {paused ? "分析已暂停，点击继续恢复推理" : activeDimensions.length > 1 ? `${activeDimensions.length} 位专家正在交换证据并校准权重` : `${expertNames[activeDimensions[0]]}正在独立核验证据`}</div>
            ) : done && !liveFailed ? (
              <>
                <div className="analysis-complete">
                  <div className="mini-score" style={{ "--mini-score": analysisScore } as React.CSSProperties}>
                    <span><strong>{analysisScore}</strong>/100</span>
                    <small>综合可信度</small>
                  </div>
                  <div>
                    <strong>{analysisSummary}</strong>
                    <p>本次结论仅基于当前输入可识别的 {activeDimensions.join(" / ")} 维度生成；未提供的模态不会被模型假设或补全。</p>
                    <div className="evidence-tags">
                      {activeDimensions.map((code) => {
                        const item = liveAgentsByCode.get(code);
                        return (
                          <span key={code}>
                            {expertNames[code]}
                            {item && !item.assessed ? "暂不评分" : "已完成"}
                          </span>
                        );
                      })}
                    </div>
                  </div>
                  <button className="report-button" onClick={onResult}>
                    查看完整信任报告 <Arrow size={17} />
                  </button>
                </div>
                <button
                  className="appeal-button"
                  disabled={hasAppealed}
                  onClick={() => sendFollowup(appealPrompt)}
                >
                  {hasAppealed ? "已进入申诉辩论" : "申诉或辩解"}
                </button>
              </>
            ) : null}
          </div>
        </div>

        {followups.map((followup, index) => {
          const isImageDetection = followup.question.includes("图片区域") || followup.question.includes("AI 修饰");
          const isAppealStart = followup.question === appealPrompt;
          const appealSelection = appealOptions.find((option) => option.label === followup.question);
          return (
            <div className="followup-thread" key={followup.id}>
              <div className="user-message followup-user-message">
                <div>
                  <p>{followup.question}</p>
                  {followup.detail && <small className="appeal-user-detail">我觉得这里没问题，因为：{followup.detail}</small>}
                  {followup.evidenceName && <small className="appeal-user-evidence">附件证据 · {followup.evidenceName}</small>}
                </div>
                <span className="avatar user-avatar">YZ</span>
              </div>
              <div className="agent-message followup-agent-message">
                <span className="agent-avatar"><Sparkle size={17} /></span>
                <div className="agent-content">
                  <div className="agent-name">
                    TruLens
                    <span>
                      {isAppealStart || appealSelection
                        ? "ARGUE · 结论复议"
                        : isImageDetection
                          ? "图像取证 Agent"
                          : `上下文推理 · 回合 ${index + 2}`}
                    </span>
                  </div>
                  {!followup.answered ? (
                    <div className={`agent-typing ${paused ? "paused" : ""}`}>
                      <span><i /><i /><i /></span>
                      {paused
                        ? "回答已暂停，点击顶部继续"
                        : isAppealStart
                          ? "正在建立申诉议题并召回复核专家"
                          : appealSelection
                            ? `正在将异议移交给${appealSelection.role} ${appealSelection.code}`
                            : "正在结合上一轮证据生成回答"}
                    </div>
                  ) : isAppealStart ? (
                    <div className="argue-entry">
                      <div className="argue-entry-head">
                        <span><Sparkle size={14} /> 已进入 ARGUE 辩论环节</span>
                        <small>原结论暂不变更</small>
                      </div>
                      <strong>收到。你不同意当前核验结果的哪一部分？</strong>
                      <p>请选择一项具体异议，TruLens 会将原始证据和评分依据交给对应专家重新审查。</p>
                      <div className="argue-options">
                        {appealOptions.map((option) => (
                          <div
                            className={`argue-option-card ${appealDraftCode === option.code && !selectedAppeal ? "selected" : ""}`}
                            key={option.code}
                          >
                            <button
                              disabled={Boolean(selectedAppeal)}
                              onClick={() => {
                                setAppealDraftCode(option.code);
                                setAppealExplanation("");
                                setAppealEvidenceName("");
                              }}
                            >
                              <span className={`report-dimension-badge badge-${option.code.toLowerCase()}`}>{option.code}</span>
                              <span><strong>{option.label}</strong><small>{option.role}重新核验</small></span>
                              <i aria-hidden="true">{appealDraftCode === option.code ? "⌄" : "→"}</i>
                            </button>
                            {appealDraftCode === option.code && !selectedAppeal && (
                              <div className="argue-appeal-input">
                                <label htmlFor={`appeal-${option.code}`}>补充你的判断依据 <small>选填</small></label>
                                <textarea
                                  id={`appeal-${option.code}`}
                                  onChange={(event) => setAppealExplanation(event.target.value)}
                                  placeholder="我觉得这里没问题，因为……"
                                  rows={3}
                                  value={appealExplanation}
                                />
                                <div className="argue-appeal-actions">
                                  <label className="argue-evidence-upload" title="上传图片或其他证据">
                                    <input
                                      accept="image/*,.pdf,.doc,.docx,.txt"
                                      onChange={(event) => setAppealEvidenceName(event.target.files?.[0]?.name ?? "")}
                                      type="file"
                                    />
                                    <Icon size={15}><path d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" /></Icon>
                                    <span>{appealEvidenceName || "上传图片或其他证据"}</span>
                                  </label>
                                  <div>
                                    <button className="skip" onClick={submitAppeal}>跳过，不填写</button>
                                    <button onClick={submitAppeal}>{appealExplanation.trim() || appealEvidenceName ? "提交申诉材料" : "直接提交"} <Arrow size={14} /></button>
                                  </div>
                                </div>
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  ) : appealSelection ? (
                    <ArgueReviewFlow
                      evidenceName={followup.evidenceName ?? ""}
                      explanation={followup.detail ?? ""}
                      onArchive={onArchiveReport}
                      onViewReport={onViewRevisedReport}
                      option={appealSelection}
                    />
                  ) : isImageDetection ? (
                    <>
                      <p>检测完成。我在主图中定位到 <strong>2 处疑似 AI 辅助修饰区域</strong>。它们更接近局部美化，而不是整张图片由 AI 生成。</p>
                      <div className="photo-detection-result">
                        <div className="detected-photo">
                          <img alt="照片 AI 修饰区域检测结果" src={postImage} />
                          <span className="detection-box zone-a"><i>A</i></span>
                          <span className="detection-box zone-b"><i>B</i></span>
                          <div className="detection-scanline" />
                          <small>IMAGE FORENSICS · FRAME 01</small>
                        </div>
                        <div className="detection-findings">
                          <div className="detection-score">
                            <span>图像原生性</span>
                            <strong>88<small>/100</small></strong>
                          </div>
                          <div className="finding-item">
                            <span>A</span>
                            <div>
                              <strong>面中与脸颊纹理</strong>
                              <p>局部毛孔纹理重复且过于均匀，疑似使用生成式皮肤细化。</p>
                            </div>
                            <em>78%</em>
                          </div>
                          <div className="finding-item">
                            <span>B</span>
                            <div>
                              <strong>唇周与下颌边缘</strong>
                              <p>边缘过渡异常平滑，但光影方向与原图保持一致。</p>
                            </div>
                            <em>64%</em>
                          </div>
                        </div>
                      </div>
                      <div className="detection-conclusion">
                        <span>结论</span>
                        <p>产品主体、背景和整体光影未发现生成痕迹。修饰主要集中在肤质优化，可能会让底妆遮瑕力看起来优于真实效果，建议参考自然光下的素人试妆。</p>
                      </div>
                    </>
                  ) : (
                    <ContextualFollowupAnswer question={followup.question} />
                  )}
                </div>
              </div>
            </div>
          );
        })}
        <div className="chat-end-anchor" ref={chatEndRef} />
      </div>
      <div className="chat-composer-wrap">
        {!isArgueFlow && (
          <div className="quick-followups">
            <span>{quickFollowups.length ? "继续追问" : "正在生成追问"}</span>
            <div>
              {quickFollowups.length ? quickFollowups.map((question) => (
                <button
                  className={quickPrompt === question ? "active" : ""}
                  key={question}
                  onClick={() => setQuickPrompt(question)}
                >
                  {question}
                </button>
              )) : <span className="quick-loading"><i /><i /><i /></span>}
            </div>
          </div>
        )}
        <Composer
          compact
          filename=""
          onFile={onFile}
          onPauseToggle={() => setPaused((current) => !current)}
          onSubmit={sendFollowup}
          pauseDisabled={!isGenerating}
          paused={paused}
          preset={quickPrompt}
        />
        <small>TruLens 可能会出错，请结合实际体验判断。</small>
      </div>
    </section>
  );
}

