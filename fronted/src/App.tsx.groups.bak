function ReportEvidenceModal({
  code,
  dimension,
  onClose,
  showAccountActivity = false,
  technicalView,
}: {
  code: DimensionCode;
  dimension: UnifiedReportDimension;
  onClose: () => void;
  showAccountActivity?: boolean;
  technicalView: boolean;
}) {
  useEffect(() => {
    const closeOnEscape = (event: KeyboardEvent) => {
      if (event.key === "Escape") onClose();
    };
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    window.addEventListener("keydown", closeOnEscape);
    return () => {
      document.body.style.overflow = previousOverflow;
      window.removeEventListener("keydown", closeOnEscape);
    };
  }, [onClose]);

  const modalTitle = {
    T: "账号可信度证据链",
    R: "图像原生性证据链",
    U: "评论区自然度证据链",
    S: "文本真实性证据链",
  }[code];

  return (
    <div
      aria-label={modalTitle}
      aria-modal="true"
      className={`report-evidence-backdrop evidence-${code.toLowerCase()}`}
      onMouseDown={(event) => {
        if (event.currentTarget === event.target) onClose();
      }}
      role="dialog"
    >
      <article className="report-evidence-modal">
        <header className="report-evidence-header">
          <div>
            <span className={`report-dimension-badge badge-${code.toLowerCase()}`}>{code}</span>
            <div>
              <small>EVIDENCE CHAIN · 可解释评分依据</small>
              <strong>{modalTitle}</strong>
            </div>
          </div>
          <div className="evidence-modal-score">
            <span>维度评分</span>
            <strong>{(dimension.score / 10).toFixed(1)}</strong>
          </div>
          <button aria-label="关闭证据链" className="evidence-modal-close" onClick={onClose}>
            <Icon size={18}><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
          </button>
        </header>

        <div className="evidence-chain-summary">
          <span>结论</span>
          <p>{dimension.text}</p>
          <div>
            {dimension.evidence.map((item) => (
              <span className="evidence-summary-item" key={item}>
                <small>{item}</small>
                {technicalView && <MethodBadge method={dimension.method ?? "llm"} />}
              </span>
            ))}
          </div>
        </div>

        {code === "T" && (
          <>
            <AccountProfileEvidence />
            <div className="account-evidence-layout">
              <div className="evidence-source-pair">
                <figure>
                  <img alt={`${showAccountActivity ? "眠云的护肤手账" : "贴贴银河"}账号主页原始材料`} src="/evidence/account-profile.jpg" />
                  <figcaption>图 1 · 账号主页与公开资料</figcaption>
                </figure>
                <figure>
                  <img alt={`${showAccountActivity ? "眠云的护肤手账" : "贴贴银河"}历史美妆护肤笔记原始材料`} src="/evidence/account-history.jpg" />
                  <figcaption>图 2 · 历史笔记内容抽样</figcaption>
                </figure>
              </div>
              <div className="evidence-document account-evidence-document">
                <div className="evidence-document-head">
                  <span className="evidence-profile-avatar">贴</span>
                  <div><strong>{showAccountActivity ? "眠云的护肤手账" : "贴贴银河"}</strong><small>{showAccountActivity ? "ID：mianyun_demo_208 · 虚拟档案" : "小红书号 601047506 · IP 广东"}</small></div>
                  <em>账号材料 2 份</em>
                </div>
                <div className="account-metrics">
                  <span><strong>128</strong>关注</span>
                  <span><strong>3.5 万</strong>粉丝</span>
                  <span><strong>24.6 万</strong>获赞与收藏</span>
                </div>
                <section>
                  <small>账号简介</small>
                  <p>“慢慢护肤，认真记录”｜日常护肤｜精华体验｜成分记录。<mark>主页已明确标注为虚构演示账号</mark>。</p>
                </section>
                <section>
                  <small>历史动态文本抽样</small>
                  <p><b>05-12</b> 换季护肤清单｜我的精简步骤 <em>♡ 326</em></p>
                  <p><b>05-10</b> <mark>连续 7 天精华记录（虚构示例）</mark> <em>♡ 184</em></p>
                  <p><b>05-08</b> 护肤日记：保湿感比想象中重要 <em>♡ 241</em></p>
                  <p><b>05-06</b> 成分党笔记｜新手怎么读精华 <em>♡ 118</em></p>
                </section>
                <footer><span>演示身份标注清楚</span><span>内容垂直稳定</span><span className="attention">连续体验需核对原始素材</span></footer>
              </div>
            </div>
            {showAccountActivity && <AccountActivityEvidence />}
          </>
        )}

        {code === "R" && (
          <>
            <div className="image-evidence-layout">
              <div className="report-forensic-image">
                <img alt="同一人物左右脸肤质对比原始材料" src="/evidence/skin-comparison.jpg" />
                <span className="forensic-anchor anchor-one">①</span>
                <span className="forensic-anchor anchor-two">②</span>
                <small>图 3 · 左右脸肤质对比原图</small>
              </div>
              <div className="forensic-findings">
                <span>锚点检测</span>
                <div><b>①</b><p><strong>左侧原始肤质区域</strong><small>毛孔、色素点与细小起伏分布自然，保留随机高频纹理，可作为真实皮肤基准。</small></p><em>基准</em></div>
                <div><b>②</b><p><strong>右侧眼下与面中区域</strong><small>微纹理和毛孔明显减少，表面平滑度显著高于左侧，符合局部磨皮或生成式细化特征。</small></p><em>72%</em></div>
                <p>两侧五官结构、镜头角度和主光方向基本一致，未见拼接错位或整图生成；当前风险集中在右侧肤质呈现被优化。</p>
              </div>
            </div>
            <MaterialTraceEvidence hasMatches={dimension.score < 90} technicalView={technicalView} />
          </>
        )}

        {code === "U" && (
          <>
            <div className="comment-evidence-layout">
              <div className="comment-source-stack">
                <figure><img alt="评论区原始材料上半部分" src="/evidence/comments-1.jpg" /><figcaption>图 4 · 评论原文</figcaption></figure>
                <figure><img alt="评论区原始材料下半部分" src="/evidence/comments-2.jpg" /><figcaption>图 5 · 评论原文</figcaption></figure>
              </div>
              <div className="evidence-document comment-evidence-document">
                <div className="comment-analysis-head"><span>评论区原文抽样</span><small>可见样本 12 条 · 具体问题与追问为主</small></div>
                <div className="report-comment detailed"><i>晚</i><p><strong>晚风饮茶</strong>用了几天，保湿感还不错，先继续观察</p><time>江苏</time></div>
                <div className="report-comment"><i>鱼</i><p><strong>小鱼汽水</strong>这个精华的质地看起来好清爽呀</p><time>广东</time></div>
                <div className="report-comment detailed"><i>梨</i><p><strong>阿梨今天早睡</strong>七天变化会不会和作息也有关系？</p><time>浙江</time></div>
                <div className="report-comment"><i>桃</i><p><strong>桃桃汽泡</strong>蹲一个后续，敏感肌能用吗？</p><time>上海</time></div>
                <div className="report-comment detailed"><i>橘</i><p><strong>橘子海</strong>姐妹们先看成分表，别只看前后对比图</p><time>四川</time></div>
                <div className="report-comment"><i>薄</i><p><strong>薄荷糖不加冰</strong>请问这是合作分享吗？</p><time>北京</time></div>
                <div className="report-comment detailed"><i>眠</i><p><strong>眠云的护肤手账</strong>我自己是敏感肌，用下来没什么刺激感，建议先在耳后试一下哦</p><time>作者回复</time></div>
                <div className="report-comment"><i>云</i><p><strong>云朵收藏夹</strong>期待更多真实使用记录～</p><time>湖北</time></div>
                <footer><span className="comment-swatch" />浅紫色标记具体问题与作者回复 <b>互动自然 · 未见集中模板话术</b></footer>
              </div>
            </div>
            <p className="comment-simulation-note">以上评论均为模拟文本，刻意包含不同观点与表达模式，方便测试对重复话术、夸大效果、购买引导及合作披露缺失等线索的识别能力。</p>
          </>
        )}

        {code === "S" && (
          <div className="evidence-document copy-evidence-document">
            <div className="evidence-document-head copy-source-head">
              <div><small>帖子原文</small><strong>秋冬奶油肌底妆分享</strong></div>
              <em>语义主张检测</em>
            </div>
            <div className="copy-evidence-legend" aria-label="文本标注说明">
              <span className="template">模版化术语</span>
              <span className="absolute">绝对化用语</span>
              <span className="unsupported">功效缺少依据</span>
            </div>
            <p>
              最近换季皮肤有点干，试了这套底妆。妆前薄涂，粉底少量叠加，在我脸上<mark className="unsupported">大约能维持 8 小时</mark>。<mark className="template">像开了原生柔焦一样</mark>，<mark className="absolute">毛孔直接隐形</mark>，但鼻翼到下午还是会有一点卡粉。色号是按我自己的肤色选的，<mark className="absolute">所有肤质都能放心入</mark>。本篇含品牌合作，具体效果会因肤质和上妆方式不同。
            </p>
            <div className="copy-annotations">
              <span><b>01</b><p><strong>模板化话术</strong><small>“像开了原生柔焦一样”属于常见的效果包装表达。</small></p></span>
              <span><b>02</b><p><strong>绝对化用语</strong><small>“毛孔直接隐形”“所有肤质都能放心入”把个人体验扩大为确定结论。</small></p></span>
              <span><b>03</b><p><strong>功效缺少依据</strong><small>“大约能维持 8 小时”未提供测试条件或可核对记录。</small></p></span>
            </div>
            <footer><span>已披露品牌合作</span><span>保留个体体验边界</span><span className="attention">2 处表述需留意</span></footer>
          </div>
        )}

        {(code === "T" || code === "R" || code === "S") && (
          <small className="evidence-ai-case-note">虚构案例 · AI 生成</small>
        )}

        <footer className="evidence-modal-footer">
          <p><span /> 原始信号 <i /> 模型检测 <em /> 评分结论</p>
          <button onClick={onClose}>返回报告</button>
        </footer>
      </article>
    </div>
  );
}

const evidenceDimensionOptions: Record<DimensionCode, { label: string; hint: string }> = {
  T: { label: "账号可信度", hint: "账号主页链接、简介或历史发布记录" },
  R: { label: "图片原生性", hint: "原始图片、对比图或局部细节截图" },
  U: { label: "评论区自然度", hint: "评论区截图、评论文本或发布时间信息" },
  S: { label: "文本真实性", hint: "笔记正文、标题或功效描述" },
};

function EvidenceExpansionPrompt({
  availableCodes,
  onAddEvidence,
}: {
  availableCodes: DimensionCode[];
  onAddEvidence: (code: DimensionCode) => void;
}) {
  const missingCodes = allDimensions.filter((code) => !availableCodes.includes(code));
  const [mode, setMode] = useState<"idle" | "adding" | "dismissed">("idle");
  const [selectedCode, setSelectedCode] = useState<DimensionCode>(missingCodes[0] ?? "T");
  const [evidenceText, setEvidenceText] = useState("");
  const [filename, setFilename] = useState("");
  const [addedCode, setAddedCode] = useState<DimensionCode | null>(null);
  const fileRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    if (!missingCodes.includes(selectedCode) && missingCodes[0]) setSelectedCode(missingCodes[0]);
  }, [missingCodes, selectedCode]);

  if (!missingCodes.length || mode === "dismissed") return null;

  const submitEvidence = () => {
    if (!evidenceText.trim() && !filename) return;
    onAddEvidence(selectedCode);
    setAddedCode(selectedCode);
    setEvidenceText("");
    setFilename("");
    setMode("idle");
  };

  return (
    <section className="evidence-expansion-prompt" aria-live="polite">
      <div className="evidence-expansion-heading">
        <span>
          <Icon size={18}>
            <path d="M12 4v16M4 12h16" stroke="currentColor" strokeLinecap="round" strokeWidth="1.4" />
          </Icon>
        </span>
        <div>
          <small>MORE EVIDENCE · 可选</small>
          <h3>{addedCode ? `${evidenceDimensionOptions[addedCode].label}证据已加入` : "要加入更多维度的证据吗？"}</h3>
          <p>
            {addedCode
              ? `报告已纳入新的证据维度。你还可以继续补充其余 ${missingCodes.length} 个维度。`
              : `当前报告基于 ${availableCodes.length} 个维度生成。补充证据可以让交叉核验更充分，也可以保留当前结果。`}
          </p>
        </div>
      </div>

      {mode === "idle" ? (
        <div className="evidence-expansion-actions">
          <button onClick={() => { setAddedCode(null); setMode("adding"); }}>补充更多证据</button>
          <button onClick={() => setMode("dismissed")}>先看当前报告</button>
        </div>
      ) : (
        <div className="evidence-expansion-form">
          <div aria-label="选择要补充的证据维度" className="missing-dimension-options" role="group">
            {missingCodes.map((code) => (
              <button
                aria-pressed={selectedCode === code}
                className={selectedCode === code ? "active" : ""}
                key={code}
                onClick={() => setSelectedCode(code)}
              >
                <span>{code}</span>
                <div><strong>{evidenceDimensionOptions[code].label}</strong><small>{evidenceDimensionOptions[code].hint}</small></div>
              </button>
            ))}
          </div>
          <label className="evidence-expansion-input">
            <span>粘贴链接或补充说明</span>
            <textarea
              onChange={(event) => setEvidenceText(event.target.value)}
              placeholder={evidenceDimensionOptions[selectedCode].hint}
              rows={3}
              value={evidenceText}
            />
          </label>
          <div className="evidence-expansion-submit">
            <input
              accept="image/*"
              onChange={(event) => setFilename(event.target.files?.[0]?.name ?? "")}
              ref={fileRef}
              type="file"
            />
            <button className="evidence-upload-button" onClick={() => fileRef.current?.click()}>
              <Icon size={15}><path d="M12 16V5m0 0L8 9m4-4 4 4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.4" /></Icon>
              {filename || "上传截图"}
            </button>
            <div>
              <button onClick={() => setMode("idle")}>暂不补充</button>
              <button
                className="evidence-submit-button"
                disabled={!evidenceText.trim() && !filename}
                onClick={submitEvidence}
              >
                加入证据并重新核验
              </button>
            </div>
          </div>
        </div>
      )}
    </section>
  );
}

function UnifiedReportTemplate({
  decision,
  dimensions: availableDimensions,
  onAddEvidence,
  onContinue,
  continueLabel,
  score,
  status,
  subtitle,
  technicalView = false,
  title,
  tone,
}: {
  decision: string;
  dimensions: UnifiedReportDimension[];
  onAddEvidence?: (code: DimensionCode) => void;
  onContinue: () => void;
  continueLabel: string;
  score: number;
  status: string;
  subtitle: string;
  technicalView?: boolean;
  title: string;
  tone: string;
}) {
  const [openEvidence, setOpenEvidence] = useState<DimensionCode | null>(null);
  const [confidenceOpen, setConfidenceOpen] = useState(false);
  const [activeReportSection, setActiveReportSection] = useState("forensics-section");
  const orderedCodes = ["T", "R", "U", "S"];
  const isCurrentFullReport = title === "当前美妆种草内容" && availableDimensions.length === 4;
  const confidenceLevel = (availableDimensions.length === 4 ? "high" : availableDimensions.length >= 2 ? "medium" : "low") as "high" | "medium" | "low";
  const confidence = reportConfidenceProfiles[confidenceLevel];
  const scoreWeights: Record<string, number> = { T: 25, R: 30, U: 25, S: 20 };
  const dimensionMap = new Map(availableDimensions.map((dimension) => [dimension.code, dimension]));
  const missingDimensions = orderedCodes
    .filter((code) => !dimensionMap.has(code))
    .map((code) => ({ T: "账号材料", R: "图片材料", U: "评论材料", S: "文案材料" })[code])
    .filter(Boolean);
  const radarCoordinates = orderedCodes.map((code, index) => {
    const dimension = dimensionMap.get(code);
    const radius = dimension ? dimension.score * 0.9 : 0;
    if (index === 0) return [120, 110 - radius];
    if (index === 1) return [120 + radius, 110];
    if (index === 2) return [120, 110 + radius];
    return [120 - radius, 110];
  });

  useEffect(() => {
    const sectionIds = ["forensics-section", "cross-check-section", "decision-section"];
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => right.intersectionRatio - left.intersectionRatio)[0];
      if (visible) setActiveReportSection(visible.target.id);
    }, { rootMargin: "-24% 0px -58% 0px", threshold: [0.05, 0.25, 0.5] });
    sectionIds.forEach((id) => {
      const element = document.getElementById(id);
      if (element) observer.observe(element);
    });
    return () => observer.disconnect();
  }, [isCurrentFullReport]);

  return (
    <div className="unified-report-page">
      <article className={`unified-report-card ${tone}`}>
        <header>
          <div><strong>TruLens 核验报告</strong><small>{title === "当前美妆种草内容" ? "当前美妆种草内容 · 一个 Agent 汇总四个维度·生成核验报告" : `${title} · 同一个 Agent 汇总四个维度`}</small></div>
          <span>AI 生成报告</span>
        </header>

        <nav aria-label="报告章节导航" className="report-anchor-nav">
          {[
            ["forensics-section", "① 鉴伪结果"],
            ["cross-check-section", "② 一致性校验"],
            ["decision-section", "③ 决策与建议"],
          ].map(([id, label]) => (
            <button
              className={activeReportSection === id ? "active" : ""}
              key={id}
              onClick={() => document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" })}
            >
              {label}
            </button>
          ))}
        </nav>

        <div className="unified-score-row">
          <div className="unified-score-cluster">
            <div className="unified-score">
              <span>Trust Score</span>
              <strong>{score}<small>/ 100</small></strong>
              <em>基于 {availableDimensions.length}/4 个维度</em>
              {confidenceLevel === "low" && <p>材料有限，结论仅供参考</p>}
            </div>
            <div className="report-confidence-wrap">
              <button
                className={`report-confidence confidence-${confidenceLevel}`}
                onClick={() => setConfidenceOpen((open) => !open)}
              >
                <span>置信度</span>
                <strong>{confidence.label}</strong>
                <i>{[1, 2, 3].map((bar) => <b className={bar <= confidence.bars ? "filled" : ""} key={bar} />)}</i>
              </button>
              {confidenceOpen && (
                <div className="report-confidence-popover">
                  <strong>置信度依据</strong>
                  <span>启用维度 <b>{availableDimensions.length}/4</b></span>
                  <span>证据条数 <b>{confidence.evidenceCount}</b></span>
                  <span>交叉验证项 <b>{confidence.crossCheckCount}</b></span>
                  <span>缺失材料 <b>{missingDimensions.length ? missingDimensions.join("、") : "无"}</b></span>
                </div>
              )}
            </div>
          </div>
          <div className="unified-verdict-group">
            <span className="unified-verdict">{status}</span>
            {isCurrentFullReport && (
              <button onClick={() => document.getElementById("cross-check-section")?.scrollIntoView({ behavior: "smooth", block: "center" })}>
                已完成交叉验证 ↓
              </button>
            )}
          </div>
        </div>

        <div className="unified-risk-band">
          <div><i style={{ left: `${score}%` }} /></div>
          <span>高风险</span><span>可信</span>
        </div>

        <section className="report-section-block" id="forensics-section">
          <header className="report-section-heading"><span>Multimodal Forensics</span><h2>① 四维结果</h2></header>
        <div className="unified-dimensions">
          <div className="unified-radar">
            <svg aria-label="T R U S 四维核验分布" viewBox="0 0 240 220">
              {[0.25, 0.5, 0.75, 1].map((scale) => {
                const radius = 90 * scale;
                return <polygon className="radar-grid" key={scale} points={`120,${110 - radius} ${120 + radius},110 120,${110 + radius} ${120 - radius},110`} />;
              })}
              <line x1="120" x2="120" y1="20" y2="200" />
              <line x1="30" x2="210" y1="110" y2="110" />
              <polygon className="unified-radar-data" points={radarCoordinates.map(([x, y]) => `${x},${y}`).join(" ")} />
              {[
                ["T", 120, 20, 120, 10, 120, 32],
                ["R", 210, 110, 226, 114, 226, 126],
                ["U", 120, 200, 120, 217, 120, 204],
                ["S", 30, 110, 14, 114, 14, 126],
              ].map(([code, x, y, tx, ty, mx, my]) => (
                <g className={dimensionMap.has(String(code)) ? "" : "missing"} key={code}>
                  <circle cx={x} cy={y} r="10" />
                  <text textAnchor="middle" x={tx} y={ty}>{code}</text>
                  {!dimensionMap.has(String(code)) && <text className="radar-disabled-label" textAnchor="middle" x={mx} y={my}>未启用</text>}
                </g>
              ))}
              {radarCoordinates.map(([x, y], index) => dimensionMap.has(orderedCodes[index]) && <circle className="unified-radar-point" cx={x} cy={y} key={orderedCodes[index]} r="4" />)}
            </svg>
            <small>四维核验分布</small>
          </div>

          <div className="unified-dimension-list">
            {orderedCodes.map((code) => {
              const dimension = dimensionMap.get(code);
              return (
                <button
                  aria-label={dimension ? `查看${dimension.title}评分证据链` : `${code} 维度数据不足`}
                  className={`unified-dimension-row ${dimension ? "" : "missing"}`}
                  disabled={!dimension}
                  key={code}
                  onClick={() => dimension && setOpenEvidence(code as DimensionCode)}
                >
                  <span className={`report-dimension-badge badge-${code.toLowerCase()}`}>{code}</span>
                  <div>
                    <span>
                      <strong>{title === "当前美妆种草内容" && code === "S" ? "文本真实性" : dimension?.title ?? { T: "账号可信度", R: "图片真实性", U: "评论区真实性", S: "文案真实性" }[code as DimensionCode]}</strong>
                      <b>{dimension ? <>{dimension.score}<small>/100 · 权重 {scoreWeights[code]}%</small><i aria-hidden="true">查看证据 →</i></> : "数据不足"}</b>
                    </span>
                    <div><i style={{ width: dimension ? `${dimension.score}%` : "0%" }} /></div>
                    <small>{dimension?.text ?? "尚未提供该维度所需材料，未参与评分。"}</small>
                    <AnimatePresence>
                      {technicalView && dimension && (
                        <motion.p
                          animate={{ opacity: 1, height: "auto" }}
                          className="technical-capability"
                          exit={{ opacity: 0, height: 0 }}
                          initial={{ opacity: 0, height: 0 }}
                        >
                          所用能力 · {technicalConfig.dimensionCapabilities[code as DimensionCode]}
                        </motion.p>
                      )}
                    </AnimatePresence>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
        </section>

        <CrossCheckSection
          activeDimensions={availableDimensions.map((dimension) => dimension.code as DimensionCode)}
          technicalView={technicalView}
        />

        <DecisionSupport
          activeDimensions={availableDimensions.map((dimension) => dimension.code as DimensionCode)}
          confidenceLevel={availableDimensions.length === 4 ? "high" : availableDimensions.length >= 2 ? "medium" : "low"}
          continueLabel={continueLabel}
          onContinue={onContinue}
          score={score}
          subtitle={subtitle || decision}
        />
      </article>
      <AnimatePresence>
        {technicalView && (
          <motion.section
            animate={{ opacity: 1, height: "auto", y: 0 }}
            className="technical-explanation"
            exit={{ opacity: 0, height: 0, y: -4 }}
            initial={{ opacity: 0, height: 0, y: -4 }}
          >
            <div>
              <section><strong>模型</strong>{technicalConfig.models.map((model) => <span key={model}>{model}</span>)}</section>
              <section><strong>部署</strong><span>{technicalConfig.deployment}</span></section>
            </div>
            <small>{technicalConfig.disclaimer}</small>
          </motion.section>
        )}
      </AnimatePresence>
      <p className="method-note">本报告由 TruLens 根据当前可用信号生成；未提供的模态不参与判断，AI 结论不构成医疗或购买建议。</p>
      {onAddEvidence && availableDimensions.length < allDimensions.length && (
        <EvidenceExpansionPrompt
          availableCodes={availableDimensions.map((dimension) => dimension.code as DimensionCode)}
          onAddEvidence={onAddEvidence}
        />
      )}
      {openEvidence && dimensionMap.get(openEvidence) && (
        <ReportEvidenceModal
          code={openEvidence}
          dimension={dimensionMap.get(openEvidence)!}
          onClose={() => setOpenEvidence(null)}
          showAccountActivity={tone === "trusted"}
          technicalView={technicalView}
        />
      )}
    </div>
  );
}

function ArchivedResult({
  task,
  onBack,
  onTechnicalViewChange,
  technicalView,
}: {
  task: Exclude<RecentTask, "makeup">;
  onBack: () => void;
  onTechnicalViewChange: (enabled: boolean) => void;
  technicalView: boolean;
}) {
  const data = archivedTasks[task];
  return (
    <section className="result archive-result">
      <header className="result-header">
        <button aria-label="返回新鉴别" className="back-button" onClick={onBack} title="返回新鉴别">
          <Icon size={22}><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
        </button>
        <div className="result-actions">
          <TechnicalViewToggle enabled={technicalView} onChange={onTechnicalViewChange} />
          <button onClick={() => window.print()}>
            <Icon size={17}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
            导出 PDF
          </button>
        </div>
      </header>
      <UnifiedReportTemplate
        continueLabel="开始新的鉴别"
        decision={data.decision}
        dimensions={data.dimensions}
        onContinue={onBack}
        score={data.score}
        status={data.status}
        subtitle={data.headline}
        technicalView={technicalView}
        title={data.title}
        tone={data.tone}
      />
    </section>
  );
}

function Result({
  onBack,
  onAddEvidence,
  scoreOverride,
  activeDimensions,
  liveReport,
  liveSample,
  creatorError,
  creatorInput,
  creatorLoading,
  creatorResult,
  onContinueOther,
  onReturnModify,
  onTechnicalViewChange,
  technicalView,
}: {
  onBack: () => void;
  onAddEvidence: (code: DimensionCode) => void;
  scoreOverride?: number | null;
  activeDimensions: DimensionCode[];
  /** Real report from the backend; when present the hardcoded deck is bypassed. */
  liveReport?: ReportRead | null;
  liveSample?: SampleRead | null;
  creatorError?: string | null;
  creatorInput?: CreatorReportInput | null;
  creatorLoading?: boolean;
  creatorResult?: CreatorCheckRead | null;
  onContinueOther?: () => void;
  onReturnModify?: (draft: string) => void;
  onTechnicalViewChange: (enabled: boolean) => void;
  technicalView: boolean;
}) {
  const [shareOpen, setShareOpen] = useState(false);
  const reportDimensions = dimensions.filter((item) => activeDimensions.includes(item.code as DimensionCode));
  const reportScore = scoreOverride ?? Math.round(reportDimensions.reduce((total, item) => total + item.score, 0) / reportDimensions.length);
  const dimensionName = ["", "单维", "双维", "三维", "四维"][reportDimensions.length];
  const reportHeadline = activeDimensions.includes("R")
    ? "图片主体可信，存在轻度 AI 修饰。"
    : activeDimensions.includes("U")
      ? "评论整体自然，少量话术需留意。"
      : activeDimensions.includes("T")
        ? "账号轨迹稳定，长期行为可信。"
        : "文案表达安全，未见高风险宣称。";
  if (creatorInput) {
    return (
      <section className="result creator-result">
        <header className="result-header">
          <button aria-label="返回过程页" className="back-button" onClick={onBack} title="返回过程页">
            <Icon size={22}><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
          </button>
          <div className="result-actions">
            <TechnicalViewToggle enabled={technicalView} onChange={onTechnicalViewChange} />
            <button onClick={() => window.print()}>
              <Icon size={17}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
              导出 PDF
            </button>
          </div>
        </header>
        <CreatorSelfCheckReport
          error={creatorError}
          input={creatorInput}
          loading={creatorLoading}
          onContinueAgent={onBack}
          onContinueOther={onContinueOther ?? onBack}
          onRestart={() => undefined}
          onReturnModify={onReturnModify ?? (() => onBack())}
          result={creatorResult}
          technicalView={technicalView}
        />
      </section>
    );
  }
  return (
    <section className="result">
      <header className="result-header">
        <button aria-label="返回对话" className="back-button" onClick={onBack} title="返回对话">
          <Icon size={22}><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
        </button>
        <div className="result-actions">
          <TechnicalViewToggle enabled={technicalView} onChange={onTechnicalViewChange} />
          <button onClick={() => window.print()}>
            <Icon size={17}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
            导出 PDF
          </button>
          <div className="share-wrap">
            <button onClick={() => setShareOpen((open) => !open)}>
              <Icon size={17}><circle cx="18" cy="5" r="2" stroke="currentColor" strokeWidth="1.5" /><circle cx="6" cy="12" r="2" stroke="currentColor" strokeWidth="1.5" /><circle cx="18" cy="19" r="2" stroke="currentColor" strokeWidth="1.5" /><path d="m8 11 8-5M8 13l8 5" stroke="currentColor" strokeWidth="1.5" /></Icon>
              分享
            </button>
            {shareOpen && <ShareMenu onClose={() => setShareOpen(false)} />}
          </div>
        </div>
      </header>
      {liveReport ? (
        <LiveReportView
          continueLabel="开始新的核验"
          onContinue={onBack}
          report={liveReport}
          sample={liveSample ?? null}
          technicalView={technicalView}
        />
      ) : (
        <UnifiedReportTemplate
          continueLabel="向 Agent 继续追问"
          decision={activeDimensions.length < 4
            ? "当前输入不足以完成四维交叉验证。建议补充账号主页、原始图片或评论区，以获得更完整的可信度判断。"
            : "当前四种信号已完成交叉验证，报告可以作为内容可信度与消费决策之间的参考依据。"}
          dimensions={reportDimensions}
          onAddEvidence={onAddEvidence}
          onContinue={onBack}
          score={reportScore}
          status={reportScore >= 80 ? "高可信" : "需留意"}
          subtitle={reportHeadline}
          technicalView={technicalView}
          title={activeDimensions.includes("R") ? "当前美妆种草内容" : `${dimensionName}内容核验`}
          tone={reportScore >= 80 ? "trusted" : "warning"}
        />
      )}
    </section>
  );
}

function TeamPage({
  onBack,
  onOpenReport,
}: {
  onBack: () => void;
  onOpenReport: (taskId: string) => void;
}) {
  const [items, setItems] = useState<TeamQueueItem[]>([]);
  const [groups, setGroups] = useState<TeamRelatedGroup[]>([]);
  const [summary, setSummary] = useState<TeamSummary | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = () => {
    setLoading(true);
    setError(null);
    void getTeamQueue()
      .then((data) => {
        setItems(
          data.items.map((item) => ({
            id: item.id,
            taskId: item.task_id,
            title: item.title,
            author: item.author,
            score: Math.round(item.score),
            risk:
              item.risk_level === "high"
                ? "高风险"
                : item.risk_level === "medium"
                  ? "中风险"
                  : "高可信",
            confidence:
              item.confidence === "high" ? "高" : item.confidence === "medium" ? "中" : "低",
            dimensions: item.dimensions,
            contradiction: item.contradiction,
            issueType: item.issue_type as TeamQueueItem["issueType"],
            actions: item.actions,
            status:
              item.status === "pending"
                ? "待复核"
                : item.status === "watching"
                  ? "观察中"
                  : "已处理",
            checks: item.checks.map((check) => [check.claim, check.evidence] as [string, string]),
          })),
        );
        setGroups(
          data.groups.map((group) => ({
            id: group.id,
            signals: group.signals,
            members: group.members.map((member) => ({
              id: member.id,
              taskId: member.task_id,
              title: member.title,
              author: member.author,
              createdAt: member.created_at,
              time: new Date(member.created_at).toLocaleDateString("zh-CN", {
                month: "2-digit",
                day: "2-digit",
              }),
            })),
          })),
        );
        setSummary({
          total: data.summary.total,
          highRisk: data.summary.high_risk,
          pending: data.summary.pending,
          trusted: data.summary.trusted,
          mediumRisk: data.summary.medium_risk,
          confidenceHigh: data.summary.confidence_high,
          confidenceMedium: data.summary.confidence_medium,
          confidenceLow: data.summary.confidence_low,
        });
      })
      .catch((err) => setError(describeApiError(err)))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    load();
  }, []);

  const handleUpdateStatus = async (taskIds: string[], status: "待复核" | "观察中" | "已处理") => {
    const apiStatus = status === "待复核" ? "pending" : status === "观察中" ? "watching" : "done";
    await Promise.all(taskIds.map((taskId) => updateTeamStatus(taskId, apiStatus)));
    load();
  };

  return (
    <TeamWorkspace
      error={error}
      groups={groups}
      items={items}
      loading={loading}
      onBack={onBack}
      onOpenReport={(taskId) => taskId && onOpenReport(taskId)}
      onRefresh={load}
      onUpdateStatus={handleUpdateStatus}
      summary={summary ?? undefined}
    />
  );
}

export default function App() {
  const [screen, setScreen] = useState<Screen>(() => {
    // Deep links: /?live=true opens the real-backend verification screen directly,
    // so the live slice can be demoed without walking the story deck first.
    const params = new URLSearchParams(window.location.search);
    if (params.get("live") === "true") return "live";
    if (params.get("report") === "true") return "result";
    return "home";
  });
  const [filename, setFilename] = useState("");
  const [prompt, setPrompt] = useState("请帮我鉴别这篇美妆种草帖子是否由 AI 造假");
  const [pendingPrompt, setPendingPrompt] = useState("");
  const [creatorInput, setCreatorInput] = useState<CreatorReportInput | null>(null);
  const [creatorSeed, setCreatorSeed] = useState("");
  const [creatorResult, setCreatorResult] = useState<CreatorCheckRead | null>(null);
  const [creatorLoading, setCreatorLoading] = useState(false);
  const [creatorError, setCreatorError] = useState<string | null>(null);
  const [workspaceInitialMode, setWorkspaceInitialMode] = useState<"link" | "manual" | "creator">("link");
  const [activeTask, setActiveTask] = useState<RecentTask>("makeup");
  const [activeDimensions, setActiveDimensions] = useState<DimensionCode[]>(allDimensions);
  const [exampleSubmission, setExampleSubmission] = useState(false);
  const [historyCleared, setHistoryCleared] = useState(false);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [technicalView, setTechnicalView] = useState(false);
  const [viewingHistory, setViewingHistory] = useState(false);
  const [archivedScore, setArchivedScore] = useState<number | null>(() => {
    const saved = window.localStorage.getItem("trulens-archived-score");
    return saved ? Number(saved) : null;
  });
  const [revisedScore, setRevisedScore] = useState<number | null>(null);
  // The single source of truth for the real backend pipeline. Every screen that
  // shows live data reads from here; deleting this + the props below reverts the
  // app to the pure story-deck behaviour.
  const live = useLiveAnalysis();
  const [liveFile, setLiveFile] = useState<File | null>(null);
  const [accountUrl, setAccountUrl] = useState("");
  const [recentRuns, setRecentRuns] = useState<RecentRunRecord[]>(loadRecentRuns);
  const [activeRecentId, setActiveRecentId] = useState<string | null>(null);
  const [viewedRecentId, setViewedRecentId] = useState<string | null>(null);
  const viewedRecent = viewedRecentId
    ? recentRuns.find((run) => run.id === viewedRecentId) ?? null
    : null;

  useEffect(() => {
    window.localStorage.setItem(RECENT_RUNS_STORAGE_KEY, JSON.stringify(recentRuns));
  }, [recentRuns]);

  useEffect(() => {
    if (!live.taskId || !live.report) return;
    const now = new Date().toISOString();
    const next: RecentRunRecord = {
      id: live.taskId,
      taskId: live.taskId,
      title: deriveRecentTitle(prompt, filename),
      createdAt: now,
      trustScore: live.report.trust_score,
      trustLabel: live.report.trust_label,
      activeDimensions: [...activeDimensions],
      report: live.report,
      sample: live.sample,
    };
    setRecentRuns((current) => {
      const existing = current.find((run) => run.id === next.id);
      const merged = existing ? { ...next, createdAt: existing.createdAt } : next;
      return [merged, ...current.filter((run) => run.id !== next.id)].slice(0, 8);
    });
    setActiveRecentId(live.taskId);
    setHistoryCleared(false);
  }, [activeDimensions, filename, live.report, live.sample, live.taskId, prompt]);

  useEffect(() => {
    const taskId = new URLSearchParams(window.location.search).get("task");
    if (!taskId) return;
    let cancelled = false;
    void Promise.all([getReport(taskId), getStatus(taskId)])
      .then(async ([report, status]) => {
        if (cancelled) return;
        const sample = await getSample(status.sample_id).catch(() => null);
        if (cancelled) return;
        const active = report.dimensions
          .filter((dimension) => dimension.assessed)
          .map((dimension) => dimension.code);
        const record: RecentRunRecord = {
          id: taskId,
          taskId,
          title: deriveRecentTitle(sample?.text_content ?? "", sample?.image?.filename ?? "") || `历史核验 ${taskId.slice(0, 8)}`,
          createdAt: sample?.created_at ?? report.created_at,
          trustScore: report.trust_score,
          trustLabel: report.trust_label,
          activeDimensions: active,
          report,
          sample,
        };
        setRecentRuns((current) => [
          record,
          ...current.filter((run) => run.id !== taskId),
        ].slice(0, 8));
        setHistoryCleared(false);
        setActiveRecentId(taskId);
        setViewedRecentId(taskId);
        setActiveTask("makeup");
        setActiveDimensions(active);
        setRevisedScore(null);
        setScreen("result");
      })
      .catch(() => {
        if (!cancelled) setScreen("workspace");
      });
    return () => {
      cancelled = true;
    };
  }, []);

  const start = () => {
    live.reset();
    setLiveFile(null);
    setAccountUrl("");
    setPendingPrompt("");
    setCreatorInput(null);
    setCreatorSeed("");
    setWorkspaceInitialMode("link");
    setActiveRecentId(null);
    setViewedRecentId(null);
    setActiveTask("makeup");
    setExampleSubmission(false);
    setViewingHistory(false);
    setScreen("workspace");
  };
  const submit = (
    newPrompt: string,
    submittedFilename = filename,
    isExample = false,
    submittedAccountUrl = "",
  ) => {
    const isLink = !isExample && looksLikeXhsLink(newPrompt);
    if (isLink && !submittedAccountUrl.trim()) {
      setFilename(submittedFilename);
      setPendingPrompt(newPrompt);
      setAccountUrl("");
      setScreen("workspace");
      return;
    }
    setActiveTask("makeup");
    setViewingHistory(false);
    setActiveRecentId(null);
    setViewedRecentId(null);
    setFilename(submittedFilename);
    setExampleSubmission(isExample);
    setActiveDimensions(inferDimensions(newPrompt, submittedFilename));
    setRevisedScore(null);
    setPrompt(newPrompt);
    setAccountUrl("");
    setPendingPrompt("");
    setCreatorInput(null);
    setCreatorSeed("");
    setScreen("chat");

    // Kick off the real analysis. The example path submits the curated demo
    // payload (so the demo is reproducible); a pasted Xiaohongshu link is sent
    // as `url` for the backend to crawl; anything else is treated as the copy.
    const image = isExample ? null : liveFile;
    void live.start(
      isExample
        ? { ...DEMO_INPUT, source: "frontend-example" }
        : isLink
          ? { url: newPrompt, accountUrl: submittedAccountUrl.trim() || undefined, source: "frontend-link" }
          : { text: newPrompt, image, source: "frontend" },
    );
  };

  const submitLink = (noteUrl: string, profileUrl: string) => {
    if (!looksLikeXhsLink(noteUrl) || !/xiaohongshu\.com\/user\/profile\/|xhslink\.(com|cn)/i.test(profileUrl)) {
      return;
    }
    live.reset();
    setLiveFile(null);
    setAccountUrl("");
    setPendingPrompt("");
    setCreatorInput(null);
    setCreatorSeed("");
    setFilename("");
    setExampleSubmission(false);
    setActiveTask("makeup");
    setActiveDimensions(allDimensions);
    setRevisedScore(null);
    setPrompt(noteUrl);
    setActiveRecentId(null);
    setViewedRecentId(null);
    setViewingHistory(false);
    setScreen("chat");
    void live.start({
      url: noteUrl,
      accountUrl: profileUrl,
      source: "frontend-link",
      agents: ["account", "image", "comment", "text"],
    });
  };

  const submitManual = ({
    text,
    image,
    comments,
    accountHistory,
  }: {
    text: string;
    image: File | null;
    comments: string;
    accountHistory: string;
  }) => {
    if (!text.trim() && !image) return;
    live.reset();
    setLiveFile(null);
    setAccountUrl("");
    setPendingPrompt("");
    setCreatorInput(null);
    setCreatorSeed("");
    setFilename(image?.name ?? "");
    setExampleSubmission(false);
    setActiveTask("makeup");
    setActiveDimensions([
      ...(image ? ["R" as DimensionCode] : []),
      ...(text.trim() ? ["S" as DimensionCode] : []),
      ...(comments.trim() ? ["U" as DimensionCode] : []),
      ...(accountHistory.trim() ? ["T" as DimensionCode] : []),
    ]);
    setRevisedScore(null);
    setPrompt(text.trim() || "请核验我上传的图片内容");
    setActiveRecentId(null);
    setViewedRecentId(null);
    setViewingHistory(false);
    setScreen("chat");
    void live.start({
      text: text.trim() || undefined,
      image,
      comments: comments.trim() || undefined,
      accountHistory: accountHistory.trim() || undefined,
      source: "frontend-manual",
    });
  };

  const submitCreator = (input: CreatorReportInput) => {
    setActiveTask("makeup");
    setViewingHistory(false);
    setActiveRecentId(null);
    setViewedRecentId(null);
    setFilename(input.images.length ? `${input.images.length} 张待发布配图` : "");
    setExampleSubmission(input.isExample);
    setActiveDimensions(input.images.length ? ["R", "S"] : ["S"]);
    setRevisedScore(null);
    setPrompt(input.draft);
    setCreatorInput(input);
    setCreatorResult(null);
    setCreatorError(null);
    setCreatorLoading(true);
    setCreatorSeed("");
    setScreen("result");
    const image = input.images.find((item) => item.file)?.file ?? null;
    void checkCreator({
      draft: input.draft,
      isCollaboration: input.isCollaboration,
      category: input.category,
      image,
    })
      .then((result) => {
        setCreatorResult(result);
        setActiveDimensions(
          result.report.dimensions
            .filter((dimension) => dimension.assessed)
            .map((dimension) => dimension.code),
        );
      })
      .catch((err) => setCreatorError(describeApiError(err)))
      .finally(() => setCreatorLoading(false));
  };

  const openTaskReport = (taskId: string) => {
    void Promise.all([getReport(taskId), getStatus(taskId)])
      .then(async ([report, status]) => {
        const sample = await getSample(status.sample_id).catch(() => null);
        const active = report.dimensions
          .filter((dimension) => dimension.assessed)
          .map((dimension) => dimension.code);
        const record: RecentRunRecord = {
          id: taskId,
          taskId,
          title: deriveRecentTitle(sample?.text_content ?? "", sample?.image?.filename ?? ""),
          createdAt: sample?.created_at ?? report.created_at,
          trustScore: report.trust_score,
          trustLabel: report.trust_label,
          activeDimensions: active,
          report,
          sample,
        };
        setRecentRuns((current) => [
          record,
          ...current.filter((run) => run.id !== taskId),
        ].slice(0, 8));
        setActiveRecentId(taskId);
        setViewedRecentId(taskId);
        setActiveTask("makeup");
        setViewingHistory(false);
        setActiveDimensions(active);
        setRevisedScore(null);
        setScreen("result");
      })
      .catch((err) => {
        console.error("task report open failed", err);
      });
  };

  if (screen === "home") {
    return (
      <Home
        onCreator={() => {
          setCreatorInput(null);
          setCreatorSeed("");
          setWorkspaceInitialMode("creator");
          setScreen("workspace");
        }}
        onStart={start}
        onSubmit={(newPrompt, submittedFilename, isExample) => submit(newPrompt, submittedFilename, isExample)}
        onTeam={() => setScreen("team")}
      />
    );
  }

  if (screen === "team") {
    return (
      <TeamPage
        onBack={() => setScreen("home")}
        onOpenReport={openTaskReport}
      />
    );
  }

  return (
    <main className={`app-shell ${sidebarCollapsed ? "sidebar-collapsed" : ""}`}>
      <Sidebar
        active={screen}
        activeTask={activeTask}
        archivedScore={archivedScore}
        activeRecentId={activeRecentId}
        collapsed={sidebarCollapsed}
        historyCleared={historyCleared}
        recentRuns={recentRuns}
        onLogout={() => {
          setFilename("");
          setAccountUrl("");
          setCreatorInput(null);
          setCreatorSeed("");
          live.reset();
          setActiveRecentId(null);
          setViewedRecentId(null);
          setScreen("home");
        }}
        onNew={() => {
          setFilename("");
          setAccountUrl("");
          setPendingPrompt("");
          setCreatorInput(null);
          setCreatorSeed("");
          setWorkspaceInitialMode("link");
          setExampleSubmission(false);
          setActiveTask("makeup");
          setActiveDimensions(allDimensions);
          setViewingHistory(false);
          live.reset();
          setLiveFile(null);
          setActiveRecentId(null);
          setViewedRecentId(null);
          setScreen("workspace");
        }}
        onLive={() => {
          setViewingHistory(false);
          setActiveRecentId(null);
          setViewedRecentId(null);
          setScreen("live");
        }}
        onRecent={(id) => {
          const run = recentRuns.find((item) => item.id === id);
          if (!run) return;
          setActiveRecentId(id);
          setViewedRecentId(id);
          setActiveTask("makeup");
          setViewingHistory(false);
          setRevisedScore(null);
          setActiveDimensions(run.activeDimensions?.length ? run.activeDimensions : allDimensions);
          setScreen("result");
          void getReport(run.taskId)
            .then((report) => {
              setRecentRuns((current) =>
                current.map((item) =>
                  item.id === id
                    ? {
                        ...item,
                        report,
                        trustScore: report.trust_score,
                        trustLabel: report.trust_label,
                      }
                    : item,
                ),
              );
            })
            .catch(() => undefined);
        }}
        onResetAgent={() => {
          setFilename("");
          setAccountUrl("");
          setPendingPrompt("");
          setCreatorInput(null);
          setCreatorSeed("");
          setWorkspaceInitialMode("link");
          setExampleSubmission(false);
          setPrompt("请帮我鉴别这篇美妆种草帖子是否由 AI 造假");
          setActiveTask("makeup");
          setActiveDimensions(allDimensions);
          setHistoryCleared(true);
          setViewingHistory(false);
          live.reset();
          setLiveFile(null);
          setRecentRuns([]);
          window.localStorage.removeItem(RECENT_RUNS_STORAGE_KEY);
          setActiveRecentId(null);
          setViewedRecentId(null);
          setArchivedScore(null);
          window.localStorage.removeItem("trulens-archived-score");
          setScreen("workspace");
        }}
        onReport={(task) => {
          setActiveRecentId(null);
          setViewedRecentId(null);
          setActiveTask(task);
          setViewingHistory(true);
          if (task === "makeup") setActiveDimensions(allDimensions);
          setScreen("result");
        }}
        onTask={(task) => {
          setActiveRecentId(null);
          setViewedRecentId(null);
          setActiveTask(task);
          setViewingHistory(true);
          if (task === "makeup") setActiveDimensions(allDimensions);
          setScreen("chat");
        }}
        onTaskReport={openTaskReport}
        onToggle={() => setSidebarCollapsed((collapsed) => !collapsed)}
      />
      {screen === "workspace" && (
        <Workspace
          accountUrl={accountUrl}
          creatorPreset={creatorSeed}
          filename={filename}
          initialMode={workspaceInitialMode}
          onAccountUrl={setAccountUrl}
          onFile={setFilename}
          onPickFile={setLiveFile}
          onHome={() => setScreen("home")}
          preset={pendingPrompt}
          onSubmitCreator={submitCreator}
          onSubmitLink={submitLink}
          onSubmitManual={submitManual}
        />
      )}
      {screen === "live" && <LiveAnalysis onBack={() => setScreen("workspace")} />}
      {screen === "chat" && activeTask === "makeup" && !viewingHistory && (
        <Chat
          activeDimensions={activeDimensions}
          filename={filename}
          isExampleSubmission={exampleSubmission}
          live={live}
          onArchiveReport={(score) => {
            setArchivedScore(score);
            setHistoryCleared(false);
            window.localStorage.setItem("trulens-archived-score", String(score));
          }}
          onFile={setFilename}
          onHome={() => setScreen("home")}
          onResult={() => {
            setActiveTask("makeup");
            setRevisedScore(null);
            setScreen("result");
          }}
          onTechnicalViewChange={setTechnicalView}
          onViewRevisedReport={(score) => {
            setActiveTask("makeup");
            setRevisedScore(score);
            setScreen("result");
          }}
          prompt={prompt}
          technicalView={technicalView}
        />
      )}
      {screen === "chat" && viewingHistory && (
        <ArchivedConversation
          onHome={() => {
            setViewingHistory(false);
            setScreen("workspace");
          }}
          onResult={() => setScreen("result")}
          task={activeTask}
        />
      )}
      {screen === "result" && activeTask === "makeup" && (
        <Result
          activeDimensions={activeDimensions}
          creatorError={creatorError}
          creatorInput={creatorInput}
          creatorLoading={creatorLoading}
          creatorResult={creatorResult}
          liveReport={viewedRecent?.report ?? live.report}
          liveSample={viewedRecent?.sample ?? live.sample}
          onAddEvidence={(code) => setActiveDimensions((current) => allDimensions.filter((dimension) => current.includes(dimension) || dimension === code))}
          onBack={() => {
            if (creatorInput) {
              setCreatorInput(null);
              setCreatorResult(null);
              setCreatorError(null);
              setCreatorLoading(false);
              setScreen("workspace");
              return;
            }
            if (viewedRecent) {
              setViewedRecentId(null);
              setActiveRecentId(null);
              setScreen("workspace");
              return;
            }
            setScreen("chat");
          }}
          onContinueOther={() => {
            setCreatorInput(null);
            setCreatorSeed("");
            setWorkspaceInitialMode("creator");
            setScreen("workspace");
          }}
          onReturnModify={(draft) => {
            setCreatorInput(null);
            setCreatorSeed(draft);
            setWorkspaceInitialMode("creator");
            setScreen("workspace");
          }}
          onTechnicalViewChange={setTechnicalView}
          scoreOverride={revisedScore}
          technicalView={technicalView}
        />
      )}
      {screen === "result" && activeTask !== "makeup" && (
        <ArchivedResult
          onBack={() => setScreen("chat")}
          onTechnicalViewChange={setTechnicalView}
          task={activeTask}
          technicalView={technicalView}
        />
      )}
    </main>
  );
}
