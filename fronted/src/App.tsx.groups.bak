function HeroSceneVisual({ scene }: { scene: HeroSceneData }) {
  if (scene.visual === "account") return <AccountHeroScene scene={scene} />;
  if (scene.visual === "reality") return <RealityHeroScene scene={scene} />;
  if (scene.visual === "voice") return <VoiceHeroScene scene={scene} />;
  if (scene.visual === "copy") return <CopyHeroScene scene={scene} />;
  if (scene.visual === "consistency") return <ConsistencyHeroScene scene={scene} />;
  if (scene.visual === "decision") return <DecisionHeroScene scene={scene} />;
  return <FinaleHeroScene />;
}

/** Idle placeholder typed out by the landing hero composer. */
const HERO_DEMO_PHRASE = "这篇种草笔记可信吗？";

function HeroComposer({
  onSubmit,
  onEngagedChange,
  expanded,
}: {
  onSubmit: (prompt: string, filename: string, example: boolean) => void;
  onEngagedChange: (engaged: boolean) => void;
  expanded: boolean;
}) {
  const textareaRef = useRef<HTMLTextAreaElement>(null);
  const idleTimerRef = useRef<number | null>(null);
  const objectUrlsRef = useRef<string[]>([]);
  const [value, setValue] = useState("");
  const [attachments, setAttachments] = useState<HeroAttachment[]>([]);
  const [interacted, setInteracted] = useState(false);
  const [focused, setFocused] = useState(false);
  const [demoText, setDemoText] = useState("");
  const [dragging, setDragging] = useState(false);
  const [shaking, setShaking] = useState(false);
  const reducedMotion = Boolean(useReducedMotion());
  const idleDemo = !interacted && !focused && !value && attachments.length === 0;
  const canSubmit = Boolean(value.trim() || attachments.length);

  useEffect(() => () => {
    objectUrlsRef.current.forEach((url) => URL.revokeObjectURL(url));
    if (idleTimerRef.current) window.clearTimeout(idleTimerRef.current);
  }, []);

  useEffect(() => {
    const textarea = textareaRef.current;
    if (!textarea) return;
    textarea.style.height = "auto";
    textarea.style.height = `${Math.min(textarea.scrollHeight, 174)}px`;
    textarea.style.overflowY = textarea.scrollHeight > 174 ? "auto" : "hidden";
  }, [value]);

  useEffect(() => {
    if (!idleDemo) {
      setDemoText("");
      return;
    }
    if (reducedMotion) {
      // No typewriter effect: show the finished phrase immediately.
      setDemoText(HERO_DEMO_PHRASE);
      return;
    }
    let cancelled = false;
    const wait = (duration: number) => new Promise((resolve) => window.setTimeout(resolve, duration));
    const run = async () => {
      while (!cancelled) {
        const phrase = HERO_DEMO_PHRASE;
        for (let index = 1; index <= phrase.length && !cancelled; index += 1) {
          setDemoText(phrase.slice(0, index));
          await wait(90);
        }
        await wait(1800);
        for (let index = phrase.length - 1; index >= 0 && !cancelled; index -= 1) {
          setDemoText(phrase.slice(0, index));
          await wait(35);
        }
      }
    };
    run();
    return () => { cancelled = true; };
  }, [idleDemo, reducedMotion]);

  const activate = () => {
    if (idleTimerRef.current) window.clearTimeout(idleTimerRef.current);
    setInteracted(true);
    setDemoText("");
    onEngagedChange(true);
  };

  const addFiles = (files: File[]) => {
    const images = files.filter((file) => file.type.startsWith("image/"));
    if (!images.length) return;
    activate();
    setAttachments((current) => [
      ...current,
      ...images.map((file) => {
        const preview = URL.createObjectURL(file);
        objectUrlsRef.current.push(preview);
        return { id: `${file.name}-${file.lastModified}-${Math.random()}`, name: file.name, kind: "image" as const, preview };
      }),
    ]);
  };

  const removeAttachment = (id: string) => {
    setAttachments((current) => {
      const target = current.find((item) => item.id === id);
      if (target?.preview?.startsWith("blob:")) URL.revokeObjectURL(target.preview);
      return current.filter((item) => item.id !== id);
    });
  };

  const addLink = (url: string) => {
    activate();
    setAttachments((current) => [
      ...current,
      { id: `link-${Date.now()}`, name: url.length > 30 ? `${url.slice(0, 30)}…` : url, kind: "link", value: url },
    ]);
  };

  const submit = () => {
    if (!canSubmit) {
      setShaking(false);
      window.requestAnimationFrame(() => setShaking(true));
      window.setTimeout(() => setShaking(false), 240);
      activate();
      textareaRef.current?.focus();
      return;
    }
    const link = attachments.find((attachment) => attachment.kind === "link");
    const writtenPrompt = value.trim();
    const linkValue = link?.value ?? link?.name;
    const prompt = writtenPrompt
      ? `${writtenPrompt}${linkValue ? `\n链接：${linkValue}` : ""}`
      : (linkValue ? `请帮我鉴别这个链接：${linkValue}` : "请帮我鉴别我上传的美妆种草内容");
    const filename = attachments.find((attachment) => attachment.kind === "image")?.name ?? "";
    onSubmit(prompt, filename, attachments.some((attachment) => attachment.example));
  };

  return (
    <div className={`hero-composer-wrap ${expanded ? "expanded" : ""}`}>
      <div
        className={`hero-composer ${focused ? "focused" : ""} ${dragging ? "dragging" : ""} ${shaking ? "shake" : ""}`}
        onDragEnter={(event) => {
          event.preventDefault();
          activate();
          setDragging(true);
        }}
        onDragLeave={(event) => {
          if (!event.currentTarget.contains(event.relatedTarget as Node)) setDragging(false);
        }}
        onDragOver={(event) => event.preventDefault()}
        onDrop={(event) => {
          event.preventDefault();
          setDragging(false);
          addFiles(Array.from(event.dataTransfer.files));
        }}
      >
        {dragging && <div className="hero-drop-overlay">松开以添加截图</div>}
        {attachments.length > 0 && (
          <div className="hero-attachments">
            {attachments.map((attachment) => (
              <span className="hero-attachment" key={attachment.id}>
                {attachment.kind === "image" ? (
                  <img alt="" src={attachment.preview} />
                ) : (
                  <i><Icon size={14}><path d="M10 13a4 4 0 0 0 5.7.1l2.4-2.4A4 4 0 0 0 12.4 5l-1.3 1.3M14 11a4 4 0 0 0-5.7-.1l-2.4 2.4A4 4 0 0 0 11.6 19l1.3-1.3" stroke="currentColor" strokeLinecap="round" strokeWidth="1.4" /></Icon></i>
                )}
                <b>{attachment.name}</b>
                {attachment.example && <em>示例</em>}
                <button aria-label="移除附件" onClick={() => removeAttachment(attachment.id)}>×</button>
              </span>
            ))}
          </div>
        )}
        <div className="hero-composer-tools">
          <div className="hero-textarea-shell">
            {idleDemo && <span aria-hidden="true" className="hero-demo-placeholder">{demoText}<i /></span>}
            <textarea
              aria-label="输入你想鉴别的种草内容"
              id="hero-trust-input"
              onBlur={() => {
                setFocused(false);
                if (!value && attachments.length === 0) {
                  idleTimerRef.current = window.setTimeout(() => {
                    setInteracted(false);
                    onEngagedChange(false);
                  }, 4000);
                }
              }}
              onChange={(event) => {
                activate();
                setValue(event.target.value);
              }}
              onFocus={() => {
                activate();
                setFocused(true);
              }}
              onKeyDown={(event) => {
                if (event.key === "Enter" && !event.shiftKey) {
                  event.preventDefault();
                  submit();
                }
              }}
              onPaste={(event) => {
                const pastedText = event.clipboardData.getData("text").trim();
                const imageFiles = Array.from(event.clipboardData.files).filter((file) => file.type.startsWith("image/"));
                if (imageFiles.length) {
                  event.preventDefault();
                  addFiles(imageFiles);
                } else if (/^https?:\/\//i.test(pastedText)) {
                  event.preventDefault();
                  addLink(pastedText);
                }
              }}
              ref={textareaRef}
              rows={1}
              value={value}
            />
          </div>
          <button
            aria-disabled={!canSubmit}
            aria-label="开始鉴别"
            className={`hero-send-button ${canSubmit ? "" : "disabled"}`}
            onClick={submit}
          >
            <Icon size={21}><path d="M12 19V5m0 0L7 10m5-5 5 5" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.7" /></Icon>
          </button>
        </div>
      </div>
      <p className="hero-promises hero-sequence-6">
        <span>每个判断都附证据</span><i /><span>数据不足时不硬判</span><i /><span>你可以反驳</span>
      </p>
    </div>
  );
}

const landingNavigation = [
  { id: "how-journey", label: "产品介绍" },
  { id: "why-trust", label: "Why Trust Us" },
  { id: "who-uses", label: "谁在用" },
  { id: "learn", label: "美妆鉴别指南" },
  { id: "faq", label: "FAQ" },
] as const;

function LandingNavigation({ onStart, onTeam }: { onStart: () => void; onTeam: () => void }) {
  // Annotated with the full union: `landingNavigation` is `as const`, so
  // inferring from `[0].id` would pin the state to the literal "how-journey"
  // and reject every other section id.
  type SectionId = (typeof landingNavigation)[number]["id"];
  const [activeSection, setActiveSection] = useState<SectionId>(landingNavigation[0].id);
  const [menuOpen, setMenuOpen] = useState(false);

  useEffect(() => {
    const updateActiveSection = () => {
      const marker = window.scrollY + 140;
      // Annotated so the later `active = item.id` (the full union) is allowed.
      let active: SectionId = landingNavigation[0].id;
      landingNavigation.forEach((item) => {
        const section = document.getElementById(item.id);
        if (section && section.offsetTop <= marker) active = item.id;
      });
      setActiveSection(active);
    };
    updateActiveSection();
    window.addEventListener("scroll", updateActiveSection, { passive: true });
    window.addEventListener("resize", updateActiveSection);
    return () => {
      window.removeEventListener("scroll", updateActiveSection);
      window.removeEventListener("resize", updateActiveSection);
    };
  }, []);

  const goToSection = (id: (typeof landingNavigation)[number]["id"]) => {
    document.getElementById(id)?.scrollIntoView({
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      block: "start",
    });
    setActiveSection(id);
    setMenuOpen(false);
  };

  return (
    <nav aria-label="主要导航" className="home-nav cinematic-nav landing-navigation">
      <button className="logo landing-brand" onClick={() => window.scrollTo({ top: 0 })}>
        <img alt="TruLens" src="/trulens-nav-logo.png" />
      </button>
      <div className="landing-nav-desktop">
        <div className="landing-nav-links">
          {landingNavigation.map((item) => (
            <button
              aria-current={activeSection === item.id ? "page" : undefined}
              className={activeSection === item.id ? "active" : ""}
              key={item.id}
              onClick={() => goToSection(item.id)}
            >
              {item.label}
            </button>
          ))}
        </div>
        <button className="landing-team-entry" onClick={onTeam}>团队版</button>
        <button className="landing-nav-cta" onClick={onStart}>开始核验 <span>↗</span></button>
      </div>
      <div className="landing-nav-mobile">
        <button className="landing-nav-mobile-cta" onClick={onStart}>开始核验 <span>↗</span></button>
        <button
          aria-expanded={menuOpen}
          aria-label={menuOpen ? "关闭导航菜单" : "打开导航菜单"}
          className={`landing-menu-toggle ${menuOpen ? "open" : ""}`}
          onClick={() => setMenuOpen((open) => !open)}
        >
          <i /><i />
        </button>
      </div>
      {menuOpen && (
        <div className="landing-mobile-menu">
          {landingNavigation.map((item) => (
            <button
              aria-current={activeSection === item.id ? "page" : undefined}
              className={activeSection === item.id ? "active" : ""}
              key={item.id}
              onClick={() => goToSection(item.id)}
            >
              {item.label}<span>→</span>
            </button>
          ))}
          <button onClick={onTeam}>团队版<span>→</span></button>
        </div>
      )}
    </nav>
  );
}

function TruLensHero({
  onSubmit,
}: {
  onSubmit: (prompt: string, filename: string, example: boolean) => void;
}) {
  const reducedMotion = Boolean(useReducedMotion());
  const elapsedRef = useRef(0);
  const [activeIndex, setActiveIndex] = useState(0);
  const [progress, setProgress] = useState(0);
  const [composerEngaged, setComposerEngaged] = useState(false);
  const paused = false;
  const activeScene = heroScenes[activeIndex];

  const goToScene = (index: number) => {
    elapsedRef.current = 0;
    setProgress(0);
    setActiveIndex((index + heroScenes.length) % heroScenes.length);
  };

  useEffect(() => {
    let animationFrame = 0;
    let previousTime = performance.now();
    const tick = (time: number) => {
      const delta = time - previousTime;
      previousTime = time;
      if (!paused) {
        elapsedRef.current += delta;
        if (elapsedRef.current >= HERO_SCENE_DURATION) {
          elapsedRef.current = 0;
          setProgress(0);
          setActiveIndex((current) => (current + 1) % heroScenes.length);
        } else {
          setProgress(elapsedRef.current / HERO_SCENE_DURATION);
        }
      }
      animationFrame = window.requestAnimationFrame(tick);
    };
    animationFrame = window.requestAnimationFrame(tick);
    return () => window.cancelAnimationFrame(animationFrame);
  }, [paused]);

  useEffect(() => {
    const handleKey = (event: KeyboardEvent) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      if (event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLInputElement) return;
      event.preventDefault();
      elapsedRef.current = 0;
      setProgress(0);
      setActiveIndex((current) => event.key === "ArrowRight"
        ? (current + 1) % heroScenes.length
        : (current - 1 + heroScenes.length) % heroScenes.length);
    };
    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, []);

  return (
    <section
      aria-label="TruLens 产品能力演示"
      className={`cinematic-hero scene-${activeScene.id} ${composerEngaged ? "composer-engaged" : ""}`}
    >
      <AnimatePresence initial={false}>
        <motion.div
          animate={{ opacity: 1, scale: 1 }}
          className="hero-scene-background"
          exit={{ opacity: 0 }}
          initial={{ opacity: 0, scale: reducedMotion ? 1 : 1.018 }}
          key={activeScene.id}
          transition={{ duration: reducedMotion ? 0.2 : 0.6, ease: [0.22, 0.7, 0.2, 1] }}
        >
          <HeroSceneVisual scene={activeScene} />
        </motion.div>
      </AnimatePresence>
      <div className="cinematic-title-shell">
        <AnimatePresence mode="wait">
          <motion.div
            animate={{ opacity: 1, y: 0 }}
            className={`cinematic-title ${activeScene.visual === "finale" ? "finale-title" : ""}`}
            exit={{ opacity: 0, y: reducedMotion ? 0 : -8 }}
            initial={{ opacity: 0, y: reducedMotion ? 0 : 18 }}
            key={`title-${activeScene.id}`}
            transition={{ duration: reducedMotion ? 0.2 : 0.6, ease: [0.22, 0.7, 0.2, 1] }}
          >
            {activeScene.visual === "finale" ? (
              <h1>{activeScene.action}</h1>
            ) : (
              <h1>
                <span>TruLens 替你</span>
                <em><HeroActionIcon name={activeScene.icon} />{activeScene.action}</em>
                <span>{activeScene.result}</span>
              </h1>
            )}
          </motion.div>
        </AnimatePresence>
      </div>
      <div className="cinematic-controls">
        <div aria-label="场景进度" className="hero-scene-progress">
          {heroScenes.map((scene, index) => (
            <button
              aria-label={`切换到${scene.dimension}`}
              className={index === activeIndex ? "active" : ""}
              key={scene.id}
              onClick={() => goToScene(index)}
            >
              <i style={{ transform: `scaleX(${index < activeIndex ? 1 : index === activeIndex ? progress : 0})` }} />
            </button>
          ))}
        </div>
        <HeroComposer expanded={activeScene.visual === "finale"} onEngagedChange={setComposerEngaged} onSubmit={onSubmit} />
      </div>
    </section>
  );
}

