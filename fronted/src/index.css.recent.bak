@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;1,500&display=swap");
@import "tailwindcss";

:root {
  color: #242233;
  background: #f8f7fb;
  font-family: "Noto Sans SC", Arial, sans-serif;
  font-synthesis: none;
  --ink: #242233;
  --muted: #777486;
  --line: rgba(39, 34, 57, 0.11);
  --serif: "Playfair Display", "Songti SC", serif;
  --mono: "DM Mono", monospace;
  --hero-bg: #f7f5fc;
  --hero-ink: #1f1b33;
  --hero-purple: #7b6bb0;
  --hero-lilac: #e9e4f7;
  --hero-success: #7fa38b;
  --hero-warning: #d9b76b;
  --hero-risk: #c98b93;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: #f8f7fb; }
button, textarea, input { font: inherit; }
button { color: inherit; cursor: pointer; }
button:focus-visible, textarea:focus-visible { outline: 2px solid #8c7cf6; outline-offset: 2px; }

.home { min-height: 100vh; overflow-x: clip; background: #faf9fc; }
.home-nav { height: 76px; padding: 0 clamp(24px, 5vw, 80px); display: grid; grid-template-columns: 1fr auto; align-items: center; border-bottom: 1px solid rgba(30,26,45,.08); position: absolute; inset: 0 0 auto; z-index: 20; }
.logo { border: 0; background: transparent; display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 17px; letter-spacing: .07em; padding: 0; justify-self: start; }
.sidebar .logo>img { width:auto;height:52px;display:block;object-fit:contain }
.brand-name { font-weight: 600; }
.logo-mark { width: 25px; height: 25px; border-radius: 50%; display: grid; place-items: center; color: white; background: #262434; box-shadow: 0 4px 14px rgba(32,28,47,.2); }
.home-nav-center { display: flex; gap: 34px; }
.home-nav-center button { background: none; border: 0; font-size: 13px; color: #6e6a7a; padding: 12px 4px; }
.nav-cta { justify-self: end; border: 1px solid rgba(36,34,51,.2); background: rgba(255,255,255,.55); border-radius: 999px; padding: 10px 16px 10px 20px; display: flex; gap: 12px; align-items: center; font-size: 12px; backdrop-filter: blur(10px); }

.hero { min-height: 100vh; position: relative; padding-top: 118px; text-align: center; background: radial-gradient(circle at 50% 40%, #fff 0 12%, transparent 45%), linear-gradient(180deg,#eff3ff 0%,#fbf5f3 41%,#fbfafc 75%); }
.hero::after { content: ""; position: absolute; inset: 0; opacity: .18; pointer-events: none; background-image: linear-gradient(rgba(50,45,70,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(50,45,70,.08) 1px,transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom,transparent 10%,black 45%,transparent 90%); }
.hero-glow { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .48; }
.glow-one { width: 370px; height: 210px; background: #f2c7de; top: 31%; left: 11%; }
.glow-two { width: 400px; height: 240px; background: #cbd9ff; top: 33%; right: 8%; }
.eyebrow { display: inline-flex; align-items: center; gap: 9px; padding: 8px 13px; border-radius: 99px; background: rgba(255,255,255,.65); box-shadow: inset 0 0 0 1px rgba(50,45,70,.07); font: 10px var(--mono); letter-spacing: .08em; position: relative; z-index: 2; }
.live-dot,.status-dot { width: 6px; height: 6px; border-radius: 50%; background: #7bddb4; box-shadow: 0 0 0 4px rgba(123,221,180,.16); }
.hero h1 { margin: 21px auto 14px; font: 500 clamp(53px,6vw,92px)/.92 var(--serif); letter-spacing: -.055em; position: relative; z-index: 2; }
.hero h1 em { color: #8177b9; font-weight: 500; }
.hero-sub { margin: 0; color: #6e6a79; font-size: 14px; line-height: 1.9; font-weight: 300; position: relative; z-index: 2; }
.hero-cta { margin-top: 21px; border: 0; border-radius: 999px; color: white; background: #282535; padding: 6px 6px 6px 23px; display: inline-flex; align-items: center; gap: 19px; font-size: 13px; position: relative; top: -10px; z-index: 5; box-shadow: 0 12px 30px rgba(38,34,56,.2); transition: transform .25s, box-shadow .25s; }
.hero-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 34px rgba(38,34,56,.26); }
.circle-arrow { width: 35px; height: 35px; display: grid; place-items: center; background: white; color: #282535; border-radius: 50%; }
.portrait-stage { width: clamp(430px,46vw,690px); height: min(43vw,570px); min-height: 390px; margin: 10px auto 0; position: relative; z-index: 1; }
.portrait-stage video { height: 100%; max-width: 75%; object-fit: cover; object-position: center 16%; mask-image: linear-gradient(to bottom,#000 75%,transparent 99%); filter: saturate(.77) contrast(.93); }
.portrait-stage::before { content:""; width: 56%; height: 22%; border-radius: 50%; position: absolute; left: 22%; top: 27%; z-index: 3; background: linear-gradient(90deg,rgba(182,211,255,.52),rgba(255,199,213,.4),rgba(203,183,255,.45)); filter: blur(8px); mix-blend-mode: color; }
.portrait-scene { position: absolute; z-index: 6; left: 50%; bottom: 14%; transform: translateX(-50%); width: max-content; max-width: 86%; padding: 10px 14px 8px; border: 1px solid rgba(255,255,255,.46); border-radius: 11px; color: #fff; background: rgba(34,30,47,.48); backdrop-filter: blur(12px); box-shadow: 0 10px 30px rgba(36,29,54,.15); text-align: center; }
.portrait-scene > span { display: block; font: 400 clamp(10px,1vw,13px)/1.4 "Noto Sans SC",sans-serif; letter-spacing: .015em; animation: scene-in .55s ease both; }
.scene-progress { display: flex; justify-content: center; gap: 4px; margin-top: 7px; }
.scene-progress i { display: block; width: 12px; height: 2px; border-radius: 99px; background: rgba(255,255,255,.3); transition: width .35s ease,background .35s ease; }
.scene-progress i.active { width: 25px; background: rgba(255,255,255,.9); }
.orbit { position: absolute; border: 1px solid rgba(83,75,108,.18); border-radius: 50%; width: 115%; height: 49%; left: -7.5%; top: 48%; transform: rotate(-6deg); z-index: 4; pointer-events: none; }
.orbit-b { transform: rotate(8deg); top: 51%; border-color: rgba(143,126,199,.13); }
.scan-line { position: absolute; left: 21%; right: 21%; top: 54%; height: 1px; background: linear-gradient(90deg,transparent,#8b7fc1,transparent); z-index: 4; box-shadow: 0 0 14px #a995f0; }
.scan-label { position: absolute; z-index: 5; padding: 8px 10px; border: 1px solid rgba(54,48,72,.1); border-radius: 8px; background: rgba(255,255,255,.67); backdrop-filter: blur(10px); display: flex; flex-direction: column; text-align: left; gap: 2px; box-shadow: 0 8px 25px rgba(49,41,71,.06); }
.scan-label span { font: 8px var(--mono); color: #807a8d; }
.scan-label strong { font: 500 12px var(--mono); }
.scan-label-a { top: 39%; left: -3%; }.scan-label-b { top: 30%; right: 3%; }.scan-label-c { bottom: 15%; right: -4%; }
.hero-metrics { position: absolute; bottom: 24px; left: 6%; right: 6%; z-index: 6; display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid rgba(37,32,53,.11); }
.hero-metrics div { text-align: left; padding: 15px 22px; border-right: 1px solid rgba(37,32,53,.1); display: grid; grid-template-columns: auto 1fr; column-gap: 11px; }
.hero-metrics div:last-child { border: 0; }
.hero-metrics span { grid-row: 1/3; font: 10px var(--mono); color: #8e859a; padding-top: 3px; }
.hero-metrics strong { font-size: 12px; font-weight: 500; }
.hero-metrics small { font-size: 10px; color: #8c8793; margin-top: 2px; }

.hero { min-height: 980px; padding-top: 96px; background: radial-gradient(circle at 50% 67%,rgba(210,217,255,.72),transparent 27%),radial-gradient(circle at 26% 72%,rgba(249,216,222,.64),transparent 29%),linear-gradient(155deg,#fbfaff 0%,#f4f5ff 52%,#faf6f8 100%); }
.hero::after { opacity:.12;background-size:72px 72px;mask-image:linear-gradient(to bottom,transparent 5%,black 48%,transparent 93%); }
.hero .eyebrow { margin-top:0;background:rgba(255,255,255,.62);box-shadow:inset 0 0 0 1px rgba(78,65,108,.08),0 7px 25px rgba(67,51,97,.05); }
.hero .live-dot { background:#bca9f0;box-shadow:0 0 0 4px rgba(188,169,240,.16); }
.hero .cover-title { margin:12px auto 8px;display:flex;flex-direction:column;align-items:center;gap:1px;letter-spacing:0;line-height:1; }
.cover-title>span { position:relative;font:500 clamp(58px,6vw,88px)/.95 var(--serif);letter-spacing:-.055em;color:#24213b; }
.cover-title>span sup { position:absolute;right:-31px;top:3px;color:#7f6bc2;filter:drop-shadow(0 5px 11px rgba(111,89,169,.2)); }
.cover-title>strong { font:500 clamp(29px,3.3vw,48px)/1.05 var(--serif);letter-spacing:-.045em;color:#28243d; }
.hero .cover-title>em { margin-top:8px;font:italic 500 clamp(25px,2.9vw,42px)/1.1 var(--serif);letter-spacing:-.035em;color:#8877c4; }
.hero .hero-sub { margin-top:12px;font-size:12px;line-height:1.7;color:#7b7687; }
.hero .hero-cta { top:0;margin-top:16px;padding:6px 6px 6px 25px;background:linear-gradient(110deg,#28233f,#41345f);box-shadow:0 14px 35px rgba(55,43,83,.2); }
.hero .hero-cta:hover { transform:translateY(-3px) scale(1.015);box-shadow:0 19px 42px rgba(55,43,83,.27); }
.hero .circle-arrow { width:38px;height:38px;box-shadow:0 2px 9px rgba(32,26,47,.12); }
.cover-stage { width:min(880px,88vw);height:390px;margin:4px auto 0;position:relative;z-index:3; }
.cover-stage::before { content:"";position:absolute;left:50%;bottom:36px;width:72%;height:54%;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgba(255,255,255,.93) 0,rgba(225,218,252,.58) 40%,transparent 72%);filter:blur(10px); }
.cover-orbit { position:absolute;left:50%;top:48%;width:110%;height:48%;border:1px solid rgba(123,106,174,.19);border-radius:50%;transform:translate(-50%,-50%) rotate(-5deg); }
.cover-orbit.orbit-two { width:88%;height:34%;top:66%;transform:translate(-50%,-50%) rotate(5deg);border-color:rgba(219,159,182,.25); }
.cover-platform { position:absolute;z-index:1;left:50%;bottom:18px;width:55%;height:62px;transform:translateX(-50%);border:1px solid rgba(127,104,184,.19);border-radius:50%;background:radial-gradient(ellipse,rgba(255,255,255,.75),rgba(198,185,240,.17) 55%,transparent 72%);box-shadow:0 14px 42px rgba(92,71,137,.11),inset 0 8px 25px rgba(255,255,255,.7); }
.cover-card { position:absolute;z-index:5;padding:17px 18px;border:1px solid rgba(255,255,255,.9);border-radius:18px;background:rgba(255,255,255,.7);backdrop-filter:blur(22px);box-shadow:0 20px 55px rgba(62,49,86,.12);text-align:left;transition:transform .35s ease,box-shadow .35s ease; }
.cover-card:hover { transform:translateY(-5px);box-shadow:0 27px 65px rgba(62,49,86,.16); }
.cover-card-heading { display:flex;align-items:center;gap:8px;color:#4c4368; }
.cover-card-heading strong { font-size:10px;font-weight:500; }
.cover-card-icon { width:25px;height:25px;display:grid;place-items:center;border-radius:8px;background:#eee9f8;color:#70619a; }
.cover-card ul { list-style:none;padding:0;margin:12px 0 0;display:flex;flex-direction:column;gap:7px; }
.cover-card li { position:relative;padding-left:15px;font-size:7px;color:#76717d; }
.cover-card li.account-finding { padding:0 0 0 15px; }
.cover-card li::before { content:"✓";position:absolute;left:0;top:-1px;width:10px;height:10px;border-radius:50%;display:grid;place-items:center;background:#e4f3ed;color:#579073;font-size:6px; }
.cover-card p { margin:11px 0 0;font-size:9px;color:#5e5867; }
.image-analysis-card { left:2%;top:104px;width:245px; }
.cover-score-row { display:flex;align-items:center;justify-content:space-between;margin-top:11px; }
.cover-score-row>span { display:flex;flex-direction:column;gap:2px; }
.cover-score-row strong { font:500 34px/1 var(--serif);color:#2c273a; }
.cover-score-row small { font-size:7px;color:#8f8995; }
.cover-score-row>i { width:49px;height:49px;border-radius:50%;background:conic-gradient(#7edbbd 0 88%,#e5eee9 88%);display:grid;place-items:center; }
.cover-score-row>i b { width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.92); }
.cover-post-card { position:absolute;z-index:4;left:50%;bottom:51px;width:190px;height:286px;padding:10px;transform:translateX(-50%);border:1px solid rgba(255,255,255,.92);border-radius:20px;background:rgba(255,255,255,.78);box-shadow:0 23px 60px rgba(69,50,101,.16);backdrop-filter:blur(16px); }
.cover-post-image { height:222px;border-radius:13px;overflow:hidden;position:relative;background:#eeeaf1; }
.cover-post-image img { width:100%;height:100%;object-fit:cover;object-position:center 24%;filter:saturate(.72) contrast(.95); }
.cover-post-image>span { position:absolute;right:7px;top:7px;padding:4px 6px;border-radius:99px;background:rgba(255,255,255,.72);font:6px var(--mono);color:#77717e; }
.cover-post-meta { height:44px;display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;padding:5px 3px 0; }
.cover-post-meta>i { width:29px;height:29px;border-radius:50%;background:linear-gradient(135deg,#d8cbde,#f1d6d6); }
.cover-post-meta>span { display:flex;flex-direction:column;gap:5px; }
.cover-post-meta b { display:block;height:5px;border-radius:9px;background:#e8e3eb; }
.cover-post-meta b:last-child { width:65%; }
.cover-post-meta>small { color:#746595; }
.cover-conversation-card { width:230px;height:304px;padding:11px;display:flex;flex-direction:column;text-align:left;background:rgba(255,255,255,.82); }
.cover-conversation-head { display:flex;align-items:center;gap:7px;padding:1px 2px 9px;border-bottom:1px solid rgba(50,42,65,.08); }
.cover-conversation-head>span { width:24px;height:24px;border-radius:8px;background:#2f2942;color:#fff;display:grid;place-items:center; }
.cover-conversation-head>div { display:flex;flex-direction:column;gap:2px; }
.cover-conversation-head strong { font-size:8px;font-weight:500; }
.cover-conversation-head small { display:flex;align-items:center;gap:4px;font-size:6px;color:#928b98; }
.cover-conversation-head small i { width:4px;height:4px;border-radius:50%;background:#77b995;box-shadow:0 0 0 3px rgba(119,185,149,.12); }
.cover-chat-stream { flex:1;display:flex;flex-direction:column;gap:6px;padding:9px 0 7px;overflow:hidden; }
.cover-chat-bubble { max-width:87%;padding:6px 8px;border-radius:9px;animation:message-in .45s ease both; }
.cover-chat-bubble small { display:block;font:5px var(--mono);margin-bottom:2px;opacity:.68; }
.cover-chat-bubble p { margin:0;font-size:6px;line-height:1.45; }
.cover-chat-bubble.user { align-self:flex-end;background:#332d46;color:#fff;border-bottom-right-radius:3px; }
.cover-chat-bubble.agent { align-self:flex-start;background:#f0ebf7;color:#51475f;border-bottom-left-radius:3px; }
.cover-chat-bubble:nth-child(2){animation-delay:.12s}.cover-chat-bubble:nth-child(3){animation-delay:.24s}.cover-chat-bubble:nth-child(4){animation-delay:.36s}
.cover-chat-input { height:29px;flex:none;border:1px solid rgba(54,46,70,.1);border-radius:9px;background:rgba(249,247,251,.9);display:flex;align-items:center;justify-content:space-between;padding:0 5px 0 8px; }
.cover-chat-input>span { font-size:6px;color:#aaa3ae; }
.cover-chat-input>i { width:20px;height:20px;border-radius:7px;background:#342e46;color:#fff;display:grid;place-items:center;font-style:normal; }
.content-analysis-card { right:0;top:69px;width:270px; }
.content-analysis-card ul { margin-top:9px; }
.reasoning-card { right:6%;bottom:43px;width:235px; }
.reasoning-meter { height:5px;margin:11px 0 7px;border-radius:99px;background:#e6e2eb;overflow:hidden; }
.reasoning-meter i { display:block;width:84%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#9b8ec6,#84d9bf); }
.reasoning-card>small { font-size:7px;color:#8f8896; }
.cover-scene-caption { position:relative;z-index:5;width:min(710px,80vw);margin:-1px auto 0;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:17px;color:#8274ab; }
.cover-scene-caption>i { height:1px;background:linear-gradient(90deg,transparent,rgba(113,94,159,.36)); }
.cover-scene-caption>i:last-child { transform:scaleX(-1); }
.cover-scene-caption>span { font:500 9px var(--mono);letter-spacing:.08em;animation:scene-in .55s ease both; }

.agent-intro-section{position:relative;overflow:hidden;min-height:min(960px,100vh);padding:88px 5% 65px;text-align:center;background:radial-gradient(circle at 50% 57%,rgba(255,255,255,.9),transparent 31%),radial-gradient(circle at 22% 58%,rgba(244,207,220,.42),transparent 27%),radial-gradient(circle at 80% 48%,rgba(204,217,255,.52),transparent 29%),linear-gradient(155deg,#f8f6fd,#f5f3fa 58%,#faf6f7)}.agent-intro-section::before,.agent-intro-section::after{content:"";position:absolute;left:50%;top:59%;border:1px solid rgba(117,98,165,.11);border-radius:50%;pointer-events:none}.agent-intro-section::before{width:980px;height:370px;transform:translate(-50%,-50%) rotate(-5deg)}.agent-intro-section::after{width:760px;height:270px;transform:translate(-50%,-50%) rotate(7deg)}.agent-intro-heading{position:relative;z-index:2}.agent-intro-heading h2{margin:27px 0 13px;font:500 clamp(44px,5vw,64px)/1 var(--serif);letter-spacing:-.045em;color:#292535}.agent-intro-heading p{margin:0;color:#7d7784;font-size:18px}.agent-intro-heading p span{color:#8877c4}.agent-intro-demo{position:relative;z-index:3;width:min(860px,100%);margin:45px auto 0}.agent-prompt-card{position:relative;min-height:205px;padding:24px 25px 18px;border:1px solid rgba(139,119,190,.22);border-radius:32px;background:rgba(250,249,251,.9);box-shadow:0 28px 80px rgba(62,49,86,.13);backdrop-filter:blur(22px);display:flex;flex-direction:column;text-align:left}.agent-prompt-attachments{min-height:36px;display:flex;flex-wrap:wrap;gap:8px}.agent-prompt-attachments>span{height:34px;padding:0 10px 0 7px;border:1px solid rgba(54,47,69,.07);border-radius:12px;background:#f0eef2;display:flex;align-items:center;gap:7px;color:#69636f;font-size:9px;opacity:0;transform:translateY(9px);transition:opacity .3s ease,transform .3s ease}.agent-prompt-attachments>span.visible{opacity:1;transform:translateY(0)}.agent-prompt-attachments i{width:23px;height:23px;border-radius:7px;background:#fff;color:#78699b;display:grid;place-items:center;font-style:normal}.agent-prompt-text{flex:1;min-height:74px;padding:24px 5px 12px;color:#37323f;font-size:20px;line-height:1.6}.typing-cursor{display:inline-block;width:1px;height:1.1em;margin-left:3px;vertical-align:-.15em;background:#6e618b;animation:agent-cursor-blink .85s steps(1) infinite}.agent-prompt-actions{position:relative;display:flex;align-items:center;justify-content:space-between}.agent-add-button,.agent-send-button{padding:0;border:0;display:grid;place-items:center}.agent-add-button{width:39px;height:39px;border:1px solid rgba(54,47,69,.1);border-radius:50%;background:#f4f2f5;color:#78727e}.agent-add-button:hover{background:#ebe8ee;color:#4f4956}.agent-send-button{width:48px;height:48px;border-radius:50%;background:#2f2a40;color:#fff;box-shadow:0 10px 25px rgba(47,42,64,.2);transition:transform .22s ease,box-shadow .22s ease}.agent-send-button:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(47,42,64,.25)}.agent-send-button.pulse{animation:agent-send-press .44s cubic-bezier(.2,.8,.2,1)}.agent-upload-hint{position:absolute;left:48px;bottom:4px;padding:7px 10px;border:1px solid rgba(255,255,255,.86);border-radius:9px;background:rgba(255,255,255,.94);box-shadow:0 9px 24px rgba(52,42,69,.1);color:#77717e;font-size:7px;animation:evidence-pop .2s ease both}.agent-intro-reply-live{min-height:132px;margin-top:14px}.agent-intro-reply{position:relative;width:100%;min-height:118px;padding:16px 20px;border:1px solid rgba(255,255,255,.92);border-radius:24px;background:rgba(255,255,255,.92);box-shadow:0 18px 55px rgba(60,47,87,.1);display:grid;grid-template-columns:auto 1fr;align-items:center;gap:18px;text-align:left;animation:agent-reply-in .3s ease both}.agent-reply-score{width:88px;height:88px;border-radius:50%;display:grid;place-items:center;position:relative}.agent-reply-score::before{content:"";position:absolute;inset:6px;border-radius:50%;background:#fff}.agent-reply-score>div{position:relative;z-index:1;text-align:center;display:flex;flex-direction:column}.agent-reply-score strong{font:500 34px/1 var(--serif)}.agent-reply-score small{margin-top:3px;font:6px var(--mono);color:#8d8692}.agent-intro-reply.caution .agent-reply-score{background:conic-gradient(#b9965b 0 calc(var(--agent-score)*1%),rgba(185,150,91,.14) 0)}.agent-intro-reply.risk .agent-reply-score{background:conic-gradient(#b56f76 0 calc(var(--agent-score)*1%),rgba(181,111,118,.14) 0)}.agent-reply-copy{display:flex;flex-direction:column;align-items:flex-start;gap:9px}.agent-reply-copy>span{padding:6px 9px;border-radius:99px;font-size:8px}.caution .agent-reply-copy>span{background:#f4e8d5;color:#765b31}.risk .agent-reply-copy>span{background:#f2dddf;color:#7e4d53}.agent-reply-copy p{max-width:610px;margin:0;color:#5f5966;font-size:10px;line-height:1.7}.agent-intro-reply>small{position:absolute;right:16px;bottom:11px;font:6px var(--mono);color:#aaa4ae}.agent-example-row{min-height:35px;margin-top:6px;display:flex;align-items:center;justify-content:center;gap:10px}.agent-example-row>small{color:#99929e;font-size:8px;white-space:nowrap}.agent-example-row>div{display:flex;flex-wrap:wrap;justify-content:center;gap:7px}.agent-example-row button{min-height:31px;padding:6px 11px;border:1px solid rgba(139,119,190,.2);border-radius:99px;background:rgba(255,255,255,.78);color:#726b79;font-size:8px;transition:background .25s ease,color .25s ease,transform .25s ease}.agent-example-row button:hover{transform:translateY(-1px)}.agent-example-row button.active{border-color:#2f2a40;background:#2f2a40;color:#fff}.agent-intro-note{position:relative;z-index:2;margin:20px 0 0;color:#99929e;font-size:8px}.agent-intro-next{position:relative;z-index:2;margin-top:30px;padding:7px 2px;border:0;border-bottom:1px solid rgba(55,47,68,.3);background:transparent;display:inline-flex;align-items:center;gap:8px;color:#5f5867;font-size:10px}.agent-intro-next svg{animation:agent-arrow-float 1.8s ease-in-out infinite}

.story-scroller { height:100vh;min-height:620px;position:relative;background:#f8f7fa; }
.story-sticky { position:relative;top:0;height:100vh;min-height:620px;overflow:hidden;display:grid;grid-template-columns:minmax(310px,.8fr) minmax(470px,1.2fr);align-items:center;gap:clamp(40px,7vw,110px);padding:7vh clamp(55px,8vw,130px) 7vh clamp(90px,10vw,160px);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:radial-gradient(circle at 78% 46%,rgba(255,255,255,.95),transparent 36%),linear-gradient(145deg,#f9f8fb,#f6f2f4);transition:background 1s ease}
.story-scene-1 .story-sticky { background: radial-gradient(circle at 78% 46%,rgba(245,249,255,.95),transparent 38%),linear-gradient(145deg,#faf9fb,#f1f4f8); }
.story-scene-2 .story-sticky { background: radial-gradient(circle at 78% 46%,rgba(250,243,247,.96),transparent 38%),linear-gradient(145deg,#faf9fb,#f4eff3); }
.story-scene-3 .story-sticky { background: radial-gradient(circle at 78% 46%,rgba(242,239,252,.96),transparent 38%),linear-gradient(145deg,#faf9fb,#efedf7); }
.story-scene-4 .story-sticky { background: radial-gradient(circle at 78% 46%,rgba(240,248,245,.9),transparent 38%),linear-gradient(180deg,#f8f8fa 0%,#f1effa 100%); }
.story-ambient { position: absolute; border-radius: 50%; filter: blur(85px); opacity: .34; transition: background 1s ease; pointer-events: none; will-change: transform; }
.ambient-one { width: 420px;height:420px;right:11%;top:18%;background:#d7dffa; }.ambient-two { width:340px;height:280px;right:1%;bottom:3%;background:#f0ceda; }
.story-scene-1 .ambient-one{background:#beddef}.story-scene-1 .ambient-two{background:#e4d7f1}
.story-scene-2 .ambient-one{background:#e7cad8}.story-scene-2 .ambient-two{background:#cbd8f4}
.story-scene-3 .ambient-one{background:#d5c9f1}.story-scene-3 .ambient-two{background:#e9d4d2}
.story-scene-4 .ambient-one{background:#cce3d8}.story-scene-4 .ambient-two{background:#ddd5ef}
.story-rail { position:absolute;left:30px;top:9%;bottom:9%;display:flex;flex-direction:column;align-items:center;gap:16px;color:#8c8693; }
.story-rail>span { font:8px var(--mono);letter-spacing:.09em;writing-mode:vertical-rl;transform:rotate(180deg); }
.story-rail>div { width:1px;flex:1;background:rgba(46,39,62,.11);position:relative;overflow:hidden; }
.story-rail>div i { position:absolute;left:0;top:0;width:1px;background:#655a7b;transition:height .15s linear; }
.story-rail small { font:10px var(--mono);color:#504a59; }
.story-copy-stack { position:relative;z-index:3;align-self:center;height:min(58vh,490px); }
.story-copy-layer { position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;will-change:opacity,transform,filter;transition-property:opacity,transform,filter;transition-duration:.72s;transition-timing-function:cubic-bezier(.2,.75,.2,1); }
.story-step { display:inline-flex;align-self:flex-start;padding:7px 10px;border:1px solid var(--line);border-radius:99px;background:rgba(255,255,255,.5);font:8px var(--mono);color:#817a8a;letter-spacing:.08em; }
.story-copy-layer>small { display:block;margin-top:26px;font:9px var(--mono);letter-spacing:.12em;color:#847d8c; }
.story-copy-layer h2 { font:500 clamp(38px,4.2vw,66px)/1.08 var(--serif);letter-spacing:-.045em;margin:15px 0 22px; }
.story-copy-layer h2 span { display:block; }
.story-copy-layer p { max-width:430px;font-size:12px;line-height:1.9;color:#746e7b;font-weight:300; }
.story-dots { position:absolute;z-index:4;left:0;bottom:0;display:flex;gap:7px; }
.story-dots i { width:18px;height:2px;border-radius:99px;background:#d8d4dc;transition:width .5s ease,background .5s ease; }
.story-dots i.active { width:42px;background:#61596c; }
.story-visual-shell { position:relative;z-index:2;width:min(100%,640px);height:min(72vh,650px);min-height:500px;justify-self:center;display:grid;place-items:center; }
.story-visual-shell::before,.story-visual-shell::after { content:"";position:absolute;border:1px solid rgba(62,52,83,.08);border-radius:50%;width:94%;aspect-ratio:1; }
.story-visual-shell::after { width:73%;border-color:rgba(115,98,155,.09); }
.story-visual-stack { position:relative;width:100%;height:100%; }
.story-visual-layer { position:absolute;inset:0;display:grid;place-items:center;will-change:opacity,transform,filter;transition-property:opacity,transform,filter;transition-duration:.82s;transition-timing-function:cubic-bezier(.16,.76,.22,1); }
.story-progress-label { position:absolute;z-index:5;right:28px;bottom:22px;display:grid;grid-template-columns:auto 110px auto;gap:9px;align-items:center;color:#918b97; }
.story-progress-label>span { font:8px var(--mono);color:#5f5867; }
.story-progress-label>i { width:110px;height:1px;background:rgba(55,47,68,.12);overflow:hidden; }
.story-progress-label>i b { display:block;height:100%;background:#756b80;transition:width .1s linear; }
.story-progress-label>small { font:6px var(--mono);letter-spacing:.1em; }

.story-post { width:330px;padding:12px;border-radius:22px;background:rgba(255,255,255,.84);border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 80px rgba(53,43,76,.13);backdrop-filter:blur(20px);transform:rotate(1.5deg);position:relative;z-index:2; }
.post-browser{height:29px;display:flex;align-items:center;gap:4px;padding:0 4px}.post-browser>span{width:5px;height:5px;border-radius:50%;background:#ded9e1}.post-browser small{margin-left:auto;font:6px var(--mono);color:#aaa4ae}
.post-image{height:285px;border-radius:14px;overflow:hidden;position:relative}.post-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.83)}.post-image-tag{position:absolute;bottom:7px;left:7px;padding:5px 7px;border-radius:6px;background:rgba(255,255,255,.76);backdrop-filter:blur(7px);font-size:7px}
.post-copy{display:flex;gap:8px;align-items:center;padding:11px 4px 7px}.mock-avatar{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#bfb1e4,#edcdd3)}.post-copy>div{display:flex;flex-direction:column;gap:3px}.post-copy strong{font-size:9px}.post-copy span{font-size:6px;color:#9b95a0}
.post-lines{padding:4px;display:flex;flex-direction:column;gap:5px}.post-lines i{height:4px;border-radius:9px;background:#eeeaf0}.post-lines i:nth-child(2){width:91%}.post-lines i:nth-child(3){width:64%}
.reading-line{height:2px;background:#ece8ef;margin:11px 4px 6px;overflow:hidden}.reading-line span{display:block;width:68%;height:100%;background:linear-gradient(90deg,#9b8fc1,#cf9faa);animation:read-progress 2.4s ease-in-out infinite}.reading-caption{font:6px var(--mono);color:#9992a0;margin-left:4px}

.visual-quiz-section{position:relative;min-height:900px;overflow:hidden;background:radial-gradient(circle at 76% 45%,rgba(255,255,255,.93),transparent 32%),radial-gradient(circle at 15% 72%,rgba(244,207,220,.44),transparent 28%),linear-gradient(145deg,#f8f7fb,#f2f1fa 56%,#f7f1f4);display:grid;grid-template-columns:40% 60%;align-items:center}.visual-quiz-copy{position:relative;z-index:3;padding:80px 6vw 80px 9vw}.visual-quiz-copy>small{display:block;margin-top:27px;font:9px var(--mono);letter-spacing:.12em;color:#847d8c}.visual-quiz-copy h2{margin:15px 0 20px;font:500 clamp(45px,4.5vw,64px)/1.08 var(--serif);letter-spacing:-.045em}.visual-quiz-copy p{max-width:430px;margin:0;color:#67616e;font-size:18px;line-height:1.75}.visual-quiz-progress{margin-top:42px;display:flex;align-items:center;gap:14px}.visual-quiz-progress>div{display:flex;gap:6px}.visual-quiz-progress i{width:55px;height:2px;border-radius:99px;background:#d8d4dc;transition:background .3s ease}.visual-quiz-progress i.active{background:#302a40}.visual-quiz-progress small{font:8px var(--mono);color:#746d7a}.visual-quiz-stage{position:relative;z-index:2;height:700px;display:flex;align-items:center}.quiz-orbit{position:absolute;left:42%;top:50%;border:1px solid rgba(118,100,162,.12);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}.quiz-orbit-one{width:720px;height:720px}.quiz-orbit-two{width:560px;height:560px;border-color:rgba(197,144,165,.14)}.visual-quiz-card{position:relative;width:calc(100% + 5vw);height:700px;overflow:hidden;padding:55px 7vw 45px 75px;border:1px solid rgba(139,119,190,.2);border-right:0;border-radius:360px 0 0 360px;background:rgba(255,255,255,.9);box-shadow:0 30px 90px rgba(62,49,86,.14);backdrop-filter:blur(22px)}.visual-quiz-card.quiz-transition-out{animation:quiz-screen-out .25s ease both}.visual-quiz-card.quiz-transition-in{animation:quiz-screen-in .35s ease both}.quiz-question-screen,.quiz-result-screen{width:min(590px,100%);height:100%;margin:auto;display:flex;flex-direction:column;justify-content:center}.quiz-question-screen>header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:23px}.quiz-question-screen>header span,.quiz-question-screen>header small{font:8px var(--mono);letter-spacing:.08em;color:#77717e}.quiz-question-screen>header small{letter-spacing:.02em;color:#99929e}.quiz-options{display:grid;grid-template-columns:repeat(2,minmax(0,240px));justify-content:center;gap:22px}.quiz-option{display:flex;flex-direction:column;align-items:center;gap:12px}.quiz-image-placeholder{position:relative;width:240px;height:300px;overflow:hidden;padding:0;border:1px solid rgba(255,255,255,.88);border-radius:20px;display:grid;place-items:center;color:#756b86;box-shadow:0 15px 40px rgba(56,45,76,.09);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}.quiz-image-placeholder:hover:not(:disabled){transform:translateY(-3px);box-shadow:0 20px 48px rgba(56,45,76,.13)}.quiz-image-placeholder.selected{border:2px solid #8d78bc;box-shadow:0 0 0 4px rgba(141,120,188,.12),0 18px 45px rgba(56,45,76,.12)}.quiz-image-placeholder:disabled{cursor:default}.quiz-image-placeholder.soft-lilac{background:radial-gradient(circle at 36% 30%,rgba(255,255,255,.8),transparent 23%),linear-gradient(145deg,#eee9fd,#dcd5f2)}.quiz-image-placeholder.soft-pink{background:radial-gradient(circle at 62% 36%,rgba(255,255,255,.78),transparent 22%),linear-gradient(145deg,#f9e7e4,#ead1d8)}.quiz-image-placeholder.soft-blue{background:radial-gradient(circle at 42% 32%,rgba(255,255,255,.8),transparent 24%),linear-gradient(145deg,#e6f0fa,#d4dfef)}.quiz-image-placeholder>span{position:absolute;z-index:2;left:12px;top:12px;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.82);display:grid;place-items:center;font:10px var(--mono);box-shadow:0 5px 15px rgba(51,42,68,.08)}.quiz-image-placeholder>small{position:absolute;right:12px;top:15px;font:6px var(--mono);letter-spacing:.08em;color:#746d7a}.quiz-image-placeholder>svg{opacity:.62}.quiz-choice-button{min-width:112px;height:34px;padding:0 15px;border:1px solid rgba(139,119,190,.25);border-radius:99px;background:#fff;color:#5f5867;font-size:9px;transition:border-color .2s ease,background .2s ease}.quiz-choice-button:hover:not(:disabled){border-color:#75629e;background:#f8f6fb}.quiz-choice-button:disabled{opacity:.45;cursor:default}.quiz-ai-marker{position:absolute;z-index:3;width:18px;height:18px;border:1px solid #fff;border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(255,255,255,.22);font-style:normal}.quiz-ai-marker::before,.quiz-ai-marker::after{content:"";position:absolute;inset:-1px;border:1px solid rgba(122,99,174,.7);border-radius:50%;animation:quiz-marker-pulse 1.2s ease-out infinite}.quiz-ai-marker::after{animation-delay:.55s}.quiz-ai-marker>b{position:absolute;inset:5px;border-radius:50%;background:#7d6aa8}.quiz-ai-marker>em{position:absolute;left:15px;top:15px;min-width:105px;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.9);box-shadow:0 8px 22px rgba(55,42,75,.1);color:#62596e;font-size:6px;font-style:normal;white-space:nowrap}.quiz-reveal{position:relative;min-height:112px;margin-top:17px;padding:0 54px 0 24px;text-align:left}.quiz-reveal>strong{display:flex;align-items:center;gap:7px;font-size:11px;font-weight:500}.quiz-reveal>strong i{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font:9px var(--mono);font-style:normal}.quiz-reveal>strong.correct{color:#456f5b}.quiz-reveal>strong.correct i{background:#dcece3}.quiz-reveal>strong.incorrect{color:#7c602f}.quiz-reveal>strong.incorrect i{background:#f4e8d5}.quiz-reveal>p{margin:8px 0 0;color:#6b6472;font-size:9px;line-height:1.65}.quiz-next-button,.quiz-result-next{position:absolute;right:0;bottom:10px;border:0;background:#302a40;color:#fff;display:grid;place-items:center;box-shadow:0 10px 24px rgba(47,42,64,.18)}.quiz-next-button{width:45px;height:45px;padding:0;border-radius:50%}.quiz-result-next{height:39px;padding:0 7px 0 15px;border-radius:99px;display:flex;gap:9px;font-size:8px}.quiz-result-next svg{width:27px;height:27px;padding:6px;border-radius:50%;background:#fff;color:#302a40}.quiz-result-screen{text-align:center;align-items:center}.quiz-result-kicker{font:8px var(--mono);letter-spacing:.1em;color:#8e8794}.quiz-result-screen>strong{margin-top:10px;font:500 92px/1 var(--serif);letter-spacing:-.05em}.quiz-result-screen>strong small{font:12px var(--mono);color:#8d8692}.quiz-result-screen h3{margin:13px 0 22px;font:500 24px var(--serif)}.quiz-source-card{width:min(480px,100%);padding:18px 20px;border-radius:16px;background:#f4f2f5;text-align:left}.quiz-source-card p{margin:0;color:#5d5664;font-size:11px;line-height:1.7}.quiz-source-card b{color:#8172ad;font-size:15px}.quiz-source-card small{display:block;margin-top:8px;color:#96909b;font-size:7px}.quiz-secondary-source{max-width:500px;margin:15px 0 24px;color:#827b88;font-size:8px;line-height:1.7}.quiz-result-actions{display:flex;align-items:center;gap:17px}.quiz-result-actions>button:first-child{height:45px;padding:0 6px 0 19px;border:0;border-radius:99px;background:#302a40;color:#fff;display:flex;align-items:center;gap:13px;font-size:10px}.quiz-result-actions>button:first-child span{width:33px;height:33px;border-radius:50%;background:#fff;color:#302a40;display:grid;place-items:center}.quiz-result-actions>button:last-child{padding:7px 1px;border:0;border-bottom:1px solid rgba(55,47,68,.35);background:transparent;color:#625b69;font-size:9px}

.comment-stage { width:min(100%,520px);padding:22px;border-radius:24px;background:rgba(255,255,255,.72);border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 90px rgba(49,56,76,.11);backdrop-filter:blur(22px);position:relative;z-index:2; }
.comment-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}.comment-head>div:first-child{display:flex;flex-direction:column}.comment-head small{font:7px var(--mono);color:#9994a0;letter-spacing:.07em}.comment-head strong{font:500 35px var(--serif)}.comment-ring{width:44px;height:44px;border-radius:50%;background:conic-gradient(#6f8496 0 87%,#e4e8eb 87%);display:grid;place-items:center;position:relative}.comment-ring::before{content:"";position:absolute;inset:4px;border-radius:50%;background:#f9fbfc}.comment-ring span{font:7px var(--mono);position:relative}
.comment-stream{display:flex;flex-direction:column;gap:6px}.mock-comment{display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:center;padding:9px;border-radius:12px;background:rgba(249,250,251,.82);border:1px solid rgba(59,65,76,.06);animation:comment-in .6s var(--delay) ease both}.comment-avatar{width:29px;height:29px;border-radius:50%;display:grid;place-items:center;font-size:8px}.ca-1{background:#dce7e5}.ca-2{background:#e7dcf0}.ca-3{background:#f0dfdc}.ca-4{background:#dce2f0}.ca-5{background:#e8e7d9}.mock-comment>div{min-width:0}.mock-comment strong{font-size:8px}.mock-comment p{font-size:7px;color:#77727d;margin:3px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mock-comment em{font-style:normal;font-size:6px;padding:4px 5px;border-radius:99px;white-space:nowrap}.mock-comment em.natural{background:#e7f1ec;color:#537563}.mock-comment em.similar{background:#f3e5e8;color:#9a626c}.mock-comment em.guided{background:#f5ecdf;color:#957447}
.comment-summary{display:flex;gap:12px;margin-top:13px;padding-top:12px;border-top:1px solid var(--line)}.comment-summary span{font-size:6px;color:#89838f;display:flex;align-items:center;gap:4px}.comment-summary i{width:5px;height:5px;border-radius:50%}.comment-summary i.natural{background:#86ad99}.comment-summary i.similar{background:#c98c97}.comment-summary i.guided{background:#c5a16b}

.forensic-stage { width:480px;height:560px;position:relative;z-index:2;border-radius:220px 220px 30px 30px;overflow:hidden;background:#e9e6ec;box-shadow:0 30px 90px rgba(59,43,70,.15); }
.compare-image{position:absolute;inset:0;overflow:hidden}.compare-image img{width:100%;height:100%;object-fit:cover;object-position:center 22%}.compare-image>span{position:absolute;top:18px;padding:6px 8px;border-radius:6px;background:rgba(255,255,255,.7);font:6px var(--mono);letter-spacing:.05em}.compare-original{clip-path:inset(0 50% 0 0)}.compare-original>span{left:18px}.compare-detail{clip-path:inset(0 0 0 50%)}.compare-detail img{filter:saturate(.85) contrast(.93) blur(.4px)}.compare-detail>span{right:18px}.forensic-stage::after{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.8);box-shadow:0 0 18px #fff}
.forensic-scan{position:absolute;left:0;right:0;height:1px;top:25%;background:linear-gradient(90deg,transparent,#c0a8e0,#fff,#c0a8e0,transparent);box-shadow:0 0 18px #c7a8f0;animation:forensic-scan 4s ease-in-out infinite}.forensic-point{position:absolute;display:flex;align-items:center;gap:7px;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.25)}.forensic-point>i{width:9px;height:9px;border:1px solid white;border-radius:50%;box-shadow:0 0 0 5px rgba(255,255,255,.2)}.forensic-point span{font-size:7px;line-height:1.5}.forensic-point strong{font:8px var(--mono)}.point-a{left:20%;top:43%}.point-b{right:13%;top:58%}.forensic-caption{position:absolute;left:18px;right:18px;bottom:18px;padding:12px 14px;border-radius:13px;background:rgba(31,27,40,.54);backdrop-filter:blur(14px);color:#fff;display:grid;grid-template-columns:1fr auto;gap:4px 10px}.forensic-caption span{font-size:8px}.forensic-caption strong{font:11px var(--mono)}.forensic-caption small{grid-column:1/3;font-size:7px;color:rgba(255,255,255,.7)}

.account-stage{width:min(100%,500px);padding:24px;border-radius:25px;background:rgba(255,255,255,.78);border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 90px rgba(55,48,80,.12);backdrop-filter:blur(24px);position:relative;z-index:2}.account-profile{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding-bottom:17px;border-bottom:1px solid var(--line)}.account-avatar{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,#e8e1f6,#dae9e3);font:500 19px var(--serif);color:#635778}.account-profile>div:nth-child(2){display:flex;flex-direction:column;gap:3px}.account-profile span{font:6px var(--mono);letter-spacing:.08em;color:#9b94a0}.account-profile strong{font-size:11px;font-weight:500}.account-profile small{font-size:7px;color:#938c98}.account-profile>em{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#75699d 0 82%,#e8e3ed 82%);position:relative;font:500 17px var(--serif);font-style:normal}.account-profile>em::before{content:"";position:absolute;inset:5px;border-radius:50%;background:#faf8fb}.account-profile>em b{position:relative;z-index:1;font:inherit}.account-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:14px 0}.account-stats>div{padding:11px;border-radius:11px;background:#f5f2f7;display:flex;flex-direction:column;gap:3px;text-align:center}.account-stats strong{font:500 18px var(--serif)}.account-stats small{font-size:6px;color:#948e99}.account-timeline{padding:12px 13px;border-radius:13px;background:#faf9fb;display:flex;flex-direction:column;gap:0}.account-timeline>span{min-height:47px;position:relative;display:grid;grid-template-columns:10px 42px 1fr;align-items:center;gap:7px}.account-timeline>span::after{content:"";position:absolute;left:4px;top:28px;bottom:-19px;width:1px;background:#ddd7e4}.account-timeline>span:last-child::after{display:none}.account-timeline i{width:9px;height:9px;border-radius:50%;background:#8575a5;box-shadow:0 0 0 4px #eeeaf4}.account-timeline strong{font:7px var(--mono)}.account-timeline small{font-size:7px;color:#7f7885}.account-verdict{margin-top:13px;padding:13px;border-radius:13px;background:linear-gradient(120deg,#ece7f7,#edf5f1);display:grid;grid-template-columns:1fr auto;gap:5px 10px}.account-verdict>span{font:6px var(--mono);color:#7d7489}.account-verdict>span i{display:inline-block;width:5px;height:5px;border-radius:50%;background:#6ba183;margin-right:5px}.account-verdict>strong{font-size:9px;font-weight:500}.account-verdict>small{grid-column:1/3;font-size:7px;color:#7e7882}

.profile-stage { width:430px;min-height:520px;padding:44px 38px 30px;border-radius:220px 220px 24px 24px;background:linear-gradient(165deg,rgba(255,255,255,.9),rgba(239,234,248,.82));border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 90px rgba(64,46,97,.14);backdrop-filter:blur(25px);position:relative;z-index:2;text-align:center; }
.profile-score{width:180px;height:180px;border-radius:50%;margin:0 auto 17px;background:conic-gradient(#766aa0 0 84%,rgba(118,106,160,.13) 84%);display:grid;place-items:center;position:relative}.profile-score::before{content:"";position:absolute;inset:8px;border-radius:50%;background:#f8f5fb}.profile-score>div{position:relative}.profile-score strong{font:500 59px/1 var(--serif)}.profile-score span{font:8px var(--mono);color:#857f8a}.profile-score small{display:block;font:6px var(--mono);color:#8c8592;margin-top:7px;letter-spacing:.08em}.profile-verdict{display:inline-flex;align-items:center;gap:6px;font:7px var(--mono);padding:6px 8px;border-radius:99px;background:#e5f1eb;color:#587563}.profile-verdict i{width:4px;height:4px;border-radius:50%;background:#71a087}.profile-stage h3{font:500 25px/1.25 var(--serif);margin:12px 0 19px}.profile-signals{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.profile-signals>div{padding:9px 4px;border-radius:9px;background:rgba(255,255,255,.58);display:grid;grid-template-columns:auto 1fr;align-items:baseline;text-align:left}.profile-signals span{font:11px var(--serif)}.profile-signals strong{font:12px var(--mono);text-align:right}.profile-signals small{grid-column:1/3;font-size:6px;color:#918b97;margin-top:3px}.profile-stage>p{margin:19px 0 0;font-size:9px;color:#726c78}

.trust-section { min-height: 860px; position:relative;text-align:center;padding:90px 0 110px;background:linear-gradient(180deg,#f1effa 0%,#f7f5fa 20%,#f1efff 64%,#f8eeee 100%); }
.trust-section::before{content:"";position:absolute;left:50%;top:-120px;width:min(900px,90vw);height:260px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgba(255,255,255,.9),rgba(220,211,244,.22) 52%,transparent 72%);filter:blur(10px);pointer-events:none}
.section-tag { font: 10px var(--mono); letter-spacing: .08em; background: rgba(255,255,255,.7); border: 1px solid var(--line); border-radius: 999px; padding: 8px 12px; color: #6f697c; }
.trust-section .trust-heading{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center}
.trust-section .trust-heading h2{margin:19px 0 11px;font:500 clamp(44px,5vw,56px)/1.04 var(--serif);letter-spacing:-.045em;color:#292535}
.trust-section .trust-heading p{margin:0;color:#686270;font-size:13px}
.trust-source-note{position:relative;z-index:3;width:320px;min-height:78px;margin:34px auto 0;padding:11px 14px;border:1px solid rgba(55,47,68,.08);border-radius:20px;background:#fff;box-shadow:0 16px 45px rgba(60,48,90,.1);display:grid;grid-template-columns:56px 1fr;align-items:center;gap:13px;text-align:left;opacity:0;transform:translateY(12px)}
.trust-source-note img{width:56px;height:56px;border-radius:14px;object-fit:cover;object-position:center 24%;filter:saturate(.78)}
.trust-source-note>div{display:flex;flex-direction:column;gap:7px}
.trust-source-note strong{font-size:11px;font-weight:500;color:#393341}
.trust-source-note small{font:7px var(--mono);letter-spacing:.06em;color:#6f6876}
.trust-split-lines{position:relative;z-index:1;display:block;width:min(1200px,94vw);height:82px;margin:0 auto -1px;overflow:visible}
.trust-split-lines path{fill:none;stroke:#9d8bc8;stroke-width:1;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;opacity:0}
.trust-section.is-entered .trust-source-note{animation:trust-note-in .4s ease both}
.trust-section.is-entered .trust-split-lines path{animation:trust-line-draw .3s ease calc(.4s + var(--line-index) * .1s) forwards,trust-line-fade .4s ease 1.05s forwards}
.trust-grid { position:relative;width:100vw;max-width:none;overflow:hidden;padding:0 0 28px;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);touch-action:pan-y; }
.trust-marquee-track{display:flex;width:max-content;will-change:transform;animation:none!important;transform:translate3d(0,0,0)}
.trust-section.is-entered .trust-marquee-track{animation:none!important}
.trust-marquee-group{display:flex;gap:24px;padding-right:24px;flex:none}
.trust-card { position:relative;width:440px;height:340px;flex:none;border-radius:28px;border:1px solid rgba(255,255,255,.82);padding:30px 31px;display:flex;text-align:left;flex-direction:column;box-shadow:0 18px 55px rgba(60,48,90,.08);transition:transform .3s;scroll-snap-align:start; }
.trust-card:hover { transform: translateY(-5px); }
.trust-card:focus-visible{outline:2px solid #7869a7;outline-offset:4px;transform:translateY(-5px)}
.trust-card > span { font:500 76px/.9 var(--serif);color:#2f2938}
.trust-card-expert{position:absolute;right:20px;top:17px;width:150px;height:155px;object-fit:contain;object-position:center bottom;pointer-events:none}
/* Advisor cards: copy in the left column, the expert portrait in the right column. */
.trust-card{display:grid;grid-template-columns:minmax(0,1fr) 150px;grid-template-rows:auto auto 1fr;column-gap:16px}
.trust-card>span{grid-column:1;grid-row:1}
.trust-card>h3{grid-column:1;grid-row:2}
.trust-card>div{grid-column:1;grid-row:3;align-self:end}
.trust-card>.trust-card-expert{position:relative;inset:auto;grid-column:2;grid-row:1/4;align-self:center;width:150px;height:min(220px,100%)}
.trust-card h3{margin:16px 0 0;font:500 25px/1.2 "Noto Sans SC",sans-serif;letter-spacing:-.03em;color:#37313f}
.trust-card>div{margin-top:auto}
.trust-card strong{font:500 25px/1.2 var(--serif);color:#393240}
.trust-card p{margin:13px 0 0;color:#554f5c;font-size:10px;line-height:1.65}
.trust-card p small{display:block;margin-bottom:4px;font:7px var(--mono);letter-spacing:.08em;color:#6b6472}
.card-1 { background: #ebe7ff; }.card-2 { background: #e6f0ff; }.card-3 { background: #f9e9e8; }.card-4 { background: #e8f3ed; }

.evidence-section{position:relative;overflow:hidden;padding:120px 7% 130px;background:radial-gradient(circle at 78% 48%,rgba(214,222,255,.6),transparent 30%),radial-gradient(circle at 15% 65%,rgba(247,217,226,.55),transparent 29%),linear-gradient(160deg,#fbfafd,#f4f2fa 55%,#faf6f7)}.evidence-section::before{content:"";position:absolute;left:48%;top:38%;width:760px;height:350px;border:1px solid rgba(117,98,165,.13);border-radius:50%;transform:translate(-50%,-50%) rotate(-7deg);pointer-events:none}.evidence-heading{position:relative;z-index:2;text-align:center}.evidence-heading h2{font:500 clamp(42px,5vw,70px)/1.02 var(--serif);letter-spacing:-.045em;margin:28px 0 15px;color:#292535}.evidence-heading>p{margin:0;color:#7d7784;font-size:13px}.evidence-layout{position:relative;z-index:2;width:min(1120px,100%);margin:68px auto 0;display:grid;grid-template-columns:5fr 7fr;gap:clamp(45px,7vw,95px);align-items:center}.evidence-copy{text-align:left}.evidence-points{display:flex;flex-direction:column;gap:12px}.evidence-points>div{min-height:75px;padding:14px 16px;border:1px solid rgba(58,49,73,.08);border-radius:16px;background:rgba(255,255,255,.52);display:flex;align-items:center;gap:13px;backdrop-filter:blur(12px);transition:transform .3s ease,background .3s ease}.evidence-points>div:hover{transform:translateX(5px);background:rgba(255,255,255,.76)}.evidence-points>div>span{width:39px;height:39px;border-radius:12px;display:grid;place-items:center;flex:none;background:#eee9f8;color:#706098}.evidence-points>div:nth-child(2)>span{background:#e8f1fa;color:#58758e}.evidence-points>div:nth-child(3)>span{background:#f8e9e6;color:#9a6964}.evidence-points p{margin:0;display:flex;flex-direction:column;gap:4px}.evidence-points strong{font-size:12px;font-weight:500}.evidence-points small{font-size:9px;color:#827c88}.evidence-note{margin:20px 2px 17px;font-size:9px;color:#96909b}.evidence-cta{border:0;border-radius:999px;color:#fff;background:linear-gradient(110deg,#28233f,#41345f);padding:6px 6px 6px 23px;display:inline-flex;align-items:center;gap:18px;font-size:12px;box-shadow:0 14px 35px rgba(55,43,83,.19);transition:transform .25s,box-shadow .25s}.evidence-cta:hover{transform:translateY(-2px);box-shadow:0 18px 42px rgba(55,43,83,.26)}.evidence-card{position:relative;padding:18px 18px 49px;border:1px solid rgba(255,255,255,.9);border-radius:28px;background:rgba(255,255,255,.67);box-shadow:0 30px 85px rgba(60,47,87,.13);backdrop-filter:blur(24px)}.evidence-image-frame{position:relative;width:min(430px,100%);aspect-ratio:4/5;margin:auto;border-radius:20px;cursor:none;user-select:none}.evidence-base-image,.evidence-forensic-layer,.evidence-forensic-layer>img{position:absolute;inset:0;width:100%;height:100%;border-radius:20px;object-fit:cover;object-position:center 20%}.evidence-base-image{filter:saturate(.78) contrast(.96)}.evidence-forensic-layer{overflow:hidden;pointer-events:none;transition:clip-path .09s ease-out}.evidence-forensic-layer>img{filter:saturate(.45) contrast(1.12) hue-rotate(10deg)}.evidence-forensic-layer>span{position:absolute;inset:0;border-radius:20px;background:radial-gradient(circle at 62% 24%,rgba(228,113,171,.7),transparent 18%),radial-gradient(circle at 38% 56%,rgba(139,112,224,.72),transparent 20%),radial-gradient(circle at 68% 72%,rgba(240,165,181,.68),transparent 17%),linear-gradient(145deg,rgba(120,102,218,.22),rgba(245,158,187,.25));mix-blend-mode:color}.evidence-forensic-layer>span::after{content:"";position:absolute;left:25%;top:40%;width:47%;height:32%;border:1px dashed rgba(255,255,255,.88);border-radius:48%;transform:rotate(-8deg);box-shadow:0 0 24px rgba(151,115,220,.45)}.evidence-lens-layer{opacity:0}.evidence-lens-layer.visible{opacity:1}.evidence-lens{position:absolute;z-index:8;width:140px;height:140px;border:1px solid rgba(255,255,255,.88);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none;box-shadow:0 8px 30px rgba(44,33,65,.2),inset 0 0 0 1px rgba(67,52,90,.12);backdrop-filter:blur(1px);transition:left .07s ease-out,top .07s ease-out}.evidence-lens>span{position:absolute;left:50%;bottom:11px;transform:translateX(-50%);padding:4px 7px;border-radius:99px;background:rgba(34,28,47,.56);color:#fff;font:6px var(--mono);letter-spacing:.05em;white-space:nowrap}.evidence-hotspot-wrap{position:absolute;z-index:10;transform:translate(-50%,-50%)}.evidence-hotspot-wrap>button{width:22px;height:22px;padding:0;border:0;border-radius:50%;background:rgba(158,132,222,.19);display:grid;place-items:center;box-shadow:0 0 0 1px rgba(151,124,211,.34);animation:hotspot-breathe 2.6s ease-in-out infinite}.evidence-hotspot-wrap>button i{width:8px;height:8px;border-radius:50%;background:#9b7fd4;border:2px solid rgba(255,255,255,.85)}.evidence-hotspot-wrap.active>button{background:rgba(126,97,190,.32)}.hotspot-popover{position:absolute;z-index:12;left:18px;top:12px;width:175px;padding:11px 12px;border:1px solid rgba(255,255,255,.88);border-radius:12px;background:rgba(255,255,255,.88);box-shadow:0 14px 38px rgba(44,34,62,.16);backdrop-filter:blur(16px);animation:evidence-pop .28s ease both;text-align:left}.hotspot-popover small{font:6px var(--mono);color:#978f9e}.hotspot-popover strong{display:block;margin:4px 0;font-size:9px;font-weight:500}.hotspot-popover p{margin:0;font-size:7px;line-height:1.55;color:#756e7a}.mobile-evidence-hint{display:none}.evidence-slider{width:min(430px,100%);margin:19px auto 0;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px}.evidence-slider>span{font:7px var(--mono);color:#8c8592}.evidence-slider input{width:100%;height:3px;appearance:none;border-radius:99px;background:linear-gradient(90deg,#9580c8 0 var(--slider-value,42%),#ddd8e1 var(--slider-value,42%) 100%);accent-color:#75629e;cursor:pointer}.evidence-slider input::-webkit-slider-thumb{appearance:none;width:17px;height:17px;border-radius:50%;background:#fff;border:1px solid #80709f;box-shadow:0 3px 9px rgba(55,43,72,.18)}.evidence-slider input::-moz-range-thumb{width:17px;height:17px;border-radius:50%;background:#fff;border:1px solid #80709f;box-shadow:0 3px 9px rgba(55,43,72,.18)}.example-data{position:absolute;right:19px;bottom:14px;font:6px var(--mono);letter-spacing:.04em;color:#aaa4ae}.reveal-section{opacity:0;transform:translateY(30px);transition:opacity .9s ease,transform .9s cubic-bezier(.2,.7,.2,1)}.reveal-section.is-visible{opacity:1;transform:translateY(0)}
.evidence-image-dim{position:absolute;z-index:5;inset:0;border-radius:20px;background:rgba(20,15,40,.14);opacity:0;pointer-events:none;transition:opacity .2s ease;backdrop-filter:saturate(.86)}.evidence-image-dim.visible{opacity:1}.evidence-lens{z-index:15;width:clamp(180px,40%,300px);height:auto;aspect-ratio:1;border:3px solid #fff;transform:translate(-50%,-50%) scale(.6);opacity:0;box-shadow:0 20px 50px rgba(60,40,110,.35),inset 0 0 0 1px rgba(255,255,255,.6);backdrop-filter:none;transition:opacity .18s ease-out,transform .18s ease-out;will-change:left,top,transform}.evidence-lens.visible{opacity:1;transform:translate(-50%,-50%) scale(1)}.evidence-lens::before{content:"";position:absolute;z-index:8;inset:-10px;border:1px solid rgba(166,139,224,.72);border-radius:50%;pointer-events:none}.evidence-lens-image,.evidence-lens-heat,.evidence-lens-grid,.evidence-lens-scan,.evidence-lens-glare{position:absolute;inset:0;border-radius:50%;clip-path:circle(50%);pointer-events:none}.evidence-lens-image{background-repeat:no-repeat;filter:contrast(1.15) saturate(.9)}.evidence-lens-heat{z-index:2;opacity:.55;background:radial-gradient(circle at 31% 55%,rgba(151,103,218,.85),transparent 24%),radial-gradient(circle at 68% 35%,rgba(240,142,181,.8),transparent 20%),radial-gradient(circle at 62% 76%,rgba(225,127,176,.72),transparent 19%);mix-blend-mode:screen;transition:opacity .2s ease}.evidence-lens.hotspot-near .evidence-lens-heat{opacity:.76}.evidence-lens-grid{z-index:3;background-image:linear-gradient(rgba(255,255,255,.22) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.22) 1px,transparent 1px);background-size:12px 12px}.evidence-lens-scan{z-index:4;height:2px;top:0;bottom:auto;background:linear-gradient(90deg,transparent,rgba(255,255,255,.95),transparent);box-shadow:0 0 10px rgba(255,255,255,.9);animation:lens-scan 2.4s linear infinite}.evidence-lens-glare{z-index:5;background:radial-gradient(circle at 27% 22%,rgba(255,255,255,.35),transparent 42%)}.evidence-reticle{position:absolute;z-index:7;left:50%;top:50%;width:10px;height:10px;border:1px solid rgba(255,255,255,.95);border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 6px rgba(51,39,75,.35)}.evidence-reticle b{position:absolute;background:#fff;box-shadow:0 0 4px rgba(53,39,73,.4)}.evidence-reticle b:nth-of-type(1){width:1px;height:5px;left:4px;bottom:12px}.evidence-reticle b:nth-of-type(2){width:1px;height:5px;left:4px;top:12px}.evidence-reticle b:nth-of-type(3){width:5px;height:1px;right:12px;top:4px}.evidence-reticle b:nth-of-type(4){width:5px;height:1px;left:12px;top:4px}.evidence-lens>span{z-index:20;bottom:-34px;padding:6px 10px;background:#2f2942;font-size:7px;box-shadow:0 6px 18px rgba(38,29,57,.2)}.evidence-operation-hint{position:absolute;z-index:13;left:50%;top:14px;transform:translateX(-50%);padding:7px 10px;border:1px solid rgba(255,255,255,.72);border-radius:99px;background:rgba(255,255,255,.78);color:#60566f;display:flex;align-items:center;gap:6px;font-size:7px;white-space:nowrap;backdrop-filter:blur(12px);box-shadow:0 8px 22px rgba(53,42,72,.11);opacity:1;transition:opacity .3s ease;animation:operation-hint-float 2.2s ease-in-out infinite}.evidence-operation-hint.hidden{opacity:0;pointer-events:none}.evidence-hotspot-wrap{width:clamp(22px,5%,30px)}.evidence-hotspot-wrap>button{width:100%;height:auto;aspect-ratio:1}.evidence-hotspot-wrap.nearby>button{animation:none;transform:scale(1.2);background:#aa8add;box-shadow:0 0 0 6px rgba(170,138,221,.18)}.evidence-hotspot-wrap.nearby>button i{background:#aa8add;border-color:#aa8add}

.one-agent-section{position:relative;overflow:hidden;padding:120px 5% 125px;background:radial-gradient(circle at 50% 73%,rgba(221,214,246,.42),transparent 28%),linear-gradient(180deg,#faf9fc,#f5f3fa 58%,#faf7f8)}.one-agent-section::before,.one-agent-section::after{content:"";position:absolute;left:50%;border:1px solid rgba(117,98,165,.1);border-radius:50%;pointer-events:none}.one-agent-section::before{top:66%;width:920px;height:390px;transform:translate(-50%,-50%) rotate(-5deg)}.one-agent-section::after{top:68%;width:700px;height:270px;transform:translate(-50%,-50%) rotate(6deg)}.one-agent-heading{position:relative;z-index:2;text-align:center}.one-agent-heading h2{font:500 clamp(42px,5vw,70px)/1.02 var(--serif);letter-spacing:-.045em;margin:28px 0 15px;color:#292535}.one-agent-heading p{margin:0;color:#7d7784;font-size:13px}.agent-segmented{position:relative;z-index:3;width:min(780px,100%);margin:46px auto 28px;padding:5px;border:1px solid rgba(58,49,73,.08);border-radius:999px;background:rgba(255,255,255,.66);box-shadow:0 12px 35px rgba(60,47,87,.07);backdrop-filter:blur(18px);display:grid;grid-template-columns:repeat(4,1fr);gap:4px}.agent-segmented button{min-height:43px;padding:7px 12px;border:0;border-radius:999px;background:rgba(240,237,245,.72);display:flex;align-items:center;justify-content:center;gap:8px;color:#726c79;font-size:10px;white-space:nowrap;transition:background .3s ease,color .3s ease,box-shadow .3s ease}.agent-segmented button span{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.8);font:9px var(--mono);transition:background .3s ease,color .3s ease}.agent-segmented button.active{background:#2f2a40;color:#fff;box-shadow:0 7px 18px rgba(44,35,62,.2)}.agent-segmented button.active span{background:rgba(255,255,255,.14);color:#fff}.agent-scene-shell{position:relative;z-index:2;width:min(1080px,100%);margin:auto;overflow:hidden;transition:height .32s ease-in-out}.agent-scene-content{min-height:360px;padding:34px 40px;border:1px solid rgba(255,255,255,.88);border-radius:26px;background:rgba(255,255,255,.64);box-shadow:0 25px 70px rgba(60,47,87,.1);backdrop-filter:blur(22px);display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center;animation:agent-scene-in .32s ease both}.agent-scene-copy{text-align:left}.agent-scene-copy>span{font:8px var(--mono);letter-spacing:.08em;color:#8d8496}.agent-scene-copy h3{max-width:390px;margin:13px 0 12px;font:500 clamp(27px,3vw,39px)/1.2 var(--serif);letter-spacing:-.035em;color:#302b3a}.agent-scene-copy p{max-width:430px;margin:0;color:#706a77;font-size:12px;line-height:1.85}.agent-scene-copy small{display:inline-flex;margin-top:22px;padding:6px 9px;border:1px solid rgba(64,52,82,.08);border-radius:99px;background:rgba(245,242,248,.75);color:#958e9b;font-size:7px}.agent-scene-visual{min-width:0;height:290px;display:grid;place-items:center}.agent-account-card,.agent-image-card,.agent-comment-chart,.agent-copy-card{width:100%;height:100%;border:1px solid rgba(58,49,73,.09);border-radius:20px;background:rgba(255,255,255,.76);box-shadow:0 16px 42px rgba(54,43,73,.09)}.agent-account-card{padding:20px;display:flex;flex-direction:column}.account-placeholder-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:11px;padding-bottom:16px;border-bottom:1px solid var(--line)}.account-placeholder-avatar{width:45px;height:45px;border-radius:50%;display:grid;place-items:center;background:#ebe7ff;color:#7467a3}.account-placeholder-head>div{display:flex;flex-direction:column;gap:3px}.account-placeholder-head strong{font-size:10px;font-weight:500}.account-placeholder-head small{font:7px var(--mono);color:#98919e}.account-placeholder-head em{padding:6px 8px;border-radius:99px;background:#f9e9e8;color:#9a6964;font-size:7px;font-style:normal}.account-placeholder-data{flex:1;display:grid;grid-template-columns:1fr 120px;gap:20px;padding-top:18px}.posting-rhythm,.commerce-ratio{display:flex;flex-direction:column}.posting-rhythm>span,.commerce-ratio>span{font-size:8px;color:#817a88}.posting-rhythm>div{height:112px;margin-top:auto;display:flex;align-items:flex-end;gap:5px;border-bottom:1px solid rgba(52,44,68,.1);background:repeating-linear-gradient(to top,rgba(52,44,68,.05) 0 1px,transparent 1px 28px)}.posting-rhythm i{width:100%;min-width:4px;border-radius:3px 3px 0 0;background:#c9bee9}.posting-rhythm i:nth-child(3n){background:#e7bfc8}.posting-rhythm small{display:flex;gap:10px;margin-top:7px;color:#9b95a1;font-size:6px}.posting-rhythm small b{width:5px;height:5px;margin-right:-6px;border-radius:50%;background:#c9bee9}.posting-rhythm small b:nth-of-type(2){background:#e7bfc8}.commerce-ratio>div{width:102px;height:102px;margin:auto;position:relative;border-radius:50%;background:conic-gradient(#8574af 0 80%,rgba(133,116,175,.12) 80%);display:grid;place-items:center}.commerce-ratio>div::before{content:"";position:absolute;inset:10px;border-radius:50%;background:#fff}.commerce-ratio strong,.commerce-ratio small{position:relative;z-index:1}.commerce-ratio strong{font:500 23px var(--serif)}.commerce-ratio small{position:absolute;top:62px;font-size:6px;color:#99929e}.agent-image-card{padding:14px;background:linear-gradient(135deg,#e6f0ff,#f9e9e8)}.skin-placeholder{position:relative;width:100%;height:100%;overflow:hidden;border-radius:15px;background:radial-gradient(circle at 37% 40%,#f4ddd8 0 13%,transparent 32%),radial-gradient(circle at 64% 54%,#e9cfc9 0 14%,transparent 34%),linear-gradient(120deg,#eadbd8,#f1e4df 48%,#dfc7c4);box-shadow:inset 0 0 45px rgba(85,65,92,.08)}.skin-placeholder::before{content:"";position:absolute;inset:0;opacity:.23;background-image:radial-gradient(rgba(80,61,82,.55) .65px,transparent .8px);background-size:7px 7px}.skin-placeholder::after{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.7);box-shadow:0 0 18px rgba(255,255,255,.75)}.skin-heat{position:absolute;border-radius:50%;filter:blur(8px);background:radial-gradient(circle,rgba(188,139,222,.72),rgba(236,144,178,.45) 48%,transparent 72%)}.heat-a{width:135px;height:90px;left:18%;top:22%;transform:rotate(-13deg)}.heat-b{width:115px;height:76px;right:12%;bottom:16%;transform:rotate(9deg)}.image-marker{position:absolute;z-index:2;padding:6px 8px;border:1px solid rgba(255,255,255,.88);border-radius:8px;background:rgba(255,255,255,.84);box-shadow:0 9px 24px rgba(57,43,74,.1);font-size:7px;color:#655e6d;display:flex;align-items:center;gap:6px}.image-marker b{width:7px;height:7px;border:2px solid #fff;border-radius:50%;background:#9b7fd4;box-shadow:0 0 0 3px rgba(155,127,212,.2)}.marker-a{left:16%;top:15%}.marker-b{right:9%;bottom:12%}.skin-placeholder>small{position:absolute;left:10px;bottom:8px;color:rgba(70,57,76,.62);font:6px var(--mono);letter-spacing:.06em}.agent-comment-chart{position:relative;padding:26px 24px 28px 35px}.comment-plot{position:relative;width:100%;height:100%;border-left:1px solid rgba(57,49,70,.14);border-bottom:1px solid rgba(57,49,70,.14);background-image:linear-gradient(rgba(57,49,70,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(57,49,70,.045) 1px,transparent 1px);background-size:25% 25%}.scatter-dot,.cluster-dot{position:absolute;width:6px;height:6px;border-radius:50%;transform:translate(-50%,-50%)}.scatter-dot{background:#b7a9dd;box-shadow:0 0 0 3px rgba(183,169,221,.12)}.cluster-dot{background:#d88f9b;box-shadow:0 0 0 3px rgba(216,143,155,.13)}.cluster-ring{position:absolute;left:44%;top:34%;width:29%;height:32%;border:1px dashed rgba(192,106,121,.65);border-radius:50%;background:rgba(239,190,196,.12)}.cluster-label{position:absolute;right:4%;top:10%;padding:6px 8px;border-radius:8px;background:#f9e9e8;color:#936269;font-size:7px;box-shadow:0 8px 20px rgba(91,56,65,.08)}.chart-x,.chart-y{position:absolute;color:#938d99;font-size:7px}.chart-x{right:25px;bottom:9px}.chart-y{left:10px;top:14px}.agent-copy-card{padding:19px 21px;text-align:left}.copy-card-head{display:flex;align-items:center;gap:8px;padding-bottom:13px;border-bottom:1px solid var(--line)}.copy-card-head i{width:8px;height:8px;border-radius:50%;background:#b9acd9}.copy-card-head span{font-size:9px;font-weight:500}.copy-card-head small{margin-left:auto;font:6px var(--mono);color:#9c95a1}.agent-copy-card p{margin:17px 0 0;font-size:10px;line-height:2;color:#625c69}.agent-copy-card mark{padding:2px 3px;border-radius:4px;background:#f3d6d8;color:#774d53}.copy-risk-labels{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}.copy-risk-labels span{padding:6px 8px;border-radius:99px;background:#f9e9e8;color:#97646b;font-size:7px}.one-agent-flow{position:relative;z-index:2;width:min(980px,100%);margin:85px auto 0;display:grid;grid-template-columns:125px 110px 300px 145px 150px;justify-content:center;align-items:center}.flow-inputs,.flow-outputs{display:flex;flex-direction:column;align-items:stretch;gap:10px}.flow-inputs>small,.flow-outputs>small{margin-bottom:4px;text-align:center;font:7px var(--mono);letter-spacing:.08em;color:#99919e}.flow-inputs>span,.flow-outputs>span{min-height:35px;padding:9px 12px;border:1px solid rgba(58,49,73,.08);border-radius:999px;background:rgba(255,255,255,.7);color:#8b8591;display:grid;place-items:center;font-size:8px;white-space:nowrap;box-shadow:0 7px 20px rgba(53,42,72,.05);transition:background .3s ease,color .3s ease,opacity .3s ease,transform .3s ease}.flow-inputs>span:not(.active){opacity:.48}.flow-inputs>span.active{background:#2f2a40;color:#fff;transform:translateX(4px);box-shadow:0 10px 25px rgba(47,42,64,.18)}.flow-outputs>p{width:190px;margin:7px 0 0 -20px;text-align:center;color:#938c98;font-size:7px;line-height:1.6}.agent-flow-connector{position:relative;width:100%;height:240px}.agent-flow-connector svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.agent-flow-connector path{fill:none;stroke:rgba(123,106,174,.22);stroke-width:1}.agent-flow-connector>i{position:absolute;left:0;top:0;width:5px;height:5px;border-radius:50%;background:#9d8bc8;box-shadow:0 0 0 4px rgba(157,139,200,.1);offset-path:var(--flow-path);offset-rotate:0deg;animation:agent-flow-dot 5.2s linear infinite}.connector-out>i{background:#bd91a0;box-shadow:0 0 0 4px rgba(189,145,160,.1)}.rule-score-node{position:absolute;z-index:2;left:53%;top:50%;transform:translate(-50%,-50%);width:92px;padding:8px 7px;border:1px solid rgba(62,50,80,.09);border-radius:10px;background:rgba(255,255,255,.9);box-shadow:0 10px 27px rgba(50,39,66,.08);text-align:center}.rule-score-node strong{display:block;font-size:7px;font-weight:500}.rule-score-node small{display:block;margin-top:3px;color:#99919d;font-size:5px;line-height:1.45}.aperture-column{text-align:center}.aperture-column>p{width:300px;margin:18px auto 0;color:#7c7583;font-size:8px;line-height:1.6}.aperture-orbits{position:relative;width:300px;height:300px;display:grid;place-items:center}.agent-aperture{position:relative;z-index:3;width:270px;height:270px;overflow:visible;filter:drop-shadow(0 18px 30px rgba(67,51,96,.12))}.aperture-orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(139,119,190,.22);border-radius:50%;pointer-events:none}.orbit-inner{width:286px;height:286px;transform:translate(-50%,-50%)}.orbit-outer{width:320px;height:320px;transform:translate(-50%,-50%);border-style:dashed;animation:agent-orbit-spin 60s linear infinite}.aperture-petal{cursor:pointer;transition:opacity .3s ease-in-out,filter .3s ease-in-out,transform .25s ease}.aperture-petal path{stroke:rgba(255,255,255,.92);stroke-width:2}.petal-t path{fill:#ebe7ff}.petal-r path{fill:#e6f0ff}.petal-u path{fill:#f9e9e8}.petal-s path{fill:#e8f3ed}.aperture-petal.muted{opacity:.45;filter:saturate(.55)}.aperture-petal.active{opacity:1;filter:saturate(1)}.aperture-petal:focus{outline:none}.aperture-petal:focus path{stroke:#7767a4;stroke-width:3}.petal-t:hover{transform:translate(-4px,-4px)}.petal-r:hover{transform:translate(4px,-4px)}.petal-u:hover{transform:translate(4px,4px)}.petal-s:hover{transform:translate(-4px,4px)}.petal-letter{font:500 30px var(--serif);fill:#353044;pointer-events:none}.petal-label{font:7px "Noto Sans SC",sans-serif;fill:#77717e;pointer-events:none}.aperture-core{animation:aperture-core-pulse .48s ease-in-out;transform-origin:center}.aperture-core circle{fill:#2f2a40;stroke:rgba(255,255,255,.75);stroke-width:2}.aperture-core svg{color:#fff}.aperture-core text{font:7px var(--mono);letter-spacing:.04em;fill:#fff}.aperture-tooltip{position:absolute;z-index:5;max-width:155px;padding:8px 10px;border:1px solid rgba(255,255,255,.88);border-radius:10px;background:rgba(255,255,255,.92);box-shadow:0 12px 32px rgba(48,37,64,.13);color:#5f5867;font-size:7px;line-height:1.5;pointer-events:none;animation:evidence-pop .2s ease both}.tooltip-t{left:-15px;top:48px}.tooltip-r{right:-25px;top:48px}.tooltip-u{right:-35px;bottom:45px}.tooltip-s{left:-30px;bottom:45px}.one-agent-example{position:absolute;right:5%;bottom:28px;font:6px var(--mono);letter-spacing:.04em;color:#aaa4ae}

.report-showcase-section{position:relative;overflow:hidden;padding:120px 5% 135px;background:radial-gradient(circle at 50% 48%,rgba(224,217,246,.5),transparent 31%),linear-gradient(180deg,#faf7f8,#f6f4fa 55%,#fbfafc)}.report-showcase-section::before,.report-showcase-section::after{content:"";position:absolute;left:50%;top:58%;border:1px solid rgba(117,98,165,.1);border-radius:50%;pointer-events:none}.report-showcase-section::before{width:1040px;height:470px;transform:translate(-50%,-50%) rotate(-6deg)}.report-showcase-section::after{width:820px;height:350px;transform:translate(-50%,-50%) rotate(7deg)}.report-showcase-heading{position:relative;z-index:2;text-align:center}.report-showcase-heading h2{font:500 clamp(42px,5vw,70px)/1.02 var(--serif);letter-spacing:-.045em;margin:28px 0 15px;color:#292535}.report-showcase-heading p{margin:0;color:#7d7784;font-size:13px}.report-showcase-stage{position:relative;z-index:2;width:min(1120px,100%);margin:48px auto 0;padding-top:58px}.report-mode-switch{position:absolute;z-index:4;left:50%;top:0;transform:translateX(-50%);padding:4px;border:1px solid rgba(58,49,73,.08);border-radius:999px;background:rgba(255,255,255,.7);box-shadow:0 10px 28px rgba(60,47,87,.07);display:grid;grid-template-columns:1fr 1fr;gap:3px}.report-mode-switch button{min-width:94px;height:33px;padding:0 13px;border:0;border-radius:999px;background:transparent;color:#8a8490;font-size:8px;transition:background .3s ease,color .3s ease,box-shadow .3s ease}.report-mode-switch button.active{background:#2f2a40;color:#fff;box-shadow:0 5px 14px rgba(47,42,64,.18)}.trust-report-card{position:relative;z-index:2;width:min(600px,100%);margin:auto;padding:25px;border:1px solid rgba(255,255,255,.9);border-radius:28px;background:rgba(255,255,255,.77);box-shadow:0 30px 90px rgba(60,47,87,.14);backdrop-filter:blur(24px)}.trust-report-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding-bottom:20px;border-bottom:1px solid var(--line)}.trust-report-head>div{display:flex;flex-direction:column;gap:5px}.trust-report-head strong{font-size:13px;font-weight:500}.trust-report-head small{font-size:8px;color:#928c98}.trust-report-head>span{padding:6px 8px;border:1px solid rgba(58,49,73,.08);border-radius:99px;background:#f5f2f7;color:#928b98;font:6px var(--mono);white-space:nowrap}.report-highlight{transition:opacity .2s ease,filter .2s ease,transform .2s ease}.trust-report-card[data-focus] .report-highlight{opacity:.4;filter:saturate(.5)}.trust-report-card[data-focus="score"] .part-score,.trust-report-card[data-focus="band"] .part-band,.trust-report-card[data-focus="radar"] .part-radar,.trust-report-card[data-focus="evidence"] .part-evidence,.trust-report-card[data-focus="missing"] .part-missing,.trust-report-card[data-focus="advice"] .part-advice{opacity:1;filter:none}.report-score-block{padding:24px 0 18px;display:flex;align-items:center;justify-content:space-between;gap:20px}.report-score-ring{width:190px;min-height:112px;padding:13px 16px;border:1px solid rgba(117,105,157,.18);border-radius:55px;display:flex;flex-direction:column;justify-content:center;transition:border .3s ease}.has-missing-data .report-score-ring{border-style:dashed}.report-score-ring>span{font:7px var(--mono);letter-spacing:.08em;color:#8e8794}.report-score-ring>strong{margin-top:2px;font:500 48px/1 var(--serif);letter-spacing:-.04em}.report-score-ring>strong small{font:10px var(--mono);color:#8d8692}.report-score-ring>em{margin-top:7px;color:#9a7880;font-size:6px;font-style:normal;animation:agent-scene-in .3s ease both}.report-verdict{padding:8px 11px;border-radius:99px;background:#f4e1e1;color:#8d5d63;font-size:8px}.report-risk-band{display:grid;grid-template-columns:1fr 1fr;padding-bottom:22px}.report-risk-band>div{position:relative;grid-column:1/3;height:5px;border-radius:99px;background:linear-gradient(90deg,#c98791,#ddc17f 52%,#78a28c);box-shadow:inset 0 0 0 1px rgba(61,50,73,.05)}.report-risk-band i{position:absolute;left:43%;top:-5px;width:2px;height:15px;border-radius:99px;background:#2f2a40;box-shadow:0 0 0 3px rgba(255,255,255,.9);transform:translateX(-50%)}.is-visible .report-risk-band i{animation:report-pointer-in .6s ease both}.report-risk-band>span{margin-top:7px;color:#9a939f;font-size:6px}.report-risk-band>span:last-child{text-align:right}.report-dimensions-block{padding:23px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:220px 1fr;gap:20px}.report-radar{min-width:0;text-align:center}.report-radar svg{width:100%;height:205px;overflow:visible}.radar-grid{fill:none;stroke:rgba(89,75,115,.13);stroke-width:1}.radar-axis{cursor:pointer;transition:opacity .2s ease}.radar-axis line{stroke:rgba(88,73,117,.2);stroke-width:1}.radar-axis circle{fill:#f4f1f8;stroke:rgba(96,79,128,.18)}.radar-axis text{font:8px var(--mono);fill:#665d73}.radar-axis.missing line{stroke-dasharray:4 4}.radar-axis.missing circle{fill:transparent;stroke-dasharray:3 3}.radar-axis.dimmed,.radar-point.dimmed{opacity:.25}.radar-axis:focus{outline:none}.radar-axis:focus circle{stroke:#796a9c;stroke-width:2}.radar-data{fill:rgba(139,120,185,.25);stroke:#8977b4;stroke-width:2;transform-origin:120px 110px;transition:d .3s ease,opacity .2s ease}.is-visible .radar-data{animation:radar-expand .6s ease both}.radar-point{fill:#8977b4;stroke:#fff;stroke-width:2;transition:opacity .2s ease}.report-radar>small{display:block;margin-top:-5px;color:#99929e;font-size:6px}.report-dimension-list{display:flex;flex-direction:column;gap:11px}.report-dimension-row{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:start;cursor:pointer}.report-dimension-row.dimension-dimmed{opacity:.28}.report-dimension-row.dimension-active{transform:translateX(3px)}.report-dimension-badge{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;font:9px var(--mono);color:#5f5869}.badge-t{background:#ebe7ff}.badge-r{background:#e6f0ff}.badge-u{background:#f9e9e8}.badge-s{background:#e8f3ed}.report-dimension-row>div{min-width:0}.report-dimension-row>div>span{display:flex;align-items:center;justify-content:space-between;gap:8px}.report-dimension-row strong{font-size:8px;font-weight:500}.report-dimension-row b{font:7px var(--mono);font-weight:400;color:#6f6876}.dimension-meter{height:3px;margin:5px 0;border-radius:99px;background:#e8e4eb;overflow:hidden}.dimension-meter i{display:block;height:100%;border-radius:99px;background:#8977b4;transition:width .3s ease}.report-dimension-row.is-missing .dimension-meter{height:4px;background:repeating-linear-gradient(90deg,#d8d2dc 0 5px,transparent 5px 9px);border:1px dashed #c9c1ce}.report-dimension-row.is-missing .dimension-meter i{display:none}.report-dimension-row small{display:block;color:#99929e;font-size:6px;line-height:1.5}.report-advice{padding-top:21px}.report-advice h3{margin:0 0 12px;font:500 18px var(--serif)}.report-advice>div{min-height:37px;padding:7px 0;border-top:1px solid rgba(52,44,68,.07);display:grid;grid-template-columns:auto 1fr;align-items:center;gap:10px;transition:opacity .3s ease}.report-advice>div.advice-muted{opacity:.3}.report-advice p{margin:0;color:#67616e;font-size:8px;line-height:1.55}.report-callouts{position:absolute;inset:58px 0 0;pointer-events:none}.report-callout{position:absolute;width:220px;padding:0;border:0;background:transparent;display:grid;align-items:center;gap:8px;color:#77717d;pointer-events:auto;text-align:left;transition:color .2s ease}.report-callout>span{width:24px;height:24px;border:1px solid rgba(94,78,126,.14);border-radius:50%;background:rgba(255,255,255,.72);display:grid;place-items:center;font:6px var(--mono)}.report-callout>strong{font-size:9px;font-weight:400;line-height:1.5}.report-callout>i{position:absolute;height:1px;width:70px;background:rgba(112,95,151,.24)}.report-callout>i::after{content:"";position:absolute;top:-3px;width:7px;height:7px;border-radius:50%;background:#b2a4d3;box-shadow:0 0 0 4px rgba(178,164,211,.1)}.report-callout.active{color:#3e3748}.report-callout.active>span{background:#2f2a40;color:#fff}.report-callout.active>i{background:rgba(80,64,118,.48)}.callout-left{right:calc(50% + 335px);grid-template-columns:auto 1fr}.callout-left>i{right:-78px}.callout-left>i::after{right:-2px}.callout-right{left:calc(50% + 335px);grid-template-columns:auto 1fr}.callout-right>i{left:-78px}.callout-right>i::after{left:-2px}.callout-1{top:115px}.callout-2{top:245px}.callout-3{top:410px}.callout-4{top:285px}.callout-5{top:445px}.callout-6{top:655px}

.how-journey{position:relative}.how-chapter-anchor{display:block;position:relative;top:-20px;scroll-margin-top:45px}.how-chapter-rail{position:fixed;z-index:18;left:18px;top:50%;transform:translateY(-50%);padding:13px 9px;border:1px solid rgba(54,47,69,.08);border-radius:16px;background:rgba(255,255,255,.72);box-shadow:0 13px 38px rgba(52,42,69,.08);backdrop-filter:blur(16px);opacity:0;pointer-events:none;transition:opacity .3s ease}.how-chapter-rail.visible{opacity:1;pointer-events:auto}.how-chapter-rail>div{position:relative;display:flex;flex-direction:column;gap:5px}.how-chapter-rail>div::before{content:"";position:absolute;left:7px;top:17px;bottom:17px;width:1px;background:#ddd8e2}.how-chapter-rail button{position:relative;z-index:1;height:31px;padding:0 5px;border:0;background:transparent;display:grid;grid-template-columns:6px 23px 18px;align-items:center;gap:5px;color:#aaa4af;text-align:left}.how-chapter-rail button i{width:6px;height:6px;border-radius:50%;background:#d1ccd6;box-shadow:0 0 0 3px rgba(255,255,255,.9)}.how-chapter-rail button span,.how-chapter-rail button strong{font:7px var(--mono);font-weight:400}.how-chapter-rail button.active{color:#302a40}.how-chapter-rail button.active i{background:#302a40}.how-chapter-rail .how-report-link{width:64px;height:auto;margin-top:10px;padding:10px 2px 1px;border-top:1px solid var(--line);display:block;text-align:center;font-size:6px;color:#77717e}

.app-shell { height: 100vh; display: grid; grid-template-columns: 256px minmax(0,1fr); background: #f8f7fa; overflow: hidden; }
.app-shell.sidebar-collapsed{grid-template-columns:76px minmax(0,1fr)}
.sidebar { border-right: 1px solid var(--line); background: rgba(248,247,250,.92); padding: 23px 14px 16px; display: flex; flex-direction: column; position: relative; z-index: 20; }
.sidebar,.app-shell{transition:grid-template-columns .28s ease,padding .28s ease}
.sidebar.collapsed{padding:22px 10px}.sidebar.collapsed .side-top{margin:0 -7px;padding-bottom:26px;justify-content:center}.sidebar.collapsed .side-top .logo{display:none}.sidebar.collapsed .side-top-actions{gap:2px}.sidebar.collapsed .sidebar-toggle{display:grid}.sidebar.collapsed .new-analysis,.sidebar.collapsed .sidebar-report-library,.sidebar.collapsed .sidebar-help-guide{padding:0;justify-content:center}.sidebar.collapsed .new-analysis>span,.sidebar.collapsed .sidebar-report-library>span,.sidebar.collapsed .sidebar-help-guide>span{font-size:0}.sidebar.collapsed .side-label,.sidebar.collapsed .history button>span:last-child,.sidebar.collapsed .new-analysis small,.sidebar.collapsed .sidebar-report-library small,.sidebar.collapsed .side-bottom button>span:nth-child(2),.sidebar.collapsed .dots{display:none}.sidebar.collapsed .history button,.sidebar.collapsed .side-bottom button{justify-content:center}.sidebar.collapsed .history button{padding:7px}.sidebar.collapsed .history-empty{padding:12px 2px;font-size:0}.sidebar.collapsed .history-empty::after{content:"—";font-size:9px}.sidebar-collapsed .chat-composer-wrap{left:76px}
.side-top { display:flex;align-items:center;justify-content:space-between;padding:0 8px 27px; }
.side-top-actions{display:flex;align-items:center;gap:3px}
.icon-button { width: 34px;height:34px;border:0;background:transparent;border-radius:10px;display:grid;place-items:center;color:#777280; }
.icon-button:hover { background:#efedf3; }
.sidebar-search-button{flex:none}
.new-analysis { width:100%;height:44px;border:1px solid rgba(61,54,85,.12);border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 11px 0 14px;box-shadow:0 5px 18px rgba(37,30,54,.05);font-size:12px; }
.new-analysis > span {display:flex;align-items:center;gap:8px;font-weight:500}.new-analysis small{font:10px var(--mono);color:#9c97a5}
.sidebar-report-library{width:100%;height:39px;margin-top:7px;padding:0 11px 0 14px;border:0;border-radius:10px;background:transparent;color:#706978;display:flex;align-items:center;justify-content:space-between;font-size:11px;transition:background .2s ease,color .2s ease}.sidebar-report-library:hover{background:#eeecf2;color:#3f3947}.sidebar-report-library>span{display:flex;align-items:center;gap:8px}.sidebar-report-library>small{min-width:20px;height:20px;padding:0 6px;border-radius:99px;background:#e9e5ee;color:#81798a;display:grid;place-items:center;font:7px var(--mono)}
.sidebar-help-guide{width:100%;height:39px;margin-top:2px;padding:0 14px;border:0;border-radius:10px;background:transparent;color:#706978;display:flex;align-items:center;font-size:11px;transition:background .2s ease,color .2s ease}.sidebar-help-guide:hover{background:#eeecf2;color:#3f3947}.sidebar-help-guide>span{display:flex;align-items:center;gap:8px}
.side-label { font-size:10px;color:#9994a1;padding:25px 11px 9px; }
.history { display:flex;flex-direction:column;gap:3px; }
.history button { border:0;background:transparent;border-radius:11px;padding:8px;display:flex;gap:9px;text-align:left;align-items:center;min-width:0; }
.history button:hover,.history button.active { background:#eeecf2; }
.history-thumb { width:35px;height:35px;border-radius:8px;overflow:hidden;display:grid;place-items:center;flex:none;background:#eee; }
.history-thumb img {width:100%;height:100%;object-fit:cover}.history-thumb.purple{background:#e9e3fa;color:#756ca7}.history-thumb.blue{background:#e1ecf7;color:#6a82a0;font:500 16px var(--serif)}
.history button > span:last-child { min-width:0;display:flex;flex-direction:column;gap:3px; }
.history strong { font-size:11px;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.history small {font-size:9px;color:#9a95a2}
.history-empty{margin:8px;padding:18px 8px;border:1px dashed rgba(61,54,85,.12);border-radius:11px;color:#a09aa6;text-align:center;font-size:9px}
.global-search-backdrop{position:fixed;z-index:110;inset:0;padding:24px;background:rgba(31,27,39,.35);backdrop-filter:blur(7px);display:grid;place-items:start center}.global-search-dialog{width:min(760px,100%);max-height:calc(100vh - 48px);margin-top:4vh;overflow:hidden;border:1px solid rgba(255,255,255,.9);border-radius:27px;background:rgba(255,255,255,.98);box-shadow:0 35px 110px rgba(35,28,47,.28);display:flex;flex-direction:column;animation:account-dialog-in .24s ease both}.global-search-header{min-height:84px;padding:18px 21px 12px 26px;display:flex;align-items:center;gap:14px}.global-search-input{flex:1;display:flex;align-items:center;gap:12px;color:#817a88}.global-search-input input{width:100%;padding:10px 0;border:0;background:transparent;color:#312b39;font-size:19px}.global-search-input input::placeholder{color:#aaa4ae}.global-search-input input:focus{outline:0}.global-search-input>button,.global-search-close{width:32px;height:32px;padding:0;border:0;border-radius:9px;background:transparent;color:#817a88;display:grid;place-items:center}.global-search-input>button:hover,.global-search-close:hover{background:#f1eef3;color:#3b3541}.global-search-tabs{padding:0 26px 17px;border-bottom:1px solid var(--line);display:flex;gap:8px}.global-search-tabs>button{min-width:145px;padding:10px 12px;border:1px solid transparent;border-radius:13px;background:transparent;display:grid;grid-template-columns:auto 1fr;gap:2px 9px;text-align:left;color:#817b86}.global-search-tabs>button:hover{background:#f6f4f7}.global-search-tabs>button.active{border-color:rgba(73,60,95,.09);background:#f0eef2;color:#302a39}.global-search-tabs>button>span{grid-row:1/3;width:31px;height:31px;border-radius:9px;background:#fff;display:grid;place-items:center;box-shadow:0 4px 13px rgba(51,42,65,.06)}.global-search-tabs strong{font-size:10px;font-weight:500}.global-search-tabs small{font-size:7px;color:#9a949f}.global-search-results{min-height:300px;overflow:auto;padding:21px 26px 25px}.global-search-result-heading{height:31px;display:flex;align-items:flex-start;justify-content:space-between;color:#8d8692;font-size:9px}.global-search-result-heading small{font-size:7px;color:#aaa4ae}.global-search-result{width:100%;min-height:65px;padding:9px 11px;border:0;border-radius:13px;background:transparent;display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:12px;text-align:left}.global-search-result:hover,.global-search-result:focus-visible{background:#f3f0f5}.global-search-result-icon{width:39px;height:39px;border-radius:11px;background:#eeeaf4;color:#695c80;display:grid;place-items:center}.global-search-result-icon.report{background:#e8f1ed;color:#537565}.global-search-result>span:nth-child(2){min-width:0;display:flex;flex-direction:column;gap:4px}.global-search-result strong{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.global-search-result small{font-size:8px;color:#99929e}.global-search-result>b{font:500 18px var(--serif);color:#51495a}.global-search-result>b small{font:6px var(--mono);margin-left:2px}.global-search-result>i{font-size:20px;font-style:normal;color:#aaa4ae}.global-search-empty{min-height:235px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#9a939f;text-align:center}.global-search-empty strong{margin-top:12px;color:#615967;font-size:11px;font-weight:500}.global-search-empty small{margin-top:5px;font-size:8px}.global-search-footer{min-height:48px;padding:0 26px;border-top:1px solid var(--line);background:#faf9fb;display:flex;align-items:center;justify-content:space-between;color:#99929e;font-size:7px}.global-search-footer kbd{padding:3px 6px;border:1px solid rgba(64,53,78,.12);border-radius:5px;background:#fff;font:7px var(--mono);box-shadow:0 1px 2px rgba(50,42,60,.06)}
.side-bottom { margin-top:auto;border-top:1px solid var(--line);padding-top:10px;display:flex;flex-direction:column;gap:3px; }
.side-bottom button { min-height:42px;border:0;background:transparent;border-radius:11px;display:flex;align-items:center;gap:10px;padding:6px 9px;text-align:left;font-size:11px; }
.side-bottom button:hover,.side-bottom button.active{background:#eeecf2}.side-bottom button>span:nth-child(2){display:flex;flex-direction:column;flex:1;gap:2px}.side-bottom small{font-size:9px;color:#928d9a}.dots{margin-left:auto;color:#96919d;display:grid;place-items:center}
.avatar { width:29px;height:29px;border-radius:50%;display:grid!important;place-items:center;background:linear-gradient(135deg,#d9d0fa,#f4d6d7);font:9px var(--mono);flex:none!important; }
.account-menu-scrim{position:fixed;z-index:58;inset:0;border:0;background:transparent;cursor:default}.account-menu{position:absolute;z-index:60;left:12px;right:12px;bottom:72px;padding:8px;border:1px solid rgba(51,43,66,.1);border-radius:17px;background:rgba(255,255,255,.97);box-shadow:0 22px 65px rgba(42,34,56,.2);backdrop-filter:blur(22px);animation:account-menu-in .22s ease both}.account-menu>button{width:100%;min-height:58px;padding:9px 8px;border:0;border-radius:11px;background:transparent;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;text-align:left}.account-menu>button:hover{background:#f2f0f4}.account-menu-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;color:#4a4550}.account-menu>button>span:nth-child(2){display:flex;flex-direction:column;gap:3px}.account-menu strong{font-size:11px;font-weight:500}.account-menu small{font-size:8px;color:#99939f}.account-menu>button>i{font-size:20px;font-style:normal;color:#aaa5ae}.account-menu-reset{color:#7b5056}.account-menu-divider{height:1px;margin:5px 8px;background:var(--line)}.account-dialog-backdrop{position:fixed;z-index:90;inset:0;padding:20px;background:rgba(31,27,39,.24);backdrop-filter:blur(5px);display:grid;place-items:center}.account-dialog{position:relative;width:min(460px,100%);max-height:min(680px,calc(100vh - 40px));overflow:auto;padding:30px;border:1px solid rgba(255,255,255,.9);border-radius:23px;background:rgba(255,255,255,.97);box-shadow:0 30px 90px rgba(39,31,52,.22);animation:account-dialog-in .25s ease both}.account-dialog-close{position:absolute;right:15px;top:14px;width:31px;height:31px;padding:0;border:0;border-radius:9px;background:#f2eff4;color:#77717e;font-size:18px}.account-dialog-tag{font:7px var(--mono);letter-spacing:.1em;color:#938b9a}.account-dialog h2{margin:10px 0 8px;font:500 28px/1.2 var(--serif);letter-spacing:-.03em}.account-dialog>p{margin:0;color:#77717d;font-size:10px;line-height:1.75}.help-guide{margin-top:24px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.help-guide section{padding:15px;border:1px solid var(--line);border-radius:15px;background:#faf9fb}.help-guide h3{margin:0 0 12px;font-size:10px;font-weight:500}.help-guide ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}.help-guide li{display:grid;grid-template-columns:auto 1fr;gap:9px}.help-guide li>span{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#ebe7ff;color:#6e618f;font:7px var(--mono)}.help-guide li>div{display:flex;flex-direction:column;gap:3px}.help-guide li strong{font-size:8px;font-weight:500}.help-guide li small{color:#96909c;font-size:7px;line-height:1.5}.help-faq details{border-top:1px solid var(--line);padding:9px 0}.help-faq summary{cursor:pointer;font-size:8px}.help-faq details p{margin:7px 0 0;color:#918b97;font-size:7px;line-height:1.55}.reset-summary{margin-top:22px;padding:13px 15px;border-radius:13px;background:#f7f4f7;display:grid;grid-template-columns:1fr auto;gap:9px;font-size:8px}.reset-summary span{color:#918a96}.reset-summary strong{font-weight:500}.account-dialog-actions{margin-top:24px;display:flex;justify-content:flex-end;gap:8px}.account-dialog-actions button{min-width:88px;height:37px;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:9px}.account-dialog-actions button:last-child{border-color:#302a40;background:#302a40;color:#fff}.account-dialog-actions button.danger{border-color:#8d5c63;background:#8d5c63}.account-dialog-actions button:disabled{opacity:.35;cursor:not-allowed}.account-input-label{display:flex;flex-direction:column;gap:8px;margin-top:22px;color:#77717d;font-size:8px}.account-input-label input{width:100%;height:42px;padding:0 12px;border:1px solid var(--line);border-radius:11px;background:#faf9fb;font-size:10px;outline:none}.account-input-label input:focus{border-color:rgba(112,95,167,.45);box-shadow:0 0 0 3px rgba(112,95,167,.08)}.account-added{margin-top:24px;padding:24px;border-radius:15px;background:#eef5f1;text-align:center;display:flex;flex-direction:column;align-items:center;gap:5px}.account-added>span{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#dcece3;color:#527b67}.account-added strong{font-size:10px}.account-added small{color:#7f9388;font-size:8px}

.workspace { position:relative;overflow:hidden;background:radial-gradient(circle at 50% 30%,#fff 0,#f9f8fb 58%,#f5f3f8 100%); }
.workspace::before {content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(51,45,70,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(51,45,70,.03) 1px,transparent 1px);background-size:54px 54px;mask-image:radial-gradient(circle at center,black,transparent 74%);}
.workspace-orb {position:absolute;border-radius:50%;filter:blur(70px);opacity:.33}.orb-left{width:370px;height:370px;background:#d7cafa;left:4%;top:12%}.orb-right{width:430px;height:300px;background:#f7d6d0;right:0;bottom:2%}
.workspace-header,.chat-header,.result-header { height:66px;border-bottom:1px solid var(--line);padding:0 26px;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:3;background:rgba(250,249,251,.68);backdrop-filter:blur(16px); }
.workspace-header>div {font-size:10px;color:#716c7a;display:flex;align-items:center;gap:8px}
.workspace-status-group{display:flex;align-items:center;gap:10px!important}.agent-online{display:flex;align-items:center;gap:8px}.workspace-home{width:38px;height:38px;padding:0;border:0;border-radius:10px;background:transparent;display:grid;place-items:center;color:#aaa8ad;transition:background .2s,color .2s}.workspace-home:hover{background:rgba(48,43,58,.05);color:#55515b}
.workspace-center { width:min(690px,calc(100% - 40px));margin:0 auto;position:relative;z-index:2;padding-top:clamp(44px,8vh,100px);text-align:center; }
.agent-symbol {width:55px;height:55px;margin:auto;display:grid;place-items:center;border-radius:18px;color:#6d609d;background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(224,215,249,.8));box-shadow:0 12px 35px rgba(77,61,120,.13),inset 0 0 0 1px rgba(255,255,255,.8)}
.hello {font:11px var(--mono);color:#8b8493;letter-spacing:.04em;margin:18px 0 8px}.workspace-center h2{font:500 clamp(37px,4vw,52px)/1.05 var(--serif);letter-spacing:-.04em;margin:0}
.workspace-intro{max-width:510px;margin:14px auto 25px;color:#797483;font-size:12px;line-height:1.75;font-weight:300}
.composer { text-align:left;background:rgba(255,255,255,.84);border:1px solid rgba(53,46,75,.13);border-radius:18px;padding:10px;box-shadow:0 16px 50px rgba(52,43,76,.1);backdrop-filter:blur(22px);transition:border .2s,box-shadow .2s; }
.composer:focus-within{border-color:rgba(112,95,167,.38);box-shadow:0 20px 55px rgba(71,55,109,.14)}
.composer textarea{width:100%;border:0;resize:none;background:transparent;padding:9px 10px;color:#34303f;font-size:13px;line-height:1.6;display:block}
.composer textarea::placeholder{color:#a29daa}.composer textarea:focus{outline:none}
.composer-account-field{display:flex;align-items:center;gap:10px;margin:2px 8px 7px;padding:7px 9px;border-top:1px solid rgba(53,46,75,.08)}
.composer-account-field>span{flex:none;color:#8a8491;font-size:10px}
.composer-account-field>input{min-width:0;flex:1;border:0;background:transparent;color:#504a58;font-size:10px;outline:none}
.composer-account-field>input::placeholder{color:#b2acb7}
.composer-account-field:focus-within>span{color:#6e6194}
.composer-account-method{margin:0 8px 9px;padding:10px 11px;border:1px dashed rgba(109,93,147,.2);background:rgba(244,242,249,.8);text-align:left}
.composer-account-method>header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
.composer-account-method>header strong{color:#514a5d;font-size:11px;font-weight:500}
.composer-account-method>header>span{display:inline-flex;align-items:center;gap:5px;color:#9a8f78;font:8px var(--mono);white-space:nowrap}
.composer-account-method>header>span i{width:5px;height:5px;border-radius:50%;background:#c6a66d}
.composer-account-method>header>span.ready{color:#4e7862}
.composer-account-method>header>span.ready i{background:#68a184}
.composer-account-method ol{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}
.composer-account-method li{min-width:150px;flex:1;display:grid;grid-template-columns:20px 1fr;gap:7px;align-items:start;padding:8px;background:rgba(255,255,255,.58)}
.composer-account-method li>b{width:18px;height:18px;display:grid;place-items:center;border-radius:50%;background:#ebe6f2;color:#6e6188;font:7px var(--mono);font-weight:500}
.composer-account-method li>span{color:#5f5869;font-size:10px;line-height:1.55}
.composer-account-method code{font:8px var(--mono);color:#6b598f;background:#eee9f6;padding:1px 3px}
.composer-account-method-actions{display:flex;gap:6px;margin-top:8px}
.composer-account-method-actions button{min-height:30px;padding:0 11px;border:1px solid rgba(91,77,121,.17);background:#fff;color:#625b6c;display:inline-flex;align-items:center;gap:5px;font-size:9px}
.composer-account-method-actions button:last-child{border-color:#3d364b;background:#3d364b;color:#fff}
.composer-account-method-actions button:hover{border-color:#756792}
.composer-account-error{margin:0 10px 7px;color:#9a4b57;font-size:10px;line-height:1.5}
.new-analysis-composer{padding:0;overflow:hidden}
.analysis-mode-switch{display:grid;grid-template-columns:1fr 1fr;background:transparent;border-bottom:1px solid rgba(53,46,75,.09)}
.analysis-mode-switch button{min-height:46px;padding:8px 12px;border:0;background:transparent;color:#8a8490;display:flex;align-items:center;justify-content:center;text-align:center;font-size:12px}
.analysis-mode-switch button.active{color:#332d3d;font-weight:600;box-shadow:inset 0 -2px #6d5d96}
.new-analysis-link-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 14px 9px}
.new-analysis-field{display:flex;flex-direction:column;gap:7px;padding:10px;border:1px solid rgba(53,46,75,.1);background:#faf9fb;text-align:left}
.new-analysis-field>span{display:flex;align-items:center;gap:6px;color:#5b5563;font-size:10px}
.new-analysis-field>span b{font:8px var(--mono);color:#8b7fa6}
.new-analysis-field>span em{margin-left:auto;padding:2px 5px;border:1px solid rgba(109,93,147,.16);color:#75698f;font:normal 7px var(--mono)}
.new-analysis-field input,.new-analysis-field textarea{width:100%;border:0;background:transparent;color:#34303f;font-size:12px;line-height:1.6;outline:none;resize:none}
.new-analysis-field input::placeholder,.new-analysis-field textarea::placeholder{color:#aaa4af}
.new-analysis-method{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 14px;padding:9px 10px;border:1px dashed rgba(109,93,147,.18);background:rgba(244,242,249,.72)}
.new-analysis-method>span{color:#6e6876;font-size:9px;line-height:1.55}
.new-analysis-method>div{display:flex;gap:6px;flex:none}
.new-analysis-method button{min-height:28px;padding:0 9px;border:1px solid rgba(91,77,121,.17);background:#fff;color:#625b6c;display:inline-flex;align-items:center;gap:4px;font-size:8px}
.new-analysis-method button:last-child{background:#3d364b;border-color:#3d364b;color:#fff}
.new-analysis-manual{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(210px,.7fr);gap:10px;padding:14px}
.new-analysis-creator{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(250px,.8fr);gap:10px;padding:14px}
.new-analysis-creator>.new-analysis-field{grid-row:1 / 3}
.creator-upload{min-height:126px;align-content:start;gap:9px}
.creator-preview-grid{width:100%;display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.creator-preview-grid figure{position:relative;aspect-ratio:1;margin:0;overflow:hidden;background:#eeeaf1}
.creator-preview-grid img{width:100%;height:100%;object-fit:cover}
.creator-preview-grid button{position:absolute;right:3px;top:3px;width:20px;height:20px;padding:0;border:0;background:rgba(38,33,47,.76);color:#fff}
.creator-form-options{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 2px}
.creator-form-options label{display:flex;align-items:center;gap:6px;color:#6e6875;font-size:9px}
.creator-form-options input[type=checkbox]{accent-color:#75658f}
.creator-form-options select{min-height:29px;border:1px solid rgba(61,50,76,.12);background:#fff;color:#5e5766;font-size:9px}
.new-analysis-upload{min-height:154px;border:1px dashed rgba(91,77,121,.2);background:#faf9fb;display:grid;place-items:center;padding:10px}
.new-analysis-upload-button{width:100%;height:100%;border:0;background:transparent;color:#625b6c;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:10px}
.new-analysis-upload-button small{font-size:8px;color:#a19ba7}
.new-analysis-file{width:100%;display:grid;grid-template-columns:52px minmax(0,1fr) auto;align-items:center;gap:9px;text-align:left}
.new-analysis-file img{width:52px;height:52px;object-fit:cover}
.new-analysis-file>span{min-width:0;display:flex;flex-direction:column;gap:3px}
.new-analysis-file strong{font-size:9px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.new-analysis-file small{font-size:7px;color:#958f9b}
.new-analysis-file>button{width:25px;height:25px;border:0;background:#efedf1;color:#766f7d}
.new-analysis-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 14px 14px;border-top:1px solid rgba(53,46,75,.08)}
.new-analysis-actions>span{color:#918b97;font-size:8px}
.new-analysis-submit{min-height:38px;padding:0 6px 0 14px;border:0;border-radius:99px;background:#302d3c;color:#fff;display:inline-flex;align-items:center;gap:12px;font-size:10px}
.new-analysis-submit>span{width:28px;height:28px;border-radius:50%;background:#fff;color:#302d3c;display:grid;place-items:center}
.new-analysis-submit:disabled{opacity:.3;cursor:not-allowed}
.new-analysis-error{margin:0 14px 10px;color:#9a4b57;font-size:9px;line-height:1.55}
@media (max-width:720px){
  .new-analysis-link-fields,.new-analysis-manual,.new-analysis-creator{grid-template-columns:1fr}
  .new-analysis-creator>.new-analysis-field{grid-row:auto}
  .new-analysis-method{align-items:flex-start;flex-direction:column}
  .new-analysis-method>div{width:100%}
  .new-analysis-method button{flex:1;justify-content:center}
  .new-analysis-actions{align-items:flex-end;flex-direction:column}
}
.composer-actions{display:flex;align-items:center;justify-content:space-between;margin-top:5px}.composer-actions>div{display:flex;align-items:center;gap:3px}
.tool-button{width:32px;height:32px;border:0;background:transparent;border-radius:9px;display:grid;place-items:center;color:#77717e}.tool-button:hover{background:#f1eef4}
.composer-submit-actions{display:flex;align-items:center;gap:20px}.composer-pause{width:36px;height:36px;padding:0;border:0;border-radius:50%;background:#f2f1f3;color:#292a31;display:grid;place-items:center;transition:background .2s,transform .2s,color .2s;box-shadow:inset 0 0 0 1px rgba(45,42,52,.02)}.composer-pause:hover{background:#e9e7eb;transform:scale(1.04)}.composer-pause.paused{background:#302a40;color:#fff}.composer-pause:disabled{cursor:default;opacity:.4;background:#f1eff2;color:#938d99;transform:none}
.composer-hint{font-size:9px;color:#aaa5b0;margin-left:5px}.send-button{width:34px;height:34px;border:0;background:#302d3c;color:#fff;border-radius:10px;display:grid;place-items:center;transition:transform .2s}.send-button:disabled{opacity:.25;cursor:not-allowed}.send-button:not(:disabled):hover{transform:scale(1.05)}
.file-chip{margin:0 8px 5px;padding:6px;border:1px solid var(--line);border-radius:10px;display:flex;align-items:center;gap:8px;background:#f9f7fb}.file-preview{width:36px;height:36px;border-radius:7px;overflow:hidden}.file-preview img{width:100%;height:100%;object-fit:cover}.file-chip>span:nth-child(2){display:flex;flex-direction:column;gap:2px;min-width:0}.file-chip strong{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.file-chip small{font-size:8px;color:#918b99}.file-chip button{margin-left:auto;border:0;background:none;color:#888}
.suggestions { display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px; }
.suggestions button { min-width:0;border:1px solid rgba(54,48,73,.09);border-radius:12px;background:rgba(255,255,255,.48);padding:10px;display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:center;text-align:left;transition:background .2s,transform .2s; }
.suggestions button:hover{background:white;transform:translateY(-2px)}.suggestions button>span:nth-child(2){min-width:0;display:flex;flex-direction:column;gap:3px}.suggestions strong{font-size:10px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.suggestions small{font-size:8px;color:#9993a0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.suggestion-icon{width:31px;height:31px;border-radius:9px;display:grid;place-items:center;font:500 15px var(--serif)}.s-1{background:#eee9fd;color:#7467a3}.s-2{background:#e6f0fa;color:#58758e}.s-3{background:#f9e7e4;color:#a87169}
.privacy-note{display:block;color:#aaa5af;font-size:8px;margin-top:18px}

.chat,.result{height:100vh;min-width:0;display:flex;flex-direction:column;background:#fbfafc}.chat-header>div{display:flex;flex-direction:column;gap:3px}.chat-header strong{font-size:12px;font-weight:500}.chat-header small{font-size:9px;color:#99939f}.header-share,.result-actions button{border:1px solid var(--line);background:rgba(255,255,255,.65);height:34px;padding:0 12px;border-radius:10px;display:flex;align-items:center;gap:7px;font-size:10px}
.chat-header>.chat-header-actions{display:flex;flex-direction:row;align-items:center;gap:6px}.chat-home-button,.analysis-pause-button{height:34px;padding:0 10px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.65);display:flex;align-items:center;gap:6px;font-size:9px;color:#77707f;transition:background .2s,color .2s,border-color .2s}.chat-home-button:hover,.analysis-pause-button:hover{background:#fff;color:#423a4d}.analysis-pause-button{background:#f0ecf7;color:#675783;border-color:#e2daef}.analysis-pause-button.paused{background:#302a40;color:#fff;border-color:#302a40}
.chat-home-button{width:38px;height:38px;padding:0;border:0;background:transparent;display:grid;place-items:center;color:#aaa8ad}.chat-home-button:hover{background:rgba(48,43,58,.05);color:#55515b}
.chat-header>.chat-header-main{display:flex;flex-direction:row;align-items:center;gap:10px}.chat-header-title{display:flex;flex-direction:column;gap:3px}
.analysis-pause-button:disabled{cursor:default;opacity:.45;background:#f4f2f5;color:#938d99;border-color:var(--line)}
.share-wrap{position:relative}.chat-header>.share-wrap{display:block}.share-menu{position:absolute;z-index:50;right:0;top:calc(100% + 9px);width:275px;padding:8px;border:1px solid rgba(47,40,61,.1);border-radius:16px;background:rgba(255,255,255,.96);box-shadow:0 22px 60px rgba(42,33,58,.16);backdrop-filter:blur(20px);animation:share-in .25s ease both}.share-menu::before{content:"";position:absolute;right:18px;top:-5px;width:9px;height:9px;background:#fff;border-left:1px solid rgba(47,40,61,.1);border-top:1px solid rgba(47,40,61,.1);transform:rotate(45deg)}.share-menu-title{padding:9px 9px 12px;display:flex;flex-direction:column;gap:3px}.share-menu-title strong{font-size:11px;font-weight:500}.share-menu-title small{font-size:8px;color:#918b98}.share-menu>button{width:100%;height:auto;min-height:58px;border:0;border-top:1px solid rgba(48,40,62,.07);border-radius:0;background:transparent;padding:9px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;text-align:left}.share-menu>button:hover{background:#f6f3f8;border-radius:10px}.share-action-icon{width:34px;height:34px;border-radius:10px;background:#ebe7f5;color:#6c5f88;display:grid;place-items:center}.share-action-icon.pdf{background:#f5e9e8;color:#926865}.share-menu>button>span:nth-child(2){display:flex;flex-direction:column;gap:3px}.share-menu>button strong{font-size:9px;font-weight:500}.share-menu>button small{font-size:7px;color:#98929e}.copy-state{font:7px var(--mono);color:#99919f}.copy-state.copied{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:#e4f1ea;color:#4f7b65}.share-menu>p{font-size:7px;color:#aaa4ae;text-align:center;margin:7px 0 3px}
.share-action-icon.image{background:#e7f0f3;color:#5f7b86}
.chat-scroll{flex:1;overflow:auto;padding:38px max(30px,calc((100% - 790px)/2)) 190px;scrollbar-width:thin}
.user-message{display:flex;justify-content:flex-end;align-items:flex-start;gap:10px;margin-bottom:38px}.user-message>div{max-width:520px;background:#eeebf1;border-radius:16px 3px 16px 16px;padding:13px}.user-message p{margin:0 2px 10px;font-size:12px;line-height:1.6}
.user-avatar{width:32px;height:32px;background:linear-gradient(135deg,#cabff0,#f2cfd1)}.message-attachment{width:250px;border-radius:11px;background:rgba(255,255,255,.65);padding:6px;display:flex;align-items:center;gap:9px}.message-attachment img{width:42px;height:42px;object-fit:cover;border-radius:8px}.message-attachment>span{display:flex;flex-direction:column;gap:3px}.message-attachment strong{font-size:9px}.message-attachment small{font-size:8px;color:#928c98}
.agent-message{display:flex;align-items:flex-start;gap:12px}.agent-avatar{width:33px;height:33px;flex:none;border-radius:11px;display:grid;place-items:center;background:#2f2b3e;color:#fff}.agent-content{width:100%;max-width:720px}.agent-name{font-size:11px;font-weight:600;margin:3px 0 15px}.agent-name span{font-size:8px;color:#9b95a2;font-weight:400;margin-left:6px}.agent-content>p{font-size:12px;line-height:1.8;color:#575260;margin-bottom:17px}
.trus-council{border:1px solid rgba(54,47,70,.11);border-radius:17px;background:rgba(255,255,255,.78);overflow:hidden;box-shadow:0 12px 40px rgba(49,39,68,.05);transition:border-color .4s,box-shadow .4s}.trus-council.is-thinking{border-color:rgba(112,92,157,.2);box-shadow:0 15px 45px rgba(75,58,112,.08)}.council-header{padding:15px 16px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;background:linear-gradient(120deg,rgba(243,239,251,.9),rgba(249,246,247,.7));border-bottom:1px solid var(--line)}.council-avatars{display:flex;padding-left:8px}.council-avatar{position:relative;width:33px;height:33px;border-radius:50%;margin-left:-8px;border:2px solid #f8f5fa;overflow:visible;background:#e7e2ec}.council-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 20%;border-radius:50%;filter:saturate(.65)}.council-avatar i{position:absolute;right:-3px;bottom:-2px;width:14px;height:14px;border-radius:5px;display:grid;place-items:center;background:#fff;font:6px var(--mono);font-style:normal;box-shadow:0 2px 7px rgba(44,35,58,.14)}.council-avatar.role-t i{color:#7060a0}.council-avatar.role-r i{color:#577890}.council-avatar.role-u i{color:#a16e66}.council-avatar.role-s i{color:#557c68}.council-title{display:flex;flex-direction:column;gap:3px}.council-title>span{font:6px var(--mono);letter-spacing:.08em;color:#968f9c}.council-title strong{font-size:10px;font-weight:500}.council-title small{font-size:7px;color:#98919d}.council-state{display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:99px;background:rgba(255,255,255,.7);font-size:7px;color:#817a87;white-space:nowrap}.council-state i{width:5px;height:5px;border-radius:50%;background:#7cb796}.is-thinking .council-state i{background:#8b7caf;box-shadow:0 0 0 4px rgba(139,124,175,.13);animation:pulse 1.4s infinite}.council-columns{min-height:28px;padding:0 17px;display:grid;grid-template-columns:1fr 50px 62px;align-items:center;border-bottom:1px solid var(--line);font-size:7px;color:#a09aa4}.council-columns span:nth-child(n+2){text-align:center}.council-role-wrap{position:relative;border-bottom:1px solid var(--line);background:rgba(255,255,255,.55);transition:background .25s}.council-role-wrap:last-child{border-bottom:0}.council-role-wrap:hover,.council-role-wrap.expanded{background:#faf8fb}.council-role{width:100%;min-height:72px;padding:10px 16px;border:0;background:transparent;display:grid;grid-template-columns:1fr 50px 62px 12px;align-items:center;gap:6px;text-align:left;animation:role-in .55s var(--role-delay) ease both}.role-persona{display:flex;align-items:center;gap:10px;min-width:0}.role-avatar{width:38px;height:38px;flex:none;border-radius:12px;position:relative;background:#ece8ef}.role-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 18%;border-radius:12px;filter:saturate(.6)}.role-avatar i{position:absolute;right:-4px;bottom:-4px;width:17px;height:17px;border-radius:6px;background:#fff;display:grid;place-items:center;font:7px var(--mono);font-style:normal;box-shadow:0 3px 9px rgba(46,36,61,.15)}.role-t .role-avatar i{color:#7060a0}.role-r .role-avatar i{color:#577890}.role-u .role-avatar i{color:#a16e66}.role-s .role-avatar i{color:#557c68}.role-persona>span:last-child{min-width:0;display:grid;grid-template-columns:auto 1fr;align-items:baseline;column-gap:6px}.role-persona strong{font-size:9px;font-weight:500}.role-persona small{font:6px var(--mono);color:#99929f}.role-persona p{grid-column:1/3;margin:4px 0 0;font-size:7px;line-height:1.5;color:#7f7985;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.role-weight{text-align:center;font:8px var(--mono);color:#85808b}.role-judgement{display:flex;flex-direction:column;align-items:center;gap:2px}.role-judgement strong{font:500 16px var(--serif)}.role-judgement small{font-size:6px;color:#85808c;white-space:nowrap}.role-judgement>i{width:16px;height:16px;border-radius:50%;border:2px solid #ddd7e3;border-top-color:#7e6e9d;animation:spin .8s linear infinite}.role-chevron{font-size:12px;color:#aaa4ae;transition:transform .25s}.expanded .role-chevron{transform:rotate(180deg)}.role-progress{position:absolute;left:64px;right:131px;bottom:0;height:1px;overflow:hidden}.role-progress i{display:block;width:0;height:100%;background:linear-gradient(90deg,#9889ba,#b8a3c0);transition:width .8s ease}.is-thinking .role-progress i{width:38%;animation:role-progress 1.8s ease-in-out infinite}.is-complete .role-progress i{width:var(--role-score)}.role-evidence{padding:10px 17px 12px 64px;display:flex;gap:6px;flex-wrap:wrap;border-top:1px dashed rgba(54,47,70,.08);animation:message-in .3s ease both}.role-evidence>span{font:6px var(--mono);color:#9d96a2;padding:5px 0;margin-right:3px}.role-evidence p{font-size:7px;color:#706a76;margin:0;padding:5px 7px;border-radius:7px;background:#f0ecf4}.council-result{min-height:46px;padding:0 17px;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(90deg,#f8f5fa,#f3f6f5)}.council-result>div{display:flex;align-items:center;gap:7px}.council-result>div:first-child span{font:7px var(--mono);color:#807987}.council-result>div:first-child i{font-size:9px;color:#b1aab5;font-style:normal}.council-result>div:last-child small{font-size:7px;color:#99929e}.council-result>div:last-child strong{font:500 20px var(--serif);margin-left:4px}.council-result>div:last-child>span:not(.council-loading){font-size:7px;color:#4f7a65;padding:5px 7px;border-radius:99px;background:#e4f1ea}.council-loading{display:flex;gap:3px}.council-loading i{width:4px;height:4px;border-radius:50%;background:#897c9d;animation:bounce 1s infinite}.council-loading i:nth-child(2){animation-delay:.15s}.council-loading i:nth-child(3){animation-delay:.3s}
.trus-council.is-paused *{animation-play-state:paused!important}
.reasoning-flow{padding:12px 16px 10px;border-bottom:1px solid var(--line);background:rgba(250,248,252,.72)}.reasoning-flow-steps{display:grid;grid-template-columns:repeat(5,1fr)}.reasoning-flow-steps>div{position:relative;display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;color:#a19ba6}.reasoning-flow-steps>div::after{content:"";position:absolute;z-index:0;left:calc(50% + 11px);right:calc(-50% + 11px);top:9px;height:1px;background:#ded9e3}.reasoning-flow-steps>div:last-child::after{display:none}.reasoning-flow-steps span{position:relative;z-index:1;width:19px;height:19px;border-radius:50%;display:grid;place-items:center;background:#f3f0f5;border:1px solid #ddd7e2;font:6px var(--mono);transition:background .35s,border-color .35s,color .35s,transform .35s}.reasoning-flow-steps small{font-size:6px;line-height:1.35;white-space:nowrap}.reasoning-flow-steps .active span{color:#fff;background:#796a9c;border-color:#796a9c;box-shadow:0 0 0 5px rgba(121,106,156,.1);animation:pulse 1.4s infinite}.reasoning-flow-steps .active small{color:#655b74}.reasoning-flow-steps .completed span{color:#4e8068;background:#e3f1e9;border-color:#cde5d9}.reasoning-flow-steps .completed::after{background:#bad7c9}.reasoning-flow>p{margin:10px 0 0;min-height:25px;border-radius:8px;background:#fff;padding:7px 9px;display:flex;align-items:center;gap:7px;color:#716979;font-size:7px;animation:message-in .35s ease both}.reasoning-flow>p svg{color:#78699a}.reasoning-finding{padding:10px 16px;border-top:1px solid var(--line);background:linear-gradient(90deg,#f7f3fb,#faf7f6);display:grid;grid-template-columns:auto 1fr;align-items:start;gap:10px;animation:message-in .35s ease both}.reasoning-finding>span{font:6px var(--mono);letter-spacing:.06em;padding:5px 7px;border-radius:6px;background:#ece6f4;color:#6d5d86;white-space:nowrap}.reasoning-finding>p{font-size:7px;line-height:1.6;color:#6f6875;margin:2px 0}.reasoning-finding.stage-2{background:linear-gradient(90deg,#faf1ef,#faf8f6)}.reasoning-finding.stage-2>span{background:#f3e1de;color:#95655f}.reasoning-finding.stage-4{background:linear-gradient(90deg,#eef5f2,#f7f8f5)}.reasoning-finding.stage-4>span{background:#e1eee8;color:#507764}
.expert-debate{padding:11px 15px 12px;border-top:1px solid var(--line);background:linear-gradient(110deg,#f8f5fb,#faf8f7);animation:message-in .35s ease both}.debate-header{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:9px}.debate-header>span{display:flex;align-items:center;gap:6px;font:6px var(--mono);letter-spacing:.07em;color:#8a8291}.debate-header>span i{width:5px;height:5px;border-radius:50%;background:#8373a4;box-shadow:0 0 0 4px rgba(131,115,164,.1)}.debate-header>small{font:6px var(--mono);color:#9a939f}.debate-cast{display:flex;gap:3px}.debate-cast i{width:18px;height:18px;border-radius:6px;display:grid;place-items:center;background:#eeeaf0;color:#aaa3af;font:6px var(--mono);font-style:normal;transition:background .25s,color .25s,transform .25s}.debate-cast i.heard{background:#e4f0ea;color:#5c806c}.debate-cast i.active{background:#332d43;color:#fff;transform:translateY(-2px);box-shadow:0 4px 10px rgba(49,41,63,.18)}.debate-message{margin-top:9px;display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;padding:10px;border-radius:11px;background:rgba(255,255,255,.82);border:1px solid rgba(61,49,78,.08);animation:message-in .32s ease both}.debate-avatar{width:35px;height:35px;border-radius:11px;position:relative;background:#ece8ef}.debate-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 18%;border-radius:11px;filter:saturate(.6)}.debate-avatar i{position:absolute;right:-4px;bottom:-4px;width:16px;height:16px;border-radius:6px;display:grid;place-items:center;background:#fff;font:6px var(--mono);font-style:normal;box-shadow:0 3px 8px rgba(48,39,61,.14)}.debate-message>div>span{display:flex;align-items:center;gap:7px}.debate-message strong{font-size:8px;font-weight:500}.debate-message small{font-size:6px;color:#887d96;padding:3px 5px;border-radius:99px;background:#eee9f4}.debate-message p{font-size:8px;line-height:1.6;color:#58515f;margin:5px 0 0}.debate-focus{margin-top:8px;display:flex;align-items:center;gap:7px;color:#88818d;font-size:6px}.debate-focus span{padding:3px 5px;border-radius:5px;background:#f2e5e3;color:#966c67}.debate-consensus{padding:11px 15px;border-top:1px solid var(--line);background:linear-gradient(90deg,#edf5f1,#f8f8f5);animation:message-in .35s ease both}.debate-consensus>span{display:flex;align-items:center;gap:7px;font-size:8px;font-weight:500;color:#4f705e}.debate-consensus>p{margin:6px 0 0;font-size:7px;line-height:1.6;color:#6e756f}
.thinking{font-size:9px;color:#96909d;margin-top:14px;display:flex;align-items:center;gap:4px}.thinking i{width:4px;height:4px;border-radius:50%;background:#8c82a7;animation:bounce 1s infinite}.thinking i:nth-child(2){animation-delay:.15s}.thinking i:nth-child(3){animation-delay:.3s}.thinking i:last-of-type{margin-right:5px}
.thinking.paused i{animation-play-state:paused}
.analysis-complete{margin-top:14px;border-radius:15px;background:linear-gradient(130deg,#f2eefc,#f8f2f2);padding:17px;display:grid;grid-template-columns:auto 1fr auto;gap:15px;align-items:center;border:1px solid rgba(103,84,150,.1)}.mini-score{width:76px;height:76px;border-radius:50%;background:conic-gradient(#7e70a8 0 calc(var(--mini-score,84)*1%),rgba(126,112,168,.14) 0);display:grid;place-items:center;position:relative}.mini-score::before{content:"";position:absolute;inset:6px;border-radius:50%;background:#f5f0fa}.mini-score span,.mini-score small{position:absolute;z-index:1}.mini-score span{font:10px var(--mono);top:19px}.mini-score span strong{font-size:22px}.mini-score small{font-size:7px;bottom:17px;color:#918a99}.analysis-complete>div:nth-child(2)>strong{font-size:11px}.analysis-complete>div:nth-child(2)>p{font-size:9px;line-height:1.65;color:#756f7c;margin:6px 0}.evidence-tags{display:flex;gap:5px;flex-wrap:wrap}.evidence-tags span{font-size:7px;padding:4px 6px;border-radius:99px;background:rgba(255,255,255,.7);border:1px solid rgba(47,39,67,.08)}
.appeal-button{margin-top:10px;padding:8px 17px;border:1px solid rgba(54,47,69,.14);border-radius:999px;background:rgba(255,255,255,.82);box-shadow:0 4px 14px rgba(52,42,69,.05);color:#56505d;font-size:9px;transition:background .2s,border-color .2s,color .2s}
.appeal-button:hover,.appeal-button:focus-visible{background:#eee9f8;border-color:#cfc3e5;color:#514564}
.appeal-button:disabled{cursor:default;background:#f0edf4;color:#81778e;border-color:transparent;box-shadow:none}
.argue-entry{padding:18px;border:1px solid rgba(105,84,150,.14);border-radius:17px;background:linear-gradient(135deg,#f5f1fb,#faf7f8);animation:message-in .4s ease both}
.argue-entry-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px}.argue-entry-head>span{display:flex;align-items:center;gap:7px;color:#62527d;font:7px var(--mono);letter-spacing:.07em}.argue-entry-head>small{padding:5px 7px;border-radius:99px;background:#eee8f5;color:#786b88;font-size:6px}
.argue-entry>strong{display:block;font:500 18px/1.4 var(--serif);color:#342d3e}.argue-entry>p{margin:7px 0 15px!important;color:#766e7c!important;font-size:8px!important;line-height:1.7!important}
.argue-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;align-items:start}.argue-option-card{overflow:hidden;border:1px solid rgba(64,51,82,.09);border-radius:12px;background:rgba(255,255,255,.82);transition:border-color .2s ease,box-shadow .2s ease,background .2s ease}.argue-option-card.selected{grid-row:span 2;border-color:#a895ce;background:#fff;box-shadow:0 10px 28px rgba(93,71,137,.11)}.argue-option-card>button{width:100%;min-height:61px;padding:9px 11px;border:0;background:transparent;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;text-align:left;color:#514a58;transition:background .2s ease}.argue-option-card>button:not(:disabled):hover,.argue-option-card>button:not(:disabled):focus-visible{background:#f6f2fb}.argue-option-card>button:disabled{opacity:.45;cursor:default}.argue-option-card.selected>button{opacity:1;background:#f0eafb}.argue-options .report-dimension-badge{width:32px;height:32px;border-radius:9px;font-size:9px}.argue-option-card>button>span:nth-child(2){display:flex;flex-direction:column;gap:3px}.argue-options strong{font-size:8px;font-weight:500}.argue-options small{color:#918995;font-size:6px}.argue-option-card>button>i{font-style:normal;color:#9a8ca9}
.argue-appeal-input{padding:12px;border-top:1px solid rgba(87,68,125,.1);background:#fcfbfd;animation:message-in .25s ease both}.argue-appeal-input>label{display:flex;justify-content:space-between;margin-bottom:7px;color:#62576d;font-size:7px}.argue-appeal-input>label small{font-size:6px}.argue-appeal-input textarea{width:100%;min-height:72px;padding:9px 10px;border:1px solid rgba(74,59,96,.13);border-radius:9px;background:#fff;resize:vertical;color:#443c4c;font:8px/1.7 "Noto Sans SC",sans-serif}.argue-appeal-input textarea:focus{outline:2px solid rgba(145,121,194,.2);border-color:#a895ce}.argue-appeal-input textarea::placeholder{color:#aaa2ae}.argue-appeal-actions{margin-top:8px;display:flex;align-items:center;justify-content:space-between;gap:8px}.argue-appeal-actions>div{display:flex;justify-content:flex-end;gap:6px}.argue-appeal-input button{padding:7px 9px;border:0;border-radius:8px;background:#332d43;color:#fff;display:flex;align-items:center;gap:5px;font-size:7px}.argue-appeal-input button.skip{border:1px solid rgba(67,53,85,.1);background:#fff;color:#7c7481}.argue-evidence-upload{max-width:180px;min-height:30px;padding:6px 8px;border:1px dashed rgba(93,72,130,.2);border-radius:8px;background:#f6f2fa;color:#71647e;display:flex;align-items:center;gap:6px;cursor:pointer;font-size:7px}.argue-evidence-upload:hover{border-color:#9f89ca;background:#f0eafb}.argue-evidence-upload input{position:absolute;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none}.argue-evidence-upload span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.argue-review{overflow:hidden;border:1px solid rgba(91,72,130,.12);border-radius:17px;background:#fff;box-shadow:0 12px 35px rgba(50,39,66,.06);animation:message-in .4s ease both}.argue-review-expert{padding:14px 16px;border-bottom:1px solid var(--line);background:linear-gradient(110deg,#f3eef9,#faf7f8);display:grid;grid-template-columns:auto 1fr auto;gap:11px;align-items:center}.argue-review-expert>span{position:relative;width:42px;height:42px;border-radius:13px;background:#ece8f1}.argue-review-expert img{width:100%;height:100%;border-radius:13px;object-fit:cover;object-position:center 18%}.argue-review-expert>span>i{position:absolute;right:-4px;bottom:-4px;width:17px;height:17px;border-radius:6px;background:#fff;display:grid;place-items:center;font:6px var(--mono);font-style:normal;box-shadow:0 3px 9px rgba(48,39,61,.14)}.argue-review-expert>div{display:flex;flex-direction:column;gap:4px}.argue-review-expert small{color:#837690;font:6px var(--mono);letter-spacing:.07em}.argue-review-expert strong{font-size:9px;font-weight:500}.argue-review-expert>em{display:flex;gap:3px}.argue-review-expert>em i{width:4px;height:4px;border-radius:50%;background:#7f709a;animation:bounce 1s infinite}.argue-review-expert>em i:nth-child(2){animation-delay:.15s}.argue-review-expert>em i:nth-child(3){animation-delay:.3s}
.argue-review>p{margin:0!important;padding:18px 18px 16px!important;color:#5d5563!important;font-size:9px!important;line-height:1.85!important}.argue-review-steps{padding:0 18px 17px;display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.argue-review-steps span{position:relative;padding-top:11px;color:#aaa3ad;font-size:6px;text-align:center}.argue-review-steps span::before{content:"";position:absolute;left:0;right:0;top:3px;height:2px;background:#e2dee5}.argue-review-steps span.complete{color:#66816f}.argue-review-steps span.complete::before{background:#9ab8a5}.argue-review-steps span.active{color:#665578}.argue-review-steps span.active::before{background:linear-gradient(90deg,#8b77ad 52%,#e2dee5 52%)}.argue-review-steps span.active::after{content:"";position:absolute;top:0;left:50%;width:8px;height:8px;border-radius:50%;background:#8874aa;box-shadow:0 0 0 4px rgba(136,116,170,.12);animation:hotspot-breathe 2s ease-in-out infinite}
.appeal-user-detail{display:block;margin-top:7px;padding-top:7px;border-top:1px solid rgba(61,50,73,.1);color:#746b79;font-size:8px;line-height:1.55}.appeal-user-evidence{display:flex;margin-top:7px;padding:6px 8px;border-radius:7px;background:rgba(255,255,255,.55);color:#6d6375;font-size:7px}
.argue-consultation{overflow:hidden;border:1px solid rgba(91,72,130,.12);border-radius:18px;background:#fff;box-shadow:0 15px 42px rgba(50,39,66,.07);animation:message-in .4s ease both}.argue-consultation-head{padding:16px 18px;border-bottom:1px solid var(--line);background:linear-gradient(110deg,#f3eef9,#faf7f8);display:flex;align-items:flex-start;justify-content:space-between;gap:15px}.argue-consultation-head>div{display:flex;flex-direction:column;gap:4px}.argue-consultation-head>div>span{color:#85778f;font:6px var(--mono);letter-spacing:.08em}.argue-consultation-head strong{font-size:10px;font-weight:500}.argue-consultation-head small{max-width:520px;color:#817886;font-size:7px;line-height:1.5}.argue-live{padding:6px 8px;border-radius:99px;background:#fff;color:#74687e;font-size:7px;white-space:nowrap}.argue-live i{display:inline-block;width:5px;height:5px;margin-right:5px;border-radius:50%;background:#8a76ad;box-shadow:0 0 0 4px rgba(138,118,173,.12);animation:pulse 1.4s infinite}
.argue-council-cast{padding:17px 18px;display:flex;align-items:center}.argue-council-cast>span{position:relative;width:37px;height:37px;margin-right:-6px;border:2px solid #fff;border-radius:12px;background:#eeeaf1;opacity:.42;transform:scale(.92);transition:opacity .3s ease,transform .3s ease}.argue-council-cast>span.active{opacity:1;transform:scale(1)}.argue-council-cast>span.lead{z-index:2;box-shadow:0 0 0 3px rgba(137,116,174,.14)}.argue-council-cast img{width:100%;height:100%;border-radius:10px;object-fit:cover;object-position:center 18%}.argue-council-cast>span>i{position:absolute;right:-3px;bottom:-3px;width:15px;height:15px;border-radius:5px;background:#fff;display:grid;place-items:center;font:6px var(--mono);font-style:normal;box-shadow:0 2px 7px rgba(44,35,58,.14)}.argue-council-cast>div{min-width:0;margin-left:18px;display:flex;flex-direction:column;gap:5px}.argue-council-cast>div span{font-size:8px;color:#584f60}.argue-council-cast>div small{font:6px var(--mono);color:#958d99}
.argue-thinking-flow{padding:0 18px 18px;display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.argue-thinking-flow>span{position:relative;padding-top:17px;color:#aaa3ad;font-size:6px;text-align:center}.argue-thinking-flow>span::before{content:"";position:absolute;left:0;right:0;top:6px;height:2px;background:#e3dfe6}.argue-thinking-flow>span>i{position:absolute;z-index:2;left:50%;top:1px;width:12px;height:12px;border-radius:50%;background:#eeebf0;display:grid;place-items:center;transform:translateX(-50%);font:5px var(--mono);font-style:normal}.argue-thinking-flow>span.complete{color:#66816f}.argue-thinking-flow>span.complete::before,.argue-thinking-flow>span.complete>i{background:#acd0bb;color:#fff}.argue-thinking-flow>span.active{color:#655776}.argue-thinking-flow>span.active::before{background:linear-gradient(90deg,#8d79af 50%,#e3dfe6 50%)}.argue-thinking-flow>span.active>i{background:#8874aa;color:#fff;box-shadow:0 0 0 4px rgba(136,116,170,.12);animation:pulse 1.4s infinite}
.argue-expert-feedback{margin:0 18px 18px;padding:13px;border:1px solid rgba(80,64,105,.1);border-radius:13px;background:#f8f5fa;display:grid;grid-template-columns:auto 1fr;gap:11px;animation:message-in .35s ease both}.argue-expert-feedback>span{position:relative;width:40px;height:40px;border-radius:12px}.argue-expert-feedback img{width:100%;height:100%;border-radius:12px;object-fit:cover;object-position:center 18%}.argue-expert-feedback>span>i{position:absolute;right:-4px;bottom:-4px;width:17px;height:17px;border-radius:6px;background:#fff;display:grid;place-items:center;font:6px var(--mono);font-style:normal;box-shadow:0 3px 9px rgba(48,39,61,.14)}.argue-expert-feedback small{color:#837690;font:6px var(--mono)}.argue-expert-feedback p{margin:5px 0 0!important;color:#5d5563!important;font-size:8px!important;line-height:1.75!important}
.argue-roundtable-note{margin:0 18px 18px;padding:12px 14px;border:1px solid rgba(105,84,150,.12);border-radius:12px;background:linear-gradient(110deg,#f3eef9,#f8f6fa);animation:message-in .35s ease both}.argue-roundtable-note>span{display:flex;align-items:center;gap:6px;color:#766589;font:6px var(--mono);letter-spacing:.07em}.argue-roundtable-note p{margin:7px 0 0!important;color:#6c6472!important;font-size:7px!important;line-height:1.7!important}
.argue-final-decision{margin:0 18px 18px;padding:17px;border:1px solid rgba(74,112,88,.14);border-radius:15px;background:linear-gradient(120deg,#eef7f2,#fbfaf8);animation:message-in .45s ease both}.argue-final-decision.partial{border-color:rgba(157,121,67,.15);background:linear-gradient(120deg,#faf4e9,#fbfaf8)}.argue-final-decision>header{display:flex;align-items:center;justify-content:space-between;gap:18px}.argue-final-decision>header>div:first-child{display:flex;flex-direction:column;gap:4px}.argue-final-decision>header>div:first-child span{color:#4d775f;font:6px var(--mono);letter-spacing:.07em}.argue-final-decision.partial>header>div:first-child span{color:#886a3e}.argue-final-decision>header>div:first-child strong{font-size:10px;font-weight:500}.argue-score-change{display:flex;align-items:baseline;gap:6px}.argue-score-change span{color:#9b949e;font:500 18px var(--serif);text-decoration:line-through}.argue-score-change i{color:#8e8692;font-size:9px;font-style:normal}.argue-score-change strong{color:#3d684f;font:500 28px var(--serif)}.partial .argue-score-change strong{color:#82663d}.argue-score-change small{font:6px var(--mono);color:#918a96}.argue-final-decision>p{margin:13px 0!important;padding-top:12px;border-top:1px solid rgba(67,90,74,.09);color:#5d645f!important;font-size:8px!important;line-height:1.8!important}.argue-decision-meta{display:flex;flex-wrap:wrap;gap:6px}.argue-decision-meta span{padding:5px 7px;border-radius:99px;background:rgba(255,255,255,.72);color:#7e837f;font-size:6px}.argue-final-decision>button{margin-top:13px;padding:9px 12px;border:0;border-radius:9px;background:#302a40;color:#fff;display:flex;align-items:center;gap:8px;font-size:8px}.argue-final-decision>button.archived{background:#dfeee6;color:#4d735e}.argue-final-decision>button:disabled{cursor:default}
.argue-final-actions{margin-top:13px;display:flex;align-items:center;gap:8px}.argue-final-actions button{min-height:36px;padding:8px 12px;border:0;border-radius:9px;background:#fff;color:#62596b;display:flex;align-items:center;justify-content:center;gap:8px;font-size:8px}.argue-final-actions button:first-child{background:#302a40;color:#fff}.argue-final-actions button.archived{background:#dfeee6;color:#4d735e}.argue-final-actions button:disabled{cursor:default}.argue-final-actions .view-revised-report{border:1px solid rgba(67,53,85,.12);box-shadow:0 5px 14px rgba(52,42,69,.05)}
.report-button{border:0;background:#302c3d;color:#fff;border-radius:10px;padding:10px 11px;display:flex;align-items:center;gap:8px;font-size:9px;white-space:nowrap}
.followup-thread{margin-top:42px;padding-top:34px;border-top:1px solid var(--line)}.followup-user-message{margin-bottom:28px}.followup-user-message>div{padding:10px 13px}.followup-user-message p{margin:0}.followup-agent-message{animation:message-in .4s ease both}.agent-typing{display:flex;align-items:center;gap:9px;color:#8d8793;font-size:9px;padding:12px 0}.agent-typing>span{display:flex;gap:3px}.agent-typing i{width:5px;height:5px;border-radius:50%;background:#80758f;animation:bounce 1s infinite}.agent-typing i:nth-child(2){animation-delay:.15s}.agent-typing i:nth-child(3){animation-delay:.3s}.followup-agent-message .agent-content>p strong{color:#54476e}.photo-detection-result{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff;display:grid;grid-template-columns:minmax(220px,.9fr) minmax(260px,1.1fr);box-shadow:0 12px 35px rgba(45,36,61,.06)}.detected-photo{min-height:310px;position:relative;overflow:hidden;background:#eee}.detected-photo>img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;filter:saturate(.86)}.detected-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,20,31,.06),transparent 60%,rgba(24,20,31,.38));pointer-events:none}.detected-photo>small{position:absolute;z-index:3;left:10px;bottom:9px;color:#fff;font:6px var(--mono);letter-spacing:.08em}.detection-box{position:absolute;z-index:4;border:1px solid rgba(255,255,255,.95);border-radius:45%;box-shadow:0 0 0 1px rgba(67,51,91,.5),0 0 18px rgba(255,255,255,.35)}.detection-box i{position:absolute;left:-1px;top:-18px;width:16px;height:16px;border-radius:5px 5px 0 0;background:#fff;color:#493e58;display:grid;place-items:center;font:7px var(--mono);font-style:normal}.zone-a{width:41%;height:25%;left:29%;top:34%}.zone-b{width:33%;height:17%;left:39%;top:58%}.detection-scanline{position:absolute;z-index:3;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#fff,transparent);box-shadow:0 0 12px rgba(255,255,255,.9);animation:detection-scan 3.5s ease-in-out infinite}.detection-findings{padding:18px}.detection-score{display:flex;align-items:flex-start;justify-content:space-between;padding-bottom:13px;margin-bottom:12px;border-bottom:1px solid var(--line)}.detection-score>span{font-size:9px;color:#7f7985}.detection-score>strong{font:500 31px/1 var(--serif)}.detection-score>strong small{font:7px var(--mono);color:#96909b}.finding-item{display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:start;padding:11px 0;border-bottom:1px solid rgba(47,40,59,.07)}.finding-item:last-child{border-bottom:0}.finding-item>span{width:22px;height:22px;border-radius:7px;background:#ede8f5;color:#67587f;display:grid;place-items:center;font:8px var(--mono)}.finding-item strong{display:block;font-size:9px;font-weight:500}.finding-item p{font-size:7px!important;line-height:1.6!important;color:#88818d!important;margin:4px 0 0!important}.finding-item em{font:7px var(--mono);font-style:normal;color:#766b84}.detection-conclusion{margin-top:10px;padding:12px 14px;border-radius:12px;background:#f1edf7;display:grid;grid-template-columns:auto 1fr;gap:10px}.detection-conclusion>span{font-size:7px;background:#fff;border-radius:6px;padding:5px 7px;align-self:start}.detection-conclusion p{font-size:8px;line-height:1.7;color:#706978;margin:0}.chat-end-anchor{height:1px}
.agent-typing.paused i{animation-play-state:paused}.agent-typing.paused{color:#6d617d}
.contextual-answer{padding:18px;border:1px solid rgba(70,56,96,.1);border-radius:16px;background:linear-gradient(135deg,#f5f1fa,#faf6f5);animation:message-in .45s ease both}.contextual-answer-tag{display:inline-block;font:7px var(--mono);letter-spacing:.08em;color:#81778e;margin-bottom:10px}.contextual-answer>strong{display:block;font:500 19px/1.35 var(--serif);color:#332d3d}.contextual-answer>p{font-size:9px;line-height:1.8;color:#716a78;margin:9px 0 13px}.contextual-answer>div{display:flex;gap:6px;flex-wrap:wrap}.contextual-answer>div span{font-size:7px;padding:6px 8px;border-radius:99px;background:rgba(255,255,255,.72);border:1px solid rgba(62,50,80,.08);color:#716779}
.chat-composer-wrap{position:absolute;z-index:4;left:256px;right:0;bottom:0;padding:24px max(30px,calc((100% - 790px)/2)) 12px;background:linear-gradient(transparent,#fbfafc 27%)}.quick-followups{margin-bottom:8px;display:flex;align-items:center;gap:10px}.quick-followups>span{font-size:8px;color:#938d9a;white-space:nowrap}.quick-followups>div{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}.quick-followups>div::-webkit-scrollbar{display:none}.quick-followups button{border:1px solid rgba(52,45,70,.1);border-radius:99px;background:rgba(255,255,255,.78);padding:6px 9px;font-size:8px;color:#746e7b;white-space:nowrap;transition:background .2s,border-color .2s,color .2s}.quick-followups button:hover,.quick-followups button.active{background:#eee9f8;border-color:#d9cef0;color:#625487}.composer-compact{border-radius:14px;padding:7px}.composer-compact textarea{min-height:36px;padding:8px}.chat-composer-wrap>small{font-size:7px;color:#aaa4af;display:block;text-align:center;margin-top:7px}
.quick-loading{height:26px;display:flex!important;align-items:center;gap:4px;padding:0 8px}.quick-loading i{width:4px;height:4px;border-radius:50%;background:#9a91a5;animation:bounce 1s infinite}.quick-loading i:nth-child(2){animation-delay:.15s}.quick-loading i:nth-child(3){animation-delay:.3s}

.result{overflow:auto}.result-header{position:sticky;top:0;flex:none}.back-button{width:38px;height:38px;padding:0;border:0;border-radius:10px;background:transparent;display:grid;place-items:center;color:#aaa8ad;transition:background .2s,color .2s}.back-button:hover{background:rgba(48,43,58,.05);color:#55515b}.result-actions{display:flex;gap:7px}
.report{width:min(1040px,calc(100% - 60px));margin:0 auto;padding:62px 0 80px}.report-title{text-align:center}.report-title h2{font:500 clamp(41px,5vw,66px)/1 var(--serif);letter-spacing:-.045em;margin:25px 0 12px}.report-title h2 em{font-weight:500;color:#8175a5}.report-title p{font-size:11px;color:#8b8591}
.archive-report{max-width:980px}.archive-overview{min-height:330px;margin-top:44px;padding:38px 64px;border:1px solid rgba(57,48,72,.1);border-radius:22px;display:grid;grid-template-columns:230px 1fr;gap:55px;align-items:center;position:relative;overflow:hidden}.archive-overview::before{content:"";position:absolute;width:390px;height:390px;border-radius:50%;left:-70px;top:-65px;filter:blur(2px);opacity:.65}.archive-overview.warning{background:linear-gradient(135deg,#fff,#faf5ed)}.archive-overview.warning::before{background:radial-gradient(circle,#f2d8af,transparent 70%)}.archive-overview.danger{background:linear-gradient(135deg,#fff,#f9eeee)}.archive-overview.danger::before{background:radial-gradient(circle,#ecc6c8,transparent 70%)}.archive-overview .score-ring{position:relative;z-index:1}.archive-overview.warning .score-ring{background:conic-gradient(#b9965b calc(var(--score)*1%),rgba(185,150,91,.13) 0)}.archive-overview.danger .score-ring{background:conic-gradient(#b56f76 calc(var(--score)*1%),rgba(181,111,118,.13) 0)}.archive-summary{position:relative;z-index:1}.archive-status{display:inline-flex;align-items:center;gap:7px;padding:6px 9px;border-radius:99px;font-size:9px}.archive-status i{width:5px;height:5px;border-radius:50%}.warning .archive-status{background:#f4e8d5;color:#866b41}.warning .archive-status i{background:#b78d50}.danger .archive-status{background:#f2dddf;color:#8d565c}.danger .archive-status i{background:#b56870}.archive-summary h3{font:500 29px/1.25 var(--serif);margin:16px 0 11px}.archive-summary>p{font-size:9px;line-height:1.85;color:#746e79;max-width:490px}.archive-confidence{margin-top:20px;padding-top:14px;border-top:1px solid rgba(53,45,67,.1);display:flex;justify-content:space-between;font-size:8px;color:#8d8692}.archive-confidence strong{font:9px var(--mono);color:#5f5866}.archive-risks{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.archive-risks article{min-height:155px;padding:18px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.65);display:grid;grid-template-columns:auto 1fr;gap:11px;align-content:start}.archive-risks article>span{font:9px var(--mono);color:#a39ca7}.archive-risks article>div strong{font-size:10px;font-weight:500}.archive-risks article>div p{font-size:8px;line-height:1.7;color:#7d7682;margin:7px 0 12px}.archive-risks article>small{grid-column:2;justify-self:start;padding:5px 7px;border-radius:99px;background:#f1eadf;color:#8b7047;font-size:7px}.archive-risks article>small.high{background:#f2dfe1;color:#945c62}.archive-decision{margin-top:34px;padding:27px;border:1px solid var(--line);border-radius:19px;display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center}.archive-decision.warning{background:linear-gradient(120deg,#faf4e9,#faf8f4)}.archive-decision.danger{background:linear-gradient(120deg,#f8e9eb,#faf6f5)}.archive-decision>div:nth-child(2)>span{font:8px var(--mono);color:#8b8490}.archive-decision h3{font:500 23px var(--serif);margin:5px 0 8px}.archive-decision p{font-size:9px;line-height:1.75;color:#746d78;margin:0}.archive-decision>button{border:0;border-radius:10px;background:#302c3d;color:#fff;padding:11px 13px;font-size:9px;display:flex;align-items:center;gap:8px;white-space:nowrap}
.score-hero{margin-top:45px;border:1px solid var(--line);border-radius:22px;min-height:310px;background:radial-gradient(circle at 35% 30%,#f1ebff,transparent 34%),linear-gradient(135deg,#fff,#f8f3f5);display:grid;grid-template-columns:190px 235px 1fr;align-items:center;padding:28px 46px;gap:24px;position:relative;overflow:hidden}.score-hero::after{content:"";position:absolute;width:380px;height:380px;border:1px solid rgba(108,91,152,.11);border-radius:50%;left:120px;top:-34px}
.score-post{height:235px;border-radius:14px;overflow:hidden;position:relative;z-index:1;box-shadow:0 15px 35px rgba(48,39,67,.13);transform:rotate(-2deg)}.score-post img{width:100%;height:100%;object-fit:cover}.score-post span{position:absolute;bottom:7px;left:7px;background:rgba(255,255,255,.8);backdrop-filter:blur(5px);font-size:7px;padding:5px 7px;border-radius:6px}
.score-source{height:235px;border-radius:14px;position:relative;z-index:1;background:linear-gradient(145deg,#eee9f8,#edf4f1);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;color:#6c5e83;box-shadow:0 15px 35px rgba(48,39,67,.08)}.score-source strong{font:500 28px var(--serif);color:#352e42}.score-source span{font-size:8px;color:#77717d}.score-source small{font:6px var(--mono);letter-spacing:.08em;color:#96909c}
.score-ring{width:210px;height:210px;border-radius:50%;background:conic-gradient(#75699d calc(var(--score)*1%),rgba(117,105,157,.12) 0);display:grid;place-items:center;position:relative;z-index:2;box-shadow:0 12px 50px rgba(74,58,107,.1)}.score-ring::before{content:"";position:absolute;inset:9px;background:#faf7fc;border-radius:50%}.score-ring>div{position:relative;z-index:1;text-align:center}.score-ring strong{font:500 66px/1 var(--serif)}.score-ring span{font:10px var(--mono);color:#827b88}.score-ring small{font:7px var(--mono);display:block;color:#918a98;margin-top:8px;letter-spacing:.08em}
.score-summary{position:relative;z-index:2}.verdict{display:inline-flex;align-items:center;gap:7px;font-size:9px;border-radius:99px;background:#e5f2eb;color:#527b67;padding:6px 9px}.verdict i{width:5px;height:5px;border-radius:50%;background:#6da484}.score-summary h3{font:500 28px/1.25 var(--serif);margin:15px 0 10px}.score-summary>p{font-size:9px;line-height:1.8;color:#766f7d;max-width:355px}.confidence{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;margin-top:18px;font-size:8px;color:#817a88}.confidence>div{height:3px;background:#e3dfe7;border-radius:99px;overflow:hidden}.confidence i{display:block;width:92%;height:100%;background:#7b709c}.confidence strong{font:8px var(--mono)}
.report-divider{display:flex;align-items:center;gap:14px;margin:48px 0 19px;font:8px var(--mono);letter-spacing:.09em;color:#8d8693}.report-divider::before,.report-divider::after{content:"";height:1px;background:var(--line);flex:1}
.dimension-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.dimension-card{border-radius:18px;padding:21px;border:1px solid rgba(255,255,255,.8)}.dimension-card.violet{background:#f0ecfc}.dimension-card.blue{background:#eaf2fa}.dimension-card.peach{background:#f8ece9}.dimension-card.green{background:#eaf4ef}
.dimension-grid.dimension-count-1{grid-template-columns:minmax(0,1fr);max-width:560px;margin-left:auto;margin-right:auto}
.dimension-top{display:flex;justify-content:space-between;align-items:center}.dimension-code{font:500 38px var(--serif)}.dimension-status{font-size:8px;background:rgba(255,255,255,.65);border-radius:99px;padding:6px 8px}.dimension-card>small{font:8px var(--mono);color:#89828f}.dimension-card h3{font:500 22px var(--serif);margin:2px 0 15px}.dimension-score{display:grid;grid-template-columns:auto auto 1fr;align-items:end;gap:5px;margin-bottom:14px}.dimension-score strong{font:500 30px/1 var(--serif)}.dimension-score>span{font:8px var(--mono);color:#87808c;margin-bottom:3px}.dimension-score>div{height:3px;background:rgba(60,50,75,.1);border-radius:9px;margin:0 0 4px 8px;overflow:hidden}.dimension-score i{height:100%;background:#716884;display:block}.dimension-card>p{font-size:9px;line-height:1.75;color:#716b77;padding-top:12px;border-top:1px solid rgba(60,50,75,.1)}.evidence-list{display:flex;gap:5px;flex-wrap:wrap}.evidence-list span{font-size:7px;padding:5px 7px;border-radius:7px;background:rgba(255,255,255,.5)}
.decision-card{margin-top:34px;padding:28px;border-radius:19px;border:1px solid var(--line);display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;background:linear-gradient(120deg,#f6f2fd,#faf6f5)}.decision-icon{width:48px;height:48px;border-radius:15px;background:#fff;color:#7569a0;display:grid;place-items:center;box-shadow:0 8px 25px rgba(59,47,91,.09)}.decision-card span{font:8px var(--mono);color:#898290}.decision-card h3{font:500 22px var(--serif);margin:5px 0 8px}.decision-card p{font-size:9px;line-height:1.75;color:#746d7a;margin:0}.decision-card button{border:0;border-radius:10px;background:#302c3d;color:#fff;padding:11px 13px;font-size:9px;display:flex;align-items:center;gap:8px;white-space:nowrap}.method-note{text-align:center;font-size:7px;color:#aaa5ad;margin-top:24px}

@keyframes pulse{50%{box-shadow:0 0 0 5px rgba(127,109,174,.12)}}@keyframes bounce{50%{transform:translateY(-3px)}}@keyframes scene-in{from{opacity:0;transform:translateY(5px);filter:blur(3px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}@keyframes story-copy-in{from{opacity:0;transform:translateY(18px);filter:blur(4px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}@keyframes story-visual-in{from{opacity:0;transform:translateY(25px) scale(.97);filter:blur(7px)}to{opacity:1;transform:translateY(0) scale(1);filter:blur(0)}}@keyframes scroll-cue{50%{transform:translateY(6px);opacity:.35}}@keyframes read-progress{50%{width:92%}}@keyframes comment-in{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:translateX(0)}}@keyframes forensic-scan{0%,100%{top:18%}50%{top:82%}}@keyframes message-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}@keyframes detection-scan{0%,100%{top:15%}50%{top:85%}}@keyframes share-in{from{opacity:0;transform:translateY(-6px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes role-in{from{opacity:0;transform:translateX(8px)}to{opacity:1;transform:translateX(0)}}@keyframes role-progress{0%{transform:translateX(-110%);width:35%}60%,100%{transform:translateX(310%);width:35%}}@keyframes spin{to{transform:rotate(360deg)}}
@keyframes trust-marquee{to{transform:translateX(-50%)}}
@keyframes trust-note-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes trust-line-draw{0%{stroke-dashoffset:1;opacity:1}100%{stroke-dashoffset:0;opacity:1}}
@keyframes trust-line-fade{from{opacity:1}to{opacity:0}}
@keyframes hotspot-breathe{0%,100%{transform:scale(1);box-shadow:0 0 0 1px rgba(151,124,211,.3)}50%{transform:scale(1.08);box-shadow:0 0 0 7px rgba(151,124,211,.08)}}@keyframes evidence-pop{from{opacity:0;transform:translateY(5px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes lens-scan{0%{top:3%;opacity:0}8%{opacity:1}92%{opacity:1}100%{top:96%;opacity:0}}@keyframes operation-hint-float{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,-4px)}}
@keyframes agent-scene-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@keyframes agent-flow-dot{from{offset-distance:0%;opacity:0}10%,90%{opacity:1}to{offset-distance:100%;opacity:0}}@keyframes agent-orbit-spin{to{transform:translate(-50%,-50%) rotate(1turn)}}@keyframes aperture-core-pulse{0%,100%{transform:scale(1)}45%{transform:scale(1.06)}}
@keyframes report-pointer-in{from{left:0}to{left:43%}}@keyframes radar-expand{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes account-menu-in{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes account-dialog-in{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes agent-cursor-blink{50%{opacity:0}}@keyframes agent-send-press{45%{transform:scale(.92)}75%{transform:scale(1.04)}100%{transform:scale(1)}}@keyframes agent-reply-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}@keyframes agent-arrow-float{50%{transform:translateY(4px)}}
@keyframes quiz-screen-out{to{opacity:0;transform:translateY(-18px)}}@keyframes quiz-screen-in{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}@keyframes quiz-marker-pulse{from{opacity:.9;transform:scale(1)}to{opacity:0;transform:scale(2.4)}}

.visual-quiz-card.quiz-transition-out{animation:none}.visual-quiz-card.quiz-transition-in{animation:none}.visual-quiz-card.quiz-transition-out>*{animation:quiz-screen-out .25s ease both}.visual-quiz-card.quiz-transition-in>*{animation:quiz-screen-in .35s ease both}

.story-scroller{height:600vh;min-height:0}.story-sticky{position:sticky;grid-template-columns:40% 60%;gap:0;padding:6vh 0 6vh clamp(90px,9vw,150px);background:radial-gradient(circle at 77% 46%,rgba(255,255,255,.96),transparent 37%),linear-gradient(145deg,#f9f8fb,#f4f1f7)}.story-copy-stack{width:min(440px,88%)}.story-copy-layer h2{text-wrap:balance}.merged-screen-label{margin-top:24px;font:8px var(--mono);font-style:normal;letter-spacing:.08em;color:#827a89;animation:scene-in .2s ease both}.merged-story-dots{position:absolute;left:0;bottom:0;display:flex;gap:7px}.merged-story-dots button{width:22px;height:3px;padding:0;border:0;border-radius:99px;background:#d8d4dc;transition:width .35s ease,background .35s ease}.merged-story-dots button.active{width:42px;background:#302a40}.merged-story-visual{position:relative;z-index:2;width:100%;height:760px;align-self:center}.merged-orbit{position:absolute;left:42%;top:50%;border:1px solid rgba(118,100,162,.1);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}.merged-orbit-one{width:780px;height:780px}.merged-orbit-two{width:610px;height:610px;border-color:rgba(197,144,165,.13)}.merged-story-card{position:absolute;inset:0 -4vw 0 0;overflow:hidden;border:1px solid rgba(139,119,190,.2);border-right:0;border-radius:390px 0 0 390px;background:rgba(255,255,255,.91);box-shadow:0 30px 90px rgba(62,49,86,.14);backdrop-filter:blur(22px)}.merged-screen-count{position:absolute;z-index:5;top:28px;left:140px;right:60px;text-align:center;font:7px var(--mono);letter-spacing:.1em;color:#8d8692}.merged-story-track{height:600%;display:flex;flex-direction:column;transition:transform .5s ease-out;will-change:transform}.merged-track-screen{position:relative;flex:0 0 calc(100% / 6);min-height:0;padding:60px 60px 55px 140px;display:flex;flex-direction:column;justify-content:center}.merged-see-screen{align-items:center}.merged-see-screen .story-post{width:370px;transform:none}.merged-see-screen>small,.merged-quiz-screen .quiz-reveal>small{margin-top:22px;color:#8c8592;font-size:8px}.merged-see-screen>small i,.merged-quiz-screen .quiz-reveal>small i{display:inline-block;font-style:normal;animation:agent-arrow-float 1.8s ease-in-out infinite}.merged-data-screen{gap:20px}.merged-data-screen>div{display:grid;grid-template-columns:150px 1fr;grid-template-rows:auto auto;align-items:center;padding-bottom:17px;border-bottom:1px solid rgba(52,44,68,.08)}.merged-data-screen>div:last-child{border-bottom:0}.merged-data-screen strong{grid-row:1/3;font:500 64px/1 var(--serif);letter-spacing:-.04em;color:#332e3e}.merged-data-screen span{font-size:11px;color:#5f5966}.merged-data-screen small{font-size:7px;color:#98919d}.merged-quiz-screen>header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}.merged-quiz-screen>header span,.merged-quiz-screen>header small{font:8px var(--mono);letter-spacing:.08em;color:#77717e}.merged-quiz-screen>header small{letter-spacing:.02em;color:#8f8995}.merged-quiz-screen .quiz-options{grid-template-columns:repeat(2,220px);gap:20px}.merged-quiz-screen .quiz-image-placeholder{width:220px;height:280px}.merged-quiz-screen .quiz-reveal{min-height:92px;margin-top:15px;padding:0 10px}.merged-quiz-screen .quiz-reveal>small{display:block;margin-top:8px}.merged-result-screen{align-items:center;text-align:center}.merged-result-screen>strong{margin-top:10px;font:500 96px/1 var(--serif);letter-spacing:-.05em}.merged-result-screen>strong small{font:12px var(--mono);color:#8d8692}.merged-result-screen h3{max-width:470px;margin:14px 0 16px;font:500 24px/1.35 var(--serif)}.merged-result-screen>p{margin:0 0 8px;color:#8a6870;font-size:8px}.merged-result-screen>small{color:#8c8592;font-size:8px}.merged-result-screen .quiz-result-actions{margin-top:24px}.merged-screen-nav{position:absolute;z-index:6;left:-19px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:7px}.merged-screen-nav button{width:38px;height:38px;padding:0;border:1px solid rgba(75,61,102,.12);border-radius:50%;background:rgba(255,255,255,.86);color:#5f5867;display:grid;place-items:center;box-shadow:0 8px 22px rgba(52,42,69,.08)}.merged-screen-nav button:disabled{opacity:.28;cursor:default}

.story-scroller{height:100vh;min-height:760px}.story-sticky{position:relative;height:100%;min-height:760px;grid-template-columns:40% 60%;padding:0 0 0 clamp(96px,9vw,150px);background:radial-gradient(circle at 78% 48%,rgba(255,255,255,.96),transparent 38%),linear-gradient(145deg,#f9f8fb,#f4f1f7)}.story-copy-stack{height:620px;width:min(470px,90%)}.story-copy-layer{justify-content:center}.story-copy-layer h2{max-width:470px;font-size:clamp(52px,4.4vw,64px);text-align:left;text-wrap:balance}.story-copy-layer p{max-width:450px;font-size:16px;line-height:1.85}.read-step-list{width:min(390px,100%);margin-top:31px;display:flex;flex-direction:column}.read-step-list button{position:relative;min-height:43px;padding:0;border:0;background:transparent;display:grid;grid-template-columns:34px 1fr;align-items:center;text-align:left;color:#99929e}.read-step-list button>span{font:7px var(--mono)}.read-step-list button>strong{font-size:10px;font-weight:400}.read-step-list button>i{position:absolute;left:0;right:0;bottom:0;height:1px;background:#ded9e3}.read-step-list button.active{color:#37313f}.read-step-list button.active>i{height:2px;background:#302a40}.merged-story-visual{height:760px}.merged-story-card{inset:0 -4vw 0 0;border-color:rgba(139,119,190,.2);transition:border-color .2s ease}.merged-story-card:hover{border-color:rgba(112,87,165,.48)}.merged-card-scroll{width:100%;height:100%;overflow-y:auto;scroll-snap-type:y mandatory;scroll-behavior:smooth;overscroll-behavior:contain;scrollbar-width:none}.merged-card-scroll::-webkit-scrollbar{display:none}.merged-track-screen{min-height:100%;height:100%;padding:70px 60px 105px 150px;scroll-snap-align:start;scroll-snap-stop:always}.merged-panel-kicker{display:block;margin-bottom:23px;font:8px var(--mono);letter-spacing:.1em;color:#817a88}.merged-data-screen{gap:0}.merged-data-screen>div{grid-template-columns:150px 1fr;min-height:130px;padding:15px 0}.merged-data-screen strong{font-size:70px}.merged-data-screen span{font-size:12px}.merged-data-screen>small{margin-top:16px;font-size:7px;line-height:1.6;color:#918a97}.merged-quiz-screen>header{margin-bottom:12px}.merged-quiz-screen>header span{letter-spacing:.1em}.merged-quiz-screen>h3{margin:0 0 19px;font:500 23px var(--serif)}.merged-quiz-screen .quiz-options{grid-template-columns:repeat(2,200px);gap:20px}.merged-quiz-screen .quiz-image-placeholder{width:200px;height:250px}.merged-quiz-screen .quiz-reveal{min-height:100px}.merged-result-screen{padding-left:150px}.merged-card-controls{position:absolute;z-index:8;left:180px;right:50px;bottom:0;height:70px;border-top:1px solid rgba(54,47,69,.08);background:rgba(255,255,255,.9);backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:space-between}.merged-card-controls>small{font:7px var(--mono);color:#9a939f}.merged-card-controls>div{display:flex;align-items:center;gap:8px}.merged-card-controls>div>span{margin-right:5px;font:8px var(--mono);color:#77717e}.merged-card-controls button{width:36px;height:36px;padding:0;border:1px solid rgba(75,61,102,.15);border-radius:50%;background:#fff;color:#665e70;display:grid;place-items:center}.merged-card-controls button:last-child{border-color:#302a40;background:#302a40;color:#fff}.merged-card-controls button:disabled{opacity:.28;cursor:default}.merged-card-mask{position:absolute;z-index:6;left:120px;right:0;height:55px;pointer-events:none}.mask-top{top:0;background:linear-gradient(#fff,rgba(255,255,255,0))}.mask-bottom{bottom:70px;background:linear-gradient(rgba(255,255,255,0),#fff)}.merged-scroll-hint{position:absolute;z-index:9;left:180px;bottom:81px;color:#827b88;font-size:7px}.merged-scroll-hint i{display:inline-block;font-style:normal;animation:agent-arrow-float 1.8s ease-in-out infinite}

@media (max-width: 900px) {
  .home-nav-center{display:none}.home-nav{grid-template-columns:1fr 1fr}
  .hero{padding-top:105px}.portrait-stage{width:80vw;height:54vw}.hero-metrics{left:3%;right:3%}.hero-metrics div{padding:12px 8px}.hero-metrics small{display:none}
  .cover-stage{width:94vw;transform:scale(.92);transform-origin:top center;margin-bottom:-28px}
  .trust-grid{grid-template-columns:repeat(2,1fr)}
  .story-sticky{grid-template-columns:minmax(270px,.8fr) minmax(380px,1.2fr);gap:25px;padding-left:65px;padding-right:30px}.story-visual-shell{transform:scale(.88)}.story-copy-layer h2{font-size:42px}
  .app-shell{grid-template-columns:76px minmax(0,1fr)}.sidebar{padding:22px 10px}.sidebar .logo,.side-label,.history button>span:last-child,.new-analysis small,.sidebar-report-library small,.side-bottom button>span:nth-child(2),.dots,.mobile-hide{display:none}.side-top{padding:0 0 26px;justify-content:center}.new-analysis,.sidebar-report-library,.sidebar-help-guide{padding:0;justify-content:center}.new-analysis>span,.sidebar-report-library>span,.sidebar-help-guide>span{font-size:0}.history button{justify-content:center;padding:7px}.side-bottom button{justify-content:center}.chat-composer-wrap{left:76px}
  .score-hero{grid-template-columns:150px 180px 1fr;padding:25px;gap:15px}.score-post{height:210px}.score-ring{width:170px;height:170px}.score-ring strong{font-size:53px}
  .evidence-layout{gap:30px}.evidence-section{padding-left:5%;padding-right:5%}
  .agent-scene-content{gap:28px;padding-left:28px;padding-right:28px}.one-agent-flow{transform:scale(.84);transform-origin:top center;margin-bottom:-55px}
  .report-showcase-stage{width:min(680px,100%)}.report-callouts{position:relative;inset:auto;margin:24px auto 0;display:grid;grid-template-columns:repeat(2,1fr);gap:8px;pointer-events:auto}.report-callout{position:relative;inset:auto!important;width:auto;min-height:48px;padding:9px 11px;border:1px solid rgba(58,49,73,.08);border-radius:13px;background:rgba(255,255,255,.58);grid-template-columns:auto 1fr}.report-callout>i{display:none}
  .visual-quiz-section{min-height:0;padding:78px 0 70px;display:block}.visual-quiz-copy{padding:0 36px 52px;text-align:center}.visual-quiz-copy .story-step{align-self:center}.visual-quiz-copy h2{font-size:48px}.visual-quiz-copy p{max-width:560px;margin-left:auto;margin-right:auto}.visual-quiz-progress{justify-content:center}.visual-quiz-stage{height:auto;width:100%}.quiz-orbit{left:50%}.visual-quiz-card{width:calc(100% - 40px);height:690px;margin:0 20px;padding:40px 28px;border-right:1px solid rgba(139,119,190,.2);border-radius:32px}.quiz-question-screen,.quiz-result-screen{width:min(560px,100%)}.quiz-options{grid-template-columns:repeat(2,140px);gap:18px}.quiz-image-placeholder{width:140px;height:220px}.quiz-image-placeholder>span{left:9px;top:9px}.quiz-image-placeholder>small{right:9px;top:12px}.quiz-ai-marker>em{left:auto;right:12px;top:14px;min-width:90px}.quiz-reveal{padding-left:10px}
  .story-sticky{min-height:700px;padding:24px 20px;display:grid;grid-template-columns:1fr;grid-template-rows:30% 65%;gap:3%;align-content:center}.story-copy-stack{width:100%;height:100%;text-align:center}.story-copy-layer{align-items:center}.story-copy-layer>small{margin-top:10px}.story-copy-layer h2{margin:8px 0 9px;font-size:38px}.story-copy-layer p{max-width:560px;margin:0 auto;font-size:10px;line-height:1.55}.merged-screen-label{margin-top:10px}.merged-story-dots{left:50%;bottom:3px;transform:translateX(-50%)}.merged-story-visual{width:100%;height:100%}.merged-story-card{inset:0;border-right:1px solid rgba(139,119,190,.2);border-radius:32px}.merged-screen-count{top:16px;left:20px;right:20px}.merged-track-screen{padding:38px 24px 22px}.merged-orbit{left:50%}.merged-see-screen .story-post{width:230px}.merged-see-screen .post-image{height:170px}.merged-data-screen{gap:10px}.merged-data-screen>div{grid-template-columns:100px 1fr;padding-bottom:9px}.merged-data-screen strong{font-size:44px}.merged-data-screen span{font-size:9px}.merged-quiz-screen>header{margin-bottom:12px}.merged-quiz-screen .quiz-options{grid-template-columns:repeat(2,140px);gap:14px}.merged-quiz-screen .quiz-image-placeholder{width:140px;height:185px}.merged-quiz-screen .quiz-reveal{min-height:83px;margin-top:10px}.merged-result-screen>strong{font-size:70px}.merged-result-screen h3{font-size:20px;margin:8px 0 10px}.merged-result-screen .quiz-result-actions{margin-top:15px}.merged-screen-nav{left:auto;right:14px;top:auto;bottom:12px;transform:none;flex-direction:row}.merged-screen-nav button{width:34px;height:34px}
}

@media (max-width: 640px) {
  .argue-entry{padding:14px}.argue-entry-head{align-items:flex-start}.argue-options{grid-template-columns:1fr}.argue-option-card.selected{grid-row:auto}.argue-option-card>button{min-height:56px}.argue-appeal-actions{align-items:stretch;flex-direction:column}.argue-evidence-upload{max-width:none}.argue-review-steps{padding-left:11px;padding-right:11px}.argue-review-steps span{font-size:5px}.argue-consultation-head{padding:14px}.argue-council-cast{padding:14px}.argue-thinking-flow{padding:0 10px 15px}.argue-thinking-flow>span{font-size:5px}.argue-final-decision>header{align-items:flex-start;flex-direction:column}.argue-score-change{align-self:flex-end;margin-top:-38px}
  .home-nav{height:64px;padding:0 18px}.nav-cta{font-size:0;padding:6px}.nav-cta svg{margin:0}.hero{min-height:920px;padding-top:105px}.hero h1{font-size:50px}.hero-sub{font-size:12px}.portrait-stage{width:100vw;height:470px;margin-top:0}.portrait-stage video{max-width:85%}.scan-label-a{left:3%}.scan-label-b{right:4%}.scan-label-c{right:3%}.hero-metrics{grid-template-columns:repeat(2,1fr);bottom:15px}.hero-metrics div{border-bottom:1px solid var(--line)}.trust-section{padding:85px 18px}.trust-grid{grid-template-columns:1fr 1fr}.trust-card{min-height:210px;padding:17px}.trust-card>span{font-size:46px}
  .hero .cover-title{margin-top:10px}.cover-title>span{font-size:55px}.cover-title>span sup{right:-24px}.cover-title>strong{font-size:28px}.hero .cover-title>em{font-size:26px}.hero .hero-sub{margin-top:10px}.hero .hero-cta{margin-top:13px}.cover-stage{width:100vw;height:385px;transform:none;margin:0 auto}.cover-card{padding:11px 12px;border-radius:14px}.cover-card-heading{gap:5px}.cover-card-heading strong{font-size:8px}.cover-card-icon{width:21px;height:21px}.cover-card li{font-size:6px;padding-left:12px}.image-analysis-card{left:2%;top:120px;width:170px}.cover-score-row strong{font-size:26px}.cover-score-row>i{width:38px;height:38px}.cover-score-row>i b{width:27px;height:27px}.content-analysis-card{right:2%;top:46px;width:183px}.reasoning-card{right:3%;bottom:28px;width:175px}.cover-post-card{width:145px;height:225px;bottom:52px;padding:7px;border-radius:16px}.cover-conversation-card{width:166px;height:250px;padding:8px}.cover-chat-stream{gap:4px;padding:6px 0 5px}.cover-chat-bubble{padding:4px 6px}.cover-chat-bubble p{font-size:5.5px}.cover-chat-input{height:25px}.cover-platform{width:68%;bottom:20px}.cover-orbit{width:118%}.cover-scene-caption{width:90vw;margin-top:-2px;gap:10px}.cover-scene-caption>span{font-size:7px;white-space:nowrap}
  .trust-handoff{width:90vw;grid-template-columns:auto 1fr;margin-bottom:55px}.trust-handoff>small{grid-column:1/3;font-size:6px;margin-top:5px}
  .story-scroller{height:540vh}.story-sticky{min-height:600px;display:flex;flex-direction:column;justify-content:flex-start;gap:12px;padding:52px 18px 25px}.story-rail{display:none}.story-copy-stack{text-align:center;height:230px;width:100%;flex:none}.story-copy-layer{align-items:center}.story-copy-layer>small{margin-top:13px}.story-copy-layer h2{font-size:34px;margin:9px 0 10px}.story-copy-layer p{font-size:10px;line-height:1.6;max-width:350px;margin:0 auto}.story-dots{left:50%;bottom:0;transform:translateX(-50%);justify-content:center}.story-visual-shell{height:calc(100vh - 310px);min-height:315px;width:100%;transform:none}.story-progress-label{display:none}.story-post{width:225px;transform:none}.post-image{height:180px}.comment-stage{padding:13px;width:min(100%,390px)}.mock-comment{padding:6px}.mock-comment:nth-child(n+5){display:none}.forensic-stage{width:270px;height:340px}.account-stage{width:300px;padding:15px}.account-profile{padding-bottom:11px}.account-avatar{width:40px;height:40px}.account-stats{margin:9px 0}.account-stats>div{padding:7px}.account-timeline{padding:7px 10px}.account-timeline>span{min-height:37px}.account-timeline>span::after{top:23px;bottom:-14px}.account-verdict{margin-top:9px;padding:9px}.profile-stage{width:275px;min-height:340px;padding:20px 20px 15px}.profile-score{width:110px;height:110px;margin-bottom:9px}.profile-score strong{font-size:39px}.profile-stage h3{font-size:19px;margin:8px 0 11px}.profile-stage>p{margin-top:10px}
  .app-shell{display:block}.sidebar{position:fixed;left:0;right:0;bottom:0;height:62px;z-index:50;flex-direction:row;align-items:center;border:0;border-top:1px solid var(--line);padding:7px 15px;background:rgba(250,249,251,.93);backdrop-filter:blur(16px)}.side-top{display:none}.sidebar-search-button{width:42px;flex:none;order:2;margin:0}.new-analysis{width:44px;order:3;margin-left:auto}.sidebar-report-library{width:42px;flex:none;order:4;margin:0}.sidebar-help-guide{width:42px;flex:none;order:5;margin:0}.history{display:flex;flex-direction:row;order:1}.history button{display:none}.history button:first-child{display:flex}.side-bottom{margin:0;padding:0;border:0;flex-direction:row;order:6}.side-bottom button:first-child{display:none}.side-bottom button:last-child{padding:5px}.global-search-backdrop{padding:10px;place-items:center}.global-search-dialog{max-height:calc(100vh - 20px);margin:0;border-radius:21px}.global-search-header{min-height:70px;padding:13px 14px 8px 18px}.global-search-input input{font-size:15px}.global-search-tabs{padding:0 14px 13px}.global-search-tabs>button{min-width:0;flex:1;padding:9px}.global-search-results{min-height:250px;padding:16px 14px 18px}.global-search-result{padding:8px;gap:9px}.global-search-result>b{font-size:15px}.global-search-footer{padding:0 16px}.workspace,.chat,.result{height:calc(100vh - 62px)}.workspace-center{padding-top:35px}.workspace-intro{font-size:11px}.suggestions{grid-template-columns:1fr}.suggestions button{padding:8px}.privacy-note{display:none}.chat-composer-wrap{left:0;bottom:62px;padding-left:18px;padding-right:18px}.chat-scroll{padding:25px 18px 195px}.analysis-complete{grid-template-columns:auto 1fr}.report-button{grid-column:1/3;justify-content:center}.report{width:calc(100% - 28px);padding-top:42px}.result-header{padding:0 14px}.result-actions button{font-size:0;padding:0;width:34px;justify-content:center}.score-hero{grid-template-columns:1fr 1fr;padding:20px}.score-ring{width:145px;height:145px}.score-summary{grid-column:1/3}.dimension-grid{grid-template-columns:1fr}.decision-card{grid-template-columns:auto 1fr}.decision-card button{grid-column:1/3;justify-content:center}
  .council-header{grid-template-columns:1fr auto;padding:13px}.council-avatars{grid-column:1}.council-state{grid-column:2}.council-title{grid-column:1/3;grid-row:2}.council-columns{display:none}.council-role{grid-template-columns:1fr 52px 10px;padding:9px 12px}.role-weight{display:none}.role-avatar{width:34px;height:34px}.role-persona p{max-width:180px}.role-progress{left:56px;right:75px}.role-evidence{padding-left:13px}.council-result{padding:9px 12px;align-items:flex-start;gap:8px}.council-result>div:first-child{gap:3px;flex-wrap:wrap}.council-result>div:first-child span{font-size:6px}.council-result>div:last-child{white-space:nowrap}
  .reasoning-flow{padding:10px 8px 8px}.reasoning-flow-steps small{font-size:5px;white-space:normal;min-height:27px}.reasoning-flow-steps>div::after{left:calc(50% + 9px);right:calc(-50% + 9px)}.reasoning-finding{padding:9px 11px;grid-template-columns:1fr;gap:4px}
  .photo-detection-result{grid-template-columns:1fr}.detected-photo{min-height:270px}.detection-findings{padding:14px}
  .chat-header{padding:0 12px}.chat-header>.chat-header-actions{gap:4px}.chat-home-button,.analysis-pause-button,.chat-header .header-share{width:32px;padding:0;justify-content:center;font-size:0}
  .archive-overview{grid-template-columns:1fr;gap:22px;padding:28px 20px;text-align:center}.archive-overview .score-ring{margin:auto}.archive-summary>p{margin-left:auto;margin-right:auto}.archive-risks{grid-template-columns:1fr}.archive-risks article{min-height:0}.archive-decision{grid-template-columns:auto 1fr}.archive-decision>button{grid-column:1/3;justify-content:center}
  .evidence-section{padding:85px 18px 95px}.evidence-heading h2{font-size:42px;margin-top:24px}.evidence-heading>p{font-size:11px}.evidence-layout{grid-template-columns:1fr;margin-top:46px;gap:38px}.evidence-copy{order:1}.evidence-card{order:2;padding:12px 12px 43px;border-radius:21px}.evidence-image-frame{cursor:pointer;border-radius:15px}.evidence-base-image,.evidence-forensic-layer,.evidence-forensic-layer>img{border-radius:15px}.evidence-lens,.evidence-lens-layer{display:none}.mobile-evidence-hint{display:block;position:absolute;z-index:9;left:50%;bottom:11px;transform:translateX(-50%);padding:5px 8px;border-radius:99px;background:rgba(34,29,45,.5);color:#fff;font-size:6px;white-space:nowrap;backdrop-filter:blur(8px)}.hotspot-popover{width:145px}.evidence-cta{font-size:11px}.evidence-points>div:hover{transform:none}
  .evidence-image-frame .evidence-lens{display:block}.evidence-lens{width:clamp(180px,48%,230px)}.hotspot-popover{z-index:25}
  .one-agent-section{padding:88px 18px 100px}.one-agent-heading h2{font-size:42px;margin-top:24px}.one-agent-heading p{max-width:330px;margin-left:auto;margin-right:auto;font-size:11px;line-height:1.7}.agent-segmented{margin-top:34px;border-radius:20px;grid-template-columns:repeat(2,1fr)}.agent-segmented button{border-radius:15px;justify-content:flex-start}.agent-scene-shell{transition:height .25s ease}.agent-scene-content{min-height:0;padding:24px 18px;grid-template-columns:1fr;gap:24px;border-radius:21px}.agent-scene-copy h3{font-size:29px}.agent-scene-copy p{font-size:11px}.agent-scene-visual{height:285px}.account-placeholder-data{grid-template-columns:1fr 105px;gap:12px}.one-agent-flow{width:100%;margin-top:65px;margin-bottom:0;transform:none;display:grid;grid-template-columns:1fr;justify-items:center;gap:0}.flow-inputs{width:min(330px,100%);display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.flow-inputs>small{grid-column:1/3}.flow-inputs>span.active{transform:translateY(-2px)}.agent-flow-connector{width:140px;height:95px;transform:rotate(90deg);margin:4px 0}.connector-out{margin:18px 0 25px}.connector-out .rule-score-node{left:55%;transform:translate(-50%,-50%) rotate(-90deg)}.aperture-column{width:100%}.aperture-orbits{margin:auto;width:280px;height:280px}.agent-aperture{width:250px;height:250px}.orbit-inner{width:266px;height:266px}.orbit-outer{width:292px;height:292px}.aperture-column>p{width:min(300px,90%)}.flow-outputs{width:min(340px,100%);display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.flow-outputs>small,.flow-outputs>p{grid-column:1/4}.flow-outputs>p{width:auto;margin:5px 0 0}.one-agent-example{right:18px;bottom:20px}
  .report-showcase-section{padding:88px 18px 100px}.report-showcase-heading h2{font-size:42px;margin-top:24px}.report-showcase-heading p{max-width:330px;margin-left:auto;margin-right:auto;font-size:11px;line-height:1.7}.report-showcase-stage{margin-top:35px;padding-top:56px}.trust-report-card{padding:18px;border-radius:22px}.trust-report-head{gap:10px}.trust-report-head small{line-height:1.5}.report-score-block{align-items:flex-end}.report-score-ring{width:175px}.report-score-ring>strong{font-size:43px}.report-dimensions-block{grid-template-columns:1fr;gap:28px}.report-radar{width:min(280px,100%);margin:auto}.report-radar svg{height:230px}.report-callouts{grid-template-columns:1fr}.report-callout{min-height:52px}.report-advice h3{font-size:17px}
  .account-menu{position:fixed;left:auto;right:8px;bottom:70px;width:280px}.account-dialog{padding:24px 19px;border-radius:19px}.help-guide{grid-template-columns:1fr}.account-dialog-actions{flex-direction:column-reverse}.account-dialog-actions button{width:100%}
  .agent-intro-section{min-height:0;padding:82px 20px 68px}.agent-intro-heading h2{font-size:36px;margin-top:23px}.agent-intro-heading p{font-size:13px;line-height:1.65}.agent-intro-demo{margin-top:36px}.agent-prompt-card{min-height:215px;padding:18px 16px 14px;border-radius:24px}.agent-prompt-attachments{height:auto;min-height:34px}.agent-prompt-attachments>span{max-width:100%;font-size:8px}.agent-prompt-text{padding:22px 3px 12px;font-size:16px}.agent-intro-reply-live{min-height:165px}.agent-intro-reply{min-height:150px;padding:15px;grid-template-columns:76px 1fr;gap:13px;border-radius:20px}.agent-reply-score{width:72px;height:72px}.agent-reply-score strong{font-size:29px}.agent-reply-copy p{font-size:9px}.agent-example-row{align-items:flex-start;flex-direction:column}.agent-example-row>div{justify-content:flex-start}.agent-intro-note{line-height:1.7}
  .story-scroller{height:auto;min-height:600px}.visual-quiz-copy{padding-left:20px;padding-right:20px}.visual-quiz-copy h2{font-size:40px}.visual-quiz-copy p{font-size:14px}.visual-quiz-progress{flex-direction:column}.visual-quiz-card{height:660px;padding:32px 16px}.quiz-question-screen>header{align-items:flex-start;flex-direction:column;gap:6px}.quiz-options{gap:12px}.quiz-image-placeholder{height:205px}.quiz-reveal{min-height:130px;margin-top:14px;padding-right:44px}.quiz-result-screen>strong{font-size:72px}.quiz-result-screen h3{font-size:21px}.quiz-source-card{padding:15px}.quiz-result-actions{flex-direction:column;gap:10px}
}

@media (max-width: 640px) {
  .story-scroller{height:600vh;min-height:0}
  .story-sticky{height:100vh;min-height:620px;padding:16px 12px 14px;display:grid;grid-template-columns:1fr;grid-template-rows:30% 65%;gap:3%;justify-content:normal;align-content:center}
  .story-copy-stack{height:100%;width:100%}
  .story-copy-layer h2{max-width:330px;font-size:34px}
  .story-copy-layer p{max-width:340px}
  .merged-story-visual{height:100%;min-height:0}
  .merged-story-card{inset:0}
  .merged-track-screen{padding:34px 16px 18px}
  .merged-quiz-screen>header{gap:4px}
  .merged-quiz-screen .quiz-options{grid-template-columns:repeat(2,min(140px,40vw));gap:8px}
  .merged-quiz-screen .quiz-image-placeholder{width:min(140px,40vw);height:180px}
  .merged-quiz-screen .quiz-choice-button{min-width:92px}
  .merged-quiz-screen .quiz-reveal{padding:0;min-height:76px}
  .quiz-ai-marker>em{left:auto;right:10px;top:14px;min-width:84px}
  .merged-screen-nav{right:8px;bottom:8px}
  .merged-story-dots button{width:17px}
  .merged-story-dots button.active{width:31px}
}

@media (max-width: 900px) {
  .how-chapter-rail{display:none}
  .story-scroller{height:auto;min-height:900px}
  .story-sticky{position:relative;height:auto;min-height:900px;padding:52px 20px 42px;display:grid;grid-template-columns:1fr;grid-template-rows:270px minmax(500px,68vh);gap:28px;align-content:start}
  .story-copy-stack{height:270px;width:100%;text-align:center}
  .story-copy-layer{position:relative;align-items:center}
  .story-copy-layer h2{max-width:540px;margin:10px auto;font-size:42px;text-align:center}
  .story-copy-layer p{max-width:560px;margin:0 auto;font-size:12px;line-height:1.65}
  .story-copy-layer>small{margin-top:12px}
  .read-step-list{display:none}
  .merged-story-visual{width:100%;height:min(68vh,650px);min-height:500px}
  .merged-story-card{inset:0;border-right:1px solid rgba(139,119,190,.2);border-radius:32px}
  .merged-card-scroll{overscroll-behavior:auto}
  .merged-track-screen{padding:50px 22px 92px}
  .merged-data-screen>div{grid-template-columns:100px 1fr;min-height:105px;padding:10px 0}
  .merged-data-screen strong{font-size:46px}
  .merged-data-screen span{font-size:10px}
  .merged-quiz-screen>header{align-items:flex-start;gap:4px}
  .merged-quiz-screen>h3{font-size:19px}
  .merged-quiz-screen .quiz-options{grid-template-columns:repeat(2,min(140px,40vw));gap:10px}
  .merged-quiz-screen .quiz-image-placeholder{width:min(140px,40vw);height:190px}
  .merged-quiz-screen .quiz-choice-button{min-width:95px}
  .merged-quiz-screen .quiz-reveal{min-height:91px;margin-top:10px;padding:0}
  .merged-result-screen{padding-left:22px}
  .merged-result-screen>strong{font-size:72px}
  .merged-result-screen h3{font-size:20px}
  .merged-card-controls{left:16px;right:16px;height:64px}
  .merged-card-controls>small{max-width:125px}
  .merged-card-mask{left:0}
  .mask-bottom{bottom:64px}
  .merged-scroll-hint{left:24px;bottom:74px}
}

@media (prefers-reduced-motion: reduce) {
  .story-copy-layer,.story-visual-layer,.mock-comment,.reading-line span,.forensic-scan,.council-role,.role-progress i,.role-judgement>i,.council-loading i { animation: none; transition: none; }
  .story-ambient,.story-dots i,.story-progress-label>i b { transition: none; }
  .trust-grid{overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);scrollbar-width:none}.trust-marquee-track{animation:none!important}.trust-marquee-group[aria-hidden="true"]{display:flex}
  .reveal-section{opacity:1;transform:none;transition:none}.evidence-hotspot-wrap>button,.hotspot-popover{animation:none}.evidence-lens{transition:none}
  .evidence-lens-scan,.evidence-operation-hint{animation:none}
  .agent-scene-shell,.agent-segmented button,.agent-segmented button span,.flow-inputs>span,.aperture-petal{transition:none}.agent-scene-content,.agent-flow-connector>i,.orbit-outer,.aperture-core{animation:none}
  .report-mode-switch button,.report-highlight,.report-score-ring,.radar-axis,.radar-data,.radar-point,.dimension-meter i,.report-advice>div,.report-callout{transition:none}.is-visible .report-risk-band i,.is-visible .radar-data,.report-score-ring>em{animation:none}
  .account-menu,.account-dialog{animation:none}
  .agent-prompt-attachments>span,.agent-example-row button,.agent-send-button{transition:none}.typing-cursor,.agent-send-button.pulse,.agent-intro-reply,.agent-intro-next svg{animation:none}.typing-cursor{opacity:1}
  .visual-quiz-card.quiz-transition-out>*,.visual-quiz-card.quiz-transition-in>*,.quiz-ai-marker::before,.quiz-ai-marker::after{animation:none}.quiz-image-placeholder,.quiz-choice-button,.visual-quiz-progress i{transition:none}
  .merged-story-track,.merged-story-dots button{transition:none}.merged-see-screen>small i,.merged-quiz-screen .quiz-reveal>small i{animation:none}
  .merged-card-scroll{scroll-behavior:auto}.merged-scroll-hint i{animation:none}
  .how-chapter-rail{transition:none}
}

@media (pointer: coarse) {
  .evidence-image-frame{touch-action:none;cursor:pointer}.evidence-operation-hint{display:none}
  .aperture-tooltip{display:none}.aperture-petal:hover{transform:none}
}

@media print {
  @page { size: A4; margin: 12mm; }
  body { background: #fff; }
  .app-shell { display:block;height:auto;overflow:visible;background:#fff; }
  .sidebar,.result-header,.chat-header,.chat-composer-wrap,.share-menu { display:none!important; }
  .result,.chat { height:auto;overflow:visible;background:#fff; }
  .report { width:100%;padding:0; }
  .score-hero,.dimension-card,.decision-card { break-inside:avoid;box-shadow:none; }
  .dimension-grid { gap:8px; }
  .chat-scroll { overflow:visible;padding:0; }
}

/* 02 / 查 — scroll-led evidence stage */
.one-agent-section{height:100%;padding:0;overflow:hidden;background:radial-gradient(circle at 50% 53%,rgba(220,213,246,.5),transparent 32%),linear-gradient(180deg,#faf9fc,#f4f2f9 62%,#faf7f8)}
.one-agent-section::before,.one-agent-section::after{display:none}
.one-agent-sticky{position:relative;height:100%;min-height:0;overflow:hidden;padding:28px 5vw 26px;display:flex;flex-direction:column;justify-content:center}
.one-agent-heading{flex:none}
.one-agent-heading .section-tag{display:inline-flex}
.one-agent-heading h2{margin:14px 0 8px;font-size:clamp(38px,4.4vw,58px)}
.one-agent-heading p{font-size:12px;color:#696473}
.agent-segmented{width:min(720px,100%);margin:20px auto 16px}
.agent-scene-shell{position:relative;width:min(900px,100%);height:520px;min-height:0;margin:0 auto;overflow:visible}
.agent-dimension-panel{position:absolute;inset:0;padding:34px 32px;border:1px solid rgba(255,255,255,.9);border-radius:28px;background:rgba(255,255,255,.68);box-shadow:0 25px 75px rgba(60,47,87,.11);backdrop-filter:blur(24px);display:grid;grid-template-columns:minmax(260px,.8fr) minmax(420px,1.2fr);gap:34px;align-items:center;opacity:0;pointer-events:none}
.agent-dimension-panel.active{z-index:2;opacity:1;pointer-events:auto}
.agent-dimension-panel .agent-scene-copy{opacity:0;transform:translateY(8px);transition:opacity 250ms ease,transform 250ms ease}
.agent-dimension-panel .agent-scene-visual{opacity:0;transition:opacity 350ms ease,transform 350ms cubic-bezier(.2,.75,.2,1)}
.agent-dimension-panel.slide-forward .agent-scene-visual{transform:translateX(46px)}
.agent-dimension-panel.slide-backward .agent-scene-visual{transform:translateX(-46px)}
.agent-dimension-panel.active .agent-scene-copy,.agent-dimension-panel.active .agent-scene-visual{opacity:1;transform:translate(0)}
.agent-scene-copy>span{font-size:9px;color:#776e82}
.agent-scene-copy h3{margin:14px 0 13px;font-size:clamp(29px,3vw,42px);line-height:1.12}
.agent-scene-copy p{font-size:12px;line-height:1.8;color:#5f5967}
.agent-scene-copy>small{margin-top:20px;color:#6e6676;background:#f3f0f7}
.agent-dimension-score{position:relative;margin-top:26px;display:grid;grid-template-columns:1fr auto;align-items:end;gap:7px 12px}
.agent-dimension-score>span{font-size:8px;color:#77707e}
.agent-dimension-score>strong{grid-row:1/3;grid-column:2;font:500 44px/1 var(--serif);color:#302a40}
.agent-dimension-score>div{height:3px;border-radius:99px;background:#e5e0e9;overflow:hidden}
.agent-dimension-score>div i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#9a88cb,#c08da4)}
.agent-scene-copy .agent-dimension-score>small{position:absolute;right:-20px;bottom:2px;margin:0;padding:0;border:0;background:transparent;color:#8c8492;font-size:7px}
.agent-scene-visual{height:420px}
.agent-mobile-panels{display:none}
.mobile-dimension-title{display:none}
.agent-account-card,.agent-comment-evidence,.agent-copy-card,.dimension-image-forensics{position:relative;width:100%;height:100%;border:1px solid rgba(58,49,73,.09);border-radius:24px;background:rgba(255,255,255,.84);box-shadow:0 16px 42px rgba(54,43,73,.09)}
.agent-visual-example{position:absolute!important;right:14px;bottom:10px;margin:0!important;padding:0!important;border:0!important;background:transparent!important;color:#77707e!important;font:6px var(--mono)!important;letter-spacing:.06em}

.agent-account-card{padding:22px 20px 28px}
.account-placeholder-data{grid-template-columns:1fr 126px;gap:18px}
.posting-rhythm>div{height:180px;gap:2px}
.posting-rhythm>div button{position:relative;width:100%;min-width:3px;padding:0;border:0;border-radius:3px 3px 0 0;background:#c9bee9;transition:filter .2s ease,transform .2s ease,background .2s ease}
.posting-rhythm>div button.commerce-bar{background:#e7bfc8}
.posting-rhythm>div button:hover,.posting-rhythm>div button:focus-visible{z-index:3;filter:saturate(1.35);transform:scaleX(1.8);outline:none}
.posting-rhythm>div button>span{position:absolute;left:50%;bottom:calc(100% + 7px);width:max-content;max-width:120px;padding:6px 7px;border-radius:7px;background:#302a40;color:#fff;font-size:6px;line-height:1.35;transform:translateX(-50%);opacity:0;pointer-events:none}
.posting-rhythm>div button:hover>span,.posting-rhythm>div button:focus-visible>span{opacity:1}
.agent-account-card.ratio-highlight .commerce-bar{background:#dc8fa0;filter:saturate(1.2)}
.commerce-ratio>button{position:relative;width:110px;height:110px;margin:auto;border:0;border-radius:50%;background:conic-gradient(#8574af 0 80%,rgba(133,116,175,.12) 80%);display:grid;place-items:center}
.commerce-ratio>button::before{content:"";position:absolute;inset:10px;border-radius:50%;background:#fff}
.commerce-ratio>button strong,.commerce-ratio>button small{position:relative;z-index:1}
.commerce-ratio>button strong{font:500 25px var(--serif)}
.commerce-ratio>button small{position:absolute;top:68px;font-size:6px;color:#77707e}
.commerce-ratio>button em{position:absolute;right:0;bottom:-48px;width:150px;padding:7px 9px;border-radius:8px;background:#302a40;color:#fff;font-size:7px;line-height:1.45;font-style:normal;opacity:0;pointer-events:none;z-index:5}
.commerce-ratio>button:hover em,.commerce-ratio>button:focus-visible em{opacity:1}

.dimension-image-forensics{max-width:460px;overflow:hidden;background:#e7d6d3}
.dimension-image-forensics>img{width:100%;height:100%;object-fit:cover;object-position:center 24%;filter:saturate(.75) contrast(.96);transform:scale(1.002);transition:filter .28s ease,transform .5s cubic-bezier(.16,1,.3,1)}
.dimension-image-forensics.is-inspecting{cursor:none}
.dimension-image-forensics.is-inspecting>img{filter:saturate(.62) contrast(1.02) brightness(.92);transform:scale(1.012)}
.dimension-forensic-lens{position:absolute;z-index:4;width:200px;height:200px;border:4px solid #fff;border-radius:50%;background-position:0 0;background-repeat:no-repeat;background-origin:border-box;transform:translate3d(-50%,-50%,0);box-shadow:0 0 0 9px rgba(187,161,235,.18),0 18px 45px rgba(69,44,97,.32);pointer-events:none;overflow:visible;transition:width .18s ease,height .18s ease,box-shadow .18s ease;will-change:left,top,background-position}
.dimension-image-forensics.is-inspecting .dimension-forensic-lens{box-shadow:0 0 0 10px rgba(187,161,235,.22),0 22px 58px rgba(69,44,97,.4)}
.dimension-forensic-lens::before{content:"";position:absolute;inset:0;border-radius:50%;background-image:linear-gradient(rgba(255,255,255,.22) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.22) 1px,transparent 1px);background-size:24px 24px}
.dimension-forensic-lens::after{content:"";position:absolute;left:0;right:0;top:0;height:2px;border-radius:50%;background:linear-gradient(90deg,transparent,#fff,transparent);box-shadow:0 0 12px #d8c5ff;animation:dimension-scan 2s linear infinite}
.dimension-forensic-lens>i,.dimension-forensic-lens>b{position:absolute;z-index:2;left:50%;top:50%;width:30px;height:1px;background:rgba(255,255,255,.8);transform:translate(-50%,-50%)}
.dimension-forensic-lens>b{width:1px;height:30px}
.dimension-forensic-lens>span{position:absolute;left:50%;bottom:-39px;transform:translateX(-50%);padding:6px 9px;border:1px solid rgba(255,255,255,.7);border-radius:99px;background:rgba(73,58,91,.58);backdrop-filter:blur(8px);color:#fff;font:7px var(--mono);white-space:nowrap}
.dimension-hotspot{position:absolute;z-index:7;width:20px;height:20px;padding:0;border:0;border-radius:50%;background:#fff;transform:translate(-50%,-50%);box-shadow:0 0 0 6px rgba(255,255,255,.25)}
.dimension-hotspot>i{position:absolute;inset:-8px;border:1px solid rgba(255,255,255,.85);border-radius:50%;animation:dimension-pulse 1.8s ease-out infinite}
.dimension-hotspot>span{position:absolute;z-index:8;left:26px;top:50%;width:185px;padding:10px 11px;border:1px solid rgba(255,255,255,.85);border-radius:10px;background:rgba(255,255,255,.94);box-shadow:0 12px 35px rgba(43,32,58,.19);color:#3f3947;font-size:9px;line-height:1.55;text-align:left;transform:translateY(-50%);animation:evidence-pop .2s ease both}
.dimension-hotspot:nth-of-type(2)>span{left:auto;right:26px}
.dimension-hotspot>span small{display:block;margin-bottom:3px;color:#8371b3;font:6px var(--mono)}
.dimension-image-forensics>p{position:absolute;z-index:3;left:50%;bottom:18px;margin:0;padding:7px 10px;border-radius:99px;background:rgba(39,32,51,.55);backdrop-filter:blur(8px);color:#fff;font-size:7px;transform:translateX(-50%);white-space:nowrap}

.agent-comment-evidence{padding:18px 18px 32px}
.comment-evidence-tabs{display:flex;justify-content:flex-end;gap:6px;margin-bottom:9px}
.comment-evidence-tabs button{padding:6px 8px;border:1px solid rgba(69,58,84,.08);border-radius:99px;background:#f1eef5;color:#625a6d;font-size:7px}
.comment-evidence-tabs button.active,.comment-evidence-tabs button:hover,.comment-evidence-tabs button:focus-visible{background:#443b58;color:#fff}
.comment-evidence-list{display:flex;flex-direction:column;gap:5px}
.comment-evidence-list p{margin:0;padding:7px 9px;border-radius:9px;background:#f7f5f8;color:#5e5865;font-size:7px;display:flex;align-items:center;gap:7px;transition:opacity .2s ease,background .2s ease}
.comment-evidence-list p i{width:15px;height:15px;flex:none;border-radius:50%;background:linear-gradient(135deg,#ded8e8,#f1dfe2)}
.comment-evidence-list p.similar{background:#eee9f9}
.comment-evidence-list.highlighted p:not(.similar){opacity:.35}
.comment-evidence-list.highlighted p.similar{background:#ded4f4}
.comment-time-axis{position:relative;margin-top:14px;padding-top:24px}
.comment-time-axis>div{position:relative;height:2px;background:#dcd6e2}
.comment-time-axis>span{position:absolute;top:29px;color:#8b8490;font-size:5px}
.comment-time-axis>span:nth-child(2){left:50%;transform:translateX(-50%)}.comment-time-axis>span:nth-child(3){right:0}
.comment-time-axis i{position:absolute;top:50%;width:7px;height:7px;border-radius:50%;background:#aaa0bd;transform:translate(-50%,-50%);transition:transform .2s ease,background .2s ease}
.comment-time-axis i.clustered{background:#c58a9a}
.comment-time-axis.highlighted i.clustered{background:#b95f78;transform:translate(-50%,-50%) scale(1.45)}
.comment-time-axis em{position:absolute;left:4%;top:0;padding:4px 6px;border-radius:5px;background:#f5e1e6;color:#814e5c;font-size:6px;font-style:normal}
.agent-comment-evidence>small:not(.agent-visual-example){display:block;margin-top:23px;color:#5d5664;font-size:8px}

.script-evidence-card{padding:22px 22px 34px}
.script-evidence-card p{margin-top:28px;font-size:12px;line-height:2.3}
.script-evidence-card p>button{position:relative;display:inline;padding:3px 5px;border:0;border-radius:5px;background:#e9e1fa;color:#4e416c}
.script-evidence-card p>button.risk{background:#f5dfe4;color:#784a55}
.script-evidence-card p>button.claim{background:#f6e8ca;color:#755d25}
.script-evidence-card p>button>span{position:absolute;z-index:3;left:50%;bottom:calc(100% + 8px);width:max-content;padding:7px 9px;border-radius:8px;background:#302a40;color:#fff;font-size:7px;line-height:1;transform:translateX(-50%);opacity:0;pointer-events:none}
.script-evidence-card p>button:hover>span,.script-evidence-card p>button:focus-visible>span{opacity:1}
.script-evidence-card .copy-risk-labels{margin-top:30px}
.script-evidence-card .copy-risk-labels span{background:#e9e1fa;color:#584675}
.script-evidence-card .copy-risk-labels span:nth-child(2){background:#f5dfe4;color:#784a55}
.script-evidence-card .copy-risk-labels span:nth-child(3){background:#f6e8ca;color:#755d25}

.architecture-section{position:relative;height:100%;min-height:0;padding:0;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(221,214,246,.42),transparent 31%),linear-gradient(180deg,#faf7f8,#f5f3fa 68%,#faf7f8)}
.architecture-sticky{position:relative;height:100%;min-height:0;padding:28px 5vw 34px;overflow:hidden;display:flex;flex-direction:column;justify-content:center}
.architecture-heading{position:relative;z-index:3;text-align:center}
.architecture-heading .section-tag{display:inline-flex}
.architecture-heading h2{margin:15px 0 9px;font:500 clamp(40px,4vw,48px)/1.05 var(--serif);letter-spacing:-.04em;color:#292535}
.architecture-heading p{margin:0;color:#625c69;font-size:12px}
.architecture-section .one-agent-flow{width:min(1080px,100%);margin:26px auto 0;grid-template-columns:190px 105px 300px 145px 165px}
.architecture-section .one-agent-example{right:5vw;bottom:22px}
.merge-results{gap:8px}
.merge-result{--result-progress:0;position:relative;isolation:isolate;min-height:46px;padding:7px 10px;border:1px dashed #aaa4af;border-radius:13px;background:#eeecf0;color:#67616d;display:grid;grid-template-columns:29px 1fr 30px;align-items:center;gap:8px;box-shadow:0 7px 20px rgba(53,42,72,.04)}
.merge-result::before{content:"";position:absolute;z-index:-1;inset:-1px;border:1px solid transparent;border-radius:inherit;opacity:var(--result-progress);transition:opacity .16s linear}
.merge-result>span{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#d9d5dd;color:#4e4854;font:500 9px var(--mono)}
.merge-result>div{min-width:0;display:flex;flex-direction:column;gap:6px}
.merge-result strong{font-size:8px;font-weight:500;white-space:nowrap}
.merge-result i{height:2px;border-radius:99px;background:rgba(55,48,67,.13);overflow:hidden}
.merge-result i b{display:block;height:100%;border-radius:inherit;background:#76669e}
.merge-result em{min-height:16px;text-align:right;font:500 13px var(--mono);font-style:normal;color:#312b39}
.result-t::before{background:#ebe7ff;border-color:#bcb0df}.result-r::before{background:#e6f0ff;border-color:#aebfd8}.result-u::before{background:#f9e9e8;border-color:#d7b1b6}.result-s::before{background:#e8f3ed;border-color:#abc9ba}
.result-t>span{background:color-mix(in srgb,#c9bee9 calc(var(--result-progress) * 100%),#d9d5dd)}.result-r>span{background:color-mix(in srgb,#bfd5ed calc(var(--result-progress) * 100%),#d9d5dd)}.result-u>span{background:color-mix(in srgb,#e7bfc8 calc(var(--result-progress) * 100%),#d9d5dd)}.result-s>span{background:color-mix(in srgb,#bfdaca calc(var(--result-progress) * 100%),#d9d5dd)}
.architecture-section .agent-flow-connector path{stroke:#8f80b4;stroke-width:1.4;transition:stroke-dashoffset .1s linear}
.architecture-section .agent-flow-connector>i{display:none}
.architecture-section .aperture-petal{opacity:calc(.24 + var(--petal-progress) * .76);filter:saturate(calc(.25 + var(--petal-progress) * .75));pointer-events:none;transition:none}
.merge-rays line{stroke:#fff;stroke-width:1.5;stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--merge-progress));filter:drop-shadow(0 0 5px rgba(126,105,174,.7));transition:stroke-dashoffset .1s linear}
.architecture-section .aperture-core{animation:none}
.architecture-section .rule-score-node{--rule-progress:0;width:142px;padding:10px 11px;opacity:var(--rule-progress);transform:translate(-50%,-50%) translateX(calc((1 - var(--rule-progress)) * 36px));transition:opacity .1s linear,transform .1s linear}
.architecture-section .rule-score-node strong{font-size:8px}
.architecture-section .rule-score-node small{font-size:6px;line-height:1.55;color:#68616f}
.flow-outputs{gap:8px}
.flow-outputs .merge-output{--output-progress:0;position:relative;min-height:40px;padding:10px 12px;border:1px dashed #aaa4af;border-radius:999px;background:color-mix(in srgb,#fff calc(var(--output-progress) * 78%),#e5e2e7);color:#4f4955;display:grid;place-items:center;font-size:8px;opacity:calc(.48 + var(--output-progress) * .52);box-shadow:0 7px 20px rgba(53,42,72,calc(var(--output-progress) * .07));transition:none}
.flow-outputs .score-output{min-height:82px;border-radius:19px;grid-template-columns:1fr auto;text-align:left}
.score-output>span{font-size:7px;color:#5e5764}
.score-output>strong{font:500 26px/1 var(--serif);color:#2f2937}
.score-output>strong small{font:7px var(--mono);color:#625b69}
.score-output>em{grid-column:1/3;justify-self:start;padding:5px 7px;border-radius:99px;background:#f3e2bd;color:#684e18;font-size:6px;font-style:normal;opacity:var(--verdict-progress,var(--output-progress))}

@keyframes dimension-scan{0%{top:5%}100%{top:95%}}
@keyframes dimension-pulse{0%{transform:scale(.7);opacity:1}100%{transform:scale(1.65);opacity:0}}

@media (max-width: 900px){
  .trust-section{min-height:760px;padding:78px 0 92px}
  .trust-section .trust-heading{padding:0 20px}
  .trust-section .trust-heading h2{font-size:42px}
  .trust-section .trust-heading p{max-width:340px;font-size:11px;line-height:1.7}
  .trust-source-note{width:min(320px,calc(100vw - 36px));margin-top:29px}
  .trust-split-lines{width:94vw;height:58px}
  .trust-grid{overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;touch-action:pan-x;scrollbar-width:none}
  .trust-grid::-webkit-scrollbar{display:none}
  .trust-marquee-group{gap:16px;padding-right:16px}
  .trust-card{width:280px;height:300px;padding:24px;border-radius:24px}
  .trust-card>span{font-size:62px}
  .trust-card h3{margin-top:12px;font-size:21px}
  .trust-card strong{font-size:21px}
  .trust-card p{font-size:9px}
  .trust-card{grid-template-columns:minmax(0,1fr) 104px;column-gap:10px;grid-template-rows:auto auto 1fr}
  .trust-card>div{grid-column:1/3}
  .trust-card>.trust-card-expert{grid-row:1/3;width:104px;height:120px;align-self:start}
  .one-agent-section{height:auto;overflow:hidden}
  .one-agent-sticky{position:relative;height:auto;min-height:0;overflow:visible;padding:86px 18px 80px;display:block}
  .one-agent-heading h2{font-size:42px;margin-top:18px}
  .one-agent-heading p{max-width:350px;margin:0 auto;font-size:11px;line-height:1.75}
  .agent-segmented,.agent-scene-shell{display:none}
  .agent-mobile-panels{width:min(620px,100%);margin:46px auto 0;display:flex;flex-direction:column;gap:28px}
  .agent-dimension-panel.mobile-panel{position:relative;inset:auto;padding:21px 17px 18px;border-radius:23px;grid-template-columns:1fr;gap:22px;opacity:1;pointer-events:auto;scroll-margin-top:18px}
  .mobile-dimension-title{display:flex;align-items:center;gap:9px;margin:0;padding-bottom:14px;border-bottom:1px solid var(--line);font:500 17px var(--serif)}
  .mobile-dimension-title span{width:29px;height:29px;border-radius:50%;display:grid;place-items:center;background:#302a40;color:#fff;font:9px var(--mono)}
  .agent-scene-copy h3{font-size:30px}
  .agent-scene-copy p{font-size:11px}
  .agent-scene-copy>small{margin-top:16px}
  .agent-dimension-score{margin-top:20px}
  .agent-scene-visual{height:420px}
  .agent-account-card{padding-left:14px;padding-right:14px}
  .account-placeholder-data{grid-template-columns:1fr 105px;gap:10px}
  .posting-rhythm>div{height:170px}
  .dimension-forensic-lens,.dimension-image-forensics>p{display:none}
  .dimension-image-forensics{max-width:none}
  .dimension-hotspot>span{width:150px;left:22px}
  .dimension-hotspot:nth-of-type(2)>span{left:auto;right:22px}
  .architecture-section{height:auto;min-height:0;overflow:hidden}
  .architecture-sticky{position:relative;height:auto;min-height:0;padding:82px 18px 94px;display:block;overflow:visible}
  .architecture-heading h2{font-size:40px;line-height:1.08}
  .architecture-heading p{max-width:340px;margin-left:auto;margin-right:auto;font-size:11px;line-height:1.7}
  .architecture-section .one-agent-flow{width:100%;margin-top:48px;margin-bottom:0;transform:none;display:grid;grid-template-columns:1fr;justify-items:center;gap:0}
  .merge-results{width:min(380px,100%);display:flex;flex-direction:column;gap:9px}
  .merge-results>small{margin-bottom:6px}
  .merge-result{width:100%;grid-template-columns:32px 1fr 36px;opacity:0;transform:translateY(12px);transition:opacity .45s ease,transform .45s ease}
  .architecture-section .connector-in{width:140px;height:95px;margin:8px 0;transform:rotate(90deg)}
  .architecture-section .aperture-column{width:100%;opacity:0;transform:translateY(12px);transition:opacity .5s ease .42s,transform .5s ease .42s}
  .architecture-section .connector-out{width:145px;height:120px;margin:12px 0 25px;transform:rotate(90deg);opacity:0;transition:opacity .45s ease .68s}
  .architecture-section .connector-out .rule-score-node{left:53%;width:150px;transform:translate(-50%,-50%) rotate(-90deg)}
  .architecture-section .flow-outputs{width:min(360px,100%);display:flex;flex-direction:column;gap:9px;opacity:1}
  .architecture-section .flow-outputs>small{margin-bottom:5px}
  .flow-outputs .merge-output{width:100%;opacity:0;transform:translateY(10px);transition:opacity .42s ease,transform .42s ease}
  .flow-outputs .score-output{padding-left:17px;padding-right:17px}
  .architecture-section.merge-visible .merge-result,.architecture-section.merge-visible .aperture-column,.architecture-section.merge-visible .connector-out,.architecture-section.merge-visible .merge-output{opacity:1;transform:translate(0)}
  .architecture-section.merge-visible .merge-result:nth-of-type(1){transition-delay:.06s}
  .architecture-section.merge-visible .merge-result:nth-of-type(2){transition-delay:.13s}
  .architecture-section.merge-visible .merge-result:nth-of-type(3){transition-delay:.2s}
  .architecture-section.merge-visible .merge-result:nth-of-type(4){transition-delay:.27s}
  .architecture-section.merge-visible .connector-out{transform:rotate(90deg)}
  .architecture-section.merge-visible .merge-output:nth-of-type(1){transition-delay:.78s}
  .architecture-section.merge-visible .merge-output:nth-of-type(2){transition-delay:.88s}
  .architecture-section.merge-visible .merge-output:nth-of-type(3){transition-delay:.98s}
  .architecture-section .one-agent-example{right:18px;bottom:24px}
}

@media (max-width: 480px){
  .agent-scene-visual{height:390px}
  .account-placeholder-head{grid-template-columns:auto 1fr}
  .account-placeholder-head>em{grid-column:1/3;justify-self:start}
  .account-placeholder-data{grid-template-columns:1fr 86px}
  .posting-rhythm>div{height:145px}
  .commerce-ratio>button{width:84px;height:84px}
  .commerce-ratio>button small{top:54px}
  .comment-evidence-list p{font-size:6.5px}
  .script-evidence-card p{font-size:11px;line-height:2.5}
}

@media (prefers-reduced-motion: reduce){
  .trust-section .trust-source-note{opacity:1;transform:none;animation:none}
  .trust-split-lines{display:none}
  .trust-section .trust-marquee-track{animation:none}
  .trust-grid{overflow-x:auto;mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);scroll-snap-type:x mandatory}
  .trust-card{transition:none}
  .one-agent-section{height:auto}
  .one-agent-sticky{position:relative;height:auto;min-height:0}
  .agent-dimension-panel .agent-scene-copy,.agent-dimension-panel .agent-scene-visual{transition:none}
  .dimension-forensic-lens::after,.dimension-hotspot>i{animation:none}
  .architecture-section{height:auto}
  .architecture-sticky{position:relative;height:auto;min-height:760px}
  .architecture-section .merge-result,.architecture-section .aperture-column,.architecture-section .connector-out,.architecture-section .merge-output,.architecture-section .rule-score-node,.architecture-section .agent-flow-connector path{transition:none}
}

/* 04 / 报 — report reveal and data states */
.report-showcase-section .trust-report-card{opacity:0;transform:translateY(24px)}
.report-mode-switch.single{grid-template-columns:1fr}
.report-mode-switch.single button{min-width:180px;font-size:10px;box-shadow:rgba(0,0,0,.25) 0 4px 4px 0;--figma-make-local-effect-type:DROP_SHADOW}
.report-showcase-section.is-visible .trust-report-card{animation:report-card-reveal .5s ease forwards}
.report-showcase-section.is-visible .report-risk-band i{animation:report-pointer-in .7s ease .18s both}
.report-showcase-section.is-visible .radar-data{animation:radar-expand .8s cubic-bezier(.2,.75,.2,1) .18s both}
.report-showcase-section .dimension-meter i{transform:scaleX(0);transform-origin:left}
.report-showcase-section.is-visible .report-dimension-row:nth-child(1) .dimension-meter i{animation:report-meter-fill .5s ease .28s forwards}
.report-showcase-section.is-visible .report-dimension-row:nth-child(2) .dimension-meter i{animation:report-meter-fill .5s ease .4s forwards}
.report-showcase-section.is-visible .report-dimension-row:nth-child(3) .dimension-meter i{animation:report-meter-fill .5s ease .52s forwards}
.report-showcase-section.is-visible .report-dimension-row:nth-child(4) .dimension-meter i{animation:report-meter-fill .5s ease .64s forwards}
.report-callout{opacity:0;transform:translateY(7px)}
.report-callout>i{transform:scaleX(0)}
.report-callout.callout-left>i{transform-origin:right}
.report-callout.callout-right>i{transform-origin:left}
.report-showcase-section.is-visible .report-callout{animation:report-callout-in .4s ease forwards}
.report-showcase-section.is-visible .report-callout>i{animation:report-callout-line .4s ease forwards}
.report-showcase-section.is-visible .report-callout:nth-child(1),.report-showcase-section.is-visible .report-callout:nth-child(1)>i{animation-delay:.45s}
.report-showcase-section.is-visible .report-callout:nth-child(2),.report-showcase-section.is-visible .report-callout:nth-child(2)>i{animation-delay:.6s}
.report-showcase-section.is-visible .report-callout:nth-child(3),.report-showcase-section.is-visible .report-callout:nth-child(3)>i{animation-delay:.75s}
.report-showcase-section.is-visible .report-callout:nth-child(4),.report-showcase-section.is-visible .report-callout:nth-child(4)>i{animation-delay:.9s}
.report-showcase-section.is-visible .report-callout:nth-child(5),.report-showcase-section.is-visible .report-callout:nth-child(5)>i{animation-delay:1.05s}
.report-callout.callout-5{top:655px}
.report-state-swap{animation:report-state-swap .25s ease both}
.report-verdict{transition:background .25s ease,color .25s ease}
.report-verdict.missing{background:#e9e7ea;color:#58525d}
.has-missing-data .report-score-ring>strong{font-size:25px;letter-spacing:-.02em}
.has-missing-data .report-risk-band i{display:none}
.has-missing-data .radar-data{fill:none;stroke-dasharray:5 4}
.radar-point.missing-point{fill:#fff;stroke:#81758f;stroke-width:2;stroke-dasharray:3 2}
.radar-axis-name{font:6px "Noto Sans SC",sans-serif!important;fill:#5f5867!important}
.report-dimension-row.is-missing b,.report-dimension-row.is-missing small{color:#625c68}
.report-final-action{position:relative;z-index:3;margin:45px auto 0;display:flex;flex-direction:column;align-items:center;gap:12px}
.report-final-action>button{padding:6px 6px 6px 23px;border:0;border-radius:999px;background:linear-gradient(110deg,#28233f,#41345f);box-shadow:0 14px 35px rgba(55,43,83,.2);color:#fff;display:flex;align-items:center;gap:18px;font-size:12px;transition:transform .25s ease,box-shadow .25s ease}
.report-final-action>button:hover{transform:translateY(-2px);box-shadow:0 18px 42px rgba(55,43,83,.27)}
.report-final-action>button>span{width:36px;height:36px;border-radius:50%;background:#fff;color:#2f2941;display:grid;place-items:center}
.report-final-action>small{color:#716b77;font-size:8px}

@keyframes report-card-reveal{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes report-meter-fill{to{transform:scaleX(1)}}
@keyframes report-callout-in{to{opacity:1;transform:translateY(0)}}
@keyframes report-callout-line{to{transform:scaleX(1)}}
@keyframes report-state-swap{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}

@media (max-width: 900px){
  .report-callout.callout-5{top:auto}
  .report-callouts{grid-template-columns:1fr;margin-top:28px}
  .report-callout{width:100%}
  .report-final-action{margin-top:38px}
}

@media (prefers-reduced-motion: reduce){
  .report-showcase-section .trust-report-card,.report-showcase-section .report-callout{opacity:1;transform:none;animation:none}
  .report-showcase-section .report-callout>i,.report-showcase-section .dimension-meter i{transform:none;animation:none}
  .report-showcase-section.is-visible .report-risk-band i,.report-showcase-section.is-visible .radar-data,.report-state-swap{animation:none}
  .report-final-action>button{transition:none}
}

/* Unified How narrative stage */
.how-narrative{position:relative;height:640vh;background:radial-gradient(circle at 24% 32%,rgba(244,207,220,.36),transparent 30%),radial-gradient(circle at 78% 44%,rgba(204,217,255,.48),transparent 32%),linear-gradient(155deg,#f8f6fd,#f5f3fa 58%,#faf6f7)}
.how-stage{position:sticky;top:0;height:100vh;min-height:650px;overflow:hidden}
.how-scene{position:absolute;inset:0;will-change:opacity,transform;transform-origin:center;overflow:hidden;backface-visibility:hidden}
.how-scene-canvas{width:100%;height:100%;transform:scale(var(--how-scene-scale,1));transform-origin:center}
.how-scene .trust-section,.how-scene .one-agent-section,.how-scene .architecture-section,.how-scene .report-showcase-section{height:100%;min-height:0;background:transparent}
.how-scene .trust-section{padding:44px 0 28px;display:flex;flex-direction:column;justify-content:center}
.how-scene .trust-heading{flex:none}
.how-scene .trust-grid{padding-left:96px}
.how-scene .trust-source-note{margin-top:20px}
.how-scene .trust-split-lines{height:58px}
.how-scene .trust-card{height:300px}
.how-scene .one-agent-section{padding:0;overflow:hidden}
.how-scene .one-agent-sticky{position:relative;top:auto;height:100%;min-height:0;padding:21px 5vw;overflow:hidden}
.how-scene .one-agent-heading h2{margin-top:11px;font-size:46px}
.how-scene .agent-segmented{margin:14px auto 12px}
.how-scene .agent-scene-shell{height:500px}
.how-scene .agent-dimension-panel{padding-top:25px;padding-bottom:25px}
.agent-segmented button{position:relative;overflow:hidden}
.agent-tab-timer{position:absolute;left:12%;right:12%;bottom:2px;height:2px;border-radius:99px;background:#bdaee7;transform-origin:left;animation:agent-tab-countdown 4.5s linear forwards}
.how-scene .architecture-section{padding:0;overflow:hidden}
.how-scene .architecture-sticky{position:relative;top:auto;height:100%;min-height:0;padding:32px 5vw;overflow:hidden}
.how-scene .architecture-section .one-agent-flow{margin-top:19px}
.how-scene .report-showcase-section{padding:clamp(78px,9vh,96px) 5vw 18px;overflow:hidden}
.how-scene .report-showcase-heading h2{margin:12px 0 7px;font-size:46px}
.how-scene .report-showcase-stage{margin-top:10px;padding-top:43px}
.how-scene .trust-report-card{padding:17px 19px;border-radius:23px}
.how-scene .trust-report-head{padding-bottom:13px}
.how-scene .report-score-block{padding:14px 0 11px}
.how-scene .report-score-ring{min-height:82px}
.how-scene .report-risk-band{padding-bottom:14px}
.how-scene .report-dimensions-block{padding:13px 0;grid-template-columns:200px 1fr}
.how-scene .report-radar svg{height:180px}
.how-scene .report-dimension-list{gap:8px}
.how-scene .report-advice{padding-top:12px}
.how-scene .report-advice h3{margin-bottom:6px}
.how-scene .report-advice>div{min-height:30px;padding:4px 0}
.how-scene .report-final-action{margin-top:13px;gap:6px}
.how-scene .report-final-action>button{padding-left:18px}
.how-narrative .how-chapter-rail{position:absolute;z-index:30;left:18px;top:50%;transform:translateY(-50%)}
.how-chapter-rail>div{overflow:hidden}
.how-rail-progress{position:absolute;z-index:0;left:7px;top:17px;width:1px;max-height:calc(100% - 34px);background:#6f628c;transition:height .08s linear}
.how-progress-card{position:absolute;z-index:28;right:24px;top:20px;width:220px;height:56px;padding:8px 11px;border:1px solid rgba(54,47,69,.08);border-radius:16px;background:rgba(255,255,255,.84);box-shadow:0 13px 38px rgba(52,42,69,.1);backdrop-filter:blur(16px);display:grid;grid-template-columns:36px 1fr;align-items:center;gap:10px}
.how-progress-card img{width:36px;height:36px;border-radius:10px;object-fit:cover;object-position:center 24%;filter:saturate(.78)}
.how-progress-card>div{min-width:0;display:flex;flex-direction:column;gap:4px}
.how-progress-card strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:8px;font-weight:500;color:#3d3744}
.how-progress-card small{font:7px var(--mono);color:#736a7b;animation:scene-in .22s ease both}
.how-story-status{position:absolute;z-index:29;right:clamp(24px,3.2vw,52px);top:clamp(88px,9vh,104px);width:min(290px,calc(100vw - 48px));padding:13px 14px 12px;border:1px solid rgba(65,52,83,.08);border-radius:18px;background:rgba(250,248,252,.78);box-shadow:0 15px 45px rgba(50,39,68,.08);backdrop-filter:blur(18px);display:grid;grid-template-columns:32px 1fr;gap:4px 10px;align-items:center;pointer-events:none}
.how-story-status>span{grid-row:1/3;width:32px;height:32px;border:1px solid rgba(84,66,111,.13);border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.7);color:#6e6081;font:8px var(--mono)}
.how-story-status>div{min-width:0;display:flex;flex-direction:column;gap:4px}
.how-story-status small{color:#948a9d;font:6px var(--mono);letter-spacing:.09em}
.how-story-status strong{overflow:hidden;color:#443c4c;font-size:9px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}
.how-story-status>i{grid-column:1/3;height:2px;margin-top:7px;border-radius:99px;background:rgba(104,86,130,.1);overflow:hidden}
.how-story-status>i>b{display:block;width:100%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#8b78ab,#b28d98);transform-origin:left;transition:transform .12s linear}

@keyframes agent-tab-countdown{from{transform:scaleX(0)}to{transform:scaleX(1)}}

@media (min-width:900px){
  .how-narrative .how-chapter-rail{display:block}
}
@media (min-width:900px) and (max-height:800px){
  .how-scene-canvas{--how-scene-scale:.88}
}
@media (min-width:900px) and (max-height:700px){
  .how-scene-canvas{--how-scene-scale:.78}
}
@media (min-width:900px) and (max-height:650px){
  .how-scene-canvas{--how-scene-scale:.75}
}

@media (max-width:899px){
  .how-narrative{height:auto;background:linear-gradient(180deg,#f1effa,#faf6f7)}
  .how-stage{position:relative;height:auto;min-height:0;overflow:visible}
  .how-story-status{display:none}
  .how-scene{position:relative;inset:auto;overflow:hidden;opacity:0;transform:translateY(20px);visibility:visible!important;transition:opacity .45s ease,transform .45s ease}
  .how-scene.mobile-visible{opacity:1;transform:translateY(0)}
  .how-scene-canvas{height:auto;transform:none}
  .how-scene .trust-section,.how-scene .one-agent-section,.how-scene .architecture-section,.how-scene .report-showcase-section{height:auto;background:transparent}
  .how-scene .trust-section{padding:78px 0 92px}
  .how-scene .trust-heading h2{width:min(360px,100%);max-width:360px;margin-left:auto;margin-right:auto;font-size:clamp(38px,10.4vw,44px);line-height:1.08;text-wrap:balance}
  .how-scene .trust-heading h2 span,.how-scene .report-showcase-heading h2 span{display:block}
  .how-scene .trust-heading p{padding:0 24px}
  .how-scene .trust-split-lines{height:58px}
  .how-scene .trust-grid{scroll-snap-type:none;padding-left:0}
  .how-scene .trust-card{height:300px}
  .how-scene .one-agent-sticky{height:auto;padding:82px 18px 88px;overflow:visible}
  .how-scene .one-agent-heading h2{width:min(360px,100%);max-width:360px;margin:18px auto 0;font-size:clamp(34px,9.4vw,39px);line-height:1.12;text-wrap:balance}
  .how-scene .agent-segmented{display:grid;margin-top:28px}
  .how-scene .agent-scene-shell{display:block;height:780px}
  .how-scene .agent-mobile-panels{display:none}
  .how-scene .agent-dimension-panel{padding:22px 17px;grid-template-columns:1fr;gap:22px;border-radius:23px}
  .how-scene .agent-scene-visual{height:420px}
  .how-scene .architecture-sticky{height:auto;padding:82px 18px 94px;overflow:visible}
  .how-scene .architecture-section .one-agent-flow{margin-top:48px}
  .how-scene .report-showcase-section{padding:82px 18px 100px;overflow:hidden}
  .how-scene .report-showcase-heading h2{width:min(360px,100%);max-width:360px;margin:18px auto 0;font-size:clamp(34px,9.4vw,39px);line-height:1.12;text-wrap:balance}
  .how-scene .report-showcase-stage{margin-top:35px;padding-top:56px}
  .how-scene .report-dimensions-block{grid-template-columns:1fr;gap:28px}
  .how-scene .report-radar svg{height:210px}
  .how-scene .report-final-action{margin-top:38px}
  .report-showcase-section.is-static .trust-report-card,.report-showcase-section.is-static .report-callout{opacity:1;transform:none;animation:none}
  .report-showcase-section.is-static .report-callout>i,.report-showcase-section.is-static .dimension-meter i{transform:none;animation:none}
  .report-showcase-section.is-static .report-risk-band i,.report-showcase-section.is-static .radar-data{animation:none}
}

@media (prefers-reduced-motion:reduce){
  .how-narrative{height:auto}
  .how-stage{position:relative;height:auto;overflow:visible}
  .how-scene{position:relative;inset:auto;opacity:1!important;transform:none!important;visibility:visible!important;overflow:hidden}
  .how-scene-canvas{height:auto;transform:none}
  .agent-tab-timer{display:none}
}

/* Shared generated and archived report template */
.unified-report-page{width:min(1040px,calc(100% - 60px));margin:0 auto;padding:36px 0 80px}
.unified-report-card{position:relative;padding:32px;border:1px solid rgba(255,255,255,.9);border-radius:32px;background:rgba(255,255,255,.83);box-shadow:0 30px 90px rgba(60,47,87,.13);backdrop-filter:blur(24px)}
.unified-report-card::before,.unified-report-card::after{content:"";position:absolute;z-index:-1;border:1px solid rgba(117,98,165,.09);border-radius:50%;pointer-events:none}
.unified-report-card::before{width:1150px;height:430px;left:50%;top:43%;transform:translate(-50%,-50%) rotate(-6deg)}
.unified-report-card::after{width:920px;height:330px;left:50%;top:48%;transform:translate(-50%,-50%) rotate(7deg)}
.unified-report-card>header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding-bottom:22px;border-bottom:1px solid var(--line)}
.unified-report-card>header>div{display:flex;flex-direction:column;gap:6px}
.unified-report-card>header strong{font-size:16px;font-weight:600;color:#332d3b}
.unified-report-card>header small{font-size:9px;color:#77717e}
.unified-report-card>header>span{padding:7px 10px;border:1px solid rgba(58,49,73,.08);border-radius:99px;background:#f4f1f6;color:#716a77;font:7px var(--mono)}
.unified-score-row{padding:27px 0 18px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.unified-score{width:285px;min-height:132px;padding:19px 24px;border:1px solid rgba(117,105,157,.18);border-radius:70px;display:flex;flex-direction:column;justify-content:center}
.unified-score>span{font:8px var(--mono);letter-spacing:.09em;color:#726b79}
.unified-score>strong{margin-top:6px;font:500 60px/1 var(--serif);letter-spacing:-.05em;color:#2e2836}
.unified-score>strong small{font:10px var(--mono);color:#77707d}
.unified-verdict{padding:10px 15px;border-radius:99px;background:#f4e1e1;color:#774b52;font-size:9px;font-weight:500}
.unified-report-card.warning .unified-verdict{background:#f3e5ce;color:#6d542a}.unified-report-card.danger .unified-verdict{background:#f2dddf;color:#7b494f}.unified-report-card.trusted .unified-verdict{background:#e2f0e8;color:#466b58}
.unified-risk-band{display:grid;grid-template-columns:1fr 1fr;padding-bottom:27px}
.unified-risk-band>div{position:relative;grid-column:1/3;height:6px;border-radius:99px;background:linear-gradient(90deg,#c98791,#ddc17f 52%,#78a28c)}
.unified-risk-band i{position:absolute;top:-6px;width:3px;height:18px;border-radius:99px;background:#2f2a40;box-shadow:0 0 0 4px rgba(255,255,255,.92);transform:translateX(-50%)}
.unified-risk-band>span{margin-top:8px;color:#77707d;font-size:7px}.unified-risk-band>span:last-child{text-align:right}
.unified-dimensions{padding:27px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:290px 1fr;gap:42px;align-items:center}
.unified-radar{text-align:center}
.unified-radar svg{width:100%;height:250px;overflow:visible}
.unified-radar line{stroke:rgba(88,73,117,.18);stroke-width:1}
.unified-radar g circle{fill:#f4f1f8;stroke:rgba(96,79,128,.2)}
.unified-radar g text{font:8px var(--mono);fill:#625a70}
.unified-radar g.missing circle{fill:transparent;stroke-dasharray:3 3}.unified-radar g.missing text{opacity:.45}
.unified-radar-data{fill:rgba(139,120,185,.25);stroke:#8977b4;stroke-width:2}
.unified-radar-point{fill:#8977b4;stroke:#fff;stroke-width:2}
.unified-radar>small{display:block;margin-top:-7px;color:#77707d;font-size:7px}
.unified-dimension-list{display:flex;flex-direction:column;gap:16px}
.unified-dimension-row{width:100%;padding:7px 9px;border:1px solid transparent;border-radius:14px;background:transparent;display:grid;grid-template-columns:38px 1fr;gap:13px;align-items:start;text-align:left;transition:transform .22s ease,background .22s ease,border-color .22s ease,box-shadow .22s ease}
.unified-dimension-row:not(:disabled){cursor:pointer}
.unified-dimension-row:not(:disabled):hover,.unified-dimension-row:not(:disabled):focus-visible{border-color:rgba(117,98,165,.14);background:rgba(255,255,255,.78);box-shadow:0 10px 28px rgba(60,47,87,.08);transform:translateX(5px)}
.unified-dimension-row:focus-visible{outline:2px solid rgba(117,98,165,.35);outline-offset:2px}
.unified-dimension-row .report-dimension-badge{width:38px;height:38px;border-radius:11px;font-size:11px}
.unified-dimension-row:not(:disabled):hover .report-dimension-badge{transform:translateY(-2px) scale(1.04);box-shadow:0 7px 16px rgba(60,47,87,.1)}
.unified-dimension-row .report-dimension-badge{transition:transform .22s ease,box-shadow .22s ease}
.unified-dimension-row>div{min-width:0}
.unified-dimension-row>div>span{display:flex;align-items:center;justify-content:space-between;gap:12px}
.unified-dimension-row strong{font-size:11px;font-weight:600;color:#37313f}
.unified-dimension-row b{font:9px var(--mono);font-weight:500;color:#5f5867}
.unified-dimension-row b>i{display:inline-block;margin-left:4px;font-style:normal;opacity:.5;transition:transform .22s ease,opacity .22s ease}
.unified-dimension-row:hover b>i{opacity:1;transform:translate(2px,-2px)}
.unified-dimension-row>div>div{height:4px;margin:7px 0;border-radius:99px;background:#e5e0e8;overflow:hidden}
.unified-dimension-row>div>div i{display:block;height:100%;border-radius:inherit;background:#8977b4}
.unified-dimension-row small{display:block;color:#716a77;font-size:8px;line-height:1.55}
.unified-dimension-row.missing{opacity:.55}
.unified-dimension-row.missing>div>div{background:repeating-linear-gradient(90deg,#cbc5cf 0 5px,transparent 5px 9px);border:1px dashed #c4bdc9}
.unified-advice{position:relative;padding:28px 0 0}
.unified-advice>span{font:8px var(--mono);letter-spacing:.08em;color:#77707d}
.unified-advice h3{margin:8px 0 10px;font:500 25px/1.25 var(--serif);color:#302a39}
.unified-advice p{max-width:760px;margin:0;color:#625c68;font-size:10px;line-height:1.8}
.unified-advice button{position:absolute;right:0;bottom:0;padding:11px 14px;border:0;border-radius:11px;background:#302a40;color:#fff;display:flex;align-items:center;gap:8px;font-size:9px}
.unified-report-page>.method-note{margin-top:22px;text-align:center}
.evidence-expansion-prompt{margin:26px auto 0;padding:24px;border:1px solid rgba(123,107,176,.14);border-radius:22px;background:rgba(255,255,255,.78);box-shadow:0 18px 50px rgba(60,47,87,.08);backdrop-filter:blur(18px)}
.evidence-expansion-heading{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start}.evidence-expansion-heading>span{width:39px;height:39px;border-radius:12px;background:#e9e4f7;color:#6d5a96;display:grid;place-items:center}.evidence-expansion-heading>div>small{font:6px var(--mono);letter-spacing:.08em;color:#8d8495}.evidence-expansion-heading h3{margin:6px 0 5px;font:500 20px/1.25 var(--serif);color:#342d3c}.evidence-expansion-heading p{margin:0;color:#756e7b;font-size:8px;line-height:1.7}
.evidence-expansion-actions{margin-top:20px;display:flex;justify-content:flex-end;gap:8px}.evidence-expansion-actions button,.evidence-expansion-submit button{min-height:36px;padding:0 13px;border:1px solid rgba(58,49,73,.11);border-radius:10px;background:#fff;color:#69616f;font-size:8px}.evidence-expansion-actions button:first-child,.evidence-submit-button{border-color:#302a40!important;background:#302a40!important;color:#fff!important}
.evidence-expansion-form{margin-top:22px;padding-top:20px;border-top:1px solid rgba(58,49,73,.08)}
.missing-dimension-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.missing-dimension-options>button{min-width:0;padding:11px;border:1px solid rgba(64,52,82,.09);border-radius:13px;background:#faf9fb;display:grid;grid-template-columns:auto 1fr;gap:9px;text-align:left;color:#69616f}.missing-dimension-options>button>span{width:29px;height:29px;border-radius:9px;background:#eee9f7;color:#675686;display:grid;place-items:center;font:8px var(--mono)}.missing-dimension-options>button>div{min-width:0;display:flex;flex-direction:column;gap:3px}.missing-dimension-options strong{font-size:8px;font-weight:500}.missing-dimension-options small{color:#98919d;font-size:6px;line-height:1.45}.missing-dimension-options>button:hover,.missing-dimension-options>button:focus-visible,.missing-dimension-options>button.active{border-color:rgba(123,107,176,.42);background:#f1edf8;outline:none}
.evidence-expansion-input{margin-top:14px;display:flex;flex-direction:column;gap:7px;color:#7c7481;font-size:7px}.evidence-expansion-input textarea{width:100%;min-height:78px;padding:11px 12px;border:1px solid rgba(64,52,82,.1);border-radius:12px;background:#faf9fb;color:#443c4c;font:8px/1.7 "Noto Sans SC",sans-serif;resize:vertical;outline:none}.evidence-expansion-input textarea:focus{border-color:rgba(123,107,176,.45);box-shadow:0 0 0 3px rgba(123,107,176,.08)}.evidence-expansion-input textarea::placeholder{color:#aaa3ae}
.evidence-expansion-submit{margin-top:12px;display:flex;align-items:center;justify-content:space-between;gap:10px}.evidence-expansion-submit>input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}.evidence-expansion-submit>div{display:flex;gap:7px}.evidence-upload-button{max-width:260px;display:flex;align-items:center;gap:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.evidence-submit-button:disabled{opacity:.34;cursor:not-allowed}

/* Click-through evidence chain modal */
.report-evidence-backdrop{position:fixed;z-index:100;inset:0;padding:32px;overflow-y:auto;background:rgba(35,29,44,.36);backdrop-filter:blur(14px);display:grid;place-items:center;animation:evidence-backdrop-in .2s ease both}
.report-evidence-modal{width:min(900px,100%);max-height:calc(100vh - 64px);overflow:auto;border:1px solid rgba(255,255,255,.9);border-radius:28px;background:rgba(252,251,253,.97);box-shadow:0 35px 110px rgba(38,29,52,.28);animation:evidence-modal-in .3s cubic-bezier(.2,.8,.2,1) both}
.report-evidence-header{position:sticky;z-index:8;top:0;min-height:90px;padding:20px 24px;border-bottom:1px solid var(--line);background:rgba(252,251,253,.9);backdrop-filter:blur(18px);display:flex;align-items:center;gap:18px}
.report-evidence-header>div:first-child{display:flex;align-items:center;gap:12px;flex:1}
.report-evidence-header .report-dimension-badge{width:46px;height:46px;border-radius:14px;font-size:14px}
.report-evidence-header>div:first-child>div{display:flex;flex-direction:column;gap:4px}
.report-evidence-header small{font:7px var(--mono);letter-spacing:.08em;color:#918996}
.report-evidence-header strong{font:600 16px "Noto Sans SC",sans-serif;color:#342d3c}
.evidence-modal-score{padding-right:16px;border-right:1px solid var(--line);display:flex;align-items:baseline;gap:7px}
.evidence-modal-score span{font-size:7px;color:#918996}.evidence-modal-score strong{font:500 27px var(--serif)}
.evidence-modal-close{width:36px;height:36px;padding:0;border:1px solid rgba(58,49,73,.1);border-radius:50%;background:#fff;color:#625b69;display:grid;place-items:center;transition:background .2s ease,transform .2s ease}
.evidence-modal-close:hover{background:#302a40;color:#fff;transform:rotate(6deg)}
.evidence-chain-summary{margin:24px 24px 0;padding:17px 19px;border:1px solid rgba(105,87,145,.1);border-radius:16px;background:linear-gradient(120deg,#f3effa,#faf6f7);display:grid;grid-template-columns:auto 1fr;gap:7px 13px}
.evidence-chain-summary>span{grid-row:1/3;padding:5px 7px;border-radius:7px;background:#fff;color:#685b80;font-size:7px;align-self:start}
.evidence-chain-summary p{margin:0;color:#564f5c;font-size:9px;line-height:1.7}
.evidence-chain-summary>div{display:flex;flex-wrap:wrap;gap:5px}.evidence-chain-summary small{padding:5px 7px;border-radius:99px;background:rgba(255,255,255,.75);color:#817887;font-size:7px}
.evidence-document,.image-evidence-layout{margin:18px 24px 0;border:1px solid rgba(60,49,74,.1);border-radius:19px;background:#fff;overflow:hidden}
.account-evidence-layout,.comment-evidence-layout{margin:18px 24px 0;display:grid;grid-template-columns:280px 1fr;gap:14px;align-items:stretch}
.account-evidence-layout .evidence-document,.comment-evidence-layout .evidence-document{margin:0}
.account-activity-evidence{position:relative;margin:14px 24px 0;padding:16px 18px 14px;border:1px solid rgba(81,66,110,.1);border-radius:17px;background:rgba(255,255,255,.88);box-shadow:0 10px 30px rgba(54,43,73,.06)}
.account-activity-evidence>header{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding-bottom:11px;border-bottom:1px solid rgba(55,47,68,.09)}
.account-activity-mark{width:34px;height:34px;border-radius:50%;background:#e9e4f7;color:#7464a0;display:grid;place-items:center}
.account-activity-evidence>header>div{display:flex;flex-direction:column;gap:3px}.account-activity-evidence>header strong{font-size:11px;font-weight:600;color:#3c3544}.account-activity-evidence>header small{font:6px var(--mono);letter-spacing:.06em;color:#938b9a}
.account-activity-evidence>header em{padding:6px 9px;border-radius:99px;background:#f6e8e6;color:#9a656b;font-size:7px;font-style:normal}
.account-activity-body{min-height:168px;padding-top:13px;display:grid;grid-template-columns:minmax(0,1fr) 145px;gap:20px}
.account-posting-rhythm,.account-commerce-share{display:flex;flex-direction:column}.account-posting-rhythm>span,.account-commerce-share>span{color:#817a88;font-size:8px}
.account-activity-bars{height:118px;margin-top:auto;padding-top:10px;border-bottom:1px solid rgba(57,49,70,.12);display:flex;align-items:flex-end;gap:3px;background:repeating-linear-gradient(to top,rgba(57,49,70,.045) 0 1px,transparent 1px 30px)}
.account-activity-bars>i{width:100%;min-width:3px;border-radius:4px 4px 0 0;background:#dfbdc7;transition:filter .2s ease,transform .2s ease}.account-activity-bars>i.organic{background:#bdb2df}.account-activity-bars>i:hover{filter:saturate(1.25);transform:scaleX(1.25)}
.account-posting-rhythm>small{margin-top:8px;display:flex;align-items:center;gap:5px;color:#958e9a;font-size:6px}.account-posting-rhythm>small i{width:6px;height:6px;border-radius:50%;background:#bdb2df}.account-posting-rhythm>small i:nth-of-type(2){margin-left:7px;background:#dfbdc7}
.account-commerce-share>div{position:relative;width:108px;height:108px;margin:auto;border-radius:50%;background:conic-gradient(#846fb2 0 67%,#eeeaf4 67%);display:grid;place-items:center}.account-commerce-share>div::before{content:"";position:absolute;inset:11px;border-radius:50%;background:#fff}
.account-commerce-share strong,.account-commerce-share small{position:relative;z-index:1}.account-commerce-share strong{font:500 27px/1 var(--serif);color:#302a40}.account-commerce-share small{position:absolute;top:68px;color:#8c8592;font-size:6px}
.account-activity-example{position:absolute;right:18px;bottom:14px;color:#aaa4ae;font:6px var(--mono);letter-spacing:.05em}
.evidence-source-pair,.comment-source-stack{min-width:0;display:grid;grid-template-columns:1fr 1fr;gap:7px}
.evidence-source-pair figure,.comment-source-stack figure{position:relative;min-width:0;margin:0;overflow:hidden;border:1px solid rgba(60,49,74,.1);border-radius:15px;background:#19181e}
.evidence-source-pair img,.comment-source-stack img{width:100%;height:100%;object-fit:cover;object-position:top;display:block;opacity:.92}
.evidence-source-pair figcaption,.comment-source-stack figcaption{position:absolute;left:7px;bottom:7px;padding:5px 7px;border-radius:99px;background:rgba(26,22,32,.72);backdrop-filter:blur(8px);color:#fff;font:6px var(--mono)}
.evidence-document-head{padding:17px 19px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:11px}
.evidence-profile-avatar{width:39px;height:39px;border-radius:50%;background:linear-gradient(135deg,#e5dcf6,#f5e8ed);color:#695980;display:grid;place-items:center;font:500 14px var(--serif)}
.evidence-document-head>div{display:flex;flex-direction:column;gap:3px}.evidence-document-head strong{font-size:10px;font-weight:500}.evidence-document-head small{font-size:7px;color:#98909c}
.evidence-document-head em{margin-left:auto;padding:6px 8px;border-radius:99px;background:#f2eef6;color:#7b6b91;font-size:7px;font-style:normal}
.account-evidence-document section{padding:15px 19px;border-bottom:1px solid rgba(58,49,73,.07)}
.account-evidence-document section>small{display:block;margin-bottom:8px;color:#8b8290;font:7px var(--mono)}
.account-evidence-document section p{margin:7px 0;color:#5e5764;font-size:9px;line-height:1.9}.account-evidence-document section b{display:inline-block;min-width:42px;color:#9b929f;font:7px var(--mono)}
.account-metrics{padding:11px 17px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.account-metrics span{color:#8b838f;font-size:6px;text-align:center}.account-metrics strong{display:block;margin-bottom:3px;color:#3d3544;font:500 11px var(--serif)}
.account-evidence-document section p em{float:right;color:#948b98;font:6px var(--mono);font-style:normal}
.evidence-document mark{padding:2px 4px;border-radius:4px;background:#e9e0f8;color:#534369}
.evidence-document>footer{padding:11px 19px;background:#faf9fb;display:flex;flex-wrap:wrap;gap:6px}.evidence-document>footer span{padding:5px 7px;border-radius:99px;background:#e9f3ee;color:#52705f;font-size:7px}.evidence-document>footer span.attention{background:#f4e5e6;color:#8b5b61}
.image-evidence-layout{display:grid;grid-template-columns:minmax(280px,1fr) minmax(280px,1fr)}
.report-forensic-image{position:relative;min-height:390px;overflow:hidden;background:#e7e0e2}.report-forensic-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.88) contrast(.98)}.report-forensic-image::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(30,24,38,.42));pointer-events:none}
.report-forensic-image>small{position:absolute;z-index:2;left:13px;bottom:11px;color:#fff;font:7px var(--mono);letter-spacing:.06em}
.forensic-anchor{position:absolute;z-index:3;width:30px;height:30px;border:2px solid #fff;border-radius:50%;background:#8c72bc;color:#fff;display:grid;place-items:center;font:10px var(--mono);box-shadow:0 0 0 8px rgba(151,124,211,.25),0 8px 22px rgba(42,31,56,.3);animation:forensic-anchor-pulse 2s ease-in-out infinite}.anchor-one{left:26%;top:48%}.anchor-two{left:76%;top:47%;animation-delay:.45s}
.forensic-findings{padding:23px}.forensic-findings>span{font:7px var(--mono);letter-spacing:.08em;color:#8f8794}.forensic-findings>div{padding:17px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:start}.forensic-findings>div>b{width:25px;height:25px;border-radius:8px;background:#e9e2f6;color:#625177;display:grid;place-items:center;font:9px var(--mono)}.forensic-findings p{margin:0}.forensic-findings strong{display:block;font-size:9px;font-weight:500}.forensic-findings small{display:block;margin-top:5px;color:#847c89;font-size:7px;line-height:1.65}.forensic-findings em{font:7px var(--mono);font-style:normal;color:#766b84}.forensic-findings>p{margin:17px 0 0;padding:12px;border-radius:11px;background:#f2eef7;color:#6f6677;font-size:8px;line-height:1.7}
.comment-analysis-head{padding:14px 18px;background:#faf8fb;display:flex;justify-content:space-between;gap:12px}.comment-analysis-head span{font-size:9px;font-weight:500}.comment-analysis-head small{font-size:7px;color:#918a96}
.comment-simulation-note{margin:12px 24px 0;padding:11px 13px;border:1px solid rgba(123,107,176,.1);border-radius:11px;background:#f5f2f9;color:#8a8290;font-size:7px;line-height:1.7}
.comment-evidence-layout{grid-template-columns:260px 1fr}.comment-source-stack{grid-template-columns:1fr}.comment-source-stack figure{min-height:230px}.comment-source-stack img{position:absolute;inset:0}.comment-evidence-document{max-height:490px;overflow:auto}
.report-comment{padding:11px 18px;border-top:1px solid rgba(58,49,73,.06);display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center}.report-comment>i{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#e9e4ef,#f4e5e7);display:grid;place-items:center;color:#776c7c;font-size:7px;font-style:normal}.report-comment p{margin:0;color:#625a68;font-size:8px}.report-comment p strong{display:block;margin-bottom:4px;color:#3c3543;font-size:8px;font-weight:500}.report-comment time{color:#aaa3ad;font:6px var(--mono)}.report-comment.similar{background:#fff8f9}.report-comment.detailed{background:#f5f2fa}.report-comment mark{background:#f6dfe3;color:#704b51}.comment-evidence-document footer{position:sticky;bottom:0;align-items:center;color:#8a818d;font-size:7px}.comment-swatch{width:12px;height:8px;padding:0!important;border-radius:3px!important;background:#f1cfd5!important}.comment-evidence-document footer b{margin-left:auto;color:#8c5962;font-weight:500}
.copy-source-head>div{gap:5px}.copy-source-head>div>small{font:7px var(--mono);letter-spacing:.08em}.copy-source-head>div>strong{font-size:12px}.copy-evidence-document>p{margin:0;padding:24px 26px;color:#554e5a;font-size:11px;line-height:2.35}.copy-evidence-document mark{padding:2px 4px;border-radius:4px;color:inherit}.copy-evidence-document mark.template{background:#eee2fa;color:#58456f}.copy-evidence-document mark.absolute{background:#f3d9df;color:#754b53}.copy-evidence-document mark.unsupported{background:#f6e8bd;color:#725d2d}
.copy-evidence-legend{padding:16px 26px 0;display:flex;flex-wrap:wrap;align-items:center;column-gap:10px;row-gap:8px}.copy-evidence-legend>span{position:static;display:inline-flex;flex:0 0 auto;margin:0;padding:7px 10px;border-radius:999px;font-size:7px;font-weight:500;white-space:nowrap}.copy-evidence-legend .template{background:#eee2fa;color:#58456f}.copy-evidence-legend .absolute{background:#f3d9df;color:#754b53}.copy-evidence-legend .unsupported{background:#f6e8bd;color:#725d2d}
.copy-annotations{margin:0 24px 21px;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.copy-annotations>span{padding:12px;border:1px solid rgba(68,55,84,.08);border-radius:12px;background:#faf8fb;display:flex;gap:9px}.copy-annotations b{width:24px;height:24px;flex:none;border-radius:7px;background:#eee5f6;color:#68567e;display:grid;place-items:center;font:7px var(--mono)}.copy-annotations>span:nth-child(2) b{background:#f3d9df;color:#754b53}.copy-annotations>span:nth-child(3) b{background:#f6e8bd;color:#725d2d}.copy-annotations p{margin:0}.copy-annotations strong{display:block;font-size:8px;font-weight:500}.copy-annotations small{display:block;margin-top:4px;color:#867e89;font-size:7px;line-height:1.55}
.evidence-modal-footer{padding:18px 24px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.evidence-modal-footer p{margin:0;display:flex;align-items:center;gap:6px;color:#968e9a;font-size:7px}.evidence-modal-footer p span,.evidence-modal-footer p i,.evidence-modal-footer p b,.evidence-modal-footer p em{width:7px;height:7px;margin-left:5px;border-radius:50%;background:#d8cdea}.evidence-modal-footer p i{background:#ead1d7}.evidence-modal-footer p b{background:#d9e7f2}.evidence-modal-footer p em{background:#d5e7dc}.evidence-modal-footer>button{padding:9px 13px;border:0;border-radius:9px;background:#302a40;color:#fff;font-size:8px}
.evidence-ai-case-note{display:block;margin:13px 24px 0;color:#a19aa6;font:6px var(--mono);letter-spacing:.06em;text-align:right}
@keyframes evidence-backdrop-in{from{opacity:0}to{opacity:1}}@keyframes evidence-modal-in{from{opacity:0;transform:translateY(18px) scale(.98)}to{opacity:1;transform:none}}@keyframes forensic-anchor-pulse{0%,100%{box-shadow:0 0 0 7px rgba(151,124,211,.2),0 8px 22px rgba(42,31,56,.3)}50%{box-shadow:0 0 0 13px rgba(151,124,211,.06),0 8px 22px rgba(42,31,56,.3)}}

@media (max-width:900px){
  .unified-report-page{width:calc(100% - 28px);padding:38px 0 90px}
  .unified-report-card{padding:20px;border-radius:24px}
  .unified-report-card>header{gap:10px}
  .unified-score{width:190px;min-height:110px;padding:16px 20px}
  .unified-score>strong{font-size:48px}
  .unified-dimensions{grid-template-columns:1fr;gap:28px}
  .unified-radar{width:min(300px,100%);margin:auto}
  .unified-radar svg{height:230px}
  .unified-advice{padding-bottom:56px}
  .unified-advice button{left:0;right:auto}
  .report-evidence-backdrop{padding:14px}
  .report-evidence-modal{max-height:calc(100vh - 28px);border-radius:22px}
  .image-evidence-layout{grid-template-columns:1fr}.report-forensic-image{min-height:360px}
  .account-evidence-layout,.comment-evidence-layout{grid-template-columns:1fr}.evidence-source-pair{min-height:330px}.comment-source-stack{grid-template-columns:1fr 1fr}.comment-source-stack figure{min-height:330px}
  .account-activity-body{grid-template-columns:1fr 145px}.account-commerce-share>div{width:108px;height:108px}.account-commerce-share small{top:68px}
  .evidence-modal-footer p{display:none}
  .missing-dimension-options{grid-template-columns:1fr}
}

@media (max-width:640px){
  .report-evidence-header{padding:15px;gap:9px}.report-evidence-header .report-dimension-badge{width:38px;height:38px}.report-evidence-header strong{font-size:13px}.report-evidence-header small{font-size:6px}
  .evidence-modal-score{display:none}.evidence-chain-summary,.evidence-document,.image-evidence-layout{margin-left:14px;margin-right:14px}.evidence-chain-summary{grid-template-columns:1fr}.evidence-chain-summary>span{grid-row:auto;justify-self:start}
  .copy-annotations{grid-template-columns:1fr;margin-left:14px;margin-right:14px}.copy-evidence-document>p{padding:20px 18px;font-size:10px}.report-forensic-image{min-height:330px}
  .account-evidence-layout,.comment-evidence-layout{margin-left:14px;margin-right:14px}.evidence-source-pair{min-height:280px}.comment-source-stack{grid-template-columns:1fr}.comment-source-stack figure{min-height:360px}.comment-evidence-document{max-height:none}
  .evidence-ai-case-note{margin-left:14px;margin-right:14px}
  .comment-simulation-note{margin-left:14px;margin-right:14px}
  .account-activity-evidence{margin-left:14px;margin-right:14px;padding:15px}.account-activity-body{grid-template-columns:1fr;gap:18px}.account-activity-bars{height:112px}.account-commerce-share{min-height:125px}.account-activity-example{bottom:8px}
  .comment-analysis-head{flex-direction:column}.report-comment{padding:10px 12px}.evidence-modal-footer{padding:14px}.evidence-modal-footer>button{width:100%}
  .evidence-expansion-prompt{padding:18px;border-radius:18px}.evidence-expansion-actions{flex-direction:column}.evidence-expansion-actions button{width:100%}.evidence-expansion-submit{align-items:stretch;flex-direction:column}.evidence-expansion-submit>div{display:grid;grid-template-columns:1fr 1fr}.evidence-upload-button{max-width:none;justify-content:center}
}

@media print{
  .unified-report-page{width:100%;padding:0}
  .unified-report-card{box-shadow:none}
  .unified-advice button{display:none}
  .report-evidence-backdrop{display:none}
}

.archive-chat-status{padding:7px 10px;border-radius:99px;background:#e7f1ec;color:#4f705e;font-size:8px}
.archived-chat .chat-scroll{padding-bottom:65px}
.archive-analysis-summary{margin-top:16px;padding:18px;border:1px solid rgba(61,54,85,.1);border-radius:17px;background:linear-gradient(135deg,#f6f2fd,#faf6f5);display:grid;grid-template-columns:78px 1fr auto;gap:17px;align-items:center}
.archive-chat-score{width:70px;height:70px;border-radius:50%;background:#fff;box-shadow:0 9px 26px rgba(59,47,91,.09);display:grid;place-items:center;font:500 27px var(--serif);color:#302a3c}
.archive-chat-score small{font:7px var(--mono);color:#77707d}
.archive-analysis-summary>div strong{font-size:11px;font-weight:500;color:#3c3544}
.archive-analysis-summary>div p{margin:6px 0 0;font-size:8px;line-height:1.7;color:#716a77}
.archive-chat-end{margin:34px 0 0;text-align:center;color:#948d99;font-size:8px}

.council-avatar.role-t,.role-t .role-avatar{background:#eaf2ff}
.council-avatar.role-r,.role-r .role-avatar{background:#f9e8e5}
.council-avatar.role-u,.role-u .role-avatar{background:#e7f6e9}
.council-avatar.role-s,.role-s .role-avatar{background:#f0e8f4}
.council-avatar img,.role-avatar img{filter:none}

@media (max-width:640px){
  .archive-analysis-summary{grid-template-columns:58px 1fr;padding:14px;gap:12px}
  .archive-chat-score{width:54px;height:54px;font-size:22px}
  .archive-analysis-summary .report-button{grid-column:1/3;justify-content:center}
}

/* Interactive landing cover */
.home-fixed-cta{position:fixed;z-index:80;top:13px;right:clamp(18px,5vw,80px);height:50px;padding:6px 6px 6px 21px;border:0;border-radius:999px;background:linear-gradient(110deg,#28233f,#41345f);color:#fff;display:flex;align-items:center;gap:15px;font-size:12px;box-shadow:0 14px 35px rgba(55,43,83,.2);transition:transform .25s ease,box-shadow .25s ease}.home-fixed-cta:hover{transform:translateY(-2px);box-shadow:0 19px 42px rgba(55,43,83,.27)}.home-fixed-cta .circle-arrow{width:38px;height:38px}
.hero{min-height:100vh;padding:105px 20px 68px;display:flex;flex-direction:column;align-items:center;justify-content:center}.hero .cover-title{margin:12px auto 0}.hero-definition{position:relative;z-index:2;max-width:780px;margin:16px auto 0;color:#373142;font:500 clamp(21px,2.3vw,31px)/1.35 var(--serif);letter-spacing:-.025em;text-wrap:balance}.hero .hero-sub{margin-top:8px;font-size:13px}
.hero-composer-wrap{position:relative;z-index:8;width:min(860px,100%);margin-top:40px}.hero-composer{position:relative;width:100%;padding:20px 22px;border:1px solid rgba(53,46,75,.13);border-radius:32px;background:#fff;box-shadow:0 20px 60px rgba(80,50,140,.1);text-align:left;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}.hero-composer.focused{border-color:#7c5cff;box-shadow:0 0 0 4px rgba(124,92,255,.15),0 20px 60px rgba(80,50,140,.1)}.hero-composer.dragging{border-color:#7c5cff;border-style:dashed;box-shadow:0 0 0 4px rgba(124,92,255,.15),0 20px 60px rgba(80,50,140,.1)}.hero-composer.shake{animation:hero-input-shake .24s ease}.hero-drop-overlay{position:absolute;z-index:10;inset:7px;border:1px dashed #7c5cff;border-radius:25px;background:rgba(246,242,255,.94);color:#665184;display:grid;place-items:center;font-size:13px;pointer-events:none}
.hero-attachments{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:11px;animation:hero-attachment-in .25s ease both}.hero-attachment{max-width:100%;height:38px;padding:4px 7px 4px 5px;border:1px solid rgba(54,47,69,.09);border-radius:11px;background:#f3f1f5;display:flex;align-items:center;gap:7px;color:#625b68}.hero-attachment>img,.hero-attachment>i{width:28px;height:28px;flex:none;border-radius:7px;object-fit:cover}.hero-attachment>i{background:#fff;display:grid;place-items:center;font-style:normal;color:#76658f}.hero-attachment>b{max-width:270px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;font-weight:400}.hero-attachment>em{padding:3px 5px;border-radius:99px;background:#e8e4eb;color:#89828e;font-size:10px;font-style:normal}.hero-attachment>button{width:22px;height:22px;padding:0;border:0;border-radius:50%;background:transparent;color:#918a96;display:grid;place-items:center}.hero-attachment>button:hover{background:#e4e0e7;color:#514a57}
.hero-textarea-shell{position:relative;min-height:58px}.hero-textarea-shell textarea{position:relative;z-index:2;width:100%;min-height:58px;max-height:174px;padding:5px 3px;border:0;resize:none;background:transparent;color:#1b1630;font-size:18px;line-height:1.55;display:block}.hero-textarea-shell textarea:focus{outline:0}.hero-demo-placeholder{position:absolute;z-index:1;left:3px;top:5px;color:#a8a3b5;font-size:18px;line-height:1.55;pointer-events:none;user-select:none}.hero-demo-placeholder i{display:inline-block;width:2px;height:1.15em;margin-left:3px;vertical-align:-.18em;background:#918a9e;animation:agent-cursor-blink .85s steps(1) infinite}
.hero-composer-tools{display:flex;align-items:center;justify-content:space-between;margin-top:8px}.hero-add-button,.hero-send-button{padding:0;border:0;border-radius:50%;display:grid;place-items:center}.hero-add-button{width:42px;height:42px;border:1px solid rgba(54,47,69,.1);background:#f5f3f6;color:#716b77}.hero-add-button:hover{background:#ebe8ee;color:#433d49}.hero-send-button{width:48px;height:48px;background:#302a40;color:#fff;box-shadow:0 10px 25px rgba(47,42,64,.18);transition:background .2s ease,transform .2s ease}.hero-send-button:hover:not(.disabled){transform:translateY(-2px)}.hero-send-button.disabled{background:#dedbe1;color:#aaa4ae;box-shadow:none;cursor:default}
.hero-examples{margin-top:20px;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap}.hero-examples>small{margin-right:2px;color:#99929e;font-size:13px}.hero-examples>button{height:36px;padding:0 14px;border:1px solid rgba(54,48,73,.12);border-radius:18px;background:#fff;color:#655e6b;font-size:14px;box-shadow:0 5px 16px rgba(55,45,72,.04);transition:border-color .2s ease,transform .2s ease,color .2s ease}.hero-examples>button:hover{border-color:#8874bc;color:#5e4c7e;transform:translateY(-1px)}
.hero-promises{margin:32px 0 0;display:flex;align-items:center;justify-content:center;gap:14px;color:#8c8692;font-size:12px}.hero-promises i{width:1px;height:13px;background:#d5d0d9}
.hero-sequence-1,.hero-sequence-2,.hero-sequence-3,.hero-sequence-4,.hero-sequence-5,.hero-sequence-6{opacity:0;animation:hero-sequence-in .5s ease forwards}.hero-sequence-1{animation-delay:.08s}.hero-sequence-2{animation-delay:.16s}.hero-sequence-3{animation-delay:.24s}.hero-sequence-4{animation-delay:.32s}.hero-sequence-5{animation-delay:.4s}.hero-sequence-6{animation-delay:.48s}
.demo-version-banner{max-width:790px;margin:0 auto 24px;padding:11px 14px;border:1px solid rgba(112,89,163,.12);border-radius:12px;background:#f1edf7;color:#6c607b;display:flex;align-items:center;gap:9px;font-size:9px}.demo-version-banner span{display:flex;gap:5px;flex-wrap:wrap}.demo-version-banner strong{font-weight:600}
@keyframes hero-sequence-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@keyframes hero-input-shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}50%{transform:translateX(4px)}75%{transform:translateX(-2px)}}@keyframes hero-attachment-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}

@media (max-width:640px){
  .home-fixed-cta{top:10px;right:12px;height:44px;padding:5px 5px 5px 14px;font-size:10px;gap:10px}.home-fixed-cta .circle-arrow{width:34px;height:34px}
  .hero{min-height:100vh;padding:88px 14px 48px}.hero .eyebrow{font-size:8px}.hero .cover-title{margin-top:10px}.cover-title>span{font-size:52px}.hero .cover-title>em{font-size:24px}.hero-definition{max-width:340px;margin-top:14px;font-size:20px}.hero .hero-sub{font-size:11px}.hero-composer-wrap{margin-top:30px}.hero-composer{padding:16px;border-radius:25px}.hero-textarea-shell textarea,.hero-demo-placeholder{font-size:16px}.hero-attachment>b{max-width:170px}.hero-examples{align-items:flex-start;justify-content:flex-start}.hero-examples>small{width:100%;font-size:11px}.hero-examples>button{height:34px;padding:0 11px;font-size:11px}.hero-promises{gap:8px;font-size:10px;flex-wrap:wrap}.hero-promises i{height:11px}
}

@media (prefers-reduced-motion:reduce){
  .hero-sequence-1,.hero-sequence-2,.hero-sequence-3,.hero-sequence-4,.hero-sequence-5,.hero-sequence-6{opacity:1;animation:none}.hero-demo-placeholder i{display:none}.hero-attachment{animation:none}
}

/* Cinematic landing hero */
.cinematic-hero {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 680px;
  overflow: hidden;
  isolation: isolate;
  color: var(--hero-ink);
  background:
    radial-gradient(circle at 20% 25%, rgba(236, 199, 220, .48), transparent 31%),
    radial-gradient(circle at 78% 35%, rgba(195, 207, 255, .62), transparent 34%),
    var(--hero-bg);
}
.cinematic-hero::after {
  content: "";
  position: absolute;
  z-index: 2;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(247, 245, 252, .12), rgba(247, 245, 252, .26) 54%, rgba(247, 245, 252, .72));
}
.cinematic-nav {
  z-index: 20;
  border: 0;
  background: linear-gradient(180deg, rgba(247, 245, 252, .82), transparent);
}
.cinematic-nav .logo {
  color: var(--hero-ink);
}
.hero-scene-background {
  position: absolute;
  z-index: 1;
  inset: 0;
  display: grid;
  place-items: center;
  overflow: hidden;
}
.hero-product-mock {
  position: relative;
  width: min(1040px, 76vw);
  height: min(640px, 72vh);
  border: 1px solid rgba(123, 107, 176, .15);
  border-radius: 36px;
  overflow: hidden;
  background: rgba(255, 255, 255, .64);
  box-shadow: 0 44px 120px rgba(50, 40, 83, .14);
  backdrop-filter: blur(24px);
  filter: blur(1.4px) saturate(.8) brightness(.93);
  transform: perspective(1100px) rotateX(2deg);
  animation: cinematic-parallax 4.2s linear both;
}
.scene-evidence .hero-product-mock {
  filter: none;
  border-color: transparent;
  box-shadow: none;
  background: transparent;
}
.cinematic-title-shell {
  position: absolute;
  z-index: 6;
  top: 47%;
  left: 50%;
  width: min(900px, 90vw);
  transform: translate(-50%, -50%);
  pointer-events: none;
  text-align: center;
  transition: top .5s ease, transform .5s ease;
}
.cinematic-title {
  width: 100%;
  text-align: center;
}
.cinematic-title h1 {
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--hero-ink);
  font: 500 clamp(48px, 5.7vw, 84px)/1.02 var(--serif);
  letter-spacing: -.052em;
  text-shadow: 0 3px 28px rgba(255, 255, 255, .86);
}
.cinematic-title h1 span,
.cinematic-title h1 em {
  display: flex;
  align-items: center;
  justify-content: center;
}
.cinematic-title h1 em {
  min-height: 1.15em;
  gap: .18em;
  color: var(--hero-purple);
  font-style: italic;
}
.cinematic-title h1 em svg {
  width: .48em;
  height: .48em;
  flex: none;
}
.cinematic-title.finale-title h1 {
  display: block;
  font-size: clamp(54px, 6.4vw, 94px);
}
.composer-engaged .cinematic-title-shell {
  top: 33%;
  transform: translate(-50%, -50%) scale(.72);
}
.cinematic-controls {
  position: absolute;
  z-index: 12;
  left: 50%;
  bottom: 18px;
  width: min(720px, calc(100% - 40px));
  transform: translateX(-50%);
}
.hero-scene-progress {
  width: 100%;
  margin: 0 auto 11px;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 7px;
}
.hero-scene-progress button {
  position: relative;
  height: 12px;
  padding: 5px 0;
  border: 0;
  background: transparent;
}
.hero-scene-progress button::before,
.hero-scene-progress button i {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 5px;
  height: 2px;
  border-radius: 99px;
}
.hero-scene-progress button::before {
  background: rgba(31, 27, 51, .16);
}
.hero-scene-progress button i {
  background: var(--hero-purple);
  transform-origin: left;
  transition: transform .08s linear;
}
.cinematic-controls .hero-composer-wrap {
  width: 100%;
  margin: 0;
}
.cinematic-controls .hero-composer {
  min-height: 64px;
  padding: 7px 8px;
  border-color: rgba(123, 107, 176, .2);
  border-radius: 999px;
  background: rgba(255, 255, 255, .76);
  box-shadow: 0 18px 50px rgba(57, 45, 91, .14), inset 0 1px rgba(255, 255, 255, .9);
  backdrop-filter: blur(22px);
}
.cinematic-controls .hero-composer.focused {
  border-color: rgba(123, 107, 176, .48);
  box-shadow: 0 0 0 4px rgba(123, 107, 176, .1), 0 20px 60px rgba(57, 45, 91, .17);
}
.cinematic-controls .hero-composer-wrap.expanded .hero-composer {
  min-height: 74px;
  padding-block: 12px;
  box-shadow: 0 0 0 5px rgba(123, 107, 176, .08), 0 25px 75px rgba(87, 65, 145, .2);
}
.cinematic-controls .hero-composer-tools {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 48px;
  gap: 8px;
  align-items: center;
  margin: 0;
}
.cinematic-controls .hero-add-button {
  width: 46px;
  height: 46px;
  border: 0;
  background: rgba(233, 228, 247, .7);
  color: var(--hero-purple);
}
.cinematic-controls .hero-send-button {
  width: 48px;
  height: 48px;
  background: var(--hero-ink);
}
.cinematic-controls .hero-textarea-shell {
  min-height: 46px;
}
.cinematic-controls .hero-textarea-shell textarea {
  min-height: 46px;
  max-height: 72px;
  padding: 9px 3px;
  color: var(--hero-ink);
  font-size: 16px;
  line-height: 28px;
}
.cinematic-controls .hero-demo-placeholder {
  top: 9px;
  color: #918b9b;
  font-size: 16px;
  line-height: 28px;
}
.cinematic-controls .hero-attachments {
  position: absolute;
  left: 24px;
  bottom: calc(100% + 10px);
  max-width: calc(100% - 48px);
  margin: 0;
}
.cinematic-controls .hero-attachment {
  background: rgba(255, 255, 255, .86);
  backdrop-filter: blur(14px);
}
.cinematic-controls .hero-promises {
  margin: 9px 0 0;
  color: rgba(31, 27, 51, .52);
  font-size: 10px;
}
.cinematic-controls .hero-promises i {
  background: rgba(31, 27, 51, .18);
}
.hero-dimension-card {
  position: absolute;
  z-index: 11;
  left: clamp(24px, 4vw, 64px);
  bottom: 28px;
  width: 255px;
  min-height: 68px;
  padding: 9px 12px 9px 9px;
  border: 1px solid rgba(123, 107, 176, .16);
  border-radius: 18px;
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 15px 45px rgba(57, 45, 91, .1);
  backdrop-filter: blur(18px);
  display: grid;
  grid-template-columns: 50px 1fr;
  align-items: center;
  gap: 10px;
}
.expert-portrait {
  position: relative;
  width: 50px;
  height: 50px;
  border-radius: 14px;
  overflow: hidden;
  display: grid;
  place-items: center;
  color: var(--hero-purple);
  background: var(--hero-lilac);
}
.expert-portrait.role-t { background: #e5dcf5; }
.expert-portrait.role-r { background: #f3dcdf; }
.expert-portrait.role-u { background: #dceee4; }
.expert-portrait.role-s { background: #e8ddf2; }
.expert-portrait img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.expert-portrait b {
  position: absolute;
  right: 3px;
  bottom: 3px;
  min-width: 16px;
  height: 16px;
  padding: 0 3px;
  border-radius: 5px;
  background: rgba(31, 27, 51, .88);
  color: white;
  display: grid;
  place-items: center;
  font: 7px var(--mono);
}
.hero-dimension-card > span:nth-child(2) {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hero-dimension-card strong {
  font-size: 11px;
  font-weight: 500;
}
.hero-dimension-card small {
  overflow: hidden;
  color: #7f7888;
  font: 7px var(--mono);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-dimension-card > i {
  grid-column: 2;
  margin-top: -12px;
  color: var(--hero-purple);
  font: 6px var(--mono);
  font-style: normal;
  letter-spacing: .04em;
}

/* Account scene */
.account-mock {
  padding: 54px 64px;
}
.mock-profile-head {
  display: grid;
  grid-template-columns: 78px 1fr auto;
  align-items: center;
  gap: 20px;
  padding-bottom: 30px;
  border-bottom: 1px solid rgba(31, 27, 51, .09);
}
.mock-profile-avatar {
  width: 78px;
  height: 78px;
  border-radius: 24px;
  overflow: hidden;
  background: #e5dcf5;
}
.mock-profile-avatar img { width: 100%; height: 100%; object-fit: contain; }
.mock-profile-head > div { display: flex; flex-direction: column; gap: 7px; }
.mock-profile-head b { font: 500 19px var(--serif); }
.mock-profile-head small { color: #847d8d; font-size: 10px; }
.mock-profile-head dl { margin: 0; display: flex; gap: 35px; }
.mock-profile-head dl div { text-align: center; }
.mock-profile-head dt { font: 500 21px var(--serif); }
.mock-profile-head dd { margin: 4px 0 0; color: #8d8794; font-size: 8px; }
.mock-note-grid { margin-top: 26px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.mock-note-grid i {
  position: relative;
  height: 150px;
  border-radius: 15px;
  background: linear-gradient(145deg, #eadce3, #dcdff1 58%, #ece9f5);
}
.mock-note-grid i:nth-child(3n) { background: linear-gradient(145deg, #dce8e3, #eee0e4); }
.mock-note-grid i span { position: absolute; left: 12px; right: 28%; bottom: 12px; height: 5px; border-radius: 9px; background: rgba(255, 255, 255, .72); }
.account-scan-line {
  position: absolute;
  z-index: 3;
  left: 4%;
  right: 4%;
  top: 14%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--hero-purple), transparent);
  box-shadow: 0 0 18px rgba(123, 107, 176, .8);
  animation: account-scan 4s ease-in-out infinite;
}
.mock-callouts span {
  position: absolute;
  z-index: 4;
  padding: 8px 11px;
  border: 1px solid rgba(123, 107, 176, .2);
  border-radius: 9px;
  background: rgba(255, 255, 255, .88);
  color: #655b7d;
  font-size: 9px;
  box-shadow: 0 8px 28px rgba(57, 45, 91, .11);
  animation: evidence-label-in .48s cubic-bezier(.2, .9, .2, 1.18) both;
}
.mock-callouts span:nth-child(1) { left: 13%; top: 34%; animation-delay: .5s; }
.mock-callouts span:nth-child(2) { left: 38%; top: 48%; animation-delay: 1.05s; }
.mock-callouts span:nth-child(3) { left: 63%; top: 62%; animation-delay: 1.6s; }

/* Reality scene */
.reality-mock { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 34px; }
.skin-panel {
  position: relative;
  overflow: hidden;
  border-radius: 26px;
  background:
    radial-gradient(circle at 34% 38%, rgba(255, 237, 224, .92), transparent 24%),
    radial-gradient(circle at 68% 60%, rgba(210, 151, 139, .48), transparent 22%),
    linear-gradient(145deg, #c98f81, #efc4ad 43%, #a96764);
}
.skin-panel.after {
  background:
    radial-gradient(circle at 38% 40%, rgba(255, 242, 230, .93), transparent 26%),
    radial-gradient(circle at 66% 58%, rgba(218, 160, 145, .4), transparent 24%),
    linear-gradient(145deg, #d29c8d, #f1cbb6 45%, #b57770);
}
.skin-panel > span {
  position: absolute;
  left: 16px;
  top: 16px;
  padding: 6px 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, .68);
  color: #655b69;
  font: 7px var(--mono);
}
.forensic-box {
  position: absolute;
  z-index: 3;
  width: 160px;
  height: 122px;
  border: 1px solid var(--hero-purple);
  transform: scaleX(0);
  transform-origin: left;
  animation: forensic-draw .7s ease forwards;
}
.forensic-box span {
  position: absolute;
  left: -1px;
  bottom: -27px;
  padding: 6px 8px;
  background: var(--hero-purple);
  color: white;
  font-size: 8px;
  white-space: nowrap;
}
.forensic-box.box-1 { left: 19%; top: 32%; animation-delay: .45s; }
.forensic-box.box-2 { right: 15%; top: 51%; animation-delay: 1.35s; }
.reality-meter {
  position: absolute;
  left: 50%;
  bottom: 52px;
  width: 260px;
  padding: 12px 14px;
  border-radius: 11px;
  background: rgba(255, 255, 255, .82);
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: center;
  transform: translateX(-50%);
  font-size: 8px;
}
.reality-meter i { height: 3px; overflow: hidden; border-radius: 99px; background: var(--hero-lilac); }
.reality-meter i b { display: block; width: 71%; height: 100%; background: var(--hero-success); }
.reality-meter strong { font: 8px var(--mono); }

/* Voice scene */
.voice-mock { padding: 48px 82px; }
.comment-title { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid rgba(31, 27, 51, .1); }
.comment-title span { font: 500 18px var(--serif); }
.comment-title small { color: var(--hero-purple); font: 8px var(--mono); }
.comment-list { position: relative; z-index: 2; }
.comment-list > div {
  height: 78px;
  padding: 0 16px;
  border-bottom: 1px solid rgba(31, 27, 51, .08);
  display: grid;
  grid-template-columns: 38px 1fr auto;
  gap: 14px;
  align-items: center;
}
.comment-list > div i { width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(145deg, #eadde9, #d7e3e8); }
.comment-list > div span { width: max-content; padding: 5px 7px; border-radius: 4px; font-size: 11px; }
.comment-list > div small { color: #a09aa6; font: 7px var(--mono); }
.comment-list > div.matched span {
  background: linear-gradient(90deg, rgba(200, 186, 237, .72), rgba(233, 228, 247, .46));
  background-size: 0 100%;
  background-repeat: no-repeat;
  animation: comment-highlight .65s ease forwards;
  animation-delay: .55s;
}
.comment-links { position: absolute; z-index: 3; inset: 102px 70px auto; width: calc(100% - 140px); height: 390px; pointer-events: none; }
.comment-links path { fill: none; stroke: var(--hero-purple); stroke-width: 1; stroke-dasharray: 8 5; stroke-dashoffset: 80; animation: link-draw 1.4s ease forwards .8s; }
.voice-callout {
  position: absolute;
  z-index: 4;
  right: 64px;
  top: 43%;
  padding: 9px 12px;
  border-radius: 9px;
  background: var(--hero-purple);
  color: white;
  font-size: 9px;
  animation: evidence-label-in .48s cubic-bezier(.2, .9, .2, 1.18) both 1.4s;
}

/* Copy scene */
.copy-mock { padding: 58px 90px; }
.copy-document-head { display: flex; align-items: center; gap: 13px; padding-bottom: 28px; border-bottom: 1px solid rgba(31, 27, 51, .09); }
.copy-document-head > i { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(145deg, #eadde9, #dce3f2); }
.copy-document-head div { display: flex; flex-direction: column; gap: 5px; }
.copy-document-head b { font: 500 17px var(--serif); }
.copy-document-head small { color: #8c8693; font-size: 8px; }
.copy-lines { margin-top: 30px; display: grid; gap: 11px; }
.copy-lines i { width: 88%; height: 6px; border-radius: 99px; background: #e8e4eb; }
.copy-lines i:nth-child(2) { width: 70%; }
.copy-lines i:nth-child(3) { width: 80%; }
.copy-mock p { margin: 27px 0; color: #5e5768; font-size: 18px; line-height: 1.9; }
.copy-mock mark {
  position: relative;
  padding: 2px 3px;
  color: inherit;
  background: linear-gradient(90deg, rgba(217, 183, 107, .5), rgba(217, 183, 107, .3));
  background-size: 0 100%;
  background-repeat: no-repeat;
  animation: copy-highlight 1s ease forwards .55s;
}
.copy-lines.lower { margin-top: 8px; }
.copy-callout {
  position: absolute;
  right: 17%;
  top: 57%;
  padding: 8px 11px;
  border-radius: 8px;
  background: var(--hero-warning);
  color: #4d3b1e;
  font-size: 9px;
  animation: evidence-label-in .45s cubic-bezier(.2, .9, .2, 1.18) both 1.35s;
}

/* Finale scene */
.finale-mock { display: grid; place-items: center; }
.finale-trace { width: 420px; display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; }
.finale-trace i { position: relative; width: 12px; height: 12px; margin: auto; border-radius: 50%; background: var(--hero-purple); box-shadow: 0 0 0 8px rgba(123, 107, 176, .1); }
.finale-trace i:not(:last-child)::after { content: ""; position: absolute; left: 12px; top: 5px; width: 93px; height: 1px; background: rgba(123, 107, 176, .35); }
.finale-mock > small { position: absolute; margin-top: 78px; color: rgba(31, 27, 51, .43); font: 8px var(--mono); letter-spacing: .15em; }

/* Semantic consistency scene */
.consistency-mock { position: relative; }
.consistency-network { position: absolute; left: 1.5%; top: 8%; width: 42%; height: 84%; overflow: visible; }
.consistency-network line { stroke: rgba(123,107,176,.34); stroke-width: 2; }
.consistency-network g circle { fill: rgba(239,235,247,.94); stroke: rgba(123,107,176,.5); stroke-width: 2; }
.consistency-network g text { fill: #5d536b; font: 600 16px var(--mono); }
.consistency-network .network-junction { fill: #9b7fc2; stroke: rgba(255,255,255,.9); stroke-width: 4; }
.consistency-compare-card { position: absolute; width: 31%; min-height: 150px; padding: 23px; border: 1px solid rgba(89,72,110,.13); border-radius: 22px; background: rgba(255,255,255,.82); box-shadow: 0 18px 50px rgba(59,46,78,.1); }
.consistency-compare-card.compare-left { right: 4%; top: 9%; }
.consistency-compare-card.compare-right { right: 8%; bottom: 9%; }
.consistency-compare-card>span { display: inline-flex; padding: 7px 10px; border-radius: 999px; font: 8px var(--mono); }
.consistency-compare-card.compare-left>span { background: rgba(201,139,147,.23); color: #8d5862; }
.consistency-compare-card.compare-right>span { background: rgba(217,183,107,.25); color: #84682f; }
.consistency-compare-card>div { margin-top: 17px; display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.consistency-compare-card>div+div { margin-top: 11px; padding-top: 11px; border-top: 1px solid rgba(74,62,88,.1); }
.consistency-compare-card i { height: 8px; border-radius: 99px; background: rgba(74,65,84,.12); }
.consistency-compare-card i:nth-child(2) { width: 78%; }
.consistency-compare-card i:nth-child(3) { width: 55%; }

/* Decision scene */
.decision-mock { position: relative; }
.decision-ladder-mock { position: absolute; left: 5%; top: 13%; bottom: 13%; width: 30%; display: flex; flex-direction: column; justify-content: center; gap: 15px; }
.decision-ladder-mock::before { content: ""; position: absolute; left: 17px; top: 19%; bottom: 19%; width: 2px; background: rgba(75,64,88,.12); }
.decision-ladder-mock>span { position: relative; min-height: 76px; padding: 0 18px 0 48px; border: 1px solid rgba(70,58,87,.1); border-radius: 18px; background: rgba(255,255,255,.76); display: flex; align-items: center; color: #6b6471; font-size: 12px; box-shadow: 0 12px 34px rgba(58,45,76,.07); }
.decision-ladder-mock>span>i { position: absolute; z-index: 2; left: 11px; width: 14px; height: 14px; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 2px currentColor; }
.decision-ladder-mock .ladder-pass { color: #648471; }
.decision-ladder-mock .ladder-verify { color: #a27c42; }
.decision-ladder-mock .ladder-review { color: #98666e; }
.decision-ladder-mock>span.active { transform: translateX(13px); box-shadow: 0 18px 46px rgba(135,101,47,.15); }
.decision-advice-mock { position: absolute; right: 4%; top: 17%; width: 35%; min-height: 66%; padding: 28px; border: 1px solid rgba(75,61,92,.11); border-radius: 24px; background: rgba(255,255,255,.78); box-shadow: 0 20px 55px rgba(58,45,76,.09); }
.decision-role-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.decision-role-tags span { padding: 7px 9px; border: 1px solid rgba(76,63,92,.1); border-radius: 999px; background: rgba(245,242,248,.84); color: #7c7482; font-size: 8px; }
.decision-role-tags span.active { border-color: #302a40; background: #302a40; color: #fff; }
.decision-blurred-lines { margin-top: 31px; display: flex; flex-direction: column; gap: 17px; }
.decision-blurred-lines i { height: 13px; border-radius: 99px; background: rgba(76,65,89,.12); }
.decision-blurred-lines i:nth-child(2) { width: 86%; }
.decision-blurred-lines i:nth-child(3) { width: 68%; }
.decision-blurred-lines i:nth-child(4) { width: 78%; }

@keyframes cinematic-parallax { from { transform: perspective(1100px) rotateX(2deg) scale(1); } to { transform: perspective(1100px) rotateX(2deg) scale(1.04); } }
@keyframes account-scan { 0%, 12% { top: 14%; opacity: 0; } 20% { opacity: 1; } 82% { opacity: 1; } 92%, 100% { top: 88%; opacity: 0; } }
@keyframes evidence-label-in { from { opacity: 0; transform: translateY(10px) scale(.94); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes forensic-draw { from { opacity: 0; transform: scaleX(0); } to { opacity: 1; transform: scaleX(1); } }
@keyframes comment-highlight { to { background-size: 100% 100%; } }
@keyframes link-draw { to { stroke-dashoffset: 0; } }
@keyframes copy-highlight { to { background-size: 100% 100%; } }

@media (max-width: 1100px) {
  .hero-dimension-card { width: 210px; }
  .cinematic-controls { width: min(620px, calc(100% - 40px)); }
  .hero-product-mock { width: 84vw; }
}

@media (max-width: 760px) {
  .cinematic-hero { min-height: 640px; }
  .cinematic-nav { height: 60px; padding: 0 18px; }
  .cinematic-title-shell { top: 35%; width: calc(100% - 32px); }
  .cinematic-title h1 { font-size: clamp(28px, 8.4vw, 32px); line-height: 1.08; gap: 4px; }
  .cinematic-title.finale-title h1 { font-size: clamp(31px, 9vw, 38px); }
  .composer-engaged .cinematic-title-shell { top: 26%; transform: translate(-50%, -50%) scale(.82); }
  .hero-product-mock {
    width: 106vw;
    height: 60vh;
    min-height: 410px;
    border-radius: 26px;
    filter: blur(2px) saturate(.72) brightness(.92);
    opacity: .72;
  }
  .account-mock { padding: 42px 30px; }
  .mock-profile-head { grid-template-columns: 60px 1fr; gap: 12px; }
  .mock-profile-avatar { width: 60px; height: 60px; }
  .mock-profile-head dl { display: none; }
  .mock-note-grid { grid-template-columns: repeat(3, 1fr); }
  .mock-note-grid i { height: 120px; }
  .reality-mock { padding: 22px; }
  .forensic-box { width: 110px; height: 90px; }
  .voice-mock { padding: 38px 30px; }
  .comment-list > div { padding: 0 6px; }
  .comment-links { inset-inline: 24px; width: calc(100% - 48px); }
  .copy-mock { padding: 50px 34px; }
  .copy-mock p { font-size: 14px; }
  .consistency-network { left: -4%; width: 50%; }
  .consistency-compare-card { width: 36%; padding: 17px; }
  .decision-ladder-mock { left: 1%; width: 38%; }
  .decision-advice-mock { right: 1%; width: 40%; padding: 20px; }
  .finale-trace { width: 260px; }
  .finale-trace i:not(:last-child)::after { width: 53px; }
  .cinematic-controls {
    bottom: 12px;
    width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
  }
  .hero-dimension-card {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 130px;
    z-index: 13;
    width: auto;
    min-height: 48px;
    margin: 0;
    padding: 6px 9px;
    grid-template-columns: 38px 1fr auto;
    border-radius: 14px;
  }
  .expert-portrait { width: 38px; height: 38px; border-radius: 11px; }
  .hero-dimension-card > i { grid-column: 3; margin: 0; }
  .hero-scene-progress { margin-bottom: 7px; }
  .cinematic-controls .hero-composer { min-height: 58px; padding: 5px 6px; }
  .cinematic-controls .hero-composer-tools { grid-template-columns: minmax(0, 1fr) 44px; gap: 4px; }
  .cinematic-controls .hero-send-button { width: 44px; height: 44px; }
  .cinematic-controls .hero-textarea-shell textarea,
  .cinematic-controls .hero-demo-placeholder { font-size: 13px; }
  .cinematic-controls .hero-promises { gap: 6px; font-size: 8px; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-product-mock,
  .account-scan-line,
  .mock-callouts span,
  .forensic-box,
  .comment-list > div.matched span,
  .comment-links path,
  .voice-callout,
  .copy-mock mark,
  .copy-callout {
    animation: none;
  }
  .account-scan-line,
  .comment-links { display: none; }
  .mock-callouts span,
  .forensic-box,
  .voice-callout,
  .copy-callout { opacity: 1; transform: none; }
  .comment-list > div.matched span,
  .copy-mock mark { background-size: 100% 100%; }
}

/* Why trust us */
.why-trust-section {
  --trust-ink: #1f1b33;
  --trust-purple: #7b6bb0;
  --trust-green: #7fa38b;
  --trust-rose: #c98b93;
  position: relative;
  overflow: hidden;
  padding: 132px clamp(24px, 6vw, 88px) 112px;
  color: var(--trust-ink);
  background:
    radial-gradient(circle at 12% 22%, rgba(201, 139, 147, .14), transparent 25%),
    radial-gradient(circle at 88% 36%, rgba(123, 107, 176, .16), transparent 29%),
    #f7f5fc;
}
.why-trust-shell { width: min(1220px, 100%); margin: auto; }
.why-trust-heading { text-align: center; }
.why-trust-heading>span,
.promise-card-label { font: 500 9px var(--mono); letter-spacing: .12em; }
.why-trust-heading>span { display: inline-flex; padding: 8px 12px; border: 1px solid rgba(123, 107, 176, .16); border-radius: 999px; background: rgba(255, 255, 255, .62); color: var(--trust-purple); }
.why-trust-heading h2 { margin: 22px 0 14px; color: var(--trust-ink); font: 500 clamp(43px, 5vw, 68px)/1.04 var(--serif); letter-spacing: -.045em; }
.why-trust-heading h2 em { color: var(--trust-purple); font-weight: 500; }
.why-trust-heading p { margin: 0; color: #716b7d; font-size: 13px; }
.promise-card-grid { margin-top: 64px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.promise-card {
  min-width: 0;
  min-height: 520px;
  padding: 24px;
  border: 1px solid rgba(123, 107, 176, .16);
  border-radius: 28px;
  background: rgba(255, 255, 255, .7);
  box-shadow: 0 22px 60px rgba(67, 54, 96, .08);
  backdrop-filter: blur(20px);
  display: flex;
  flex-direction: column;
  transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
  cursor: pointer;
}
.promise-card:hover,
.promise-card:focus-visible { border-color: rgba(123, 107, 176, .3); box-shadow: 0 27px 70px rgba(67, 54, 96, .12); transform: translateY(-4px); outline: none; }
.promise-card-label { height: 25px; display: flex; align-items: center; gap: 8px; color: #776f82; }
.promise-card-label b { color: var(--trust-purple); font-weight: 500; }
.promise-card-label i { width: 18px; height: 1px; background: rgba(123, 107, 176, .32); }
.promise-demo { position: relative; height: 214px; margin: 18px 0 26px; padding: 42px 18px 18px; overflow: hidden; border: 1px solid rgba(123, 107, 176, .11); border-radius: 20px; background: rgba(247, 245, 252, .82); }
.promise-example { position: absolute; right: 12px; top: 11px; color: #9a93a2; font: 500 6px var(--mono); letter-spacing: .08em; }
.promise-card-copy { margin-top: auto; }
.promise-card-copy h3 { margin: 0 0 12px; font: 500 22px/1.25 "Noto Sans SC", sans-serif; letter-spacing: -.025em; }
.promise-card-copy p { margin: 0; color: #706a77; font-size: 11px; line-height: 1.85; }
.evidence-promise-demo>p { min-height: 46px; margin: 1px 0 26px; color: #413a4b; font-size: 11px; line-height: 1.65; }
.evidence-signal-row { display: flex; align-items: center; width: 100%; }
.evidence-signal-step { min-width: 0; display: flex; align-items: center; flex: 1; }
.evidence-signal-step>i { width: 14px; height: 1px; flex: none; background: rgba(123, 107, 176, .24); transform-origin: left; }
.evidence-signal-step>span { min-width: 0; flex: 1; height: 34px; padding: 0 7px; border: 1px solid rgba(123, 107, 176, .13); border-radius: 999px; background: rgba(255, 255, 255, .9); display: flex; align-items: center; justify-content: center; gap: 5px; color: #655f6c; font-size: 7px; white-space: nowrap; transition: background .25s ease, box-shadow .25s ease; }
.evidence-signal-step>span b { width: 5px; height: 5px; border-radius: 50%; background: var(--trust-purple); }
.evidence-signal-step>span.signal-rose b { background: var(--trust-rose); }
.evidence-signal-step>span.signal-green b { background: var(--trust-green); }
.evidence-promise-demo:hover .evidence-signal-step>span { background: #fff; box-shadow: 0 0 0 3px rgba(123, 107, 176, .08); }
.evidence-promise-demo:hover .evidence-signal-step:nth-child(2)>span { transition-delay: .12s; }
.evidence-promise-demo:hover .evidence-signal-step:nth-child(3)>span { transition-delay: .24s; }
.restraint-dimensions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; }
.restraint-dimensions>span { height: 42px; border-radius: 11px; display: grid; place-items: center; color: #4d4657; font: 500 13px var(--mono); }
.restraint-t { background: #ded4f3; }
.restraint-r { background: #f1d9df; }
.restraint-u { background: #dcece3; }
.restraint-s { background: #e7dcf0; }
.unavailable-note { display: block; margin: 12px 0 19px; color: #918a98; font: 7px var(--mono); }
.restraint-score { padding-top: 14px; border-top: 1px solid rgba(123, 107, 176, .12); display: flex; align-items: end; justify-content: space-between; gap: 12px; }
.restraint-score>span { color: #514a5a; font-size: 9px; }
.restraint-score strong { margin-left: 4px; color: var(--trust-ink); font: 500 26px/1 var(--serif); }
.restraint-score small { color: #918a98; font-size: 7px; }
.appeal-promise-demo { display: flex; flex-direction: column; gap: 12px; }
.appeal-promise-demo p { max-width: 82%; margin: 0; padding: 10px 12px; border-radius: 13px 13px 4px 13px; align-self: flex-end; background: #342e46; color: #fff; font-size: 8px; line-height: 1.55; }
.appeal-agent { max-width: 92%; padding: 10px 12px 9px; border-radius: 13px 13px 13px 4px; background: #ece7f5; color: #574e63; font-size: 8px; line-height: 1.6; }
.appeal-agent>span { display: block; width: 100%; white-space: nowrap; overflow: hidden; }
.appeal-agent>span i { display: block; overflow: hidden; white-space: nowrap; font-style: normal; }
.appeal-agent>b { display: block; height: 2px; margin-top: 9px; border-radius: 999px; overflow: hidden; background: rgba(123, 107, 176, .13); }
.appeal-agent>b i { display: block; width: 100%; height: 100%; background: var(--trust-purple); transform-origin: left; }
.trust-boundary-grid { margin-top: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.trust-boundary-grid>section { padding: 28px 30px; border: 1px solid rgba(123, 107, 176, .14); border-radius: 24px; background: rgba(255, 255, 255, .56); backdrop-filter: blur(16px); }
.trust-boundary-grid h3 { margin: 0 0 18px; font: 500 21px/1.2 var(--serif); }
.trust-boundary-grid ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 13px; }
.trust-boundary-grid li { display: grid; grid-template-columns: 24px 1fr; gap: 9px; align-items: start; color: #686170; font-size: 11px; line-height: 1.75; }
.trust-boundary-grid li>span { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: rgba(127, 163, 139, .14); color: #678774; }
.boundary-avoid li>span { background: rgba(217, 183, 107, .14); color: #9a7d3f; }
.trust-verification-band { margin-top: 18px; padding: 23px 28px; border: 1px solid rgba(123, 107, 176, .14); border-radius: 22px; background: rgba(255, 255, 255, .62); display: grid; grid-template-columns: 1.25fr .75fr; gap: 40px; align-items: center; }
.verification-weights { height: 28px; display: flex; overflow: hidden; border-radius: 8px; }
.verification-weights i { display: grid; place-items: center; color: #4f4858; font: 500 7px var(--mono); font-style: normal; }
.weight-t { background: #ded4f3; }.weight-r { background: #f1d9df; }.weight-u { background: #dcece3; }.weight-s { background: #e7dcf0; }
.trust-verification-band>div>small { display: block; margin-top: 7px; color: #8e8794; font-size: 7px; }
.trust-verification-band p { margin: 0; display: flex; flex-direction: column; gap: 6px; color: #645d6b; font-size: 9px; }
.trust-verification-band p strong { color: #3d3745; font-weight: 500; }
.why-trust-back { margin: 42px auto 0; padding: 8px 3px; border: 0; border-bottom: 1px solid rgba(123, 107, 176, .32); background: transparent; display: block; color: var(--trust-purple); font-size: 11px; }

@media (max-width: 899px) {
  .why-trust-section { padding: 92px 18px 82px; }
  .why-trust-heading h2 { font-size: 43px; }
  .why-trust-heading p { max-width: 320px; margin: auto; line-height: 1.7; }
  .promise-card-grid { margin-top: 46px; grid-template-columns: 1fr; }
  .promise-card { min-height: 470px; }
  .promise-demo { height: 196px; }
  .trust-boundary-grid { grid-template-columns: 1fr; }
  .trust-verification-band { grid-template-columns: 1fr; gap: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  .promise-card { transition: none; }
  .promise-card:hover,
  .promise-card:focus-visible { transform: none; }
}

/* Learn */
.learn-section {
  --learn-ink: #1f1b33;
  --learn-purple: #7b6bb0;
  --learn-lilac: #e9e4f7;
  --learn-green: #7fa38b;
  --learn-amber: #d9b76b;
  --learn-rose: #c98b93;
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 110px clamp(26px, 6vw, 92px) 0;
  color: var(--learn-ink);
  background:
    radial-gradient(circle at 9% 28%, rgba(201, 139, 147, .14), transparent 25%),
    radial-gradient(circle at 82% 42%, rgba(123, 107, 176, .16), transparent 32%),
    #f7f5fc;
}
.learn-layout { width: 100%; max-width: 1240px; margin: 0 auto; display: flex; flex-direction: column; }
.learn-intro { position: relative; max-width: 760px; margin: 0 auto; padding: 0 0 48px; text-align: center; }
.learn-intro>span,
.learn-section-label { color: var(--learn-purple); font: 500 9px var(--mono); letter-spacing: .12em; }
.learn-intro>span { display: inline-flex; padding: 8px 12px; border: 1px solid rgba(123, 107, 176, .16); border-radius: 999px; background: rgba(255, 255, 255, .64); }
.learn-intro h2 { margin: 24px 0 16px; font: 500 clamp(45px, 4.8vw, 68px)/1.04 var(--serif); letter-spacing: -.05em; }
.learn-intro h2 em { display: block; color: var(--learn-purple); font-weight: 500; }
.learn-intro>p { max-width: 480px; margin: 0 auto; color: #716b7d; font-size: 13px; line-height: 1.9; }
.learn-intro nav { position: relative; margin-top: 34px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 30px; }
.learn-intro nav::before { content: none; }
.learn-intro nav button { position: relative; padding: 0; border: 0; background: transparent; display: flex; align-items: center; gap: 13px; color: #aaa3b0; text-align: left; font-size: 10px; }
.learn-intro nav button i { z-index: 1; width: 11px; height: 11px; border: 2px solid #d8d2df; border-radius: 50%; background: #f7f5fc; transition: border-color .25s, background .25s, box-shadow .25s; }
.learn-intro nav button.active { color: #4a4254; }
.learn-intro nav button.active i { border-color: var(--learn-purple); background: var(--learn-purple); box-shadow: 0 0 0 5px rgba(123, 107, 176, .1); }
.learn-intro nav button.complete i { border-color: var(--learn-green); background: var(--learn-green); }
.learn-card-wrap { position: relative; }
.learn-scroll-card {
  border: 1px solid rgba(123, 107, 176, .14);
  border-radius: 32px;
  background: rgba(255, 255, 255, .68);
  box-shadow: -28px 28px 90px rgba(65, 52, 92, .1);
  backdrop-filter: blur(24px);
  outline: none;
}
.learn-scroll-card:focus-visible { box-shadow: inset 0 0 0 2px rgba(123, 107, 176, .32), -28px 28px 90px rgba(65, 52, 92, .1); }
.learn-scroll-card::-webkit-scrollbar { width: 5px; }
.learn-scroll-card::-webkit-scrollbar-thumb { border-radius: 99px; background: rgba(123, 107, 176, .3); }
.learn-card-content { width: 100%; margin: 0 auto; padding: clamp(40px, 5vw, 64px) clamp(20px, 3vw, 44px) clamp(56px, 6vw, 80px); }
.learn-fade { display: none; }
.learn-fade-top { top: 1px; background: linear-gradient(rgba(249, 248, 252, .96), transparent); border-radius: 360px 0 0; }
.learn-fade-bottom { bottom: 0; background: linear-gradient(transparent, rgba(249, 248, 252, .96)); }
.learn-section-intro { margin: 17px 0 36px; color: #5f5967; font-size: 14px; line-height: 1.8; }
/* Row 1: the four clues side by side; row 2 (below) is the quiz. */
.learn-clue-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; align-items: stretch; }
.learn-clue-card { min-width: 0; padding: 22px; border: 1px solid rgba(123, 107, 176, .14); border-radius: 24px; background: rgba(255, 255, 255, .7); box-shadow: 0 16px 48px rgba(65, 52, 92, .06); }
.learn-clue-card>header { display: flex; align-items: center; gap: 12px; }
.learn-clue-card>header>span { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: #ded4f3; color: #4d455b; font: 500 14px var(--mono); }
.learn-clue-card.clue-r>header>span { background: #f1d9df; }
.learn-clue-card.clue-u>header>span { background: #dcece3; }
.learn-clue-card.clue-s>header>span { background: #e7dcf0; }
.learn-clue-card h3 { margin: 0; font: 500 23px var(--serif); }
.learn-clue-card>ul { margin: 22px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
.learn-clue-card>ul li { position: relative; padding-left: 17px; color: #655f6c; font-size: 11px; line-height: 1.75; }
.learn-clue-card>ul li::before { content: ""; position: absolute; left: 0; top: .72em; width: 6px; height: 1px; background: var(--learn-purple); }
.learn-reminder { margin: 18px 0 0; padding: 12px 14px; border-left: 2px solid var(--learn-amber); background: rgba(217, 183, 107, .09); color: #746b59; font-size: 9px; line-height: 1.7; }
.learn-account-example,
.learn-image-example,
.learn-comment-example,
.learn-copy-example { position: relative; min-height: 150px; margin-top: 23px; padding: 18px; overflow: hidden; border: 1px solid rgba(123, 107, 176, .1); border-radius: 17px; background: #f7f5fa; }
.learn-account-example { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px; padding-bottom: 42px; }
.learn-account-example>span { min-height: 70px; padding: 10px 7px; border-radius: 9px; background: #fff; display: flex; align-items: end; color: #8d8692; font-size: 6px; line-height: 1.5; }
.learn-account-example>span.dense { border: 1px solid rgba(123, 107, 176, .22); background: #ede8f7; color: #625775; }
.learn-account-example>small { position: absolute; right: 18px; bottom: 15px; padding: 5px 7px; border-radius: 99px; background: #ded4f3; color: #665682; font-size: 6px; }
.learn-image-example { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.learn-image-example>div { min-height: 130px; border-radius: 12px; background: radial-gradient(circle at 54% 45%, #f2d8d3, #dfc2bf 45%, #cab1b8); }
.learn-image-example>div:nth-child(2) { background: radial-gradient(circle at 47% 43%, #f5e6df, #e8d3cf 48%, #c8b8c6); filter: contrast(.92); }
.learn-image-example>div>span { display: inline-flex; margin: 8px; padding: 4px 6px; border-radius: 99px; background: rgba(255,255,255,.66); color: #716a77; font: 5px var(--mono); }
.learn-image-callout { position: absolute; padding: 5px 7px; border: 1px solid rgba(123, 107, 176, .35); border-radius: 7px; background: rgba(255,255,255,.82); color: #665a7a; font-size: 6px; font-style: normal; }
.learn-image-callout::after { content: ""; position: absolute; width: 40px; height: 28px; border: 1px solid rgba(123,107,176,.45); }
.learn-image-callout.callout-1 { right: 8%; top: 54%; }.learn-image-callout.callout-1::after { right: 32%; bottom: calc(100% + 4px); }
.learn-image-callout.callout-2 { left: 35%; top: 12%; }.learn-image-callout.callout-2::after { left: 45%; top: calc(100% + 4px); }
.learn-image-example>small { position: absolute; right: 13px; top: 10px; color: #8e8794; font: 5px var(--mono); }
.learn-comment-example { display: flex; flex-direction: column; gap: 6px; }
.learn-comment-example>span { position: relative; z-index: 2; padding: 8px 10px; border-radius: 8px; background: #fff; color: #77707d; font-size: 7px; }
.learn-comment-example>span.similar { background: #eee9f9; color: #635674; }
.learn-comment-example svg { position: absolute; z-index: 1; inset: 10px; width: calc(100% - 20px); height: calc(100% - 20px); overflow: visible; }
.learn-comment-example path { fill: none; stroke: var(--learn-purple); stroke-width: 1.2; stroke-dasharray: 4 3; opacity: .55; }
.learn-copy-example { min-height: 120px; display: flex; flex-direction: column; justify-content: center; }
.learn-copy-example p { margin: 0; color: #5f5866; font-size: 10px; line-height: 2; }
.learn-copy-example mark { padding: 2px 3px; background: linear-gradient(transparent 15%, rgba(197, 174, 237, .55) 15% 90%, transparent 90%); color: inherit; }
.learn-copy-example small { align-self: flex-end; margin-top: 8px; color: #725f8b; font: 6px var(--mono); }
.learn-clue-closing { margin: 50px 0 0; padding: 23px 0; border-top: 1px solid rgba(123, 107, 176, .12); border-bottom: 1px solid rgba(123, 107, 176, .12); color: #5f5867; font: 500 18px var(--serif); text-align: center; }
.learn-quiz { max-width: 760px; margin: 0 auto; padding-top: 96px; }
.learn-quiz>h2 { margin: 20px 0 12px; font: 500 clamp(34px, 4vw, 50px)/1.1 var(--serif); text-align: center; }
.learn-quiz>p { margin: 0 auto 52px; max-width: 500px; color: #756e7b; font-size: 11px; line-height: 1.8; text-align: center; }
.learn-round-list { display: flex; flex-direction: column; gap: 58px; }
.learn-quiz-round { padding: 28px; border: 1px solid rgba(123, 107, 176, .14); border-radius: 24px; background: rgba(255, 255, 255, .74); box-shadow: 0 18px 52px rgba(65, 52, 92, .07); }
.learn-quiz-round>header { display: flex; justify-content: space-between; align-items: center; }
.learn-quiz-round>header>span { color: #4f4858; font: 500 11px var(--mono); }
.learn-quiz-round>header>small { color: #928b98; font: 7px var(--mono); }
.round-progress { margin: 13px 0 23px; display: flex; gap: 5px; }
.round-progress i { width: 30px; height: 2px; border-radius: 99px; background: #e0dce4; }
.round-progress i.active { background: var(--learn-purple); }
.quiz-select-list { position: relative; display: flex; flex-direction: column; gap: 9px; }
.quiz-select-list>button { position: relative; z-index: 2; width: 100%; padding: 14px 15px; border: 1px solid rgba(61, 51, 77, .08); border-radius: 12px; background: #faf9fb; color: #5f5966; text-align: left; font-size: 10px; line-height: 1.65; transition: border-color .2s, background .2s, box-shadow .2s; }
.quiz-select-list>button:hover:not(.answer),
.quiz-select-list>button:focus-visible { border-color: rgba(123, 107, 176, .45); box-shadow: 0 0 0 3px rgba(123, 107, 176, .08); outline: none; }
.quiz-select-list>button.selected { border-color: var(--learn-purple); background: #f1edf8; }
.quiz-select-list>button.answer>span { background: linear-gradient(90deg, rgba(195, 173, 235, .55), rgba(195, 173, 235, .55)) no-repeat 0 100% / 100% 45%; }
.quiz-select-list>button.missed { border-color: rgba(217, 183, 107, .6); background: rgba(217, 183, 107, .08); }
.quiz-select-list>button small { display: block; margin-top: 8px; color: #796c8d; font-size: 7px; }
.quiz-comment-curve { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.quiz-comment-curve path { fill: none; stroke: var(--learn-purple); stroke-width: 1.2; stroke-dasharray: 5 3; animation: learn-path-draw .7s ease both; }
.quiz-image-sample { position: relative; height: 340px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.quiz-image-sample>div { position: relative; overflow: hidden; border-radius: 15px; background: radial-gradient(circle at 52% 45%, #f1d5cf, #d9bbb8 46%, #c4a9b3); }
.quiz-image-sample>div.sample-1 { background: radial-gradient(circle at 46% 42%, #f6e5df, #e8ceca 50%, #c4b1bf); }
.quiz-image-sample>div>img { position: absolute; top: 0; width: 200%; height: 100%; max-width: none; object-fit: cover; object-position: center 42%; filter: saturate(.82) contrast(.97); }
.quiz-image-sample>div.sample-0>img { left: 0; }
.quiz-image-sample>div.sample-1>img { left: -100%; }
.quiz-image-sample>div>span { position: absolute; left: 10px; top: 10px; padding: 5px 7px; border-radius: 99px; background: rgba(255,255,255,.7); color: #69616e; font: 6px var(--mono); }
.quiz-image-sample>div>small { position: absolute; right: 10px; top: 11px; color: rgba(64,55,70,.62); font: 5px var(--mono); }
.quiz-image-sample code { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); color: rgba(64,55,70,.48); font: 5px var(--mono); white-space: nowrap; }
.quiz-image-sample>button { position: absolute; z-index: 3; width: 28px; height: 28px; padding: 0; border: 1px solid rgba(255,255,255,.9); border-radius: 50%; background: rgba(123,107,176,.24); transform: translate(-50%,-50%); box-shadow: 0 0 0 5px rgba(255,255,255,.2); }
.quiz-image-sample>button:hover,
.quiz-image-sample>button:focus-visible,
.quiz-image-sample>button.selected { background: var(--learn-purple); outline: 3px solid rgba(123,107,176,.24); }
.quiz-image-sample>button.answer { border-radius: 8px; width: 72px; height: 55px; background: rgba(255,255,255,.08); border-color: var(--learn-purple); }
.quiz-image-sample>button.missed { border-color: var(--learn-amber); outline: 3px solid rgba(217,183,107,.2); }
.quiz-image-sample>button>i { position: absolute; inset: 7px; border: 1px solid white; border-radius: 50%; }
.quiz-image-sample>button.answer>i { inset: 5px; border-color: var(--learn-purple); border-radius: 5px; }
.quiz-image-sample>button>span { position: absolute; left: calc(100% + 8px); top: 50%; width: 145px; padding: 7px 8px; border-radius: 8px; background: rgba(255,255,255,.92); color: #62586c; font-size: 6px; line-height: 1.5; text-align: left; transform: translateY(-50%); opacity: 0; pointer-events: none; }
.quiz-image-sample>button.answer>span { opacity: 1; }
.round-answer { margin-top: 20px; padding: 14px 16px; border-radius: 12px; background: #f1edf7; color: #5e5469; }
.round-answer strong { font-size: 10px; font-weight: 500; }
.round-answer p { margin: 6px 0 0; font-size: 8px; line-height: 1.6; }
.learn-quiz-round>footer { margin-top: 22px; display: flex; justify-content: flex-end; gap: 8px; }
.learn-quiz-round>footer button { min-width: 88px; height: 36px; padding: 0 13px; border: 1px solid rgba(55,47,68,.12); border-radius: 999px; background: #fff; color: #675f6d; font-size: 8px; }
.learn-quiz-round>footer button:hover,
.learn-quiz-round>footer button:focus-visible { border-color: var(--learn-purple); color: #55436d; outline: none; }
.learn-quiz-round>footer .round-reveal,
.learn-quiz-round>footer .round-next { border-color: #302a40; background: #302a40; color: #fff; }
.learn-result { max-width: 760px; margin: 110px auto 0; padding: 55px 44px; border: 1px solid rgba(123,107,176,.15); border-radius: 28px; background: linear-gradient(145deg, rgba(255,255,255,.84), rgba(238,233,248,.76)); text-align: center; }
.learn-result>span { color: var(--learn-purple); font: 500 8px var(--mono); letter-spacing: .1em; }
.learn-result>strong { display: block; margin-top: 22px; font: 500 clamp(34px,4vw,52px)/1.1 var(--serif); }
.learn-result h3 { margin: 16px 0 28px; color: #5e5666; font-size: 13px; font-weight: 400; }
.learn-result p { max-width: 540px; margin: 0 auto; color: #625c69; font-size: 10px; line-height: 1.85; }
.learn-result>small { display: block; margin-top: 8px; color: #99929e; font-size: 6px; }
.learn-result>i { display: none; }
.learn-result>b { display: block; margin: 35px 0 15px; font-size: 12px; font-weight: 500; }
.learn-result>button { display: block; margin-left: auto; margin-right: auto; }
.learn-result-primary { min-height: 45px; padding: 0 21px; border: 0; border-radius: 999px; background: #302a40; color: #fff; font-size: 9px; box-shadow: 0 12px 30px rgba(47,42,64,.18); }
.learn-result-reset { margin-top: 12px; padding: 6px; border: 0; border-bottom: 1px solid rgba(123,107,176,.24); background: transparent; color: var(--learn-purple); font-size: 8px; }
.learn-footer { margin: 0 calc(-1 * clamp(26px, 6vw, 92px)); padding: 30px 20px; color: #8f8895; font-size: 8px; text-align: center; }

@keyframes learn-path-draw { from { stroke-dashoffset: 40; opacity: 0; } to { stroke-dashoffset: 0; opacity: 1; } }

@media (max-width: 1180px) {
  .learn-clue-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 899px) {
  .learn-section { padding: 88px 16px 0; }
  .learn-layout { display: block; }
  .learn-intro { position: relative; top: auto; max-width: none; padding: 0 4px 44px; text-align: center; }
  .learn-intro h2 { font-size: 44px; }
  .learn-intro>p { margin: auto; }
  .learn-intro nav { margin: 34px auto 0; max-width: 270px; text-align: left; }
  .learn-card-wrap { height: auto; min-height: 0; }
  .learn-scroll-card { height: auto; overflow: visible; border-right: 1px solid rgba(123,107,176,.14); border-radius: 28px; box-shadow: 0 22px 65px rgba(65,52,92,.09); }
  .learn-card-content { width: 100%; padding: 56px 16px 70px; }
  .learn-fade { display: none; }
  .learn-clue-list { gap: 20px; }
  .learn-clue-card,
  .learn-quiz-round { padding: 20px; }
  .learn-account-example { grid-template-columns: repeat(3, 1fr); }
  .learn-account-example>span { min-height: 58px; }
  .learn-quiz { padding-top: 86px; }
  .quiz-image-sample { height: 280px; }
  .quiz-image-sample>button>span { left: auto; right: calc(100% + 7px); width: 112px; }
  .learn-result { margin-top: 80px; padding: 42px 20px; }
  .learn-footer { margin-left: -16px; margin-right: -16px; }
}

@media (max-width: 640px) {
  .learn-clue-list { grid-template-columns: minmax(0, 1fr); }
}

@media (prefers-reduced-motion: reduce) {
  .learn-intro nav button i,
  .quiz-select-list>button { transition: none; }
  .quiz-comment-curve path { animation: none; stroke-dashoffset: 0; }
}

/* Landing navigation */
#how-journey,
#why-trust,
#learn,
#faq { scroll-margin-top: 72px; }
.landing-navigation {
  position: fixed;
  inset: 0 0 auto;
  z-index: 100;
  height: 72px;
  padding: 0 clamp(24px, 5vw, 80px);
  border-bottom: 1px solid rgba(31, 27, 51, .08);
  background: rgba(247, 245, 252, .78);
  box-shadow: 0 8px 30px rgba(52, 42, 78, .045);
  backdrop-filter: blur(20px) saturate(1.15);
}
.landing-brand { gap:8px }
.landing-brand>img { width:auto;height:54px;display:block;object-fit:contain }
.landing-brand .trulens-mark { width:29px;height:25px;flex:none;overflow:visible }
.landing-brand .brand-name { font:500 23px/1 var(--serif);letter-spacing:-.035em }
.trulens-mark-dot { transform-box:fill-box;transform-origin:center }
.landing-brand:hover .trulens-mark-dot,
.landing-brand:focus-visible .trulens-mark-dot { animation:trulens-dot-pop .46s cubic-bezier(.22,.72,.24,1) both }
.landing-brand:hover .dot-2,.landing-brand:focus-visible .dot-2 { animation-delay:.07s }
.landing-brand:hover .dot-3,.landing-brand:focus-visible .dot-3 { animation-delay:.14s }
.landing-brand:hover .dot-4,.landing-brand:focus-visible .dot-4 { animation-delay:.21s }
.landing-nav-desktop { display: flex; align-items: center; gap: 28px; }
.landing-nav-links { display: flex; align-items: center; gap: 24px; }
.landing-nav-links>button {
  position: relative;
  height: 42px;
  padding: 0 1px;
  border: 0;
  background: transparent;
  color: #726c7a;
  font: 500 12px "Noto Sans SC", sans-serif;
  transition: color .2s ease;
}
.landing-nav-links>button::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4px;
  height: 1px;
  background: var(--hero-purple);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform .25s ease;
}
.landing-nav-links>button:hover,
.landing-nav-links>button:focus-visible,
.landing-nav-links>button.active { color: var(--hero-ink); outline: none; }
.landing-nav-links>button.active::after { transform: scaleX(1); }
.landing-nav-cta,
.landing-nav-mobile-cta {
  min-height: 40px;
  padding: 0 18px;
  border: 0;
  border-radius: 999px;
  background: #29243a;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  font: 500 11px "Noto Sans SC", sans-serif;
  box-shadow: 0 9px 24px rgba(41, 36, 58, .16);
  transition: transform .2s ease, box-shadow .2s ease;
}
.landing-nav-cta span,
.landing-nav-mobile-cta span { font-family: var(--mono); font-size: 11px; }
.landing-nav-cta:hover,
.landing-nav-cta:focus-visible,
.landing-nav-mobile-cta:hover,
.landing-nav-mobile-cta:focus-visible { transform: translateY(-1px); box-shadow: 0 12px 28px rgba(41, 36, 58, .22); outline: 2px solid rgba(123, 107, 176, .24); outline-offset: 2px; }
.landing-nav-mobile,
.landing-mobile-menu { display: none; }

@keyframes trulens-dot-pop {
  0%,100% { transform:scale(1) }
  55% { transform:scale(1.55) }
  78% { transform:scale(.92) }
}

@media (max-width: 899px) {
  #how-journey,
  #why-trust,
  #learn,
  #faq { scroll-margin-top: 64px; }
  .landing-navigation {
    height: 64px;
    padding: 0 15px 0 18px;
    grid-template-columns: 1fr auto;
  }
  .landing-navigation .logo { font-size: 15px; }
  .landing-brand>img { height:46px }
  .landing-brand .brand-name { font-size:20px }
  .landing-nav-desktop { display: none; }
  .landing-nav-mobile { display: flex; align-items: center; gap: 8px; }
  .landing-nav-mobile-cta { min-height: 36px; padding: 0 14px; font-size: 9px; }
  .landing-menu-toggle { width: 38px; height: 38px; padding: 0; border: 1px solid rgba(31, 27, 51, .1); border-radius: 50%; background: rgba(255,255,255,.58); display: grid; place-content: center; gap: 5px; }
  .landing-menu-toggle i { width: 15px; height: 1px; background: #302a40; transition: transform .25s ease; }
  .landing-menu-toggle.open i:first-child { transform: translateY(3px) rotate(45deg); }
  .landing-menu-toggle.open i:last-child { transform: translateY(-3px) rotate(-45deg); }
  .landing-menu-toggle:focus-visible { outline: 2px solid rgba(123,107,176,.4); outline-offset: 2px; }
  .landing-mobile-menu {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 70px;
    padding: 8px;
    border: 1px solid rgba(123, 107, 176, .14);
    border-radius: 20px;
    background: rgba(250, 249, 252, .96);
    box-shadow: 0 22px 60px rgba(47, 39, 67, .15);
    backdrop-filter: blur(22px);
    display: flex;
    flex-direction: column;
  }
  .landing-mobile-menu>button {
    min-height: 48px;
    padding: 0 13px;
    border: 0;
    border-radius: 13px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #716a78;
    font-size: 11px;
    text-align: left;
  }
  .landing-mobile-menu>button:hover,
  .landing-mobile-menu>button:focus-visible,
  .landing-mobile-menu>button.active { background: #eee9f7; color: #302a40; outline: none; }
  .landing-mobile-menu>button span { color: var(--hero-purple); font-family: var(--mono); }
}

@media (prefers-reduced-motion: reduce) {
  .landing-brand:hover .trulens-mark-dot,
  .landing-brand:focus-visible .trulens-mark-dot { animation:none }
  .landing-nav-links>button,
  .landing-nav-links>button::after,
  .landing-nav-cta,
  .landing-nav-mobile-cta,
  .landing-menu-toggle i { transition: none; }
}

/* FAQ */
.faq-section {
  --faq-ink: #1f1b33;
  --faq-purple: #7b6bb0;
  position: relative;
  overflow: hidden;
  padding: 128px clamp(24px, 7vw, 110px) 140px;
  color: var(--faq-ink);
  background:
    radial-gradient(circle at 12% 18%, rgba(201, 139, 147, .13), transparent 26%),
    radial-gradient(circle at 88% 42%, rgba(123, 107, 176, .16), transparent 30%),
    #f7f5fc;
}
.faq-heading { position: relative; z-index: 1; text-align: center; }
.faq-heading>span { display: inline-flex; padding: 8px 12px; border: 1px solid rgba(123,107,176,.16); border-radius: 999px; background: rgba(255,255,255,.62); color: var(--faq-purple); font: 500 9px var(--mono); letter-spacing: .12em; }
.faq-heading h2 { margin: 20px 0 12px; font: 500 clamp(45px, 5vw, 68px)/1.04 var(--serif); letter-spacing: -.045em; }
.faq-heading p { max-width: 560px; margin: 0 auto; color: #716b7d; font-size: 13px; line-height: 1.8; }
.faq-shell { position: relative; z-index: 1; width: min(980px, 100%); margin: 76px auto 0; }
.faq-group { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 44px; padding: 40px 0; border-top: 1px solid rgba(123,107,176,.15); }
.faq-group:last-child { border-bottom: 1px solid rgba(123,107,176,.15); }
.faq-group>h3 { margin: 5px 0 0; color: #81798a; font: 500 10px var(--mono); letter-spacing: .06em; }
.faq-group>div { display: flex; flex-direction: column; }
.faq-item { border-bottom: 1px solid rgba(54,47,69,.09); }
.faq-item:last-child { border-bottom: 0; }
.faq-item>button { width: 100%; min-height: 76px; padding: 17px 0; border: 0; background: transparent; display: grid; grid-template-columns: 34px minmax(0,1fr) auto 34px; align-items: center; gap: 12px; color: #342e3f; text-align: left; }
.faq-item>button>span { color: #9a93a1; font: 8px var(--mono); }
.faq-item>button>strong { font-size: 13px; font-weight: 500; line-height: 1.6; }
.faq-item>button>small { padding: 5px 7px; border-radius: 99px; background: #eee9f7; color: #6d5e85; font-size: 7px; white-space: nowrap; }
.faq-item>button>i { position: relative; width: 30px; height: 30px; border: 1px solid rgba(123,107,176,.18); border-radius: 50%; background: rgba(255,255,255,.58); display: grid; place-items: center; transition: border-color .2s ease, background .2s ease; }
.faq-item>button>i b { position: absolute; width: 10px; height: 1px; background: #635872; transition: transform .25s ease; }
.faq-item>button>i b:last-child { transform: rotate(90deg); }
.faq-item.open>button>i b:last-child { transform: rotate(0); }
.faq-item>button:hover>i,
.faq-item>button:focus-visible>i { border-color: rgba(123,107,176,.45); background: #eee9f7; }
.faq-item>button:focus-visible { outline: 2px solid rgba(123,107,176,.25); outline-offset: 3px; border-radius: 10px; }
.faq-answer { overflow: hidden; }
.faq-answer p { margin: 0; padding: 0 46px 25px; color: #6d6673; font-size: 11px; line-height: 1.95; }

@media (max-width: 899px) {
  .faq-section { padding: 96px 18px 100px; }
  .faq-heading h2 { font-size: 44px; }
  .faq-heading p { max-width: 330px; font-size: 11px; }
  .faq-shell { margin-top: 56px; }
  .faq-group { grid-template-columns: 1fr; gap: 12px; padding: 28px 0; }
  .faq-group>h3 { margin-bottom: 7px; }
  .faq-item>button { min-height: 68px; grid-template-columns: 26px minmax(0,1fr) 30px; gap: 8px; }
  .faq-item>button>small { grid-column: 2; justify-self: start; margin-top: -8px; }
  .faq-item>button>i { grid-column: 3; grid-row: 1 / span 2; width: 28px; height: 28px; }
  .faq-answer p { padding: 0 34px 23px; font-size: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  .faq-item>button>i,
  .faq-item>button>i b { transition: none; }
}

/* Landing footer */
.landing-footer {
  padding: 0 clamp(24px, 6vw, 92px);
  color: #302a40;
  background:
    radial-gradient(circle at 10% 10%, rgba(201,139,147,.08), transparent 26%),
    radial-gradient(circle at 88% 28%, rgba(123,107,176,.1), transparent 30%),
    #f4f0fa;
}
.landing-footer-main {
  min-height: 330px;
  padding: 62px 0 56px;
  border-top: 1px solid rgba(123,107,176,.18);
  display: grid;
  grid-template-columns: minmax(260px,1.35fr) minmax(180px,.65fr) minmax(180px,.65fr);
  gap: clamp(48px,8vw,120px);
  align-items: start;
}
.landing-footer-brand-area { display:flex;flex-direction:column;align-items:flex-start;gap:24px }
.landing-footer-brand { padding: 0; border: 0; background: transparent; display: inline-flex; align-items: center; justify-self: start; gap: 12px; color: #1f1b33; font: 500 36px/1 var(--serif); letter-spacing: -.04em; }
.landing-footer-brand>img { width:auto;height:92px;display:block;object-fit:contain }
.landing-footer-brand:focus-visible { outline: 2px solid rgba(123,107,176,.35); outline-offset: 7px; border-radius: 4px; }
.landing-footer-brand-area>input { width:min(340px,100%);height:48px;padding:0 17px;border:1px solid rgba(123,107,176,.16);border-radius:16px;background:rgba(255,255,255,.58);color:#302a40;font-size:12px;box-shadow:inset 0 1px 0 rgba(255,255,255,.72);outline:none }
.landing-footer-brand-area>input::placeholder { color:#aaa3b2 }
.landing-footer-brand-area>input:focus { border-color:rgba(123,107,176,.45);box-shadow:0 0 0 3px rgba(123,107,176,.09) }
.landing-footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: 17px; }
.landing-footer-column>strong { margin-bottom: 3px; color: #8d78c2; font: 500 11px var(--mono); letter-spacing: .08em; }
.landing-footer-column>button,
.landing-footer-column>span { padding: 0; border: 0; background: transparent; color: #393244; font-size: 13px; line-height: 1.45; text-align: left; }
.landing-footer-column>button { position: relative; }
.landing-footer-column>button::after { content:""; position:absolute; left:0; right:0; bottom:-4px; height:1px; background:#7b6bb0; transform:scaleX(0); transform-origin:left; transition:transform .2s ease; }
.landing-footer-column>button:hover::after,
.landing-footer-column>button:focus-visible::after { transform:scaleX(1); }
.landing-footer-column>button:focus-visible { outline: none; color:#5f4e81; }
.landing-footer-information>span { cursor: default; }
.landing-footer-bottom { min-height: 116px; padding: 32px 0; border-top: 1px solid rgba(123,107,176,.18); display: flex; align-items: center; justify-content: space-between; gap: 30px; color: #8b8496; font-size: 11px; letter-spacing: .01em; }

@media (max-width: 720px) {
  .landing-footer { padding: 0 20px; }
  .landing-footer-main { min-height: 0; padding: 48px 0; grid-template-columns: 1fr 1fr; gap: 44px 28px; }
  .landing-footer-brand-area { grid-column: 1 / 3; }
  .landing-footer-brand>img { height:78px }
  .landing-footer-column { gap: 14px; }
  .landing-footer-column>button,
  .landing-footer-column>span { font-size: 11px; }
  .landing-footer-bottom { min-height: 0; padding: 27px 0 34px; flex-direction: column; align-items: flex-start; gap: 9px; font-size: 9px; }
}

@media (prefers-reduced-motion: reduce) {
  .landing-footer-column>button::after { transition: none; }
}

/* ---------------------------------------------------------------------------
   Live verification (real backend vertical slice) — see src/LiveAnalysis.tsx
   Reuses the report/workspace language above; only the form + progress states
   are new, because the static story pages had no live-input UI.
   --------------------------------------------------------------------------- */
.live-form { display: flex; flex-direction: column; gap: 2px; }
.live-field { display: flex; flex-direction: column; gap: 4px; padding: 7px 9px; }
.live-field > span { font: 9px var(--mono); letter-spacing: .05em; color: #8b8493; }
.live-field > small { color: #a9a3b0; font-size: 8px; line-height: 1.6; }
.live-field textarea { min-height: 62px; }
.live-field textarea.live-short { min-height: 40px; }
.live-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 6px; padding: 8px 9px 2px; border-top: 1px solid rgba(53,46,75,.08); }
.live-actions > div { display: flex; align-items: center; gap: 6px; min-width: 0; }
.live-file { display: flex; align-items: center; gap: 8px; min-width: 0; color: #716a77; font-size: 9px; }
.live-file button { border: 0; background: transparent; color: #8b8493; cursor: pointer; font-size: 12px; line-height: 1; }
.live-primary { padding: 10px 16px; border: 0; border-radius: 11px; background: #302a40; color: #fff; display: flex; align-items: center; gap: 8px; font-size: 10px; cursor: pointer; }
.live-primary:disabled { opacity: .32; cursor: not-allowed; }
.live-primary .live-arrow { transition: transform .2s ease; }
.live-primary:not(:disabled):hover .live-arrow { transform: translateX(3px); }
.live-progress { margin: 22px 0 0; text-align: left; }
.live-progress-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.live-progress-head strong { font-size: 11px; font-weight: 500; color: #3c3544; }
.live-progress-head b { font: 9px var(--mono); color: #77707d; }
.live-progress ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.live-progress li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 11px; padding: 9px 12px; border: 1px solid rgba(54,48,73,.08); border-radius: 12px; background: rgba(255,255,255,.55); }
.live-dot { width: 8px; height: 8px; border-radius: 50%; background: #cbc5d2; }
.live-dot.running { background: #8977b4; box-shadow: 0 0 0 4px rgba(137,119,180,.15); }
.live-dot.completed { background: #78a28c; }
.live-dot.failed { background: #c98791; }
.live-progress li > span:nth-child(2) { min-width: 0; color: #4f4956; font-size: 10px; }
.live-progress li b { font: 9px var(--mono); font-weight: 400; color: #5f5867; white-space: nowrap; }
.live-error { margin: 18px 0 0; padding: 14px 16px; border: 1px solid rgba(201,135,145,.42); border-radius: 14px; background: #fdf3f4; color: #7b494f; font-size: 10px; line-height: 1.7; text-align: left; }
.live-resume-button { display: block; margin-top: 10px; min-height: 32px; padding: 0 12px; border: 1px solid #a26a71; border-radius: 99px; background: #fff; color: #7b494f; font-size: 9px; }
.live-resume-button:hover { background: #7b494f; color: #fff; }
.live-input-summary { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 20px 0 0; }
.live-input-summary span { padding: 6px 10px; border: 1px solid rgba(54,48,73,.08); border-radius: 99px; background: rgba(255,255,255,.6); font: 8px var(--mono); color: #6f6876; }
.live-evidence { margin-top: 26px; }
.live-evidence h3 { margin: 0 0 12px; font: 500 18px var(--serif); color: #302a39; }
.live-evidence ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.live-evidence li { display: grid; grid-template-columns: auto 1fr; gap: 11px; align-items: start; padding: 10px 12px; border: 1px solid rgba(52,44,68,.07); border-radius: 12px; background: rgba(255,255,255,.6); }
.live-sev { width: 36px; height: 18px; border-radius: 99px; display: grid; place-items: center; font: 7px var(--mono); }
.live-sev.high { background: #f4e1e1; color: #774b52; }
.live-sev.medium { background: #f3e5ce; color: #6d542a; }
.live-sev.low { background: #e2f0e8; color: #466b58; }
.live-evidence p { margin: 0; font-size: 10px; line-height: 1.65; color: #4f4956; }
.live-evidence small { color: #8b8493; font-size: 8px; }
.live-thumb { width: 132px; height: 132px; flex: none; border-radius: 20px; overflow: hidden; border: 1px solid rgba(54,48,73,.1); background: #f4f1f8; display: grid; place-items: center; }
.live-thumb img { width: 100%; height: 100%; object-fit: cover; }
.live-overall-note { margin: 0 0 18px; color: #9a7880; font-size: 8px; font-style: normal; }

/* Per-dimension limitation note inside the unified report rows */
.live-dim-limit { display: block; margin-top: 3px; color: #9a93a2; font-size: 8px; line-height: 1.5; }

/* ---------------------------------------------------------------------------
   Help-guide dialog sizing.
   `.account-dialog` is a 460x680 box tuned for the one-line confirm dialogs
   (reset / add / sign-out). The help guide instead carries a two-column how-to
   plus an FAQ, which made it cramped and forced it to scroll inside its own
   frame. It gets its own larger frame and readable type below; the other
   dialogs are untouched.
   --------------------------------------------------------------------------- */
.account-dialog-wide { width: min(920px, 100%); max-height: min(88vh, calc(100vh - 40px)); padding: 34px 38px; }
.account-dialog-wide > p { font-size: 12px; }
.account-dialog-wide .help-guide { margin-top: 26px; gap: 18px; }
.account-dialog-wide .help-guide section { padding: 20px; border-radius: 17px; }
.account-dialog-wide .help-guide h3 { font-size: 13px; margin-bottom: 15px; }
.account-dialog-wide .help-guide li { gap: 11px; }
.account-dialog-wide .help-guide li > span { width: 26px; height: 26px; font-size: 9px; }
.account-dialog-wide .help-guide li strong { font-size: 12px; }
.account-dialog-wide .help-guide li small { font-size: 10px; line-height: 1.7; }
.account-dialog-wide .help-faq details { padding: 13px 0; }
.account-dialog-wide .help-faq summary { font-size: 11px; }
.account-dialog-wide .help-faq details p { font-size: 10px; line-height: 1.75; }

@media (max-width: 640px) {
  /* Give a narrow viewport back the backdrop's padding so the dialog can use the
     full width, and let it grow taller instead of scrolling inside a sub-500px box. */
  .account-dialog-backdrop { padding: 10px; }
  .account-dialog-wide { width: 100%; max-height: calc(100vh - 20px); padding: 24px 19px; }
  .account-dialog-wide .help-guide { gap: 12px; }
  .account-dialog-wide .help-guide li strong { font-size: 11px; }
}

/* Frontend teammate additions: team, technical view, process progress */
.technical-view-toggle{height:34px;padding:0 9px 0 11px;border:1px solid rgba(67,55,83,.11);border-radius:10px;background:rgba(255,255,255,.68);color:#827b88;display:flex;align-items:center;gap:8px;font-size:8px;white-space:nowrap;transition:background .2s ease,border-color .2s ease,color .2s ease}.technical-view-toggle:hover{border-color:rgba(111,91,151,.24);background:#fff;color:#554b61}.technical-view-toggle>i{position:relative;width:25px;height:14px;border-radius:99px;background:#dfdbe3;box-shadow:inset 0 0 0 1px rgba(60,49,74,.06);transition:background .2s ease}.technical-view-toggle>i>b{position:absolute;left:2px;top:2px;width:10px;height:10px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(47,38,58,.2);transition:transform .2s ease}.technical-view-toggle.enabled{border-color:rgba(119,94,169,.19);background:#f1edf8;color:#645478}.technical-view-toggle.enabled>i{background:#8773ad}.technical-view-toggle.enabled>i>b{transform:translateX(11px)}
.technical-method-badge{width:max-content;display:inline-flex!important;align-items:center;gap:3px;margin-top:5px;padding:3px 5px;border:1px solid;border-radius:99px;font:5px var(--mono)!important;font-weight:400!important;line-height:1!important;white-space:nowrap;overflow:visible!important}.technical-method-badge.method-llm{border-color:#cfc1e8;background:#f8f5fc;color:#766092}.technical-method-badge.method-rule{border-color:#d6d2d9;background:#f7f6f8;color:#716b76}.technical-method-badge svg{flex:none}
.technical-explanation{overflow:hidden;width:min(1040px,100%);margin:16px auto 0;padding:16px 18px;border:1px solid rgba(66,53,81,.08);border-radius:15px;background:rgba(255,255,255,.58);color:#8f8794}.technical-explanation>div{display:grid;grid-template-columns:1fr 1fr;gap:28px}.technical-explanation section{display:flex;flex-direction:column;gap:5px}.technical-explanation strong{color:#756d7b;font-size:7px;font-weight:600}.technical-explanation span{font:6px var(--mono);line-height:1.55}.technical-explanation>small{display:block;margin-top:12px;padding-top:10px;border-top:1px solid rgba(61,49,77,.07);font-size:6px}
.evidence-summary-item{display:inline-flex;align-items:center;gap:5px}.evidence-summary-item>.technical-method-badge{margin-top:0}.cross-check-row .technical-method-badge{margin-top:4px}.cross-evidence-summary small .technical-method-badge{margin:0 0 0 5px;vertical-align:middle}.technical-stage-note{overflow:hidden;margin:3px 0 0;color:#918798;font:5px var(--mono);line-height:1.45}
  .report-anchor-nav{top:8px;width:100%;justify-content:flex-start}.report-anchor-nav button{flex:1;padding-left:9px;padding-right:9px}.unified-score-cluster{width:100%;align-items:stretch;flex-direction:column}.report-confidence{width:165px}.report-confidence-popover{left:0}.analysis-process-progress{padding:13px 10px}.analysis-process-progress>div:first-child{gap:5px}.analysis-process-progress>div:first-child>div{grid-template-columns:20px 1fr;gap:5px}.analysis-process-progress>div:first-child>div>span{width:20px;height:20px}.analysis-process-progress>div:first-child>div>i{left:10px;top:9px}.analysis-process-progress strong{font-size:7px}.analysis-process-progress small{font-size:5px;line-height:1.35}.consistency-live-messages{padding-left:4px}
.team-workspace{min-height:100vh;background:radial-gradient(circle at 50% 0,rgba(231,224,247,.65),transparent 34%),#f8f6fa;color:#342d3c}.team-top-nav{height:66px;padding:0 clamp(22px,4vw,58px);border-bottom:1px solid var(--line);background:rgba(250,249,252,.82);backdrop-filter:blur(18px);display:flex;align-items:center;gap:12px}.team-brand{width:112px;padding:0;border:0;background:transparent}.team-brand img{width:100%;display:block}.team-top-nav>span{padding:5px 8px;border-radius:99px;background:#eee9f5;color:#746488;font:7px var(--mono)}.team-top-nav>button:last-child{margin-left:auto;padding:8px 11px;border:1px solid rgba(61,50,76,.1);border-radius:9px;background:#fff;color:#716977;font-size:8px}.team-example-badge{position:fixed;z-index:20;right:15px;bottom:15px;padding:6px 8px;border:1px solid rgba(74,59,95,.1);border-radius:99px;background:rgba(255,255,255,.88);color:#948d98;font:6px var(--mono);backdrop-filter:blur(12px)}.team-page{width:min(1240px,calc(100% - 48px));margin:0 auto;padding:45px 0 78px}.team-page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:30px}.team-page-heading>div:first-child>span{font:7px var(--mono);letter-spacing:.1em;color:#8c8392}.team-page-heading h1{margin:9px 0 6px;font:500 clamp(38px,4vw,54px)/1 var(--serif);letter-spacing:-.04em}.team-page-heading p{margin:0;color:#817a86;font-size:10px}.team-role-switch{padding:4px;border:1px solid rgba(61,49,77,.09);border-radius:11px;background:#eeeaf1;display:flex}.team-role-switch button{height:34px;padding:0 14px;border:0;border-radius:8px;background:transparent;color:#847d89;font-size:8px}.team-role-switch button.active{background:#fff;color:#3f3747;font-weight:600;box-shadow:0 4px 13px rgba(47,38,61,.08)}
.team-summary{margin-top:31px;padding:17px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:135px 135px 135px 1fr;gap:10px}.team-summary>div:not(.team-risk-distribution){padding:5px 18px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:4px}.team-summary>div>span{color:#8f8893;font-size:7px}.team-summary>div>strong{font:500 34px/1 var(--serif)}.team-risk-distribution{padding:3px 0 0 18px}.team-risk-distribution>header,.team-risk-distribution>footer{display:flex;align-items:center;justify-content:space-between}.team-risk-distribution>header span{font-size:8px;font-weight:500}.team-risk-distribution>header small{color:#99929d;font-size:6px}.team-risk-distribution>div{height:7px;margin:11px 0 7px;border-radius:99px;overflow:hidden;display:flex}.team-risk-distribution i{display:block;height:100%;cursor:help}.team-risk-distribution i.trusted{width:67.2%;background:#82a18e}.team-risk-distribution i.medium{width:25.8%;background:#c7995f}.team-risk-distribution i.high{width:7%;background:#a66f78}.team-risk-distribution>footer span{font-size:6px;color:#8e8792}
.team-filters{padding:17px 0;display:flex;flex-wrap:wrap;gap:13px 24px}.team-filters>div{display:flex;align-items:center;gap:8px}.team-filters>div>span{color:#8b8490;font-size:7px}.team-filters>div>div{display:flex;gap:3px}.team-filters button{height:28px;padding:0 9px;border:0;border-radius:7px;background:transparent;color:#817a87;font-size:7px}.team-filters button:hover{background:#f0ecf3}.team-filters button.active{background:#3b3346;color:#fff}.team-mobile-filter-toggle{display:none}.team-queue{position:relative;border-top:1px solid var(--line);background:rgba(255,255,255,.46)}.team-batch-bar{position:sticky;z-index:5;top:0;min-height:48px;padding:8px 13px;border-bottom:1px solid rgba(87,68,125,.12);background:rgba(244,240,249,.96);backdrop-filter:blur(12px);display:flex;align-items:center;gap:8px}.team-batch-bar strong{font-size:8px}.team-batch-bar span{flex:1}.team-batch-bar button{padding:7px 9px;border:1px solid rgba(61,49,77,.1);border-radius:7px;background:#fff;color:#716777;font-size:7px}.team-batch-bar button:last-child{border-color:#3a3344;background:#3a3344;color:#fff}.team-queue table{width:100%;border-collapse:collapse;table-layout:fixed}.team-queue th{height:40px;padding:0 8px;color:#938c98;font-size:6px;font-weight:400;text-align:left}.team-queue th:first-child{width:38px}.team-queue th:nth-child(2){width:22%}.team-queue th:nth-child(3){width:130px}.team-queue th:nth-child(4){width:125px}.team-queue th:nth-child(5){width:19%}.team-queue th:nth-child(6){width:17%}.team-queue th:nth-child(7){width:90px}.team-queue th button{padding:0;border:0;background:transparent;color:inherit;font:inherit}.team-queue tbody tr{border-top:1px solid rgba(57,48,69,.07);cursor:pointer;transition:background .2s ease}.team-queue tbody tr:hover,.team-queue tbody tr:focus{background:#f4f0f7;outline:none}.team-queue td{height:72px;padding:9px 8px;vertical-align:middle}.team-queue input{accent-color:#6f5c8b}.team-title-cell strong,.team-title-cell small{display:block}.team-title-cell strong{font:500 14px/1.35 var(--serif);color:#3d3544}.team-title-cell small{margin-top:5px;color:#9a939e;font-size:6px}.team-score-cell{display:grid;grid-template-columns:auto 1fr;gap:3px 6px;align-items:center}.team-score-cell>strong{grid-row:1/3;font:500 23px var(--mono);color:#3d3544}.team-score-cell>small{font-size:6px;color:#918995}.team-risk-pill{justify-self:start;padding:4px 6px;border-radius:99px;font-size:6px;white-space:nowrap}.team-risk-pill.risk-high{background:#f1dfe2;color:#8d5861}.team-risk-pill.risk-medium{background:#f4eadb;color:#896238}.team-risk-pill.risk-trusted{background:#e2eee7;color:#53735f}.team-dimensions-cell{display:flex;gap:5px}.team-dimensions-cell i{width:22px;height:22px;border-radius:50%;background:#eeecef;color:#aaa4ad;display:grid;place-items:center;font:6px var(--mono);font-style:normal;opacity:.55}.team-dimensions-cell i.active{opacity:1}.team-dimensions-cell i.active.dot-t{background:#ebe7ff;color:#7060a0}.team-dimensions-cell i.active.dot-r{background:#e6f0ff;color:#577890}.team-dimensions-cell i.active.dot-u{background:#f9e9e8;color:#a16e66}.team-dimensions-cell i.active.dot-s{background:#e8f3ed;color:#557c68}.team-contradiction-cell{color:#7c7581;font-size:7px;line-height:1.6}.team-action-cell>span{display:inline-block;padding:6px 7px;border-radius:7px;background:#eee9f4;color:#675776;font-size:6px;line-height:1.4}.team-status-cell>span{display:inline-block;padding:5px 7px;border-radius:99px;font-size:6px;white-space:nowrap}.team-status-cell .status-pending{background:#f3e3e4;color:#8c5c63}.team-status-cell .status-watching{background:#f5eadb;color:#8a663b}.team-status-cell .status-done{background:#e3eee7;color:#587361}.team-empty{padding:50px;text-align:center;color:#99929d;font-size:9px}
.team-drawer-backdrop{position:fixed;z-index:80;inset:0;border:0;background:rgba(35,29,44,.25);backdrop-filter:blur(3px)}.team-drawer{position:fixed;z-index:81;right:0;top:0;bottom:0;width:min(460px,92vw);padding:24px;overflow:auto;border-left:1px solid rgba(64,51,80,.1);background:#fbfafc;box-shadow:-25px 0 80px rgba(42,33,56,.18)}.team-drawer>header{display:flex;align-items:center;justify-content:space-between}.team-drawer>header>span{color:#897e91;font:6px var(--mono);letter-spacing:.08em}.team-drawer>header>button{width:31px;height:31px;padding:0;border:1px solid var(--line);border-radius:50%;background:#fff;color:#716a76;font-size:17px}.team-drawer>h2{margin:27px 0 5px;font:500 29px/1.25 var(--serif)}.team-drawer>p{margin:0;color:#98919c;font-size:8px}.team-drawer-score{margin-top:19px;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:9px}.team-drawer-score>strong{font:500 38px var(--mono)}.team-drawer-score>small{margin-left:auto;color:#847c89;font-size:7px}.team-drawer>section{padding:20px 0;border-bottom:1px solid var(--line)}.team-drawer>section>span{display:block;margin-bottom:12px;color:#8b8390;font:6px var(--mono);letter-spacing:.07em}.team-drawer>section>div{padding:11px;border-radius:10px;background:#f4f1f6;display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center}.team-drawer>section>div+div{margin-top:7px}.team-drawer>section>div strong{font-size:8px;font-weight:500}.team-drawer>section>div i{color:#a391b3;font-style:normal}.team-drawer>section>div p{margin:0;color:#766e7b;font-size:7px;line-height:1.5}.team-drawer-action>strong{font:500 19px/1.35 var(--serif);color:#473e4d}.team-drawer>footer{position:sticky;bottom:-24px;margin:28px -24px -24px;padding:16px 24px 24px;background:linear-gradient(180deg,rgba(251,250,252,0),#fbfafc 25%);display:grid;grid-template-columns:1fr 1fr;gap:8px}.team-drawer>footer button{height:41px;border:1px solid rgba(58,49,73,.11);border-radius:10px;background:#fff;color:#675f6c;font-size:8px}.team-drawer>footer button:last-child{border-color:#302a40;background:#302a40;color:#fff}.team-drawer>footer button:disabled{border-color:transparent;background:#e1ece5;color:#557160}
.team-page-heading h1{font-size:clamp(56px,5vw,62px);margin-bottom:14px}.team-page-heading p{font-size:13px}.team-risk-distribution>footer{align-items:flex-start;justify-content:flex-start}.team-risk-distribution>footer span{display:block;text-align:center;font-size:10px}.team-risk-distribution>footer span:nth-child(1){width:67.2%}.team-risk-distribution>footer span:nth-child(2){width:25.8%}.team-risk-distribution>footer span:nth-child(3){width:7%;min-width:58px}.team-queue th{font-size:11px}.team-queue tbody tr{height:80px}.team-queue td{height:80px;padding-top:8px;padding-bottom:8px;vertical-align:middle}.team-title-cell strong{font-size:15px}.team-title-cell small{font-size:11px}.team-score-cell{display:table-cell}.team-score-cell>div{display:grid;grid-template-columns:auto 1fr;gap:4px 7px;align-items:center}.team-score-cell>div>strong{grid-row:1/3;font:500 24px var(--mono);color:#3d3544}.team-score-cell>div>small{font-size:11px;color:#77707d}.team-risk-pill{padding:5px 8px;font-size:11px}.team-dimensions-cell{display:table-cell}.team-dimensions-cell>div{display:flex;align-items:center;gap:6px}.team-dimensions-cell i{width:25px;height:25px;border:1px solid #d8d3db;background:transparent;color:#99929c;font-size:9px;opacity:1}.team-dimensions-cell i.active{border-color:transparent;color:#fff;font-weight:700;box-shadow:0 3px 8px rgba(55,45,68,.1)}.team-dimensions-cell i.active.dot-t{background:#806bb3;color:#fff}.team-dimensions-cell i.active.dot-r{background:#6387a5;color:#fff}.team-dimensions-cell i.active.dot-u{background:#b87378;color:#fff}.team-dimensions-cell i.active.dot-s{background:#648a75;color:#fff}.team-contradiction-cell{font-size:12px;line-height:1.45}.team-action-cell>span{padding:6px 8px;font-size:12px;line-height:1.35}.team-status-cell>span{position:relative;padding:6px 9px;font-size:11px}.team-status-cell .status-pending{background:#eee8f6;color:#625078}.team-status-cell .status-watching{background:#eeecef;color:#77717b}.team-status-cell .status-watching::before{content:"";display:inline-block;width:5px;height:5px;margin-right:5px;border-radius:50%;background:#8f8992;vertical-align:1px}.team-status-cell .status-done{background:#e8eeea;color:#65736a}.team-status-cell .status-done::before{content:"✓";margin-right:5px;color:#5c7667;font-size:9px}
@media(max-width:720px){.team-top-nav{padding:0 15px}.team-page{width:calc(100% - 24px);padding-top:28px}.team-page-heading{align-items:flex-start;flex-direction:column}.team-role-switch{align-self:stretch}.team-role-switch button{flex:1}.team-summary{grid-template-columns:repeat(3,1fr)}.team-summary>div:not(.team-risk-distribution){padding:4px 8px}.team-summary>div>strong{font-size:27px}.team-risk-distribution{grid-column:1/4;padding:13px 0 0}.team-mobile-filter-toggle{width:100%;height:42px;margin-top:14px;padding:0 11px;border:1px solid var(--line);border-radius:9px;background:#fff;color:#665e6b;display:flex;justify-content:space-between;align-items:center;font-size:8px}.team-filters{display:none;padding:12px 0}.team-filters.open{display:flex;flex-direction:column}.team-filters>div{align-items:flex-start;flex-direction:column}.team-filters>div>div{width:100%;overflow-x:auto}.team-queue{margin-top:14px;background:transparent}.team-queue table,.team-queue tbody{display:block}.team-queue thead{display:none}.team-queue tbody tr{position:relative;margin-bottom:9px;padding:14px;border:1px solid rgba(59,48,73,.09);border-radius:14px;background:rgba(255,255,255,.72);display:grid;grid-template-columns:1fr auto;gap:10px}.team-queue td{height:auto;padding:0;display:block}.team-select-cell{position:absolute;right:13px;top:13px}.team-title-cell{padding-right:28px!important}.team-title-cell strong{font-size:17px}.team-score-cell{grid-column:2;grid-row:2/4}.team-dimensions-cell{grid-row:2}.team-contradiction-cell{grid-column:1/3;padding-top:9px!important;border-top:1px solid var(--line)}.team-action-cell{grid-column:1}.team-status-cell{grid-column:2;text-align:right}.team-batch-bar{border:1px solid rgba(87,68,125,.12);border-radius:11px;margin-bottom:9px}.team-drawer{left:0;right:0;top:auto;width:100%;height:min(78vh,680px);padding:20px;border-left:0;border-top:1px solid rgba(64,51,80,.1);border-radius:24px 24px 0 0}.team-drawer>footer{bottom:-20px;margin-left:-20px;margin-right:-20px;margin-bottom:-20px;padding-left:20px;padding-right:20px}.team-example-badge{bottom:72px}}
@media(max-width:720px){.team-page-heading h1{font-size:42px}}
.team-view-switch{width:fit-content;margin-top:30px;padding:4px;border:1px solid rgba(61,49,77,.09);border-radius:12px;background:#ebe7ef;display:flex;gap:3px}
.team-view-switch button{min-width:112px;height:36px;padding:0 16px;border:0;border-radius:9px;background:transparent;color:#817986;font-size:10px;transition:background .2s ease,color .2s ease,box-shadow .2s ease}
.team-view-switch button.active{background:#fff;color:#332c3b;font-weight:600;box-shadow:0 5px 16px rgba(47,38,61,.08)}
.team-summary{margin-top:18px;align-items:stretch}
.team-summary>div:not(.team-risk-distribution){justify-content:center}
.team-risk-distribution{display:flex;flex-direction:column}
.team-risk-distribution>.team-distribution-bar{height:7px;margin:11px 0 7px;border-radius:99px;overflow:hidden;display:flex}
.team-distribution-bar>i,.team-distribution-bar>button{display:block;height:100%;padding:0;border:0;border-radius:0}
.team-risk-bar .trusted{width:67.2%;background:#82a18e}.team-risk-bar .medium{width:25.8%;background:#c7995f}.team-risk-bar .high{width:7%;background:#a66f78}
.team-risk-distribution>.team-confidence-distribution{height:auto;margin:14px 0 0;padding-top:13px;border-top:1px solid rgba(63,52,77,.08);border-radius:0;overflow:visible;display:block}
.team-confidence-distribution>header{display:flex;align-items:center;justify-content:space-between}
.team-confidence-distribution>header span{font-size:8px;font-weight:500}.team-confidence-distribution>header small{color:#99929d;font-size:6px}
.team-confidence-distribution .team-distribution-bar{height:8px;margin:9px 0 7px;border-radius:99px;overflow:hidden;display:flex;background:#eeeaf3}
.team-confidence-bar .confidence-high{width:71.875%;background:#8f7caf}
.team-confidence-bar .confidence-medium{width:18.75%;background:#b8abd0}
.team-confidence-bar .confidence-low{width:9.375%;min-width:22px;background:#ded7e9;cursor:pointer;transition:filter .2s ease,box-shadow .2s ease}
.team-confidence-bar .confidence-low:hover,.team-confidence-bar .confidence-low:focus-visible,.team-confidence-bar .confidence-low.active{filter:saturate(1.35) brightness(.94);box-shadow:inset 0 0 0 2px #77658d;outline:none}
.team-distribution-labels{display:flex;align-items:flex-start;justify-content:flex-start}
.team-confidence-labels span,.team-confidence-labels button{display:block;padding:0;border:0;background:transparent;color:#8e8792;font-size:9px;text-align:center}
.team-confidence-labels span:nth-child(1){width:71.875%}.team-confidence-labels span:nth-child(2){width:18.75%}.team-confidence-labels button{width:9.375%;min-width:42px;cursor:pointer}.team-confidence-labels button.active{color:#665477;font-weight:700}
.team-confidence-distribution>small{display:block;margin-top:8px;color:#8e8495;font-size:8px}
.team-confidence-filter-chip{height:28px;padding:0 10px;border:1px solid rgba(112,89,153,.16)!important;border-radius:99px!important;background:#eee8f5!important;color:#67567c!important}
.team-related-groups{margin-top:18px;padding-top:22px;border-top:1px solid var(--line)}
.team-related-groups>header{display:flex;align-items:center;justify-content:space-between;gap:20px}
.team-related-groups>header p{margin:0;color:#817987;font-size:10px}
.team-related-groups>header>span,.team-related-card>header>span{padding:5px 7px;border-radius:99px;background:#eee9f4;color:#82748e;font:6px var(--mono)}
.team-related-groups>div{margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
.team-related-card{min-width:0;padding:23px;border:1px solid rgba(62,50,78,.1);border-radius:22px;background:rgba(255,255,255,.7);box-shadow:0 17px 52px rgba(55,44,73,.07);backdrop-filter:blur(18px)}
.team-related-card>header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.team-related-card>header small{color:#8e8495;font:6px var(--mono);letter-spacing:.08em}
.team-related-card h2{margin:7px 0 0;color:#382f40;font:500 23px/1.25 var(--serif);letter-spacing:-.025em}
.team-related-signals{margin-top:18px;display:flex;flex-wrap:wrap;gap:6px}
.team-related-signals span{padding:6px 8px;border-radius:99px;background:#eee9f5;color:#675978;font-size:7px}
.team-related-signals span:nth-child(2){background:#e8eff5;color:#5d7282}.team-related-signals span:nth-child(3){background:#e7f0eb;color:#607668}
.team-related-members{margin-top:18px;border-top:1px solid rgba(61,50,76,.08)}
.team-related-members>button{position:relative;width:100%;min-height:72px;padding:12px 4px;border:0;border-bottom:1px solid rgba(61,50,76,.07);background:transparent;display:grid;grid-template-columns:25px minmax(0,1fr) auto;gap:9px 11px;align-items:center;text-align:left;color:#4a424f;transition:background .2s ease,padding .2s ease}
.team-related-members>button:hover,.team-related-members>button:focus-visible{padding-left:9px;padding-right:9px;background:#f5f1f8;outline:none}
.team-related-members>button>span{color:#a097a3;font:7px var(--mono)}
.team-related-members>button>div{min-width:0}.team-related-members strong,.team-related-members small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.team-related-members strong{font-size:11px;font-weight:500}.team-related-members small{margin-top:5px;color:#918995;font-size:8px}
.team-related-members time{color:#938b97;font:7px var(--mono);white-space:nowrap}
.team-related-members em{grid-column:2;justify-self:start;margin-top:-8px;padding:4px 6px;border-radius:99px;background:#e4efe8;color:#557160;font-size:6px;font-style:normal}
.team-related-members b{position:absolute;right:5px;bottom:7px;color:#78678d;font-size:6px;font-weight:500;opacity:0;transition:opacity .2s ease}
.team-related-members>button:hover b,.team-related-members>button:focus-visible b{opacity:1}
.team-related-card>footer{margin-top:18px;display:flex;justify-content:flex-end;gap:8px}
.team-related-card>footer button{height:36px;padding:0 13px;border:1px solid rgba(58,49,73,.11);border-radius:9px;background:#fff;color:#6d6472;font-size:8px}
.team-related-card>footer button:last-child{border-color:#302a40;background:#302a40;color:#fff;box-shadow:0 8px 20px rgba(48,42,64,.14)}
  .team-related-groups>div{grid-template-columns:1fr}
  .team-view-switch{width:100%;margin-top:23px}.team-view-switch button{min-width:0;flex:1}
  .team-summary{margin-top:14px}.team-risk-distribution>.team-confidence-distribution{margin-top:12px}
  .team-confidence-labels span,.team-confidence-labels button{font-size:8px}
  .team-related-groups{margin-top:14px;padding-top:18px}.team-related-groups>header{align-items:flex-start;flex-direction:column;gap:9px}
  .team-related-card{padding:17px;border-radius:17px}.team-related-card h2{font-size:20px}
  .team-related-members>button{grid-template-columns:21px minmax(0,1fr)}.team-related-members time{grid-column:2}.team-related-members em{grid-column:2;margin-top:0}
.analysis-process-progress{max-width:790px;margin:0 auto 26px;padding:17px 18px;border:1px solid rgba(67,55,85,.09);border-radius:16px;background:rgba(255,255,255,.78);box-shadow:0 10px 32px rgba(52,42,70,.05)}.analysis-process-progress>div:first-child{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.analysis-process-progress>div:first-child>div{position:relative;display:grid;grid-template-columns:auto 1fr;gap:8px;align-items:center;color:#aaa4ae}.analysis-process-progress>div:first-child>div>span{position:relative;z-index:2;width:24px;height:24px;border:1px solid #d8d3dc;border-radius:50%;background:#f6f4f7;display:grid;place-items:center;font:7px var(--mono)}.analysis-process-progress>div:first-child>div>div{display:flex;flex-direction:column;gap:3px}.analysis-process-progress strong{font-size:8px;font-weight:400}.analysis-process-progress small{font-size:6px;color:#aaa4ae}.analysis-process-progress>div:first-child>div>i{position:absolute;z-index:0;left:12px;right:calc(-50% + 1px);top:11px;height:2px;background:#e5e1e7;overflow:hidden}.analysis-process-progress>div:first-child>div>i>b{display:block;width:0;height:100%;background:#8271a3;transition:width .55s ease}.analysis-process-progress>div:first-child>div.completed{color:#587763}.analysis-process-progress>div:first-child>div.completed>span{border-color:#c8dfd1;background:#e3f0e8;color:#547762}.analysis-process-progress>div:first-child>div.completed>i>b{width:100%;background:#83a590}.analysis-process-progress>div:first-child>div.active{color:#413849}.analysis-process-progress>div:first-child>div.active>span{border-color:#756292;background:#756292;color:#fff;box-shadow:0 0 0 5px rgba(117,98,146,.1)}.analysis-process-progress>div:first-child>div.active strong{font-weight:700}.consistency-live-messages{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:5px;overflow:hidden}.consistency-live-messages small{opacity:0;color:#766d7b;font:7px var(--mono);animation:consistency-message-in .45s ease forwards}.consistency-live-messages small::before{content:"";display:inline-block;width:5px;height:5px;margin-right:7px;border-radius:50%;background:#9a86bb;box-shadow:0 0 0 3px rgba(154,134,187,.1)}@keyframes consistency-message-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
@media (max-width:640px){.analysis-process-progress{padding:13px 10px}.analysis-process-progress>div:first-child{gap:5px}.analysis-process-progress>div:first-child>div{grid-template-columns:20px 1fr;gap:5px}.analysis-process-progress>div:first-child>div>span{width:20px;height:20px}.analysis-process-progress>div:first-child>div>i{left:10px;top:9px}.analysis-process-progress strong{font-size:7px}.analysis-process-progress small{font-size:5px;line-height:1.35}.consistency-live-messages{padding-left:4px}.technical-stage-note{font-size:4.5px}.technical-explanation>div{grid-template-columns:1fr;gap:12px}}
.team-use-demo { padding-top: 36px; display: flex; flex-direction: column; }
.team-use-demo>div { flex: 1; min-height: 48px; border-bottom: 1px solid rgba(123, 107, 176, .11); display: grid; grid-template-columns: 42px 1fr auto; gap: 10px; align-items: center; }
.team-use-demo>div:last-child { border-bottom: 0; }
.team-use-demo>div>strong { color: #403848; font: 500 20px var(--serif); }
.team-use-demo>div>span { justify-self: start; padding: 5px 7px; border-radius: 999px; font-size: 6px; }
.team-use-demo .risk-high { background: rgba(201,139,147,.17); color: #98636b; }
.team-use-demo .risk-medium { background: rgba(217,183,107,.18); color: #92743c; }
.team-use-demo .risk-trusted { background: rgba(127,163,139,.17); color: #5f806c; }
.team-use-demo>div>small { padding: 5px 7px; border: 1px solid rgba(71,61,82,.1); border-radius: 6px; background: rgba(255,255,255,.7); color: #77707d; font-size: 6px; }
.landing-team-entry{height:36px;padding:0 13px;border:1px solid rgba(47,42,64,.14);border-radius:99px;background:rgba(255,255,255,.48);color:#514a5c;font-size:9px;transition:background .2s ease,border-color .2s ease}.landing-team-entry:hover{border-color:rgba(102,82,143,.32);background:#fff}

/* Frontend teammate additions: cross-check and decision support */
.decision-card{margin-top:34px;padding:28px;border-radius:19px;border:1px solid var(--line);display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;background:linear-gradient(120deg,#f6f2fd,#faf6f5)}.decision-icon{width:48px;height:48px;border-radius:15px;background:#fff;color:#7569a0;display:grid;place-items:center;box-shadow:0 8px 25px rgba(59,47,91,.09)}.decision-card span{font:8px var(--mono);color:#898290}.decision-card h3{font:500 22px var(--serif);margin:5px 0 8px}.decision-card p{font-size:9px;line-height:1.75;color:#746d7a;margin:0}.decision-card button{border:0;border-radius:10px;background:#302c3d;color:#fff;padding:11px 13px;font-size:9px;display:flex;align-items:center;gap:8px;white-space:nowrap}.method-note{text-align:center;font-size:7px;color:#aaa5ad;margin-top:24px}
.cross-check-preview{--preview-progress:0;min-height:31px;padding:5px 7px;border:1px solid rgba(67,55,83,.09);border-radius:9px;background:rgba(255,255,255,.9);display:grid;grid-template-columns:39px minmax(0,1fr) 10px minmax(0,1fr);gap:5px;align-items:center;color:#6f6875;opacity:var(--preview-progress);transform:translateY(calc((1 - var(--preview-progress)) * 7px));box-shadow:0 7px 18px rgba(53,42,72,.05)}
.cross-check-preview>em{padding:4px 5px;border-radius:99px;background:#f3e0e3;color:#92535c;font:6px var(--mono);font-style:normal;text-align:center}.cross-check-preview.preview-doubtful>em{background:#f5e8d8;color:#8a6239}.cross-check-preview>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:6px}.cross-check-preview>i{color:#aaa3ad;font-size:6px;font-style:normal;text-align:center}.merge-cross-checks>small{position:absolute;right:2px;top:-18px;color:#aaa3ad;font:5px var(--mono);letter-spacing:.05em}
.report-anchor-nav{position:sticky;z-index:30;top:12px;width:max-content;max-width:100%;margin:16px auto 0;padding:4px;border:1px solid rgba(68,55,86,.09);border-radius:99px;background:rgba(249,247,251,.88);box-shadow:0 8px 25px rgba(49,39,66,.07);backdrop-filter:blur(16px);display:flex;overflow-x:auto;scrollbar-width:none}.report-anchor-nav::-webkit-scrollbar{display:none}.report-anchor-nav button{flex:none;padding:8px 12px;border:0;border-radius:99px;background:transparent;color:#8d8692;font-size:7px;white-space:nowrap;transition:background .2s ease,color .2s ease}.report-anchor-nav button.active{background:#3b3346;color:#fff}
.unified-score-cluster{display:flex;align-items:center;gap:11px}.unified-score>em{margin-top:9px;color:#8f8794;font:7px var(--mono);font-style:normal}.unified-score>p{margin:5px 0 0;color:#9a626b;font-size:7px}.report-confidence-wrap{position:relative}.report-confidence{min-width:116px;padding:11px 12px;border:1px solid rgba(64,52,80,.09);border-radius:14px;background:#faf9fb;display:grid;grid-template-columns:1fr auto;gap:5px 10px;text-align:left}.report-confidence>span{color:#8b8490;font-size:7px}.report-confidence>strong{font:600 13px var(--mono)}.report-confidence>i{grid-column:1/3;display:grid;grid-template-columns:repeat(3,1fr);gap:3px}.report-confidence>i b{height:4px;border-radius:99px;background:#e4e0e6}.report-confidence>i b.filled{background:#7d9c89}.report-confidence.confidence-medium>i b.filled{background:#c3955a}.report-confidence.confidence-low>i b.filled{background:#a66e77}.report-confidence.confidence-high>strong{color:#5f806c}.report-confidence.confidence-medium>strong{color:#9b703e}.report-confidence.confidence-low>strong{color:#945e67}.report-confidence-popover{position:absolute;z-index:40;left:0;top:calc(100% + 8px);width:230px;padding:13px;border:1px solid rgba(61,49,77,.1);border-radius:13px;background:rgba(255,255,255,.97);box-shadow:0 18px 50px rgba(45,35,59,.14);display:grid;gap:9px}.report-confidence-popover>strong{padding-bottom:8px;border-bottom:1px solid var(--line);font-size:9px;font-weight:600}.report-confidence-popover>span{display:flex;justify-content:space-between;gap:12px;color:#88808d;font-size:7px}.report-confidence-popover b{color:#4d4454;font-weight:500;text-align:right}
.decision-support{padding:28px 0 0;scroll-margin-top:78px}.decision-support>header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.decision-support>header>div>span{font:8px var(--mono);letter-spacing:.09em;color:#77707d}.decision-support>header h3{margin:7px 0 0;font:500 22px/1.2 var(--serif);color:#302a39}.decision-support>header p{margin:9px 0 0;font:500 25px/1.25 var(--serif);color:#302a39}.decision-tier-panel>span{font:600 11px var(--mono);letter-spacing:.07em;color:#50475a}.decision-support>header>small{color:#aaa3ad;font:7px var(--mono);letter-spacing:.06em}
.decision-support-layout{margin-top:24px;padding:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:minmax(225px,.27fr) minmax(0,.73fr);gap:30px}.decision-tier-panel{padding-right:26px;border-right:1px solid var(--line)}.decision-tier-panel>div{position:relative;margin-top:15px;display:flex;flex-direction:column}.decision-tier-panel>div::before{content:"";position:absolute;left:8px;top:20px;bottom:20px;width:1px;background:#ded9e1}.decision-tier{position:relative;z-index:1;width:100%;min-height:50px;padding:8px 8px 8px 0;border:0;border-radius:9px;background:transparent;display:grid;grid-template-columns:18px 23px 1fr auto;align-items:center;text-align:left;color:#a09aa3;transition:background .2s ease,color .2s ease}.decision-tier>i{width:8px;height:8px;border:2px solid currentColor;border-radius:50%;background:#fff}.decision-tier>b{font:10px var(--mono);font-weight:400}.decision-tier>strong{font-size:11px;font-weight:400;letter-spacing:.01em}.decision-tier>small{font:8px var(--mono);color:#aaa4ae}.decision-tier.active{font-weight:600}.decision-tier.active>i{border-color:transparent;background:currentColor;box-shadow:0 0 0 3px rgba(255,255,255,.9)}.decision-tier.active>strong{font-weight:600}.decision-tier.tier-pass{color:#6f8f7c}.decision-tier.tier-pass.active{background:#edf4f0}.decision-tier.tier-verify{color:#ad824f}.decision-tier.tier-verify.active{background:#f7f0e5}.decision-tier.tier-review{color:#a37078}.decision-tier.tier-review.active{background:#f5e9eb}
.limited-material .decision-tier.provisional{background:transparent;outline:1px dashed currentColor;outline-offset:-3px}.limited-material .decision-tier.provisional>i{border-style:dashed;border-color:currentColor;background:#fff;box-shadow:none}.limited-material .decision-tier.provisional>strong{font-size:10px}.decision-recommendations{min-width:0}.decision-perspectives{display:flex;align-items:center;gap:30px;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}.decision-perspectives::-webkit-scrollbar{display:none}.decision-perspectives button{position:relative;flex:none;padding:2px 0 13px;border:0;background:transparent;color:#77707c;font-size:12px;font-weight:500;white-space:nowrap}.decision-perspectives button::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;border-radius:2px;background:#79649e;transform:scaleX(0);transition:transform .2s ease}.decision-perspectives button.active{color:#352d3d;font-weight:700}.decision-perspectives button.active::after{transform:scaleX(1)}
.decision-advice-list{min-height:174px}.decision-advice-row{min-height:58px;padding:11px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:35px 22px minmax(0,1fr) auto;gap:9px;align-items:center}.decision-advice-row:last-child{border-bottom:0}.decision-advice-row>span{padding:4px 5px;border-radius:4px;background:#efedf0;color:#817a84;font:6px var(--mono);text-align:center}.decision-advice-row>span.important{background:#40364d;color:#fff}.decision-advice-row>b{color:#aaa3ad;font:7px var(--mono);font-weight:400}.decision-advice-row>div{min-width:0}.decision-advice-row>div strong{display:block;color:#443d49;font-size:9px;font-weight:500;line-height:1.55}.decision-advice-row>div small{display:block;margin-top:4px;color:#98919c;font-size:7px;line-height:1.45}.decision-advice-row>button{padding:4px 0;border:0;background:transparent;color:#736286;font-size:7px;white-space:nowrap;transition:transform .2s ease,color .2s ease}.decision-advice-row>button:hover{color:#493958;transform:translateX(2px)}
.decision-support>footer{padding-top:17px;display:flex;align-items:center;justify-content:space-between;gap:20px}.decision-support>footer>small{color:#958e99;font-size:7px}.decision-support>footer>button{padding:11px 14px;border:0;border-radius:11px;background:#302a40;color:#fff;display:flex;align-items:center;gap:8px;font-size:9px}
.cross-check-section h4{font-size:18px}
.cross-check-layout{margin-top:24px;display:grid;grid-template-columns:minmax(310px,.85fr) minmax(420px,1.15fr);gap:28px;align-items:center}.cross-check-graph{padding:12px;border:1px solid rgba(69,55,91,.07);border-radius:20px;background:linear-gradient(145deg,rgba(249,247,252,.9),rgba(245,242,248,.5));text-align:center}.cross-check-graph svg{width:100%;display:block;overflow:visible}.cross-check-graph>small{color:#9a929f;font-size:6px}
.cross-check-list{display:flex;flex-direction:column;gap:7px}.cross-check-row{width:100%;min-height:54px;padding:9px 10px;border:1px solid rgba(67,55,83,.08);border-radius:13px;background:rgba(255,255,255,.74);display:grid;grid-template-columns:72px 1fr auto 18px;gap:10px;align-items:center;text-align:left;color:#4c4452;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.cross-check-row:hover,.cross-check-row:focus-visible{transform:translateX(4px);border-color:rgba(116,96,157,.24);box-shadow:0 8px 22px rgba(55,43,70,.07);outline:none}.cross-check-row.state-unverified{border-style:dashed;background:#f7f6f8;color:#817b84}.cross-check-row.state-unverified .cross-pair{filter:grayscale(1);opacity:.65}.cross-pair{display:flex;align-items:center;gap:5px}.cross-pair b{width:23px;height:23px;border-radius:7px;background:#eee9f6;display:grid;place-items:center;font:8px var(--mono)}.cross-pair i{color:#aaa2ae;font-size:8px;font-style:normal}.cross-check-row>span:nth-child(2){min-width:0}.cross-check-row>span:nth-child(2) small,.cross-check-row>span:nth-child(2) strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cross-check-row>span:nth-child(2) small{color:#928a96;font-size:6px}.cross-check-row>span:nth-child(2) strong{margin-top:4px;font-size:8px;font-weight:500}.cross-check-row>em,.cross-state-pill{padding:5px 7px;border-radius:99px;font-size:6px;font-style:normal;white-space:nowrap}.state-conflict>em,.cross-state-pill.state-conflict{background:#f3e0e3;color:#92535c}.state-consistent>em,.cross-state-pill.state-consistent{background:#e8eeea;color:#60756a}.state-corroborated>em,.cross-state-pill.state-corroborated{background:#e2f0e9;color:#4d785f}.state-doubtful>em,.cross-state-pill.state-doubtful{background:#f5e8d8;color:#8a6239}.state-unverified>em,.cross-state-pill.state-unverified{background:#e9e7eb;color:#77717b}.cross-arrow{color:#918798;font-style:normal}.cross-check-note{display:block;margin-top:12px;text-align:right;color:#aaa3ad;font:6px var(--mono)}
.cross-check-row>em{justify-self:end}
.technical-method-badge{width:max-content;display:inline-flex!important;align-items:center;gap:3px;margin-top:5px;padding:3px 5px;border:1px solid;border-radius:99px;font:5px var(--mono)!important;font-weight:400!important;line-height:1!important;white-space:nowrap;overflow:visible!important}.technical-method-badge.method-llm{border-color:#cfc1e8;background:#f8f5fc;color:#766092}.technical-method-badge.method-rule{border-color:#d6d2d9;background:#f7f6f8;color:#716b76}.technical-method-badge svg{flex:none}
.technical-capability{overflow:hidden;margin:5px 0 0;color:#99919d;font:6px var(--mono);line-height:1.45}
.evidence-summary-item{display:inline-flex;align-items:center;gap:5px}.evidence-summary-item>.technical-method-badge{margin-top:0}.cross-check-row .technical-method-badge{margin-top:4px}.cross-evidence-summary small .technical-method-badge{margin:0 0 0 5px;vertical-align:middle}.technical-stage-note{overflow:hidden;margin:3px 0 0;color:#918798;font:5px var(--mono);line-height:1.45}
.cross-check-source-label{display:inline-flex!important;width:max-content;margin-top:5px;padding:4px 6px;border-radius:99px;background:#ebe5f4;color:#68577c;font:6px var(--mono)!important;font-weight:400!important}
@media (max-width:640px){
  .decision-support-layout{grid-template-columns:1fr;gap:20px}.decision-tier-panel{padding:0;border-right:0}.decision-tier-panel>div{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}.decision-tier-panel>div::before{left:7%;right:7%;top:10px;bottom:auto;width:auto;height:2px}.decision-tier{min-width:0;padding:0 5px 9px;grid-template-columns:1fr;grid-template-rows:22px auto auto;justify-items:center;text-align:center;gap:4px}.decision-tier>i{grid-row:1}.decision-tier>b{display:none}.decision-tier>strong{font-size:10px}.decision-tier>small{font-size:8px}.decision-perspectives{overflow-x:auto}.decision-advice-list{min-height:0}
  .cross-check-section>header{flex-direction:column}.cross-check-summary{white-space:normal;flex-wrap:wrap}.cross-check-layout{grid-template-columns:1fr}.cross-check-graph{max-width:520px;margin:auto}
  .unified-score-row{align-items:flex-start;gap:12px}.unified-score{width:165px}.unified-score>strong{font-size:43px}.unified-verdict-group{max-width:145px}.cross-check-row{grid-template-columns:62px 1fr auto}.cross-check-row>em{grid-column:2}.cross-arrow{grid-column:3;grid-row:1/3}.cross-evidence-columns{grid-template-columns:1fr;margin-left:14px;margin-right:14px}.cross-evidence-summary{margin-left:14px;margin-right:14px}
  .decision-support>header h3{font-size:21px}.decision-advice-row{grid-template-columns:34px 18px 1fr}.decision-advice-row>button{grid-column:3;justify-self:start}.decision-support>footer{align-items:flex-start;flex-direction:column}.decision-support>footer>button{align-self:stretch;justify-content:center}
  .report-anchor-nav{top:8px;width:100%;justify-content:flex-start}.report-anchor-nav button{flex:1;padding-left:9px;padding-right:9px}.unified-score-cluster{width:100%;align-items:stretch;flex-direction:column}.report-confidence{width:165px}.report-confidence-popover{left:0}.analysis-process-progress{padding:13px 10px}.analysis-process-progress>div:first-child{gap:5px}.analysis-process-progress>div:first-child>div{grid-template-columns:20px 1fr;gap:5px}.analysis-process-progress>div:first-child>div>span{width:20px;height:20px}.analysis-process-progress>div:first-child>div>i{left:10px;top:9px}.analysis-process-progress strong{font-size:7px}.analysis-process-progress small{font-size:5px;line-height:1.35}.consistency-live-messages{padding-left:4px}
}
.decision-mock { position: relative; }
.decision-ladder-mock { position: absolute; left: 5%; top: 13%; bottom: 13%; width: 30%; display: flex; flex-direction: column; justify-content: center; gap: 15px; }
.decision-ladder-mock::before { content: ""; position: absolute; left: 17px; top: 19%; bottom: 19%; width: 2px; background: rgba(75,64,88,.12); }
.decision-ladder-mock>span { position: relative; min-height: 76px; padding: 0 18px 0 48px; border: 1px solid rgba(70,58,87,.1); border-radius: 18px; background: rgba(255,255,255,.76); display: flex; align-items: center; color: #6b6471; font-size: 12px; box-shadow: 0 12px 34px rgba(58,45,76,.07); }
.decision-ladder-mock>span>i { position: absolute; z-index: 2; left: 11px; width: 14px; height: 14px; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 2px currentColor; }
.decision-ladder-mock .ladder-pass { color: #648471; }
.decision-ladder-mock .ladder-verify { color: #a27c42; }
.decision-ladder-mock .ladder-review { color: #98666e; }
.decision-ladder-mock>span.active { transform: translateX(13px); box-shadow: 0 18px 46px rgba(135,101,47,.15); }
.decision-advice-mock { position: absolute; right: 4%; top: 17%; width: 35%; min-height: 66%; padding: 28px; border: 1px solid rgba(75,61,92,.11); border-radius: 24px; background: rgba(255,255,255,.78); box-shadow: 0 20px 55px rgba(58,45,76,.09); }
.decision-role-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.decision-role-tags span { padding: 7px 9px; border: 1px solid rgba(76,63,92,.1); border-radius: 999px; background: rgba(245,242,248,.84); color: #7c7482; font-size: 8px; }
.decision-role-tags span.active { border-color: #302a40; background: #302a40; color: #fff; }
.decision-blurred-lines { margin-top: 31px; display: flex; flex-direction: column; gap: 17px; }
.decision-blurred-lines i { height: 13px; border-radius: 99px; background: rgba(76,65,89,.12); }
.decision-blurred-lines i:nth-child(2) { width: 86%; }
.decision-blurred-lines i:nth-child(3) { width: 68%; }
.decision-blurred-lines i:nth-child(4) { width: 78%; }
  .decision-ladder-mock { left: 1%; width: 38%; }
  .decision-advice-mock { right: 1%; width: 40%; padding: 20px; }

/* Frontend teammate additions: creator self-check */
.creator-workspace{overflow-y:auto}.creator-workspace::before{position:fixed}.creator-self-check{position:relative;z-index:2;width:min(820px,calc(100% - 40px));margin:0 auto;padding:38px 0 72px}.creator-self-check>header{text-align:center}.creator-self-check>header>span{display:inline-flex;align-items:center;gap:7px;color:#7b6b94;font:7px var(--mono);letter-spacing:.09em}.creator-self-check>header h2{margin:11px 0 0;font:500 clamp(31px,3.5vw,44px)/1.1 var(--serif);letter-spacing:-.035em;color:#302a39}.creator-self-check>header p{margin:11px 0 0;color:#7c7582;font-size:11px}
.creator-form{margin-top:27px;padding:22px;border:1px solid rgba(57,47,72,.11);border-radius:22px;background:rgba(255,255,255,.78);box-shadow:0 20px 65px rgba(58,46,78,.09);backdrop-filter:blur(22px);text-align:left}.creator-draft-field{position:relative;display:block}.creator-draft-field>span,.creator-field-label>span,.creator-category>span{display:block;margin-bottom:8px;color:#514957;font-size:10px;font-weight:600}.creator-draft-field textarea{width:100%;min-height:150px;padding:14px 15px 27px;border:1px solid rgba(57,47,72,.1);border-radius:14px;background:#fbfafc;color:#3f3846;font:11px/1.8 "Noto Sans SC",sans-serif;resize:vertical;outline:none;transition:border-color .2s ease,box-shadow .2s ease}.creator-draft-field textarea:focus{border-color:rgba(118,96,163,.4);box-shadow:0 0 0 3px rgba(118,96,163,.08)}.creator-draft-field textarea::placeholder{color:#aaa4ae}.creator-draft-field>small{position:absolute;right:12px;bottom:10px;color:#aaa3ad;font:6px var(--mono)}
.creator-upload-field{margin-top:18px}.creator-field-label{display:flex;align-items:center;justify-content:space-between}.creator-field-label>small{color:#a29ba6;font:7px var(--mono)}.creator-dropzone{width:100%;min-height:82px;padding:14px;border:1px dashed rgba(100,83,137,.28);border-radius:14px;background:rgba(246,243,249,.72);color:#756488;display:flex;align-items:center;justify-content:center;gap:12px;text-align:left;transition:border-color .2s ease,background .2s ease,transform .2s ease}.creator-dropzone:hover,.creator-dropzone.dragging{border-color:#8b75b4;background:#f0ebf7;transform:translateY(-1px)}.creator-dropzone:disabled{opacity:.48;cursor:not-allowed;transform:none}.creator-dropzone>span{display:flex;flex-direction:column;gap:4px}.creator-dropzone strong{font-size:9px;font-weight:500;color:#554a61}.creator-dropzone small{color:#958c9b;font-size:7px}.creator-image-grid{margin-top:10px;display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.creator-image-grid figure{position:relative;aspect-ratio:1;margin:0;overflow:hidden;border:1px solid rgba(58,48,71,.1);border-radius:11px;background:#eeeaf1}.creator-image-grid img{width:100%;height:100%;object-fit:cover;display:block}.creator-image-grid figcaption{position:absolute;left:5px;bottom:5px;padding:4px 5px;border-radius:6px;background:rgba(38,31,47,.7);color:#fff;font-size:6px;backdrop-filter:blur(8px)}.creator-image-grid figure>button{position:absolute;right:5px;top:5px;width:20px;height:20px;padding:0;border:0;border-radius:50%;background:rgba(38,31,47,.7);color:#fff;display:grid;place-items:center;font-size:12px}
.creator-options{margin-top:18px;padding-top:18px;border-top:1px solid var(--line);display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.creator-switch{display:flex;align-items:center;gap:9px;color:#554e5b;font-size:9px}.creator-switch>button{width:36px;height:20px;padding:2px;border:0;border-radius:99px;background:#dcd8df;transition:background .2s ease}.creator-switch>button i{display:block;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(46,37,58,.18);transition:transform .2s ease}.creator-switch>button.active{background:#7e6aa2}.creator-switch>button.active i{transform:translateX(16px)}.creator-category{display:flex;align-items:center;gap:9px}.creator-category>span{margin:0}.creator-category select{height:34px;min-width:112px;padding:0 28px 0 11px;border:1px solid rgba(58,49,73,.11);border-radius:9px;background:#faf9fb;color:#5f5765;font-size:8px;outline:none}.creator-category select:focus{border-color:rgba(118,96,163,.42)}
.creator-form-actions{margin-top:20px;display:flex;align-items:center;justify-content:space-between;gap:12px}.creator-form-actions button{height:40px;padding:0 14px;border-radius:11px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:9px}.creator-example-button{border:1px solid rgba(70,57,87,.11);background:#fff;color:#706577}.creator-example-button:hover{background:#f5f1f8}.creator-submit-button{min-width:136px;border:0;background:#302a40;color:#fff;box-shadow:0 9px 25px rgba(48,42,64,.17)}.creator-submit-button:disabled{opacity:.35;cursor:not-allowed;box-shadow:none}.creator-dimensions-note{margin:14px 0 0;padding-top:13px;border-top:1px solid var(--line);color:#96909a;font-size:7px;line-height:1.65}.creator-dimensions-note span{color:#665776;font-weight:600}
  .workspace-header{height:104px;align-items:flex-start;padding-top:13px}.workspace-mode-switch{top:56px;width:calc(100% - 24px)}.workspace-mode-switch button{padding:0 7px;font-size:8px}.creator-workspace{height:calc(100vh - 62px)}.creator-self-check{width:calc(100% - 24px);padding:28px 0 85px}.creator-self-check>header h2{font-size:30px}.creator-self-check>header p{font-size:10px;line-height:1.65}.creator-form{padding:15px;border-radius:18px}.creator-draft-field textarea{min-height:170px}.creator-image-grid{grid-template-columns:repeat(3,1fr)}.creator-options{align-items:stretch;flex-direction:column}.creator-category{justify-content:space-between}.creator-category select{flex:1}.creator-form-actions{align-items:stretch;flex-direction:column-reverse}.creator-form-actions button{width:100%}.creator-dimensions-note{text-align:center}
.creator-result{background:#f8f6fa}.creator-report-page{flex:1;overflow:auto;background:radial-gradient(circle at 50% 0,rgba(236,230,248,.75),transparent 38%),#f8f6fa}.creator-report-sheet{width:min(1080px,calc(100% - 64px));margin:34px auto 80px;padding:32px;border:1px solid rgba(255,255,255,.9);border-radius:30px;background:rgba(255,255,255,.82);box-shadow:0 30px 90px rgba(60,47,87,.1);backdrop-filter:blur(24px);overflow:visible}
.creator-report-hero{position:relative;padding-bottom:26px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px 26px;align-items:center}.creator-report-hero>div:first-child{min-width:0}.creator-report-hero>div:first-child>span,.creator-copy-panel>header>span,.creator-issues-panel>header>span,.creator-image-review>header span,.creator-report-extras header>span{font:7px var(--mono);letter-spacing:.1em;color:#887f90}.creator-report-hero h1{margin:7px 0 8px;font:500 clamp(52px,5.3vw,60px)/1 var(--serif);letter-spacing:-.045em;white-space:nowrap}.creator-report-hero h1.state-ready{color:#628471}.creator-report-hero h1.state-revise{color:#a97941}.creator-report-hero h1.state-hold{color:#9b666e}.creator-report-hero p{margin:0;color:#77707d;font-size:9px}.creator-report-hero p strong{color:#403845;font:500 12px var(--mono)}.creator-report-hero>small{grid-column:1/3;color:#99929d;font-size:7px}.creator-report-hero>em{position:absolute;right:0;top:0;padding:5px 7px;border-radius:99px;background:#efebf4;color:#776987;font:6px var(--mono);font-style:normal}
.creator-report-hero h1{font-size:clamp(44px,4.6vw,52px)}.creator-report-hero p{font-size:13px;line-height:1.5}.creator-report-hero p strong{font-size:15px}
.creator-report-scores{display:flex;gap:8px;max-width:100%}.creator-report-scores>div{width:145px;min-width:0;padding:11px 12px;border:1px solid rgba(65,53,81,.09);border-radius:13px;background:rgba(250,248,252,.8);display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center}.creator-report-scores>div>span{width:27px;height:27px;border-radius:8px;display:grid;place-items:center;font:8px var(--mono)}.creator-report-scores .badge-t{background:#ebe7ff;color:#7060a0}.creator-report-scores .badge-r{background:#e6f0ff;color:#577890}.creator-report-scores .badge-u{background:#f9e9e8;color:#a16e66}.creator-report-scores .badge-s{background:#e8f3ed;color:#557c68}.creator-report-scores small{min-width:0;color:#77707d;font-size:7px;line-height:1.35}.creator-report-scores small b,.creator-report-scores small em{display:block;font:inherit}.creator-report-scores small b{font-weight:400;white-space:nowrap}.creator-report-scores small em{margin-top:2px;color:#9b929f;font-size:6px;font-style:normal;white-space:nowrap}.creator-report-scores strong{font:500 24px var(--serif);color:#38303f}
.creator-badge-hint{margin:18px 0 0;padding:11px 13px;border:1px solid rgba(164,120,68,.12);border-radius:11px;background:#faf5ed;color:#8a7358;font-size:8px;text-align:center}.creator-badge-hint strong{color:#9a6830;font:600 11px var(--mono)}.creator-recheck-state{margin-top:18px;padding:14px 16px;border:1px solid rgba(105,85,144,.12);border-radius:14px;background:#f7f3fb;display:grid;grid-template-columns:1fr 1fr;gap:12px}.creator-recheck-state>span{display:grid;grid-template-columns:auto 1fr;gap:3px 10px;align-items:center}.creator-recheck-state i{position:relative;grid-row:1/3;width:38px;height:38px;border-radius:12px;background:#fff;color:#6e5e83;display:grid;place-items:center;font:8px var(--mono);font-style:normal}.creator-recheck-state i::after{content:"";position:absolute;inset:-3px;border:2px solid rgba(120,99,155,.15);border-top-color:#806da0;border-radius:14px;animation:creator-expert-turn 1.2s ease-in-out 1}.creator-recheck-state i.expert-r{background:#fbf2f1;color:#8d676c}.creator-recheck-state i.expert-r::after{border-color:rgba(170,111,118,.14);border-top-color:#aa7279;animation-delay:.15s}.creator-recheck-state b{font-size:9px;font-weight:500;color:#4e4654}.creator-recheck-state small{font-size:7px;color:#958e9a}
.creator-badge-area{margin-top:18px;padding:16px;border:1px solid rgba(112,89,153,.12);border-radius:16px;background:linear-gradient(120deg,rgba(247,243,252,.88),rgba(252,250,253,.82));display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center}.creator-badge-area>div:first-child>small{display:block;margin-top:7px;color:#9a939f;font-size:6px}.creator-selfcheck-badge{padding:15px 17px;border:1px solid #cdbfe3;border-radius:16px;background:#faf8fd;display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;box-shadow:0 10px 28px rgba(71,53,98,.06)}.creator-selfcheck-badge>svg{width:54px;height:54px}.creator-selfcheck-badge .trulens-mark-dot.dot-1{fill:#cfc3ea}.creator-selfcheck-badge .trulens-mark-dot.dot-2{fill:#c5d9ec}.creator-selfcheck-badge .trulens-mark-dot.dot-3{fill:#eccfd2}.creator-selfcheck-badge .trulens-mark-dot.dot-4{fill:#c8dfd2}.creator-selfcheck-badge>div:nth-child(2){display:flex;flex-direction:column;gap:4px}.creator-selfcheck-badge>div:nth-child(2)>span{color:#8b8193;font:6px var(--mono);letter-spacing:.08em}.creator-selfcheck-badge>div:nth-child(2)>strong{color:#3d3545;font:600 13px "Noto Sans SC",sans-serif}.creator-selfcheck-badge>div:nth-child(2)>small{color:#668072;font-size:7px}.creator-selfcheck-badge>div:last-child{display:flex;gap:7px}.creator-selfcheck-badge>div:last-child>span{min-width:100px;padding:8px;border-left:1px solid rgba(75,61,92,.08);color:#77707d;font-size:6px}.creator-selfcheck-badge>div:last-child i{display:inline-grid;width:20px;height:20px;margin-right:6px;border-radius:6px;background:#e8f3ed;color:#557c68;place-items:center;font:7px var(--mono);font-style:normal}.creator-selfcheck-badge>div:last-child span+span i{background:#e6f0ff;color:#577890}.creator-selfcheck-badge>div:last-child strong{display:block;margin:5px 0 0 27px;color:#3c3443;font:500 19px var(--serif)}.creator-badge-actions{display:flex;flex-direction:column;gap:7px}.creator-badge-actions button{min-width:150px;height:36px;padding:0 12px;border:1px solid rgba(58,49,73,.12);border-radius:9px;background:#fff;color:#6e6574;display:flex;align-items:center;justify-content:center;gap:7px;font-size:7px}.creator-badge-actions button:last-child{border-color:#302a40;background:#302a40;color:#fff}
.creator-record-scores{display:flex;gap:7px}.creator-record-scores>span{min-width:135px;padding:8px;border-left:1px solid rgba(75,61,92,.08);display:grid;grid-template-columns:auto 1fr auto auto auto;gap:5px;align-items:center;color:#77707d}.creator-record-scores i{width:20px;height:20px;border-radius:6px;background:#e8f3ed;color:#557c68;display:grid;place-items:center;font:7px var(--mono);font-style:normal}.creator-record-scores>span+span i{background:#e6f0ff;color:#577890}.creator-record-scores small{grid-column:1/6;color:#817987;font-size:6px}.creator-record-scores b{color:#9a929d;font:500 13px var(--serif)}.creator-record-scores em{color:#a89daf;font:8px var(--mono);font-style:normal}.creator-record-scores strong{font:500 20px var(--serif);background:linear-gradient(120deg,#668675,#8e77aa);background-clip:text;color:transparent}.creator-record-scores>span+span strong{background-image:linear-gradient(120deg,#66839e,#8d77aa)}.creator-record-stats{grid-column:1/4;margin:0;padding-top:10px;border-top:1px solid rgba(75,61,92,.08);color:#5f5665;font-size:7px}
.creator-report-columns{display:grid;grid-template-columns:minmax(0,.43fr) minmax(0,.57fr);border-bottom:1px solid var(--line);align-items:start}.creator-copy-panel,.creator-issues-panel{min-width:0;padding:28px 0}.creator-copy-panel{position:sticky;top:18px;align-self:start;padding-right:28px;border-right:1px solid var(--line)}.creator-issues-panel{padding-left:28px}.creator-copy-panel>header,.creator-issues-panel>header{position:relative}.creator-copy-panel h2,.creator-issues-panel h2,.creator-image-review h2,.creator-report-extras h2{margin:6px 0 0;font:500 20px/1.2 var(--serif);color:#342d3c}.creator-copy-panel>header>small,.creator-issues-panel>header>small{position:absolute;right:0;bottom:1px;color:#a19aa5;font-size:6px}.creator-copy-panel>p{margin:22px 0 0;padding:21px;border:1px solid rgba(65,53,81,.08);border-radius:16px;background:#fbfafc;color:#554e5a;font-size:11px;line-height:2.25;white-space:pre-wrap;transition:background .3s ease}.creator-copy-panel>p.updated{animation:creator-draft-update .8s ease}.creator-copy-hit{display:inline;padding:1px 0;border:0;border-bottom:2px solid currentColor;background:transparent;color:inherit;font:inherit;line-height:inherit;cursor:pointer;transition:background .2s ease}.creator-copy-hit.severity-must{color:#8f5d66;border-color:#c88d96}.creator-copy-hit.severity-suggest{color:#956b38;border-color:#d5a96e}.creator-copy-hit.severity-tip{color:#76638e;border-color:#b7a1ce}.creator-copy-hit:hover,.creator-copy-hit.linked{border-radius:3px;background:rgba(222,211,234,.45)}.creator-copy-placeholder{display:inline-block;min-width:44px;padding:0 4px;border:1px dashed #a88ec4;border-radius:4px;background:#eee5f7;color:#69527c;line-height:1.55;outline:none;cursor:text}.creator-copy-placeholder:focus{border-style:solid;box-shadow:0 0 0 3px rgba(139,112,173,.1)}
.creator-issues-panel>div{margin-top:16px;display:flex;flex-direction:column;gap:9px}.creator-issue-card{padding:14px 15px;border:1px solid rgba(66,53,82,.09);border-left:3px solid #b7a0c9;border-radius:13px;background:rgba(255,255,255,.65);transition:opacity .25s ease,background .2s ease,border-color .2s ease,transform .2s ease}.creator-issue-card.severity-must{border-left-color:#bd7f89}.creator-issue-card.severity-suggest{border-left-color:#c99759}.creator-issue-card.severity-tip{border-left-color:#a994c1}.creator-issue-card.linked{background:#faf7fc;border-color:rgba(115,91,151,.27);transform:translateX(-3px)}.creator-issue-card.handled{opacity:.48;background:#f7f7f7}.creator-issue-card>header{display:flex;align-items:center;gap:6px}.creator-issue-card>header span,.creator-issue-card>header em{padding:4px 6px;border-radius:5px;font-size:6px;font-style:normal}.creator-issue-card>header span{background:#f0e3e6;color:#8b5962}.creator-issue-card.severity-suggest>header span{background:#f5eadb;color:#8c6334}.creator-issue-card.severity-tip>header span{background:#ece6f3;color:#6f5c85}.creator-issue-card.handled>header span{background:#e3efe8;color:#52705e}.creator-issue-card>header em{background:#f2f0f3;color:#7e7682}.creator-issue-card>p{margin:9px 0;color:#77707d;font-size:7px;line-height:1.65}.creator-rewrite{padding:9px 10px;border-top:1px solid rgba(60,49,73,.07);border-bottom:1px solid rgba(60,49,73,.07);display:grid;gap:7px}.creator-rewrite>span{display:grid;grid-template-columns:33px 1fr;gap:7px;align-items:start}.creator-rewrite small{color:#9b949f;font:6px var(--mono)}.creator-rewrite del{color:#968d97;font-size:8px}.creator-rewrite strong{color:#4f4654;font-size:8px;font-weight:500;line-height:1.6}.creator-rewrite mark{padding:2px 3px;border-radius:3px;background:#eee3f7;color:#68527b}.creator-issue-card>footer{padding-top:10px;display:flex;justify-content:flex-end;gap:7px}.creator-issue-card>footer button{padding:6px 9px;border:1px solid rgba(58,49,73,.1);border-radius:7px;background:#fff;color:#716977;font-size:7px}.creator-issue-card>footer button:first-child{border-color:#3a3344;background:#3a3344;color:#fff}.creator-issue-collapsed{width:100%;padding:9px 11px;border:1px dashed rgba(67,55,82,.12);border-radius:10px;background:#faf9fa;color:#8d858f;display:flex;align-items:center;gap:8px;text-align:left;font-size:7px}.creator-issue-collapsed>span{padding:3px 5px;border-radius:4px;background:#eeecee;font:6px var(--mono)}.creator-issue-collapsed>small{margin-left:auto;color:#aaa4ad;font-size:6px}
.creator-image-review{padding:28px 0;border-bottom:1px solid var(--line)}.creator-image-review>header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.creator-image-review>header>small{color:#9d96a1;font-size:7px}.creator-report-thumbnails{margin-top:18px;display:flex;gap:10px;overflow-x:auto;padding-bottom:5px}.creator-report-thumbnails>button{position:relative;width:112px;height:112px;flex:none;padding:0;border:2px solid transparent;border-radius:13px;background:#eeeaf0;overflow:hidden}.creator-report-thumbnails>button.active{border-color:#8874a7}.creator-report-thumbnails>button>img{width:100%;height:100%;object-fit:cover;display:block}.creator-report-thumbnails i{position:absolute;z-index:3;right:6px;top:6px;padding:4px 5px;border-radius:99px;background:#c38e4d;color:#fff;font:6px var(--mono);font-style:normal}.creator-report-thumbnails>button>span{position:absolute;z-index:3;left:6px;bottom:6px;padding:4px 6px;border-radius:99px;background:rgba(37,30,45,.68);color:#fff;font:6px var(--mono)}.creator-skin-comparison{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr}.creator-skin-comparison>span{position:relative;min-width:0;overflow:hidden}.creator-skin-comparison>span+span{border-left:1px solid rgba(255,255,255,.8)}.creator-skin-comparison img{width:200%;height:100%;object-fit:cover;display:block}.creator-skin-comparison>span+span img{transform:translateX(-50%);filter:brightness(1.08) saturate(.88) blur(.45px)}.creator-skin-comparison b{position:absolute;left:4px;bottom:27px;padding:2px 3px;border-radius:3px;background:rgba(35,29,42,.6);color:#fff;font:5px var(--mono);font-weight:400}.creator-image-note{margin-top:12px;padding:13px 14px;border:1px solid rgba(165,117,57,.15);border-radius:13px;background:#fbf6ed;display:grid;grid-template-columns:auto 1fr auto;gap:11px;align-items:center}.creator-image-note>span{padding:5px 7px;border-radius:6px;background:#f0dfc7;color:#8a6234;font:6px var(--mono)}.creator-image-note strong{font-size:9px;font-weight:500;color:#514850}.creator-image-note p{margin:4px 0 0;color:#817982;font-size:7px}.creator-image-note>button{padding:7px 9px;border:0;border-radius:8px;background:#3a3344;color:#fff;font-size:7px}.creator-image-note.handled{opacity:.72;background:#f4f7f5;border-color:#dce9e1}.creator-image-note.handled>span{background:#e1eee6;color:#52705e}.creator-no-images{margin:18px 0 0;padding:18px;border:1px dashed rgba(67,55,82,.13);border-radius:13px;color:#99919d;font-size:8px;text-align:center}
.creator-report-extras{padding:28px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1.3fr .7fr;gap:38px}.creator-disclosure-list>div{margin-top:16px;display:grid;grid-template-columns:1fr 1fr;gap:7px}.creator-disclosure-list label{padding:10px;border:1px solid rgba(65,53,81,.08);border-radius:10px;background:#faf9fb;display:grid;grid-template-columns:auto auto 1fr;gap:7px;align-items:center;color:#817982}.creator-disclosure-list input{position:absolute;opacity:0;pointer-events:none}.creator-disclosure-list label>span{color:#9b7040;font:6px var(--mono)}.creator-disclosure-list label>strong{font-size:8px;font-weight:500}.creator-disclosure-list label::before{content:"△";width:19px;height:19px;border-radius:6px;background:#f4e9d9;color:#9b7040;display:grid;place-items:center;font:7px var(--mono)}.creator-disclosure-list label.ready{background:#f5f8f6;color:#5c6f63}.creator-disclosure-list label.ready>span{color:#5f806c}.creator-disclosure-list label.ready::before{content:"✓";background:#e1eee6;color:#537461}.creator-good-points>p{margin:16px 0 0;padding-bottom:10px;border-bottom:1px solid var(--line);color:#635c68;font-size:8px}.creator-good-points>p+p{margin-top:10px}.creator-good-points i{display:inline-grid;width:20px;height:20px;margin-right:8px;border-radius:50%;background:#e3efe8;color:#52705e;place-items:center;font-size:7px;font-style:normal}
.creator-report-actions{padding-top:22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.creator-report-actions>small{color:#99929d;font-size:7px}.creator-report-actions>div{display:flex;gap:8px}.creator-report-actions button{height:38px;padding:0 13px;border:1px solid rgba(58,49,73,.11);border-radius:10px;background:#fff;color:#6e6673;display:flex;align-items:center;gap:7px;font-size:8px}.creator-report-actions button:last-child{border-color:#302a40;background:#302a40;color:#fff}
@media (max-width:900px){.creator-report-sheet{width:calc(100% - 28px);padding:22px;border-radius:23px}.creator-report-hero{grid-template-columns:1fr}.creator-report-hero>small{grid-column:1}.creator-report-scores{justify-content:flex-start}.creator-report-columns{grid-template-columns:1fr}.creator-copy-panel{position:static;padding-right:0;border-right:0;border-bottom:1px solid var(--line)}.creator-issues-panel{padding-left:0}.creator-report-extras{grid-template-columns:1fr;gap:28px}}
@media (max-width:640px){.creator-report-page{padding-bottom:62px}.creator-report-sheet{width:calc(100% - 20px);margin:16px auto 76px;padding:16px}.creator-report-hero h1{font-size:38px}.creator-report-scores{display:grid;grid-template-columns:1fr 1fr}.creator-report-scores>div{min-width:0;padding:9px}.creator-recheck-state{grid-template-columns:1fr}.creator-badge-area{grid-template-columns:1fr}.creator-selfcheck-badge{grid-template-columns:auto 1fr}.creator-record-scores{grid-column:1/3;border-top:1px solid var(--line);padding-top:10px}.creator-record-scores>span{min-width:0;flex:1}.creator-record-stats{grid-column:1/3}.creator-badge-actions{display:grid;grid-template-columns:1fr 1fr}.creator-badge-actions button{min-width:0}.creator-copy-panel>p{padding:16px;font-size:10px}.creator-issues-panel>div{gap:8px}.creator-image-note{grid-template-columns:auto 1fr}.creator-image-note>button{grid-column:2;justify-self:start}.creator-disclosure-list>div{grid-template-columns:1fr}.creator-report-actions{align-items:stretch;flex-direction:column}.creator-report-actions>div{display:grid;grid-template-columns:1fr 1fr}.creator-report-actions button{justify-content:center}}
.cross-check-section{padding:28px 0;border-bottom:1px solid var(--line);scroll-margin-top:78px}.cross-check-section>header{display:flex;align-items:flex-start;justify-content:space-between;gap:28px}.cross-check-section>header>div:first-child{max-width:540px}.cross-check-section>header span:first-child{font:7px var(--mono);letter-spacing:.1em;color:#887a98}.cross-check-section h3{margin:6px 0 5px;font:500 22px/1.25 var(--serif);color:#302a39}.cross-check-section h4{margin:10px 0 6px;color:#4a424f;font:500 15px/1.45 var(--serif)}.cross-check-section>header p{margin:0;color:#77707d;font-size:8px;line-height:1.7}.cross-check-summary{display:flex;align-items:center;gap:7px;padding:9px 12px;border:1px solid rgba(82,68,110,.08);border-radius:99px;background:#f7f4f9;color:#837b89;font-size:7px;white-space:nowrap}.cross-check-summary b{font-weight:400}.cross-check-summary strong{color:#433b4b;font:500 10px var(--mono)}.creator-cross-check{padding-top:30px}.creator-cross-check>header>div:first-child{max-width:620px}
.creator-use-demo>p { margin: 0; color: #504957; font-size: 10px; line-height: 1.85; }
.creator-use-demo>p mark { padding: 0 1px 2px; background: transparent; border-bottom: 2px solid rgba(201, 139, 147, .72); color: inherit; }
.creator-use-demo>div { margin-top: 16px; padding: 12px; border: 1px solid rgba(123, 107, 176, .12); border-radius: 12px; background: rgba(255,255,255,.8); display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: end; }
.creator-use-demo>div>span { color: #6d6573; font-size: 7px; line-height: 1.75; }
.creator-use-demo>div mark { padding: 2px 4px; border-radius: 4px; background: #ece5f7; color: #67567b; }
.creator-use-demo button { height: 27px; padding: 0 9px; border: 0; border-radius: 7px; background: #302a40; color: #fff; font-size: 6px; white-space: nowrap; }

/* Frontend teammate additions: audience section */
.who-uses-section {
  --trust-ink: #1f1b33;
  --trust-purple: #7b6bb0;
  --trust-green: #7fa38b;
  --trust-rose: #c98b93;
  position: relative;
  overflow: hidden;
  padding: 104px clamp(24px, 6vw, 88px) 126px;
  color: var(--trust-ink);
  background:
    linear-gradient(180deg, #f7f5fc 0, rgba(247, 245, 252, 0) 110px, rgba(247, 245, 252, 0) calc(100% - 110px), #f7f5fc 100%),
    radial-gradient(circle at 84% 20%, rgba(127, 163, 139, .13), transparent 25%),
    radial-gradient(circle at 14% 72%, rgba(123, 107, 176, .13), transparent 28%),
    #f7f5fc;
}
.who-use-card { min-height: 560px; cursor: default; }
.who-use-card .promise-card-copy h3 { font-family: var(--serif); font-weight: 600; line-height: 1.32; letter-spacing: -.03em; }
.who-use-demo { margin-bottom: 4px; }
.consumer-use-demo>div { display: flex; align-items: center; gap: 12px; }
.consumer-use-demo>div>strong { color: #302a40; font: 500 58px/1 var(--serif); letter-spacing: -.04em; }
.consumer-use-demo>div>span { padding: 6px 9px; border-radius: 999px; background: rgba(127, 163, 139, .18); color: #5f806c; font-size: 7px; }
.consumer-use-demo>small:not(.promise-example) { display: block; margin-top: 10px; color: #89818e; font: 7px var(--mono); }
.consumer-use-demo>p { margin: 19px 0 0; padding-top: 16px; border-top: 1px solid rgba(123, 107, 176, .12); color: #625b69; font-size: 8px; line-height: 1.65; }
.creator-use-demo>p { margin: 0; color: #504957; font-size: 10px; line-height: 1.85; }
.creator-use-demo>p mark { padding: 0 1px 2px; background: transparent; border-bottom: 2px solid rgba(201, 139, 147, .72); color: inherit; }
.creator-use-demo>div { margin-top: 16px; padding: 12px; border: 1px solid rgba(123, 107, 176, .12); border-radius: 12px; background: rgba(255,255,255,.8); display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: end; }
.creator-use-demo>div>span { color: #6d6573; font-size: 7px; line-height: 1.75; }
.creator-use-demo>div mark { padding: 2px 4px; border-radius: 4px; background: #ece5f7; color: #67567b; }
.creator-use-demo button { height: 27px; padding: 0 9px; border: 0; border-radius: 7px; background: #302a40; color: #fff; font-size: 6px; white-space: nowrap; }
.team-use-demo { padding-top: 36px; display: flex; flex-direction: column; }
.team-use-demo>div { flex: 1; min-height: 48px; border-bottom: 1px solid rgba(123, 107, 176, .11); display: grid; grid-template-columns: 42px 1fr auto; gap: 10px; align-items: center; }
.team-use-demo>div:last-child { border-bottom: 0; }
.team-use-demo>div>strong { color: #403848; font: 500 20px var(--serif); }
.team-use-demo>div>span { justify-self: start; padding: 5px 7px; border-radius: 999px; font-size: 6px; }
.team-use-demo .risk-high { background: rgba(201,139,147,.17); color: #98636b; }
.team-use-demo .risk-medium { background: rgba(217,183,107,.18); color: #92743c; }
.team-use-demo .risk-trusted { background: rgba(127,163,139,.17); color: #5f806c; }
.team-use-demo>div>small { padding: 5px 7px; border: 1px solid rgba(71,61,82,.1); border-radius: 6px; background: rgba(255,255,255,.7); color: #77707d; font-size: 6px; }
.who-use-action { align-self: flex-start; min-height: 37px; margin-top: auto; padding: 0 15px; border: 1px solid rgba(48,42,64,.2); border-radius: 999px; background: transparent; color: #4d4656; display: inline-flex; align-items: center; gap: 9px; font-size: 8px; transition: background .22s ease, color .22s ease, border-color .22s ease, transform .22s ease; }
.who-use-action span { font: 9px var(--mono); }
.who-use-action:hover,.who-use-action:focus-visible { border-color: #302a40; background: #302a40; color: #fff; transform: translateY(-1px); outline: none; }

@media (max-width: 899px) {
  .who-uses-section { padding: 82px 18px 92px; }
  .who-use-card { min-height: 535px; }
}

@media (prefers-reduced-motion: reduce) {
  .who-use-action { transition: none; }
}

/* Frontend teammate additions: cross-check graph and evidence states */
.cross-check-section{padding:28px 0;border-bottom:1px solid var(--line);scroll-margin-top:78px}.cross-check-section>header{display:flex;align-items:flex-start;justify-content:space-between;gap:28px}.cross-check-section>header>div:first-child{max-width:540px}.cross-check-section>header span:first-child{font:7px var(--mono);letter-spacing:.1em;color:#887a98}.cross-check-section h3{margin:6px 0 5px;font:500 22px/1.25 var(--serif);color:#302a39}.cross-check-section h4{margin:10px 0 6px;color:#4a424f;font:500 18px/1.45 var(--serif)}.cross-check-section>header p{margin:0;color:#77707d;font-size:8px;line-height:1.7}.cross-check-summary{display:flex;align-items:center;gap:7px;padding:9px 12px;border:1px solid rgba(82,68,110,.08);border-radius:99px;background:#f7f4f9;color:#837b89;font-size:7px;white-space:nowrap}.cross-check-summary b{font-weight:400}.cross-check-summary strong{color:#433b4b;font:500 10px var(--mono)}.creator-cross-check{padding-top:30px}.creator-cross-check>header>div:first-child{max-width:620px}
.cross-check-layout{margin-top:24px;display:grid;grid-template-columns:minmax(310px,.85fr) minmax(420px,1.15fr);gap:28px;align-items:center}.cross-check-graph{padding:12px;border:1px solid rgba(69,55,91,.07);border-radius:20px;background:linear-gradient(145deg,rgba(249,247,252,.9),rgba(245,242,248,.5));text-align:center}.cross-check-graph svg{width:100%;display:block;overflow:visible}.cross-check-graph>small{color:#9a929f;font-size:6px}
.cross-node circle{fill:#eee9f7;stroke:#9f8abe;stroke-width:1.5;filter:drop-shadow(0 5px 8px rgba(63,48,83,.09))}.cross-node text{fill:#544862;font:600 11px var(--mono);pointer-events:none}.cross-node.node-r circle{fill:#edf3f8;stroke:#8faec5}.cross-node.node-u circle{fill:#edf5f1;stroke:#8eb5a5}.cross-node.node-s circle{fill:#f5edef;stroke:#c39da8}.cross-node.inactive circle{fill:transparent;stroke:#bbb5bf;stroke-dasharray:4 4;filter:none}.cross-node.inactive>text:not(.cross-node-disabled-label){fill:#aaa4ad}.cross-node .cross-node-disabled-label{fill:#aaa4ad;font:5px "Noto Sans SC",sans-serif}
.cross-edge{cursor:pointer;outline:none;animation:cross-line-in .75s ease both}.cross-edge line{stroke-width:2.5;stroke-linecap:round;transition:stroke-width .2s ease,opacity .2s ease}.cross-edge circle{stroke:#fff;stroke-width:2}.cross-edge text{fill:#fff;font:600 6px var(--mono);pointer-events:none}.cross-edge:hover line,.cross-edge:focus-visible line,.cross-edge.active line{stroke-width:5}.cross-edge.state-conflict line,.cross-edge.state-conflict circle{stroke:#bd737d;fill:#bd737d}.cross-edge.state-consistent line,.cross-edge.state-consistent circle{stroke:#879b90;fill:#879b90}.cross-edge.state-corroborated line,.cross-edge.state-corroborated circle{stroke:#6ea48d;fill:#6ea48d}.cross-edge.state-doubtful line,.cross-edge.state-doubtful circle{stroke:#d19a62;fill:#d19a62}.cross-edge.state-unverified line,.cross-edge.state-unverified circle{stroke:#aaa4ae;fill:#aaa4ae;stroke-dasharray:5 5}
.cross-check-list{display:flex;flex-direction:column;gap:7px}.cross-check-row{width:100%;min-height:54px;padding:9px 10px;border:1px solid rgba(67,55,83,.08);border-radius:13px;background:rgba(255,255,255,.74);display:grid;grid-template-columns:72px 1fr auto 18px;gap:10px;align-items:center;text-align:left;color:#4c4452;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.cross-check-row:hover,.cross-check-row:focus-visible{transform:translateX(4px);border-color:rgba(116,96,157,.24);box-shadow:0 8px 22px rgba(55,43,70,.07);outline:none}.cross-check-row.state-unverified{border-style:dashed;background:#f7f6f8;color:#817b84}.cross-check-row.state-unverified .cross-pair{filter:grayscale(1);opacity:.65}.cross-pair{display:flex;align-items:center;gap:5px}.cross-pair b{width:23px;height:23px;border-radius:7px;background:#eee9f6;display:grid;place-items:center;font:8px var(--mono)}.cross-pair i{color:#aaa2ae;font-size:8px;font-style:normal}.cross-check-row>span:nth-child(2){min-width:0}.cross-check-row>span:nth-child(2) small,.cross-check-row>span:nth-child(2) strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cross-check-row>span:nth-child(2) small{color:#928a96;font-size:6px}.cross-check-row>span:nth-child(2) strong{margin-top:4px;font-size:8px;font-weight:500}.cross-check-row>em,.cross-state-pill{padding:5px 7px;border-radius:99px;font-size:6px;font-style:normal;white-space:nowrap}.state-conflict>em,.cross-state-pill.state-conflict{background:#f3e0e3;color:#92535c}.state-consistent>em,.cross-state-pill.state-consistent{background:#e8eeea;color:#60756a}.state-corroborated>em,.cross-state-pill.state-corroborated{background:#e2f0e9;color:#4d785f}.state-doubtful>em,.cross-state-pill.state-doubtful{background:#f5e8d8;color:#8a6239}.state-unverified>em,.cross-state-pill.state-unverified{background:#e9e7eb;color:#77717b}.cross-arrow{color:#918798;font-style:normal}.cross-check-note{display:block;margin-top:12px;text-align:right;color:#aaa3ad;font:6px var(--mono)}
.cross-state-dot{width:42px;height:42px;flex:none;border-radius:13px;background:#e8eeea;position:relative}.cross-state-dot::after{content:"";position:absolute;inset:13px;border:2px solid #71877b;border-radius:50%}.cross-state-dot.state-conflict{background:#f3e0e3}.cross-state-dot.state-conflict::after{border-color:#a85f69}.cross-state-dot.state-corroborated{background:#e2f0e9}.cross-state-dot.state-corroborated::after{border-color:#5f9175}.cross-state-dot.state-doubtful{background:#f5e8d8}.cross-state-dot.state-doubtful::after{border-color:#b17c47}.cross-state-dot.state-unverified{background:#eeecef}.cross-state-dot.state-unverified::after{border-color:#918b95;border-style:dashed}
.cross-evidence-summary{margin:22px 24px 0;padding:15px 17px;border:1px solid rgba(89,71,126,.1);border-radius:15px;background:#f5f1f9;display:grid;grid-template-columns:auto 1fr;gap:6px 12px}.cross-evidence-summary>span{grid-row:1/3;padding:5px 7px;border-radius:7px;background:#fff;color:#746489;font-size:7px;align-self:start}.cross-evidence-summary p{margin:0;color:#554d5b;font-size:9px;line-height:1.7}.cross-evidence-summary small{color:#958d9a;font-size:7px}.cross-evidence-columns{margin:18px 24px 0;display:grid;grid-template-columns:1fr 1fr;gap:12px}.cross-evidence-columns>section{overflow:hidden;border:1px solid rgba(66,53,81,.1);border-radius:17px;background:#fff}.cross-evidence-columns section>header{padding:15px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--line)}.cross-evidence-columns .report-dimension-badge{width:36px;height:36px;border-radius:10px}.cross-evidence-columns header>div{min-width:0}.cross-evidence-columns header small,.cross-evidence-columns header strong{display:block}.cross-evidence-columns header small{color:#9a929f;font:6px var(--mono)}.cross-evidence-columns header strong{margin-top:3px;font-size:9px;font-weight:500}.cross-evidence-capture{min-height:180px;padding:22px;background:linear-gradient(145deg,#faf9fb,#f1edf6);display:flex;flex-direction:column;justify-content:center}.cross-evidence-capture>span{color:#9a929f;font:6px var(--mono);letter-spacing:.08em}.cross-evidence-capture p{margin:10px 0;color:#443c4b;font:500 16px/1.5 var(--serif)}.cross-evidence-capture mark{align-self:flex-start;padding:5px 7px;border-radius:6px;background:#e8e0f4;color:#665276;font-size:7px}
@keyframes cross-line-in{from{opacity:0;transform:scale(.85);transform-origin:center}to{opacity:1;transform:scale(1)}}
.material-trace-evidence{margin:14px 24px 0;padding:19px;border:1px solid rgba(73,59,94,.1);border-radius:18px;background:linear-gradient(145deg,rgba(255,255,255,.96),rgba(246,243,249,.9));box-shadow:0 11px 32px rgba(54,43,73,.05)}
.material-trace-evidence>header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.material-trace-evidence>header>div:first-child{display:flex;flex-direction:column;gap:5px}.material-trace-evidence>header>div:first-child>span{color:#3f3747;font:600 13px "Noto Sans SC",sans-serif}.material-trace-evidence>header>div:first-child>small{color:#918a96;font-size:7px}
.material-trace-evidence>header>div:last-child{display:flex;align-items:center;gap:6px}.material-trace-evidence>header b,.material-trace-evidence>header em{padding:5px 7px;border-radius:99px;font:6px var(--mono);font-style:normal;font-weight:400;white-space:nowrap}.material-trace-evidence>header b{background:#f0edf2;color:#948c98}.material-trace-evidence>header em{border:1px solid #d7cde4;background:#f5f1fa;color:#6e5c83}
.material-trace-evidence>p{margin:16px 0 0;color:#534b59;font:500 12px/1.55 var(--serif)}
.material-trace-timeline{position:relative;margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.material-trace-timeline::before{content:"";position:absolute;left:16.5%;right:16.5%;top:68px;height:1px;background:#d8d2dc}
.material-trace-timeline>article{position:relative;min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center}
.material-trace-thumbnail{width:92px;height:58px;border:1px solid #d7d2da;border-radius:10px;background:linear-gradient(145deg,#e5e2e7,#d8d4db);color:#9c96a0;display:grid;place-items:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.65)}
.material-trace-thumbnail img{width:100%;height:100%;object-fit:cover;border-radius:9px}
.material-trace-timeline>article>i{z-index:1;width:9px;height:9px;margin-top:6px;border:2px solid #fff;border-radius:50%;background:#8877a5;box-shadow:0 0 0 1px #b9afc5}
.material-trace-timeline>article>span{margin-top:7px;color:#756b80;font:7px var(--mono)}.material-trace-timeline>article>em{margin-top:5px;padding:4px 6px;border-radius:99px;background:#e5efe9;color:#577060;font-size:6px;font-style:normal}.material-trace-timeline>article>strong{max-width:100%;margin-top:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#4d4653;font-size:8px;font-weight:500}.material-trace-timeline>article>time{margin-top:4px;color:#9a939e;font:6px var(--mono)}
.material-trace-empty{margin-top:16px;padding:17px;border:1px solid rgba(111,139,121,.12);border-radius:13px;background:#edf3ef;display:flex;align-items:center;gap:11px}.material-trace-empty>span{width:32px;height:32px;flex:none;border-radius:50%;background:#dbe9e1;color:#5e7b69;display:grid;place-items:center}.material-trace-empty>div{display:flex;flex-direction:column;gap:4px}.material-trace-empty strong{color:#52675a;font-size:9px;font-weight:600}.material-trace-empty small{color:#7d8e83;font-size:7px;line-height:1.55}

@media (max-width:640px){
  .material-trace-evidence{margin-left:14px;margin-right:14px;padding:15px}.material-trace-thumbnail{width:72px;height:50px}.material-trace-timeline::before{top:60px}.material-trace-evidence>header{gap:10px}.material-trace-evidence>header>div:last-child{align-items:flex-end;flex-direction:column}
  .workspace{overflow-y:auto;-webkit-overflow-scrolling:touch}
  .workspace-center{padding-bottom:96px}
  .live-report-summary{padding:18px 0}
  .cross-check-section>header{flex-direction:column}
  .cross-check-summary{white-space:normal;flex-wrap:wrap}
  .cross-check-layout{grid-template-columns:1fr}
  .cross-check-graph{max-width:520px;margin:auto}
  .cross-check-row{grid-template-columns:62px minmax(0,1fr) auto}
  .cross-check-row>em{grid-column:2;justify-self:start}
  .cross-arrow{grid-column:3;grid-row:1/3}
}

.live-report-summary{padding:24px 0;border-bottom:1px solid var(--line)}
.live-report-summary>span{font:7px var(--mono);letter-spacing:.1em;color:#887a98}
.live-report-summary>p{max-width:780px;margin:8px 0 0;color:#5f5765;font-size:10px;line-height:1.85}

/* Teammate report additions */
.report-section-block{scroll-margin-top:78px}
.report-section-heading{padding-top:26px}
.report-section-heading>span{font:7px var(--mono);letter-spacing:.1em;color:#887f90}
.report-section-heading h2{margin:6px 0 0;font:500 22px/1.2 var(--serif);color:#332d3b}
.unified-radar g.missing .radar-disabled-label{font:5px "Noto Sans SC",sans-serif;fill:#9c959f;opacity:1}
.unified-dimension-row b{font:10px var(--mono);font-weight:500;color:#4d4655;display:flex;align-items:baseline;gap:6px;white-space:nowrap}
.unified-dimension-row b>small{font:6px var(--mono);color:#918996}
.unified-dimension-row b>i{display:inline-block;margin-left:3px;font:7px "Noto Sans SC",sans-serif;font-style:normal;color:#74638f;opacity:.72;transition:transform .22s ease,opacity .22s ease}
.unified-verdict-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.unified-verdict-group>button{padding:9px 12px;border:1px solid rgba(101,82,143,.14);border-radius:99px;background:#f0ebf8;color:#675783;font-size:8px;transition:transform .2s ease,background .2s ease}
.unified-verdict-group>button:hover{background:#e7def5;transform:translateY(-1px)}
.account-profile-evidence{margin:18px 24px 0;padding:18px 19px 0;border:1px solid rgba(81,66,110,.11);border-radius:18px;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(246,243,250,.92));box-shadow:0 12px 34px rgba(54,43,73,.06);overflow:hidden}
.account-profile-evidence>header{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:11px;padding-bottom:15px;border-bottom:1px solid rgba(55,47,68,.09)}
.account-profile-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(145deg,#e7e2ec,#dcd7e2);color:#766e7d;display:grid;place-items:center;box-shadow:inset 0 0 0 1px rgba(75,63,91,.06)}
.account-profile-evidence>header>div{display:flex;flex-direction:column;gap:4px}.account-profile-evidence>header strong{color:#3c3544;font-size:11px;font-weight:600}.account-profile-evidence>header small{color:#938b9a;font:6px var(--mono);letter-spacing:.05em}
.account-profile-evidence>header em{align-self:start;padding:5px 7px;border-radius:99px;background:#f0edf2;color:#948c98;font:6px var(--mono);font-style:normal}
.account-profile-signals{padding:4px 0 3px}.account-profile-signal{padding:12px 0;border-bottom:1px solid rgba(55,47,68,.07)}.account-profile-signal:last-child{border-bottom:0}
.account-profile-signal>div:first-child{display:flex;align-items:center;justify-content:space-between;gap:12px}.account-profile-signal>div:first-child strong{font-size:8px;font-weight:500}.account-profile-signal>div:first-child span{color:#6c6178;font:7px var(--mono)}
.account-profile-meter{height:5px;margin-top:7px;border-radius:99px;background:#eae6ed;overflow:hidden}.account-profile-meter>i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#b7a8da,#8875b5)}
.account-profile-signal:nth-child(2) .account-profile-meter>i{background:linear-gradient(90deg,#d7b1bb,#c98b93)}.account-profile-signal:nth-child(3) .account-profile-meter>i{background:linear-gradient(90deg,#b8d1c2,#7fa38b)}.account-profile-signal:nth-child(4) .account-profile-meter>i{background:linear-gradient(90deg,#ddd4e8,#9f8eb4)}
.account-profile-signal p{margin:6px 0 0;color:#817987;font-size:7px;line-height:1.55}
.account-profile-summary{margin:4px -19px 0;padding:13px 19px;background:linear-gradient(90deg,#f0ebf7,#f8f4f5);display:grid;grid-template-columns:auto 1fr;align-items:center;gap:11px}.account-profile-summary>span{padding:5px 7px;border-radius:7px;background:#fff;color:#776789;font:6px var(--mono)}.account-profile-summary>strong{color:#5d5365;font-size:8px;font-weight:500;line-height:1.55}
.account-profile-evidence>footer{margin:0 -19px;padding:10px 19px;border-top:1px solid rgba(55,47,68,.06);background:#faf9fb;color:#99919d;font-size:6px;line-height:1.5}

.new-analysis-supplements{margin:0 14px 12px;border:1px dashed rgba(91,77,121,.18);background:rgba(247,245,250,.78)}
.new-analysis-supplement-toggle{width:100%;min-height:36px;padding:0 11px;border:0;background:transparent;color:#665d70;display:flex;align-items:center;justify-content:space-between;font-size:9px}
.new-analysis-supplement-toggle small{color:#978f9d;font:7px var(--mono)}
.new-analysis-supplement-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 9px 9px}
.new-analysis-supplement-grid .new-analysis-field{background:#fff}
.new-analysis-dimension-preview{padding:8px 10px;border-top:1px solid rgba(91,77,121,.1);display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.new-analysis-dimension-preview>span{color:#8e8794;font-size:7px}
.new-analysis-dimension-preview>b{padding:4px 6px;border-radius:99px;background:#ece9ef;color:#9b95a0;font:6px var(--mono);font-weight:400}
.new-analysis-dimension-preview>b.enabled{background:#e4efe8;color:#557160}

@media (max-width:640px){
  .account-profile-evidence{margin-left:14px;margin-right:14px}
  .account-profile-summary{grid-template-columns:1fr;gap:7px}
  .account-profile-summary>span{justify-self:start}
  .new-analysis-supplement-grid{grid-template-columns:1fr}
}

/* ---------------------------------------------------------------------------
   New-analysis dialog · link / copy-image tabs (reference card style).
   Scoped by mode class so the creator form and the homepage composer keep theirs.
   --------------------------------------------------------------------------- */
.new-analysis-composer.mode-link,
.new-analysis-composer.mode-manual{border-radius:36px;border-color:rgba(53,46,75,.07);background:#fff;box-shadow:0 18px 60px rgba(52,43,76,.06)}
.new-analysis-composer.mode-link:focus-within,
.new-analysis-composer.mode-manual:focus-within{border-color:rgba(53,46,75,.1);box-shadow:0 22px 66px rgba(52,43,76,.08);transform:none}
.new-analysis-composer.mode-link .analysis-mode-switch,
.new-analysis-composer.mode-manual .analysis-mode-switch{margin:0 32px;border-bottom-color:rgba(53,46,75,.08)}
.new-analysis-composer.mode-link .analysis-mode-switch button,
.new-analysis-composer.mode-manual .analysis-mode-switch button{min-height:58px;font-size:13px;color:#9a95a0}
.new-analysis-composer.mode-link .analysis-mode-switch button.active,
.new-analysis-composer.mode-manual .analysis-mode-switch button.active{color:#2f2a38;font-weight:600}
.new-analysis-composer.mode-link .analysis-mode-switch::before,
.new-analysis-composer.mode-manual .analysis-mode-switch::before{box-shadow:inset 0 -3px #6d5d96}

/* Fields: label above, the input itself is the rounded box. */
.new-analysis-composer.mode-link .new-analysis-link-fields{gap:20px;padding:26px 32px 24px}
.new-analysis-composer.mode-manual .new-analysis-manual{gap:20px;padding:26px 32px 18px}
.new-analysis-composer.mode-link .new-analysis-field,
.new-analysis-composer.mode-manual .new-analysis-field,
.new-analysis-composer.mode-link .new-analysis-field:hover,
.new-analysis-composer.mode-manual .new-analysis-field:hover,
.new-analysis-composer.mode-link .new-analysis-field:focus-within,
.new-analysis-composer.mode-manual .new-analysis-field:focus-within{gap:10px;padding:0;border:0;background:transparent;box-shadow:none;transform:none}
.new-analysis-composer.mode-link .new-analysis-field>span,
.new-analysis-composer.mode-manual .new-analysis-field>span{gap:8px;color:#2f2a38;font-size:12px;font-weight:600}
.new-analysis-composer.mode-link .new-analysis-field>span small,
.new-analysis-composer.mode-manual .new-analysis-field>span small,
.new-analysis-composer.mode-manual .new-analysis-field>span em{margin:0;padding:0;border:0;color:#a7a1ad;font-family:inherit;font-size:11px;font-style:normal;font-weight:400}
.new-analysis-composer.mode-link .new-analysis-field input,
.new-analysis-composer.mode-manual .new-analysis-field input,
.new-analysis-composer.mode-manual .new-analysis-field textarea{padding:15px 20px;border:1px solid rgba(53,46,75,.12);border-radius:24px;background:#fbfafc;color:#34303f;font-size:13px;transition:border-color .24s,background-color .24s,box-shadow .3s}
.new-analysis-composer.mode-link .new-analysis-field input:hover,
.new-analysis-composer.mode-manual .new-analysis-field input:hover,
.new-analysis-composer.mode-manual .new-analysis-field textarea:hover{border-color:rgba(53,46,75,.2)}
.new-analysis-composer.mode-link .new-analysis-field input:focus,
.new-analysis-composer.mode-manual .new-analysis-field input:focus,
.new-analysis-composer.mode-manual .new-analysis-field textarea:focus{border-color:rgba(109,93,150,.42);background:#fff;box-shadow:0 0 0 4px rgba(109,93,150,.07)}
.new-analysis-composer.mode-manual .new-analysis-upload{border-radius:24px;border-color:rgba(53,46,75,.14);background:#fbfafc}
.new-analysis-composer.mode-manual .new-analysis-file img{border-radius:14px}
.new-analysis-composer.mode-manual .new-analysis-file>button{border-radius:50%}
.new-analysis-composer.mode-manual .new-analysis-supplements{margin:0 32px 18px;border-radius:24px;border-color:rgba(53,46,75,.14);background:#fbfafc;overflow:hidden}
.new-analysis-composer.mode-manual .new-analysis-supplement-toggle{min-height:46px;padding:0 20px;font-size:11px}
.new-analysis-composer.mode-manual .new-analysis-supplement-grid{gap:16px;padding:4px 20px 18px}
.new-analysis-composer.mode-manual .new-analysis-supplement-grid .new-analysis-field textarea{background:#fff}
.new-analysis-composer.mode-manual .new-analysis-dimension-preview{padding:12px 20px}

/* Bottom row: hint on the left, "载入示例" + submit on the right. */
.new-analysis-composer.mode-link .new-analysis-actions,
.new-analysis-composer.mode-manual .new-analysis-actions{gap:18px;margin:0 32px;padding:18px 0 26px;border-top-color:rgba(53,46,75,.08)}
.new-analysis-composer.mode-link .new-analysis-actions>span,
.new-analysis-composer.mode-manual .new-analysis-actions>span{margin-right:auto;color:#a39da8;font-size:11px}
.new-analysis-example{padding:6px 2px;border:0;background:transparent;color:#5c5664;font-size:12px;white-space:nowrap}
.new-analysis-example:hover,.new-analysis-example:focus-visible{color:#2f2a38;text-decoration:underline;text-underline-offset:4px;outline:none}
.new-analysis-composer.mode-link .new-analysis-submit,
.new-analysis-composer.mode-manual .new-analysis-submit{min-height:44px;padding:0 22px;gap:8px;border-radius:999px;background:#ebe7f1;color:#3a3443;font-size:12px;font-weight:500}
.new-analysis-composer.mode-link .new-analysis-submit>span,
.new-analysis-composer.mode-manual .new-analysis-submit>span{width:auto;height:auto;background:transparent;color:inherit}
.new-analysis-composer.mode-link .new-analysis-submit:not(:disabled):hover,
.new-analysis-composer.mode-manual .new-analysis-submit:not(:disabled):hover{background:#e2dcec;box-shadow:0 10px 24px rgba(48,40,64,.1)}
.new-analysis-composer.mode-link .new-analysis-submit:disabled,
.new-analysis-composer.mode-manual .new-analysis-submit:disabled{opacity:.55}
.new-analysis-composer.mode-link .new-analysis-error,
.new-analysis-composer.mode-manual .new-analysis-error{margin:0 32px 12px;font-size:11px}

@media (max-width:720px){
  .new-analysis-composer.mode-link,
  .new-analysis-composer.mode-manual{border-radius:28px}
  .new-analysis-composer.mode-link .analysis-mode-switch,
  .new-analysis-composer.mode-manual .analysis-mode-switch,
  .new-analysis-composer.mode-link .new-analysis-actions,
  .new-analysis-composer.mode-manual .new-analysis-actions,
  .new-analysis-composer.mode-manual .new-analysis-supplements{margin-left:18px;margin-right:18px}
  .new-analysis-composer.mode-link .new-analysis-link-fields,
  .new-analysis-composer.mode-manual .new-analysis-manual{padding:20px 18px 18px}
  .new-analysis-composer.mode-link .new-analysis-actions,
  .new-analysis-composer.mode-manual .new-analysis-actions{flex-direction:row;flex-wrap:wrap;align-items:center}
  .new-analysis-composer.mode-link .new-analysis-actions>span,
  .new-analysis-composer.mode-manual .new-analysis-actions>span{flex-basis:100%}
}

/* ---------------------------------------------------------------------------
   03 / 合 · 语义一致性校验 — cross-check arcs, notes and outputs
   (ported from the teammate build, kkk/src/index.css).
   --------------------------------------------------------------------------- */
.merge-results{position:relative}
.merge-results>small,.merge-results>.merge-result{position:relative;z-index:2}
.merge-cross-links{position:absolute;z-index:1;left:0;top:18px;width:300px;height:220px;overflow:visible;pointer-events:none}
.merge-cross-links path{fill:none;stroke-width:2.2;stroke-dasharray:1;transition:stroke-dashoffset .1s linear}
.merge-cross-links .cross-link-conflict{stroke:#c4838d}
.merge-cross-links .cross-link-doubtful{stroke:#c59a54;stroke-dasharray:.08 .055}
.aperture-column{position:relative}
.merge-cross-checks{position:absolute;z-index:6;left:50%;top:286px;width:410px;transform:translateX(-50%);display:flex;flex-direction:column;gap:6px;pointer-events:none}
.flow-outputs .merge-output>*{opacity:var(--output-progress)}
.score-output>em{background:#e2f0e8;color:#4d765f}
.flow-outputs .detail-output{min-height:55px;padding:9px 12px;border-radius:13px;place-items:initial;align-content:center;gap:4px}
.detail-output>span{color:#77707d;font-size:6px}
.detail-output>strong{color:#4b4452;font-size:7px;font-weight:500;white-space:nowrap}

@media (max-width:899px){
  /* Stacked layout: the arcs only line up with the side-by-side cards. */
  .merge-cross-links{display:none}
  .architecture-section .connector-in{display:none}
  .merge-cross-checks{position:relative;left:auto;top:auto;width:min(410px,100%);margin:18px auto 0;transform:none}
  .merge-cross-checks>small{position:static;align-self:flex-end;order:-1}
}

/* ---------------------------------------------------------------------------
   04 / 报 — cross-check banner + decision panel (ported from kkk/src/index.css).
   Progress vars default to 1 (fully shown). Inside the scroll narrative they are
   derived from --how-scene-progress, which HowNarrative writes on .how-narrative.
   --------------------------------------------------------------------------- */
.report-showcase-section{--report-cross-progress:1;--report-advice-progress:1;--report-final-progress:1;--report-scroll-offset:0px}
.trust-report-card[data-focus="cross"] .part-cross{opacity:1;filter:none}
.report-cross-check{margin-top:14px;padding:10px 12px;border:1px solid rgba(122,96,161,.12);border-radius:12px;background:linear-gradient(90deg,#f1edf7,#faf7f8);display:flex;align-items:center;gap:9px;opacity:var(--report-cross-progress);transform:translateY(calc((1 - var(--report-cross-progress)) * 10px))}
.report-cross-check>span{width:27px;height:27px;border-radius:8px;background:#fff;color:#75628f;display:grid;place-items:center;box-shadow:0 4px 12px rgba(63,47,83,.07)}
.report-cross-check>strong{color:#5c5266;font-size:8px;font-weight:500}
.report-decision-panel{position:relative;margin-top:10px;padding:12px 12px 27px;border:1px solid rgba(62,50,78,.09);border-radius:15px;background:rgba(250,248,251,.92);display:grid;grid-template-columns:132px minmax(0,1fr);gap:13px;opacity:var(--report-advice-progress);transform:translateY(calc((1 - var(--report-advice-progress)) * 12px))}
.report-decision-levels{padding-right:12px;border-right:1px solid rgba(67,54,82,.08);display:flex;flex-direction:column}
.report-decision-levels>span{position:relative;min-height:34px;padding-left:18px;color:#8a838e;font-size:6px;display:flex;align-items:center}
.report-decision-levels>span::before{content:"";position:absolute;left:5px;top:21px;bottom:-13px;width:1px;background:#ddd7df}
.report-decision-levels>span:last-child::before{display:none}
.report-decision-levels i{position:absolute;z-index:1;left:0;width:11px;height:11px;border:3px solid #fff;border-radius:50%;background:#82a28e;box-shadow:0 0 0 1px rgba(72,62,79,.08)}
.report-decision-levels>span:nth-child(2) i{background:#d4ae66}
.report-decision-levels>span:nth-child(3) i{background:#b47780}
.report-decision-levels>span.active{margin-top:1px;padding:7px 7px 7px 18px;border-radius:8px;background:#f5e8e9;color:#825961;font-weight:600}
.report-role-advice>div{display:flex;flex-wrap:wrap;gap:4px}
.report-role-advice button{height:23px;padding:0 8px;border:1px solid rgba(63,52,78,.08);border-radius:99px;background:#fff;color:#8a838f;font-size:6px;transition:background .2s ease,color .2s ease,border-color .2s ease}
.report-role-advice button.active{border-color:#443a52;background:#443a52;color:#fff}
.report-role-advice p{min-height:48px;margin:9px 0 0;padding:9px 10px;border-radius:9px;background:#fff;color:#5f5864;font-size:8px;line-height:1.65;animation:report-state-swap .25s ease both}
.report-decision-panel>small{position:absolute;left:157px;right:12px;bottom:9px;color:#a19aa4;font-size:5.5px}

.how-narrative:not(.linear) .how-scene .report-showcase-section{
  --report-phase-two:clamp(0, calc((var(--how-scene-progress, 0) - .42) / .58), 1);
  --report-cross-progress:clamp(0, calc(var(--report-phase-two) / .28), 1);
  --report-advice-progress:clamp(0, calc((var(--report-phase-two) - .22) / .36), 1);
  --report-final-progress:clamp(0, calc((var(--report-phase-two) - .76) / .24), 1);
  --report-scroll-offset:calc(var(--report-phase-two) * var(--report-scroll-distance, -200px));
}
.report-closing-line{position:relative;z-index:3;margin:8px auto 0;color:#5e5665;font:500 13px var(--serif);text-align:center;letter-spacing:.04em;opacity:var(--report-final-progress);transform:translateY(calc((1 - var(--report-final-progress)) * 8px))}
.how-narrative:not(.linear) .how-scene .trust-report-card{height:500px;overflow:hidden}
.how-narrative:not(.linear) .how-scene .trust-report-body{transform:translateY(var(--report-scroll-offset));will-change:transform}
.how-narrative:not(.linear) .how-scene .report-callout.phase-two{opacity:var(--report-advice-progress);transform:translateY(calc((1 - var(--report-advice-progress)) * 7px));animation:none}
.how-narrative:not(.linear) .how-scene .report-callout.phase-two>i{transform:scaleX(var(--report-advice-progress));animation:none}
.how-narrative:not(.linear) .how-scene .report-callout.callout-6{opacity:var(--report-cross-progress)}
.how-narrative:not(.linear) .how-scene .report-callout.callout-6>i{transform:scaleX(var(--report-cross-progress))}
.how-narrative:not(.linear) .how-scene .callout-5{top:390px}
.how-narrative:not(.linear) .how-scene .callout-6{top:247px}
.how-narrative:not(.linear) .how-scene .callout-7{top:340px}
.report-showcase-section.is-static .trust-report-body{transform:none}
.report-showcase-section.is-static .trust-report-card{height:auto;overflow:visible}

@media (max-width:899px){
  .report-decision-panel{grid-template-columns:1fr}
  .report-decision-levels{padding:0 0 10px;border-right:0;border-bottom:1px solid rgba(67,54,82,.08)}
  .report-decision-panel>small{position:static;grid-column:1;margin-top:2px}
  .report-closing-line{margin-top:28px}
}

/* Short desktop windows: a shorter report card (and a longer inner scroll) keeps
   the closing line and the CTA inside the viewport. */
@media (min-width:900px) and (max-height:820px){
  .how-narrative:not(.linear) .how-scene .report-showcase-section{--report-scroll-distance:-290px}
  .how-narrative:not(.linear) .how-scene .trust-report-card{height:410px}
  .how-narrative:not(.linear) .how-scene .callout-5{top:300px}
  .how-narrative:not(.linear) .how-scene .callout-6{top:157px}
  .how-narrative:not(.linear) .how-scene .callout-7{top:250px}
}

/* Learn · 再试一试 — rounds swap in one stage instead of stacking down the page. */
.learn-round-stage{position:relative;transition:min-height .32s ease}
.learn-round-slide{width:100%}
.learn-round-stage .learn-result{margin-top:0}
.learn-quiz-round>header:focus,.learn-result>strong:focus{outline:none}
@media (prefers-reduced-motion:reduce){
  .learn-round-stage{transition:none}
}

/* Team queue · priority hint above the table */
.team-priority-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;margin:14px 0 10px}
.team-priority-hint{min-height:34px;padding:0 14px;border:1px solid rgba(160,90,100,.22);border-radius:99px;background:#fbf0f1;color:#7f4851;font-size:13px}
.team-priority-hint strong{font-weight:700}
.team-priority-hint.active{border-color:#7f4851;background:#7f4851;color:#fff}
.team-priority-hint:disabled{opacity:.5;cursor:default}
.team-priority-row>span{color:#8a838f;font-size:12px}
.team-sort-reset{padding:4px 10px;border:1px solid rgba(63,52,78,.14);border-radius:99px;background:#fff;color:#5d5568;font-size:12px}
.team-score-scope{display:inline-block;padding:2px 6px;border-radius:6px;background:#f1eef4;color:#6f6779;font-size:11px;font-style:normal;white-space:nowrap}

/* Team queue · filter bar readable on a projector (≥13px, roomier options). */
.team-filters{gap:16px 40px;padding:20px 0}
.team-filters>div{gap:12px}
.team-filters>div>span{color:#6f6876;font-size:13px;font-weight:500;white-space:nowrap}
.team-filters>div>div{gap:8px}
.team-filters button{flex:none;height:36px;padding:0 14px;border-radius:9px;font-size:14px;white-space:nowrap}
.team-filters .team-confidence-filter-chip{font-size:13px}
@media (max-width:720px){
  .team-filters>div>div{flex-wrap:nowrap;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
  .team-filters>div>div::-webkit-scrollbar{display:none}
}

/* Team top nav · size the logo by height so it never touches the bar edges. */
.team-top-nav{overflow:visible}
.team-brand{width:auto;height:44px;flex:none;display:flex;align-items:center}
.team-brand img{width:auto;height:100%;max-width:none;object-fit:contain}
@media (max-width:720px){
  .team-brand{height:38px}
}

/* Team related groups · basis line and merged duplicate rows */
.team-related-basis{margin:10px 0 2px;color:#4f4759;font-size:13px;line-height:1.6}
.team-related-merged{border-radius:12px}
.team-related-merged>button{width:100%}
.team-related-count{font:600 14px var(--mono)!important;color:#7f4851!important}
.team-related-merged>ol{margin:0 0 6px 46px;padding:0;list-style:none;display:flex;flex-direction:column;gap:4px}
.team-related-merged>ol>li{display:flex;align-items:center;gap:10px;padding:6px 10px;border-radius:8px;background:#f7f5f9;color:#6b6472;font-size:12px}
.team-related-merged>ol>li>em{padding:2px 6px;border-radius:6px;background:#efe8f6;color:#6c5a85;font-size:11px;font-style:normal}
.team-related-merged>ol>li>button{margin-left:auto;padding:3px 9px;border:1px solid rgba(63,52,78,.14);border-radius:99px;background:#fff;color:#5d5568;font-size:12px}
/* Merged rows reuse the member-row layout (the base rules only match direct-child buttons). */
.team-related-merged>button{position:relative;width:100%;min-height:72px;padding:12px 4px;border:0;border-bottom:1px solid rgba(61,50,76,.07);background:transparent;display:grid;grid-template-columns:25px minmax(0,1fr) auto;gap:9px 11px;align-items:center;text-align:left;color:#4a424f;transition:background .2s ease,padding .2s ease}
.team-related-merged>button:hover,.team-related-merged>button:focus-visible{padding-left:9px;padding-right:9px;background:#f5f1f8;outline:none}
.team-related-merged>button>span{color:#a097a3;font:7px var(--mono)}
.team-related-merged>button>div{min-width:0}
.team-related-merged>button>b{opacity:1}
.team-related-merged.open>button{border-bottom-color:transparent}
.team-related-merged>ol{margin-top:2px;margin-bottom:10px}
.team-related-merged>ol>li>time{grid-column:auto;font-size:12px}
.team-related-merged>ol>li>em{grid-column:auto;justify-self:auto;margin-top:0}
@media (max-width:720px){
  .team-related-merged>button{grid-template-columns:21px minmax(0,1fr)}
  .team-related-merged>ol{margin-left:30px}
}

/* Team related groups · relationship graph */
.team-group-graph{margin:14px 0 4px;padding:12px 12px 10px;border:1px solid rgba(61,50,76,.08);border-radius:14px;background:#faf9fb}
.team-group-graph svg{display:block;width:100%;max-width:520px;height:auto;margin:0 auto}
.team-group-graph .graph-link{stroke-width:1.6;stroke-linecap:round}
.team-group-graph .link-account{stroke:#7d6aa3}
.team-group-graph .link-image{stroke:#b47780;stroke-dasharray:6 4}
.team-group-graph .link-title{stroke:#c79a4f;stroke-dasharray:1.5 3.5}
.team-group-graph .link-time{stroke:#a8a1ad;stroke-width:1}
.team-group-graph .graph-node{cursor:default;outline:none}
.team-group-graph .graph-node circle{stroke:#fff;stroke-width:2;transition:r .15s ease}
.team-group-graph .graph-node text{fill:#fff;font:600 8px var(--mono);pointer-events:none}
.team-group-graph .graph-node.active circle,.team-group-graph .graph-node:focus-visible circle{stroke:#3b3346}
.team-group-graph .tone-high circle,.team-group-graph i.tone-high{fill:#b47780;background:#b47780}
.team-group-graph .tone-medium circle,.team-group-graph i.tone-medium{fill:#d4ae66;background:#d4ae66}
.team-group-graph .tone-trusted circle,.team-group-graph i.tone-trusted{fill:#82a28e;background:#82a28e}
.team-group-graph .tone-unknown circle{fill:#b5afb9}
.team-group-graph .tone-more circle{fill:#ece8f0;stroke:#d8d2de}
.team-group-graph .tone-more text{fill:#5d5568}
.team-group-graph .graph-center text{font-size:10px}
.team-group-graph-tip{min-height:20px;margin:6px 0 0;color:#5f5866;font-size:12px;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.team-group-graph figcaption{margin-top:6px;display:flex;flex-wrap:wrap;justify-content:center;gap:4px 14px;color:#8a838f;font-size:11px}
.team-group-graph figcaption span{display:inline-flex;align-items:center;gap:5px}
.team-group-graph .legend-link i{width:18px;height:0;border-top:2px solid}
.team-group-graph .legend-link.link-account i{border-color:#7d6aa3}
.team-group-graph .legend-link.link-image i{border-top-style:dashed;border-color:#b47780}
.team-group-graph .legend-link.link-title i{border-top-style:dotted;border-color:#c79a4f}
.team-group-graph .legend-link.link-time i{border-top-width:1px;border-color:#a8a1ad}
.team-group-graph .legend-risk i{width:8px;height:8px;margin-left:6px;border-radius:50%}

/* Team summary · role-specific cards (3 metrics + action distribution + shared risk panel) */
.team-summary{grid-template-columns:repeat(3,minmax(120px,150px)) minmax(190px,220px) 1fr}
.team-summary>div>span{font-size:12px}
.team-role-card>small{color:#a19aa5;font-size:11px;line-height:1.4}
.team-action-distribution ul{margin:4px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:5px}
.team-action-distribution li{display:flex;align-items:baseline;gap:8px;color:#5f5866;font-size:12px}
.team-action-distribution li b{min-width:26px;font:500 18px/1 var(--serif);color:#2f2a38}
.team-action-distribution li em{font-style:normal}
@media (max-width:1100px){
  .team-summary{grid-template-columns:repeat(2,minmax(0,1fr))}
  .team-summary>.team-risk-distribution{grid-column:1/-1}
}

/* Team queue · export + review flow */
.team-export-button{margin-left:auto;min-height:36px;padding:0 14px;border:1px solid #3b3346;border-radius:10px;background:#3b3346;color:#fff;font-size:13px;display:inline-flex;align-items:center;gap:8px}
.team-export-button small{color:rgba(255,255,255,.72);font-size:11px}
.team-export-button:disabled{opacity:.4;cursor:default}
.team-drawer-next{width:100%;min-height:44px;margin-top:10px;border:0;border-radius:12px;background:#7f4851;color:#fff;font-size:13px}
.team-drawer-next:disabled{opacity:.45;cursor:default}
.team-drawer-notice{margin:12px 0 0;padding:10px 12px;border-radius:10px;background:#e4efe8;color:#4d765f;font-size:13px;text-align:center}
@media (max-width:720px){.team-export-button{margin-left:0}}

/* Team · 关联分组: the container is far taller than the viewport, so the global
   scroll-reveal (8% visible) never fired until the user scrolled. Show it at once. */
.tl-ui-ready .team-workspace .team-related-groups.tl-reveal.tl-reveal:not(.tl-in-view),
.tl-ui-ready .team-workspace .team-related-groups.tl-reveal.tl-reveal{opacity:1;translate:none;scale:none;transition:none}

/* Sidebar · 最近任务 scrolls on its own; the account area stays pinned at the bottom. */
.sidebar{min-height:0;overflow:hidden}
.sidebar>.history{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding-right:2px;scrollbar-width:thin;scrollbar-color:rgba(61,54,85,.18) transparent}
.sidebar>.history::-webkit-scrollbar{width:6px}
.sidebar>.history::-webkit-scrollbar-thumb{border-radius:99px;background:rgba(61,54,85,.16)}
.sidebar>.side-bottom{flex:none}

/* Analysis three-step progress: dots + connectors on one row, copy underneath,
   so a connector never runs through a title. */
.analysis-process-progress>div:first-child{gap:18px}
.analysis-process-progress>div:first-child>div{display:flex;flex-direction:column;align-items:flex-start;gap:9px;color:#6f6878}
.analysis-process-progress>div:first-child>div>span{position:relative;z-index:2;width:26px;height:26px;font-size:11px}
.analysis-process-progress>div:first-child>div>div{position:relative;z-index:2;gap:4px}
.analysis-process-progress>div:first-child>div>i{z-index:0;left:34px;right:-10px;top:12px;height:2px}
.analysis-process-progress>div:first-child>div strong{font-size:13px;line-height:1.35;font-weight:500;color:#625b6a}
.analysis-process-progress>div:first-child>div small{font-size:11px;line-height:1.45;color:#8a8392}
.analysis-process-progress>div:first-child>div.active strong,.analysis-process-progress>div:first-child>div.completed strong{color:#2f2a38}
.analysis-process-progress>div:first-child>div.active small,.analysis-process-progress>div:first-child>div.completed small{color:#6c6574}
@media (max-width:640px){
  .analysis-process-progress>div:first-child{gap:10px}
  .analysis-process-progress>div:first-child>div{display:flex;gap:7px}
  .analysis-process-progress>div:first-child>div>span{width:22px;height:22px;font-size:10px}
  .analysis-process-progress>div:first-child>div>i{left:28px;right:-6px;top:10px}
  .analysis-process-progress>div:first-child>div strong{font-size:12px}
  .analysis-process-progress>div:first-child>div small{font-size:10px;line-height:1.4}
}

/* Recognition step / link error / result entry — ported from kkk/src/index.css */
.verification-workspace{overflow-y:auto}.verification-workspace::before{position:fixed}.verification-workspace-center{width:min(850px,calc(100% - 40px));padding:34px 0 78px}.verification-input,.verification-recognition-panel,.verification-feedback-panel{padding:20px;border:1px solid rgba(54,45,69,.11);border-radius:21px;background:rgba(255,255,255,.82);box-shadow:0 18px 58px rgba(54,43,74,.09);backdrop-filter:blur(22px);text-align:left}.verification-entry-tabs{display:flex;border-bottom:1px solid var(--line)}.verification-entry-tabs button{position:relative;min-width:150px;height:42px;padding:0 17px;border:0;background:transparent;color:#918a96;font-size:10px}.verification-entry-tabs button::after{content:"";position:absolute;left:17px;right:17px;bottom:-1px;height:2px;background:#7964a0;transform:scaleX(0);transition:transform .2s ease}.verification-entry-tabs button.active{background:#fff;color:#3d3545;font-weight:600}.verification-entry-tabs button.active::after{transform:scaleX(1)}
.verification-feedback-panel{max-width:620px;margin:0 auto;padding:34px;text-align:center}.verification-panel-icon{width:44px;height:44px;margin:0 auto 12px;border-radius:14px;background:#eee8f5;color:#705e88;display:grid;place-items:center;font:500 15px var(--serif)}.verification-feedback-panel>small,.verification-recognition-panel>header>small{color:#8c8194;font:6px var(--mono);letter-spacing:.1em}.verification-feedback-panel h3,.verification-recognition-panel h3{margin:9px 0 7px;font:500 24px/1.25 var(--serif);color:#342d3c}.verification-feedback-panel>p,.verification-recognition-panel>header>p{margin:0;color:#817a86;font-size:9px;line-height:1.7}.verification-feedback-panel>button,.verification-feedback-panel>div button{height:38px;margin-top:19px;padding:0 13px;border:0;border-radius:9px;background:#302a40;color:#fff;display:inline-flex;align-items:center;gap:7px;font-size:8px}.verification-feedback-panel>div{display:flex;justify-content:center;gap:8px}.verification-feedback-panel>div button:first-child{border:1px solid rgba(58,49,73,.11);background:#fff;color:#706875}
.verification-recognition-panel{max-width:790px;margin:0 auto}.verification-recognition-panel>header{text-align:center}.recognition-layout{margin-top:20px;padding:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:25px}.recognition-layout>section>span{display:block;margin-bottom:10px;color:#8c8491;font:7px var(--mono);letter-spacing:.06em}.recognition-layout>section:first-child{padding-right:24px;border-right:1px solid var(--line)}.recognition-layout>section:first-child>div{min-height:36px;border-bottom:1px solid rgba(58,49,73,.06);display:grid;grid-template-columns:auto 1fr auto auto;gap:7px;align-items:center}.recognition-layout>section:first-child i{width:19px;height:19px;border-radius:6px;background:#e2eee7;color:#547461;display:grid;place-items:center;font-size:7px;font-style:normal}.recognition-layout>section:first-child .missing{opacity:.48}.recognition-layout>section:first-child .missing i{background:#eeecef;color:#8c858f}.recognition-layout>section:first-child strong{font-size:8px;font-weight:500}.recognition-layout>section:first-child small{color:#817789;font:6px var(--mono)}.recognition-layout>section:first-child button{padding:4px 6px;border:0;border-radius:6px;background:#eee8f5;color:#6d5a84;font-size:6px}.recognition-layout>section:last-child{display:grid;grid-template-columns:1fr 1fr;gap:7px;align-content:start}.recognition-layout>section:last-child>span{grid-column:1/3}.recognition-layout>section:last-child>div{min-height:58px;padding:9px;border:1px solid rgba(59,48,73,.08);border-radius:10px;background:#faf9fb;display:grid;grid-template-columns:auto 1fr;gap:8px;align-items:center}.recognition-layout>section:last-child>div.disabled{opacity:.38;filter:grayscale(.7)}.recognition-layout .report-dimension-badge{width:30px;height:30px;border-radius:9px}.recognition-layout>section:last-child>div>div{display:flex;flex-direction:column;gap:3px}.recognition-layout>section:last-child strong{font-size:8px;font-weight:500}.recognition-layout>section:last-child small{color:#8f8794;font-size:6px;line-height:1.4}.recognition-scope-note{margin:14px 0 0;padding:10px 11px;border-radius:9px;background:#f3eff7;color:#6f6479;display:flex;align-items:center;gap:7px;font-size:7px}.verification-recognition-panel>footer{margin-top:15px;display:flex;justify-content:flex-end;gap:8px}.verification-recognition-panel>footer button{height:38px;padding:0 13px;border:1px solid rgba(58,49,73,.11);border-radius:9px;background:#fff;color:#716976;font-size:8px}.verification-recognition-panel>footer button:last-child{border-color:#302a40;background:#302a40;color:#fff;display:flex;align-items:center;gap:7px}
@media (max-width:640px){.verification-workspace-center{width:calc(100% - 24px);padding-top:25px}.verification-input,.verification-recognition-panel,.verification-feedback-panel{padding:14px;border-radius:17px}.verification-entry-tabs button{min-width:0;flex:1;padding:0 7px}.link-verification-form,.content-verification-grid,.recognition-layout{grid-template-columns:1fr}.link-verification-form{gap:14px}.recognition-layout>section:first-child{padding:0 0 17px;border-right:0;border-bottom:1px solid var(--line)}.recognition-layout>section:last-child{grid-template-columns:1fr}.recognition-layout>section:last-child>span{grid-column:1}.supplemental-materials>div{grid-template-columns:1fr}.verification-submit-row{grid-template-columns:1fr auto}.verification-submit-row>small{grid-column:1}.verification-start-button{grid-column:1/3;justify-content:center}.verification-feedback-panel>div{align-items:stretch;flex-direction:column}.verification-feedback-panel>div button{width:100%;justify-content:center}.verification-recognition-panel>footer{display:grid;grid-template-columns:1fr 1fr}.verification-recognition-panel>footer button:last-child{justify-content:center}}
.analysis-result-entry{margin-top:17px;padding:19px;border:1px solid rgba(92,72,137,.15);border-radius:16px;background:linear-gradient(125deg,#f2edfb,#faf6f8);display:flex;flex-direction:column;align-items:center;gap:9px;text-align:center;box-shadow:0 12px 34px rgba(70,52,103,.07)}.analysis-result-entry>small{color:#817887;font-size:8px}.analysis-result-entry>button{min-width:210px;height:43px;padding:0 21px;border:0;border-radius:12px;background:#302a40;color:#fff;font-size:10px;font-weight:500;box-shadow:0 9px 24px rgba(48,42,64,.2);animation:result-entry-breathe 2.4s ease-in-out infinite;transition:transform .2s ease,box-shadow .2s ease}.analysis-result-entry>button:hover,.analysis-result-entry>button:focus-visible{transform:translateY(-2px);box-shadow:0 13px 30px rgba(71,55,98,.27);outline:2px solid rgba(126,103,174,.25);outline-offset:3px}
@keyframes result-entry-breathe{0%,100%{box-shadow:0 9px 24px rgba(48,42,64,.2),0 0 0 0 rgba(126,103,174,0)}50%{box-shadow:0 12px 29px rgba(48,42,64,.25),0 0 0 7px rgba(126,103,174,.08)}}
.verification-recognition-panel,.verification-feedback-panel{width:100%}
.verification-recognition-panel h3,.verification-feedback-panel h3{font-size:26px}
.verification-recognition-panel>header>p,.verification-feedback-panel>p{font-size:13px}
.recognition-layout>section>span{font-size:11px}
.recognition-layout>section:first-child strong,.recognition-layout>section:last-child strong{font-size:13px}
.recognition-layout>section:first-child small,.recognition-layout>section:last-child small{font-size:11px}
.recognition-layout>section:first-child i{width:22px;height:22px;font-size:11px}
.recognition-layout>section:first-child .expected i{background:#efe9f7;color:#6c5a85}
.recognition-layout>section:first-child button{font-size:11px;padding:4px 9px}
.recognition-thumb{width:34px;height:34px;border-radius:7px;object-fit:cover}
.recognition-scope-note{display:flex;align-items:center;justify-content:center;gap:6px;margin:14px 0 0;color:#7d7684;font-size:12px}
.verification-recognition-panel>footer{margin-top:16px;display:flex;justify-content:flex-end;gap:10px}
.verification-recognition-panel>footer button{height:42px;padding:0 18px;border:1px solid rgba(58,49,73,.12);border-radius:11px;background:#fff;color:#5d5568;font-size:13px;display:inline-flex;align-items:center;gap:7px}
.verification-recognition-panel>footer button:last-child{border-color:#302a40;background:#302a40;color:#fff}
.verification-feedback-panel>div button{font-size:13px;height:42px;padding:0 16px}
.link-error-tips{max-width:460px;margin:14px auto 0;padding:12px 16px 12px 30px;border-radius:12px;background:#fbf0f1;color:#7f4851;font-size:13px;line-height:1.8;text-align:left}
.verification-panel-icon{background:#f3e0e3;color:#92535c}
.analysis-result-entry>small{font-size:12px}
.analysis-result-entry>button{font-size:14px}
.live-error .live-resume-button{margin-left:8px}

/* Workspace: scroll vertically whenever its content (e.g. the 识别结果 page) is taller
   than the screen, so 「确认并开始」 is always reachable. Horizontal stays clipped for the orbs. */
.workspace{overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
.workspace:focus{outline:none}

/* Creator self-check · experts with no pre-publish data are shown greyed out (未启用). */
.council-role-disabled .council-role{opacity:.55;filter:grayscale(.85);cursor:default;pointer-events:none}
.council-role-disabled .council-role p{color:#8a8392}
.council-role-disabled .role-judgement small{color:#9a94a0}

/* Creator self-check · record locked until the self-check is complete */
.creator-selfcheck-locked{filter:grayscale(1);opacity:.78;background:#f4f3f6!important;border-style:dashed!important}
.creator-selfcheck-locked .creator-record-heading strong{color:#6f6a76}
.creator-selfcheck-locked .creator-record-heading small{color:#7d7884;font-size:12px;line-height:1.6}
.creator-pending-steps{margin:12px 0 0;padding:0 0 0 18px;color:#6d6874;font-size:12px;line-height:1.8}
.creator-locked-action{display:inline-flex}
.creator-locked-action>button:disabled{opacity:.45;cursor:not-allowed;pointer-events:none}
.creator-badge-actions button:disabled{opacity:.45;cursor:not-allowed}
.creator-recheck-error{margin:12px 0 0}

/* Creator self-check · 自检记录 card (shared by 尚未完成 / 已完成). New class names on purpose:
   the legacy .creator-selfcheck-badge rules target children by position. */
.creator-record-area{grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:20px;padding:20px}
.creator-record-column{min-width:0;display:flex;flex-direction:column;gap:10px}
.creator-record-card{padding:28px;border:1px solid #cdbfe3;border-radius:18px;background:#faf8fd;display:flex;flex-direction:column;gap:18px;box-shadow:0 10px 28px rgba(71,53,98,.06)}
.creator-record-card.is-locked{border-style:dashed;border-color:#cfc9d6;background:#f6f5f8;box-shadow:none}
.creator-record-card-head{display:flex;align-items:center;gap:18px}
.creator-record-card-head>img{flex:none;width:84px;height:auto}
.creator-record-card.is-locked .creator-record-card-head>img{filter:grayscale(1);opacity:.55}
.creator-record-card-head>div{min-width:0;display:flex;flex-direction:column;gap:6px}
.creator-record-label{color:#857d8d;font:500 11px/1.4 var(--mono);letter-spacing:.06em}
.creator-record-title{color:#2f2a38;font:600 20px/1.3 "Noto Sans SC","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif}
.creator-record-card.is-locked .creator-record-title{color:#4f4957}
.creator-record-note{margin:0;color:#635d6b;font-size:13px;line-height:1.6}
.creator-record-compare{display:flex;flex-wrap:wrap;gap:12px}
.creator-record-compare>span{flex:1 1 200px;padding:12px 14px;border-radius:12px;background:#fff;border:1px solid rgba(75,61,92,.08);display:grid;grid-template-columns:auto 1fr auto auto auto;gap:6px 8px;align-items:center;color:#6e6775}
.creator-record-compare i{width:26px;height:26px;border-radius:8px;background:#e8f3ed;color:#557c68;display:grid;place-items:center;font:600 12px var(--mono);font-style:normal}
.creator-record-compare .is-image i{background:#e6f0ff;color:#577890}
.creator-record-compare small{font-size:13px}
.creator-record-compare b{color:#9a929d;font:500 18px var(--serif)}
.creator-record-compare em{color:#a89daf;font:13px var(--mono);font-style:normal}
.creator-record-compare strong{color:#3f6a55;font:600 24px var(--serif)}
.creator-record-steps{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px}
.creator-record-steps li{display:flex;align-items:flex-start;gap:10px;color:#4f4957;font-size:13px;line-height:1.6;word-break:normal;overflow-wrap:anywhere}
.creator-record-steps li>i{flex:none;width:18px;height:18px;margin-top:2px;border:1.5px solid #a9a2b1;border-radius:50%;display:grid;place-items:center;font-size:11px;font-style:normal}
.creator-record-steps li.done{color:#3f6a55}
.creator-record-steps li.done>i{border-color:#5f8e74;background:#5f8e74;color:#fff}
.creator-record-steps li>span{flex:1 1 auto;min-width:0}
.creator-record-tally{margin:0;padding-top:14px;border-top:1px solid rgba(75,61,92,.08);color:#4f4957;font-size:13px}
.creator-badge-area.creator-record-area>.creator-record-column>small.creator-record-disclaimer{display:block;margin-top:0;color:#7d7684;font-size:11px;line-height:1.6}
.creator-record-area .creator-badge-actions{padding-top:4px}
.creator-record-area .creator-badge-actions button{font-size:13px;height:40px}
@media (max-width:720px){
  .creator-record-area{grid-template-columns:1fr;padding:14px}
  .creator-record-card{padding:22px}
  .creator-record-card-head{align-items:flex-start}
  .creator-record-card-head>img{width:64px}
  .creator-record-title{font-size:18px}
  .creator-record-area .creator-badge-actions{display:grid;grid-template-columns:1fr 1fr}
}
@media print{
  /* 导出 PDF: keep the record and its disclaimer, drop on-screen actions. */
  .creator-record-area .creator-badge-actions,.creator-report-actions>div,.creator-recheck-error{display:none!important}
  .creator-record-area{grid-template-columns:1fr}
  .creator-record-card{box-shadow:none;break-inside:avoid}
}

/* Creator self-check · appeal entry and status */
.creator-dispute-link{align-self:flex-start;margin-top:8px;padding:2px 0;border:0;background:transparent;color:#6c5a85;font-size:12px;text-decoration:underline;text-underline-offset:3px}
.creator-dispute-link:hover,.creator-dispute-link:focus-visible{color:#3f3150;outline:none}
.creator-appeal-flag{display:inline-flex;align-items:center;margin-left:8px;padding:2px 8px;border-radius:99px;background:#efe8f6;color:#6c5a85;font-size:11px;font-weight:500;letter-spacing:0}
