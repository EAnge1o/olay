  { id: 6, title: "平价面霜用了一个月", author: "慢慢空瓶记", score: 84, risk: "高可信", confidence: "高", dimensions: ["R"], contradiction: "对比图轻度修饰", issueType: "疑似 AI 生成", actions: { platform: "加提示标注", brand: "可作合作参考，建议注明修图" }, status: "已处理", checks: [["“自然光原图”", "右侧纹理轻度平滑"], ["“使用一个月”", "时间线与发布记录一致"]] },
  { id: 7, title: "成分表看不懂？一篇讲清楚", author: "配方阅读课", score: 58, risk: "高风险", confidence: "低", dimensions: ["S"], contradiction: "材料有限，仅核验文案", issueType: "凭证矛盾", actions: { platform: "补充材料后复核", brand: "暂不判断，建议补充材料" }, status: "待复核", checks: [["“成分结论有出处”", "未附数据来源"], ["“完整核验”", "仅提供文案材料"]] },
