}

const evidenceDimensionOptions: Record<DimensionCode, { label: string; hint: string }> = {
  T: { label: "账号可信度", hint: "账号主页链接、简介或历史发布记录" },
  R: { label: "图像原生性", hint: "原始图片、对比图或局部细节截图" },
  U: { label: "评论自然度", hint: "评论区截图、评论文本或发布时间信息" },
  S: { label: "文案真实性", hint: "笔记正文、标题或功效描述" },
};

function EvidenceExpansionPrompt({
  availableCodes,
  onAddEvidence,
}: {
  availableCodes: DimensionCode[];
  onAddEvidence: (code: DimensionCode) => void;
}) {
  const missingCodes = allDimensions.filter((code) => !availableCodes.includes(code));
  const [mode, setMode] = useState<"idle" | "adding" | "dismissed">("idle");
  const [selectedCode, setSelectedCode] = useState<DimensionCode>(missingCodes[0] ?? "T");
  const [evidenceText, setEvidenceText] = useState("");
  const [filename, setFilename] = useState("");
  const [addedCode, setAddedCode] = useState<DimensionCode | null>(null);
  const fileRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    if (!missingCodes.includes(selectedCode) && missingCodes[0]) setSelectedCode(missingCodes[0]);
  }, [missingCodes, selectedCode]);

  if (!missingCodes.length || mode === "dismissed") return null;

  const submitEvidence = () => {
    if (!evidenceText.trim() && !filename) return;
    onAddEvidence(selectedCode);
    setAddedCode(selectedCode);
    setEvidenceText("");
    setFilename("");
    setMode("idle");
  };

  return (
    <section className="evidence-expansion-prompt" aria-live="polite">
      <div className="evidence-expansion-heading">
        <span>
          <Icon size={18}>
            <path d="M12 4v16M4 12h16" stroke="currentColor" strokeLinecap="round" strokeWidth="1.4" />
          </Icon>
        </span>
        <div>
          <small>MORE EVIDENCE · 可选</small>
          <h3>{addedCode ? `${evidenceDimensionOptions[addedCode].label}证据已加入` : "要加入更多维度的证据吗？"}</h3>
          <p>
            {addedCode
              ? `报告已纳入新的证据维度。你还可以继续补充其余 ${missingCodes.length} 个维度。`
              : `当前报告基于 ${availableCodes.length} 个维度生成。补充证据可以让交叉核验更充分，也可以保留当前结果。`}
          </p>
        </div>
      </div>

      {mode === "idle" ? (
        <div className="evidence-expansion-actions">
          <button onClick={() => { setAddedCode(null); setMode("adding"); }}>补充更多证据</button>
          <button onClick={() => setMode("dismissed")}>先看当前报告</button>
        </div>
      ) : (
        <div className="evidence-expansion-form">
          <div aria-label="选择要补充的证据维度" className="missing-dimension-options" role="group">
            {missingCodes.map((code) => (
              <button
                aria-pressed={selectedCode === code}
                className={selectedCode === code ? "active" : ""}
                key={code}
                onClick={() => setSelectedCode(code)}
              >
                <span>{code}</span>
                <div><strong>{evidenceDimensionOptions[code].label}</strong><small>{evidenceDimensionOptions[code].hint}</small></div>
              </button>
            ))}
          </div>
          <label className="evidence-expansion-input">
            <span>粘贴链接或补充说明</span>
            <textarea
              onChange={(event) => setEvidenceText(event.target.value)}
              placeholder={evidenceDimensionOptions[selectedCode].hint}
              rows={3}
              value={evidenceText}
            />
          </label>
          <div className="evidence-expansion-submit">
            <input
              accept="image/*"
              onChange={(event) => setFilename(event.target.files?.[0]?.name ?? "")}
              ref={fileRef}
              type="file"
            />
            <button className="evidence-upload-button" onClick={() => fileRef.current?.click()}>
              <Icon size={15}><path d="M12 16V5m0 0L8 9m4-4 4 4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.4" /></Icon>
              {filename || "上传截图"}
            </button>
            <div>
              <button onClick={() => setMode("idle")}>暂不补充</button>
              <button
                className="evidence-submit-button"
                disabled={!evidenceText.trim() && !filename}
                onClick={submitEvidence}
              >
                加入证据并重新核验
              </button>
            </div>
          </div>
        </div>
      )}
    </section>
  );
}

type CrossCheckState = "conflict" | "consistent" | "corroborated" | "doubtful" | "unverified";

export type CrossCheckItem = {
  id: string;
  from: DimensionCode;
  to: DimensionCode;
  left: string;
  right: string;
  conclusion: string;
  state: CrossCheckState;
  dimension: string;
  detail: string;
  confidence?: "高" | "中" | "低";
  method?: ConclusionMethod;
  kind?: "material-trace";
  label?: string;
};

