function HeroActionIcon({ name }: { name: HeroSceneData["icon"] }) {
  if (name === "search") {
    return <Icon size={28}><circle cx="11" cy="11" r="6" stroke="currentColor" strokeWidth="1.35" /><path d="m16 16 4 4M8 11h6M11 8v6" stroke="currentColor" strokeLinecap="round" strokeWidth="1.35" /></Icon>;
  }
  if (name === "focus") {
    return <Icon size={28}><path d="M4 9V5a1 1 0 0 1 1-1h4m6 0h4a1 1 0 0 1 1 1v4m0 6v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4M8 12h8" stroke="currentColor" strokeLinecap="round" strokeWidth="1.35" /></Icon>;
  }
  if (name === "comment") {
    return <Icon size={28}><path d="M5 17.5 3.8 21l4-2.1c1.2.7 2.6 1.1 4.2 1.1 4.9 0 8.8-3.5 8.8-8S16.9 4 12 4s-8.8 3.5-8.8 8c0 2.1.7 4 1.8 5.5Z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.35" /><path d="M8 12h8M8 9h5" stroke="currentColor" strokeLinecap="round" strokeWidth="1.35" /></Icon>;
  }
  if (name === "quote") {
    return <Icon size={28}><path d="M7.5 8.5H5.7A2.7 2.7 0 0 0 3 11.2V16h5v-5H5.6M17.5 8.5h-1.8a2.7 2.7 0 0 0-2.7 2.7V16h5v-5h-2.4" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.35" /></Icon>;
  }
  if (name === "consistency") {
    return <Icon size={28}><circle cx="9" cy="12" r="5.5" stroke="currentColor" strokeWidth="1.35" /><circle cx="15" cy="12" r="5.5" stroke="currentColor" strokeWidth="1.35" /></Icon>;
  }
  if (name === "compass") {
    return <Icon size={28}><circle cx="12" cy="12" r="8.5" stroke="currentColor" strokeWidth="1.35" /><path d="m15.5 8.5-2.1 4.9-4.9 2.1 2.1-4.9 4.9-2.1Z" stroke="currentColor" strokeLinejoin="round" strokeWidth="1.35" /></Icon>;
  }
  return <Sparkle size={28} />;
}

