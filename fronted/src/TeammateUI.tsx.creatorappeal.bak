function PromiseCard({ data }: { data: PromiseData }) {
  const cardRef = useRef<HTMLElement>(null);
  const reducedMotion = Boolean(useReducedMotion());
  const playedRef = useRef(false);
  const [replayKey, setReplayKey] = useState(0);

  useEffect(() => {
    const card = cardRef.current;
    if (!card || reducedMotion) return;
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !playedRef.current) {
        playedRef.current = true;
        setReplayKey((key) => key + 1);
        observer.disconnect();
      }
    }, { threshold: 0.35 });
    observer.observe(card);
    return () => observer.disconnect();
  }, [reducedMotion]);

  const replay = () => {
    if (!reducedMotion) setReplayKey((key) => key + 1);
  };

  return (
    <article
      className="promise-card"
      onClick={replay}
      onKeyDown={(event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          replay();
        }
      }}
      onMouseEnter={replay}
      ref={cardRef}
      tabIndex={0}
    >
      <span className="promise-card-label"><b>{data.number}</b><i />{data.label}</span>
      {data.id === "evidence" && <EvidencePromiseDemo data={data} reducedMotion={reducedMotion} replayKey={replayKey} />}
      {data.id === "restraint" && <RestraintPromiseDemo data={data} reducedMotion={reducedMotion} replayKey={replayKey} />}
      {data.id === "appeal" && <AppealPromiseDemo data={data} reducedMotion={reducedMotion} replayKey={replayKey} />}
      <div className="promise-card-copy">
        <h3>{data.title}</h3>
        <p>{data.description}</p>
      </div>
    </article>
  );
}

function TrustVerificationBand() {
  const data = whyTrustContent.verification;
  const hasUnfilledPlaceholder = [data.sample, data.metric].some((value) => /\{[A-Z_]+\}/.test(value));
  if (hasUnfilledPlaceholder) return null;
  return (
    <section className="trust-verification-band">
      <div>
        <div className="verification-weights">
          {data.weights.map((weight) => <i className={`weight-${weight.code.toLowerCase()}`} key={weight.code} style={{ flex: weight.value }}>{weight.code} {weight.value}%</i>)}
        </div>
        <small>{data.caption}</small>
      </div>
      <p><span>{data.sample}</span><strong>{data.metric}</strong></p>
    </section>
  );
}

