  { id: "purchase", from: "T", to: "R", left: "账号：历史图片风格稳定", right: "图片：主体与既往内容一致", conclusion: "已比对，未发现矛盾", state: "consistent", confidence: "中", dimension: "账号 × 图片", detail: "当前图片主体、拍摄环境与账号既往发布风格一致，暂未发现来源冲突。" },
  { id: "account-comments", from: "T", to: "U", left: "账号：互动增长连续", right: "评论：用户表达分散自然", conclusion: "账号互动与评论分布相互佐证", state: "corroborated", confidence: "中", dimension: "账号 × 评论", detail: "账号互动增长没有突变，评论发布时间与表达方式也较为分散，两类信号相互支持。" },
  { id: "identity-copy", from: "T", to: "S", left: "账号：长期发布美妆内容", right: "文案：当前为底妆体验分享", conclusion: "主题匹配，账号与文案一致", state: "consistent", confidence: "高", dimension: "账号 × 文案", detail: "历史内容长期围绕美妆与护肤展开，本篇底妆分享没有偏离账号稳定主题。" },
  { id: "image-comments", from: "R", to: "U", left: "图片：展示局部肤质细节", right: "评论：围绕肤质和妆效讨论", conclusion: "已比对，未发现矛盾", state: "consistent", confidence: "中", dimension: "图片 × 评论", detail: "评论讨论集中在图片可见的肤质和妆效细节，暂未发现评论描述与画面明显冲突。" },
  { id: "copy-image", from: "S", to: "R", left: "文案：“同一光源未修图”", right: "图片：左右图色彩被统一调整", conclusion: "文案与图片存在待说明差异", state: "doubtful", confidence: "中", dimension: "文案 × 图片", detail: "文案声称同一光源且未修图，但图像检测到左右图色彩被统一调整，建议补充修图与拍摄条件说明。" },
  { id: "claim-feedback", from: "S", to: "U", left: "文案：保留个人体验边界", right: "评论：保湿与成分反馈具体", conclusion: "用户反馈支持文案的温和体验", state: "corroborated", confidence: "中", dimension: "文案 × 评论", detail: "评论集中在肤质、保湿感和成分等具体体验，没有集中复述夸大功效话术。" },
];

const crossCheckStateLabels: Record<CrossCheckState, string> = {
  conflict: "矛盾",
  consistent: "一致",
  corroborated: "佐证",
  doubtful: "存疑",
  unverified: "未核验",
};

const crossCheckDimensionNames: Record<DimensionCode, { material: string; short: string }> = {
  T: { material: "账号", short: "账号" },
  R: { material: "图片", short: "图片" },
  U: { material: "评论", short: "评论" },
  S: { material: "文案", short: "文案" },
};

const intraDimensionChecks: Record<DimensionCode, Omit<CrossCheckItem, "from" | "to">> = {
  T: { id: "intra-t", left: "账号历史：内容主题连续", right: "账号当前：发布节奏稳定", conclusion: "账号内部信息前后一致", state: "consistent", confidence: "中", dimension: "账号维度内", detail: "账号历史主题、身份信息与当前发布节奏之间暂未发现明显矛盾。" },
  R: { id: "intra-r", left: "图片文字：妆效对比", right: "图片画面：展示对应区域", conclusion: "图片文字与画面一致", state: "consistent", confidence: "中", dimension: "图片维度内", detail: "图片中的文字标注能够对应画面区域，当前未发现文字描述与可见内容相互矛盾。" },
  U: { id: "intra-u", left: "评论观点：存在不同体验", right: "评论互动：追问与回复连续", conclusion: "评论内部语境自洽", state: "consistent", confidence: "中", dimension: "评论维度内", detail: "评论观点存在自然差异，追问与回复关系连续，暂未发现明显的内部语义冲突。" },
  S: { id: "intra-s", left: "文案前段：个人使用感受", right: "文案后段：效果因人而异", conclusion: "文案前后表述未发现矛盾", state: "consistent", confidence: "中", dimension: "文案维度内", detail: "文案中的体验描述与边界声明能够相互对应，暂未发现前后自相矛盾。" },
};

function getCrossCheckItems(activeDimensions: DimensionCode[], creatorMode = false) {
  const enabled = new Set(activeDimensions);
  const pairItems = crossCheckPairResults.map((item) => {
    if (enabled.has(item.from) && enabled.has(item.to)) {
      if (creatorMode && item.id === "copy-image") {
        return {
          ...item,
          left: "文案：声称“真实对比”",
          right: "图片：图 1 检测到局部磨皮",
          conclusion: "图片有轻度修饰，建议主动注明",
          detail: "文案声称“真实对比”，图 1 检测到局部磨皮。建议友好说明滤镜或修饰情况，帮助读者准确理解。",
        };
      }
      return item;
    }
    const missing = [item.from, item.to].filter((code) => !enabled.has(code));
    const missingText = missing.map((code) => crossCheckDimensionNames[code].material).join("、");
    const leftName = crossCheckDimensionNames[item.from].short;
    const rightName = crossCheckDimensionNames[item.to].short;
    return {
      ...item,
      left: `${leftName} × ${rightName}`,
      right: `缺少${missingText}材料`,
      conclusion: `未提供${missingText}，无法比对${leftName}与${rightName}`,
      state: "unverified" as const,
      confidence: undefined,
      detail: `本次未启用${missingText}维度，因此无法完成${leftName}与${rightName}之间的交叉验证。`,
    };
  });
  const baseItems = activeDimensions.length !== 1
    ? pairItems
    : [{ ...intraDimensionChecks[activeDimensions[0]], from: activeDimensions[0], to: activeDimensions[0] }, ...pairItems];
  if (!enabled.has("R")) return baseItems;
  return [
    ...baseItems,
    {
      id: "material-trace",
      from: "R" as const,
      to: "R" as const,
      left: "本篇图片",
      right: "TruLens 已核验内容库",
      conclusion: "发现 2 篇配图高度相似的已核验笔记",
      state: "doubtful" as const,
      confidence: "高" as const,
      dimension: "图片 × 内容库",
      detail: "本篇图片与内容库中 2 篇已核验笔记的配图高度相似，建议结合最早出现时间与发布语境进一步复核素材来源。",
      kind: "material-trace" as const,
      label: "内容库比对",
      method: "rule" as const,
    },
  ];
}

function CrossCheckEvidenceModal({ item, onClose, technicalView }: { item: CrossCheckItem; onClose: () => void; technicalView: boolean }) {
  useEffect(() => {
    const closeOnEscape = (event: KeyboardEvent) => event.key === "Escape" && onClose();
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    window.addEventListener("keydown", closeOnEscape);
    return () => {
      document.body.style.overflow = previousOverflow;
      window.removeEventListener("keydown", closeOnEscape);
    };
  }, [onClose]);

  return (
    <div
      aria-label="交叉验证证据链"
      aria-modal="true"
      className="report-evidence-backdrop"
      onMouseDown={(event) => event.currentTarget === event.target && onClose()}
      role="dialog"
    >
      <article className="report-evidence-modal cross-evidence-modal">
        <header className="report-evidence-header">
          <div>
            <span className={`cross-state-dot state-${item.state}`} />
            <div><small>CROSS-CHECK EVIDENCE · 双信号对照</small><strong>{item.conclusion}</strong></div>
          </div>
          <span className={`cross-state-pill state-${item.state}`}>{crossCheckStateLabels[item.state]}</span>
          <button aria-label="关闭证据链" className="evidence-modal-close" onClick={onClose}>
            <Icon size={18}><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
          </button>
        </header>
        <div className="cross-evidence-summary">
          <span>交叉结论</span>
          <p>{item.detail}</p>
          <small>关联维度 · {item.dimension} {technicalView && <MethodBadge method={item.method} />}</small>
        </div>
        {item.kind === "material-trace" ? (
          <MaterialTraceEvidence technicalView={technicalView} />
        ) : (
        <div className="cross-evidence-columns">
          <section>
            <header><span className={`report-dimension-badge badge-${item.from.toLowerCase()}`}>{item.from}</span><div><small>信号 A</small><strong>{item.left}</strong></div></header>
            <div className="cross-evidence-capture"><span>{item.from === item.to ? "维度内信号 A" : "原始材料摘录"}</span><p>{item.left}</p><mark>{item.state === "unverified" ? "材料未提供" : "检测到可核验事实"}</mark></div>
          </section>
          <section>
            <header><span className={`report-dimension-badge badge-${item.to.toLowerCase()}`}>{item.to}</span><div><small>信号 B</small><strong>{item.right}</strong></div></header>
            <div className="cross-evidence-capture"><span>{item.from === item.to ? "维度内信号 B" : "关联材料摘录"}</span><p>{item.right}</p><mark>{item.state === "unverified" ? "等待补充材料" : "与信号 A 进行语义对照"}</mark></div>
          </section>
        </div>
        )}
        <footer className="evidence-modal-footer">
          <p><span /> 原始信号 <i /> 交叉关系 <em /> 综合结论</p>
          <button onClick={onClose}>返回交叉验证</button>
        </footer>
      </article>
    </div>
  );
}

function CrossCheckSection({
  activeDimensions,
  creatorMode = false,
  items,
  live = false,
  technicalView,
}: {
  activeDimensions: DimensionCode[];
  creatorMode?: boolean;
  items?: CrossCheckItem[];
  live?: boolean;
  technicalView: boolean;
}) {
  const [activeItem, setActiveItem] = useState<CrossCheckItem | null>(null);
  const [filteredId, setFilteredId] = useState<string | null>(null);
  const crossCheckItems = items ?? getCrossCheckItems(activeDimensions, creatorMode);
  const enabled = new Set(activeDimensions);
  const graphItems = crossCheckItems.filter((item) => item.from !== item.to && item.state !== "unverified");
  const shownItems = filteredId ? crossCheckItems.filter((item) => item.id === filteredId) : crossCheckItems;
  const stateCounts = crossCheckItems.reduce<Record<CrossCheckState, number>>((counts, item) => {
    counts[item.state] += 1;
    return counts;
  }, { conflict: 0, consistent: 0, corroborated: 0, doubtful: 0, unverified: 0 });
  const headline = activeDimensions.length === 1
    ? stateCounts.doubtful
      ? `${crossCheckDimensionNames[activeDimensions[0]].short}维度内存在待复核风险信号。`
      : stateCounts.conflict
        ? `${crossCheckDimensionNames[activeDimensions[0]].short}维度内存在冲突信号。`
        : `${crossCheckDimensionNames[activeDimensions[0]].short}维度内表述自洽。`
    : stateCounts.conflict
      ? "发现跨维度矛盾，建议优先复核。"
      : stateCounts.doubtful
        ? creatorMode
          ? "文案与图片存在可补充说明之处。"
          : "部分维度存在待说明差异，暂未发现明确矛盾。"
        : "已启用维度相互印证，暂未发现矛盾。";
  const nodePositions: Record<DimensionCode, [number, number]> = {
    T: [210, 34],
    R: [364, 120],
    U: [210, 206],
    S: [56, 120],
  };

  useEffect(() => {
    const openReferencedEvidence = (event: Event) => {
      const id = (event as CustomEvent<string>).detail;
      const item = crossCheckItems.find((entry) => entry.id === id);
      if (!item) return;
      setFilteredId(id);
      setActiveItem(item);
    };
    window.addEventListener("trulens:open-cross-evidence", openReferencedEvidence);
    return () => window.removeEventListener("trulens:open-cross-evidence", openReferencedEvidence);
  }, [crossCheckItems]);

  return (
    <section className={`cross-check-section ${creatorMode ? "creator-cross-check" : ""}`} id={creatorMode ? "creator-cross-check-section" : "cross-check-section"}>
      <header>
        <div>
          <span>Semantic Consistency</span>
          <h3>{creatorMode ? "交叉验证" : "② 交叉验证"}</h3>
          <h4>{headline}</h4>
          <p>{activeDimensions.length === 1 ? "需至少提供两类材料，才能进行跨维度交叉验证。当前先完成维度内自洽检查。" : live ? "基于本次报告的可信分、风险等级与证据数量比较维度间方向；未评估的维度会明确保留为未核验。" : "用不同维度的独立信号互相校验，未启用的组合会保留并说明原因。"}</p>
        </div>
        <div className="cross-check-summary">
          {(["conflict", "corroborated", "doubtful", "consistent", "unverified"] as CrossCheckState[]).map((state, index) => (
            <Fragment key={state}>{index > 0 && <span>·</span>}<b><strong>{stateCounts[state]}</strong> {crossCheckStateLabels[state]}</b></Fragment>
          ))}
        </div>
      </header>
      <div className="cross-check-layout">
        <div className="cross-check-graph">
          <svg aria-label="T R U S 四维交叉关系图" viewBox="0 0 420 240">
            {graphItems.map((item, index) => {
              const [x1, y1] = nodePositions[item.from];
              const [x2, y2] = nodePositions[item.to];
              return (
                <g
                  aria-label={`${item.left}与${item.right}：${crossCheckStateLabels[item.state]}`}
                  className={`cross-edge state-${item.state} ${filteredId === item.id ? "active" : ""}`}
                  key={item.id}
                  onClick={() => setFilteredId((current) => current === item.id ? null : item.id)}
                  role="button"
                  style={{ animationDelay: `${index * 120}ms` }}
                  tabIndex={0}
                  onKeyDown={(event) => {
                    if (event.key === "Enter" || event.key === " ") setFilteredId((current) => current === item.id ? null : item.id);
                  }}
                >
                  <line x1={x1} x2={x2} y1={y1} y2={y2} />
                  <circle cx={(x1 + x2) / 2} cy={(y1 + y2) / 2} r="9" />
                  <text textAnchor="middle" x={(x1 + x2) / 2} y={(y1 + y2) / 2 + 3}>{index + 1}</text>
                </g>
              );
            })}
            {(Object.entries(nodePositions) as [DimensionCode, [number, number]][]).map(([code, [x, y]]) => (
              <g className={`cross-node node-${code.toLowerCase()} ${enabled.has(code) ? "" : "inactive"}`} key={code}>
                <circle cx={x} cy={y} r="23" />
                <text textAnchor="middle" x={x} y={y + 4}>{code}</text>
                {!enabled.has(code) && <text className="cross-node-disabled-label" textAnchor="middle" x={x} y={y + (code === "U" ? 32 : 36)}>未启用</text>}
              </g>
            ))}
          </svg>
          <small>点击连线筛选对应关系，再次点击恢复全部</small>
        </div>
        <div className="cross-check-list">
          {shownItems.map((item) => (
            <button className={`cross-check-row state-${item.state}`} key={item.id} onClick={() => setActiveItem(item)}>
              <span className="cross-pair"><b>{item.from}</b><i>↔</i><b>{item.to}</b></span>
              <span>
                <small>{item.left} × {item.right}</small>
                <strong>{item.conclusion}</strong>
                {item.label && <b className="cross-check-source-label">{item.label}</b>}
                {technicalView && <MethodBadge method={item.method} />}
              </span>
              <em>{crossCheckStateLabels[item.state]}{item.confidence ? ` · ${item.confidence}` : ""}</em>
              <i className="cross-arrow">→</i>
            </button>
          ))}
        </div>
      </div>
      <small className="cross-check-note">{live ? "实时报告 · 关系状态由本次维度分数和证据数量计算。" : "示例数据 · 交叉关系由 TruLens 基于当前可用信号生成。"}</small>
      {activeItem && <CrossCheckEvidenceModal item={activeItem} onClose={() => setActiveItem(null)} technicalView={technicalView} />}
    </section>
  );
}

type DecisionTier = "pass" | "verify" | "review";
type DecisionPerspective = "consumer" | "creator" | "platform" | "brand";

type DecisionAdvice = {
  text: string;
  basis?: string;
  importance?: "重点";
  evidenceId?: string;
  action?: "appeal";
};

const decisionPerspectives: { id: DecisionPerspective; label: string }[] = [
  { id: "consumer", label: "消费者" },
  { id: "creator", label: "创作者" },
  { id: "platform", label: "平台运营" },
  { id: "brand", label: "品牌方" },
];

const passDecisionAdvice: Record<DecisionPerspective, DecisionAdvice[]> = {
  consumer: [
    { text: "可以参考这篇的成分和使用感受。", basis: "账号、文案、评论三项稳定。", evidenceId: "identity-copy" },
    { text: "对比图的“前后效果”请打折看待。", basis: "右侧检测到局部磨皮信号。", importance: "重点", evidenceId: "copy-image" },
    { text: "下单前再核对：使用周期、肤质是否与你相近。", basis: "未提供订单凭证，购买真实性未核验。", evidenceId: "purchase" },
  ],
  creator: [
    { text: "对比图建议注明“已磨皮/滤镜”，避免被误判为 AI 修饰。", basis: "右侧检测到局部磨皮信号。", importance: "重点", evidenceId: "copy-image" },
    { text: "补充未修图原图或使用周期时间线，可显著提升可信度。", basis: "评论自然度是当前最低分项。", evidenceId: "claim-feedback" },
    { text: "如对结果有异议，可提交材料申诉。", action: "appeal" },
  ],
  platform: [
    { text: "不建议限流；可加“含 AI 辅助修饰”提示标注。", basis: "轻度修饰，不属于违规。", importance: "重点", evidenceId: "copy-image" },
    { text: "暂无需人工复核，保持观察。", basis: "无矛盾项，无刷评聚集。", evidenceId: "identity-copy" },
  ],
  brand: [
    { text: "可作为 KOC 合作的候选参考。", basis: "内容稳定，无夸大宣称。", evidenceId: "claim-feedback" },
    { text: "合作前建议索取原始素材，核对对比图。", basis: "对比图存在修饰信号。", importance: "重点", evidenceId: "copy-image" },
  ],
};

const decisionAdviceByTier: Record<DecisionTier, Record<DecisionPerspective, DecisionAdvice[]>> = {
  pass: passDecisionAdvice,
  verify: {
    ...passDecisionAdvice,
    consumer: [
      { text: "暂缓直接采用帖子中的效果结论。", basis: "当前信号存在待补充核验项。", importance: "重点", evidenceId: "purchase" },
      { text: "补充查看自然光原图与长期使用反馈。", basis: "单次对比不足以验证持续效果。", evidenceId: "copy-image" },
      { text: "核对合作披露与独立用户评价后再决策。", basis: "需要更多独立信号相互印证。", evidenceId: "copy-comments" },
    ],
  },
  review: {
    ...passDecisionAdvice,
    consumer: [
      { text: "暂停将这篇内容作为购买依据。", basis: "综合风险已进入人工复核区间。", importance: "重点", evidenceId: "copy-image" },
      { text: "等待平台复核或独立来源给出补充证据。", basis: "当前材料不足以排除关键风险。", evidenceId: "purchase" },
    ],
  },
};

