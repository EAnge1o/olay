    basis: "文案真实性。",
    evidenceId: "intra-s",
    advice: {
      consumer: "文案中有绝对化的功效表述，请谨慎对待。",
      creator: "文案中的绝对化表述建议修改。",
      platform: "可先加“待核实”提示标注。",
      brand: "文案涉及功效宣称，建议留意。",
    },
  },
};

const decisionTiers: { id: DecisionTier; number: string; label: string; range: string }[] = [
  { id: "pass", number: "①", label: "放行 · 轻提示", range: "80–100" },
  { id: "verify", number: "②", label: "提示 · 补充核验", range: "60–79" },
  { id: "review", number: "③", label: "人工复核 · 处置", range: "0–59" },
];

function DecisionSupport({
  activeDimensions,
  confidenceLevel,
  continueLabel,
  creatorMode = false,
  liveAdvice,
  onContinue,
  recommendations,
  score,
  sourceLabel = "示例数据",
  subtitle,
}: {
  activeDimensions: DimensionCode[];
  confidenceLevel: ReportConfidenceLevel;
  continueLabel: string;
  creatorMode?: boolean;
  liveAdvice?: Array<{
    perspective: DecisionPerspective;
    priority: "重点" | "建议";
    title: string;
    basis: string;
    action?: string | null;
  }>;
  onContinue: () => void;
  recommendations?: string[];
  score: number;
  sourceLabel?: string;
  subtitle: string;
}) {
  const initialTier: DecisionTier = score >= 80 ? "pass" : score >= 60 ? "verify" : "review";
  const [tier, setTier] = useState<DecisionTier>(initialTier);
  const [perspective, setPerspective] = useState<DecisionPerspective>("consumer");
  const hasLimitedMaterial = activeDimensions.length < 4 || confidenceLevel === "low";
  const supplementAdvice = creatorMode && perspective === "creator" ? [] : [limitedMaterialAdvice[perspective]];
  const fallbackAdvice = hasLimitedMaterial
    ? [
        ...supplementAdvice,
        ...activeDimensions.map((code) => {
          const config = dimensionDecisionAdvice[code];
          const pairEvidenceId = crossCheckPairResults.find((item) =>
            (item.from === code || item.to === code)
            && activeDimensions.includes(item.from)
            && activeDimensions.includes(item.to),
          )?.id;
          return {
            text: config.advice[perspective],
            basis: config.basis,
            evidenceId: activeDimensions.length === 1 ? config.evidenceId : pairEvidenceId,
          };
        }),
      ]
    : decisionAdviceByTier[tier][perspective];
  const liveRecommendations: DecisionAdvice[] | null = perspective === "consumer" && recommendations?.length
    ? recommendations.slice(0, 5).map((text, index) => ({
        text,
        basis: "来自本次分析报告的后端建议。",
        importance: index === 0 ? "重点" : undefined,
      }))
    : null;
  const backendAdvice = liveAdvice
    ?.filter((item) => item.perspective === perspective)
    .map((item) => ({
      text: item.title,
      basis: item.basis,
      importance: item.priority === "重点" ? "重点" as const : undefined,
      action: item.action === "appeal" ? "appeal" as const : undefined,
    }));
  const advice = backendAdvice?.length ? backendAdvice : liveRecommendations ?? fallbackAdvice;

  const openEvidence = (id: string) => {
    document.getElementById(creatorMode ? "creator-cross-check-section" : "cross-check-section")?.scrollIntoView({ behavior: "smooth", block: "center" });
    window.setTimeout(() => {
      window.dispatchEvent(new CustomEvent("trulens:open-cross-evidence", { detail: id }));
    }, 320);
  };

  return (
    <section className={`decision-support ${hasLimitedMaterial ? "limited-material" : ""}`} id={creatorMode ? "creator-decision-section" : "decision-section"}>
      <header>
        <div><span>Decision &amp; Advice</span><h3>③ 决策与建议</h3><p>{subtitle}</p></div>
        <small>{sourceLabel}</small>
      </header>
      <div className="decision-support-layout">
        <aside className="decision-tier-panel">
          <span>分级策略</span>
          <div>
            {decisionTiers.map((item, index) => (
              <button
                aria-pressed={tier === item.id}
                className={`decision-tier tier-${item.id} ${tier === item.id ? "active" : ""} ${hasLimitedMaterial && tier === item.id ? "provisional" : ""}`}
                key={item.id}
                onClick={() => setTier(item.id)}
              >
                <i /><b>{item.number}</b><strong>{hasLimitedMaterial && tier === item.id ? `倾向第 ${index + 1} 档 · 待补充材料` : item.label}</strong><small>{item.range}</small>
              </button>
            ))}
          </div>
        </aside>
        <div className="decision-recommendations">
          <div aria-label="建议视角" className="decision-perspectives" role="tablist">
            {decisionPerspectives.map((item) => (
              <button
                aria-selected={perspective === item.id}
                className={perspective === item.id ? "active" : ""}
                key={item.id}
                onClick={() => setPerspective(item.id)}
                role="tab"
              >
                {item.label}
              </button>
            ))}
          </div>
          <AnimatePresence mode="wait">
            <motion.div
              animate={{ opacity: 1, y: 0 }}
              className="decision-advice-list"
              exit={{ opacity: 0, y: -4 }}
              initial={{ opacity: 0, y: 4 }}
              key={`${tier}-${perspective}`}
              transition={{ duration: 0.2 }}
            >
              {advice.map((item, index) => (
                <div className="decision-advice-row" key={item.text}>
                  <span className={item.importance ? "important" : ""}>{item.importance ?? "建议"}</span>
                  <b>{String(index + 1).padStart(2, "0")}</b>
                  <div><strong>{item.text}</strong>{item.basis && <small>依据：{item.basis}</small>}</div>
                  {item.action === "appeal"
                    ? <button onClick={() => window.alert("申诉入口将在接入材料提交服务后开放。")}>提交申诉</button>
                    : item.evidenceId && <button onClick={() => openEvidence(item.evidenceId!)}>查看依据 →</button>}
                </div>
              ))}
            </motion.div>
          </AnimatePresence>
        </div>
      </div>
      <footer>
        <small>辅助决策，不构成购买建议或定性结论。</small>
        <button onClick={onContinue}>{continueLabel} <Arrow size={17} /></button>
      </footer>
    </section>
  );
}

type ReportConfidenceLevel = "high" | "medium" | "low";

const reportConfidenceProfiles: Record<ReportConfidenceLevel, { label: string; evidenceCount: number; crossCheckCount: number; bars: number }> = {
  high: { label: "高", evidenceCount: 14, crossCheckCount: 5, bars: 3 },
  medium: { label: "中", evidenceCount: 8, crossCheckCount: 2, bars: 2 },
  low: { label: "低", evidenceCount: 3, crossCheckCount: 0, bars: 1 },
};

function UnifiedReportTemplate({
  decision,
  dimensions: availableDimensions,
  onAddEvidence,
  onContinue,
  continueLabel,
  score,
  status,
  subtitle,
  technicalView,
  title,
  tone,
}: {
  decision: string;
  dimensions: UnifiedReportDimension[];
  onAddEvidence?: (code: DimensionCode) => void;
  onContinue: () => void;
  continueLabel: string;
  score: number;
  status: string;
  subtitle: string;
  technicalView: boolean;
  title: string;
  tone: string;
}) {
  const [openEvidence, setOpenEvidence] = useState<DimensionCode | null>(null);
  const [confidenceOpen, setConfidenceOpen] = useState(false);
  const [activeReportSection, setActiveReportSection] = useState("forensics-section");
  const orderedCodes = ["T", "R", "U", "S"];
  const isCurrentFullReport = title === "当前美妆种草内容" && availableDimensions.length === 4;
  const confidenceLevel: ReportConfidenceLevel = availableDimensions.length === 4 ? "high" : availableDimensions.length >= 2 ? "medium" : "low";
  const confidence = reportConfidenceProfiles[confidenceLevel];
  const scoreWeights: Record<string, number> = { T: 25, R: 30, U: 25, S: 20 };
  const dimensionMap = new Map(availableDimensions.map((dimension) => [dimension.code, dimension]));
  const missingDimensions = orderedCodes
    .filter((code) => !dimensionMap.has(code))
    .map((code) => ({ T: "账号材料", R: "图片材料", U: "评论材料", S: "文案材料" })[code])
    .filter(Boolean);
  const radarCoordinates = orderedCodes.map((code, index) => {
    const dimension = dimensionMap.get(code);
    const radius = dimension ? dimension.score * 0.82 : 0;
    if (index === 0) return [120, 110 - radius];
    if (index === 1) return [120 + radius, 110];
    if (index === 2) return [120, 110 + radius];
    return [120 - radius, 110];
  });

  useEffect(() => {
    const sectionIds = ["forensics-section", "cross-check-section", "decision-section"];
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActiveReportSection(visible.target.id);
    }, { rootMargin: "-24% 0px -58% 0px", threshold: [0.05, 0.25, 0.5] });
    sectionIds.forEach((id) => {
      const element = document.getElementById(id);
      if (element) observer.observe(element);
    });
    return () => observer.disconnect();
  }, [isCurrentFullReport]);

  return (
    <div className="unified-report-page">
      <article className={`unified-report-card ${tone}`}>
        <header>
          <div><strong>TruLens 核验报告</strong><small>{title === "当前美妆种草内容" ? "当前美妆种草内容 · 一个 Agent 汇总四个维度 · 生成核验报告" : `${title} · 同一个 Agent 汇总四个维度`}</small></div>
          <span>AI 生成报告</span>
        </header>

        <nav className="report-anchor-nav" aria-label="报告章节导航">
          {[
            ["forensics-section", "① 鉴伪结果"],
            ["cross-check-section", "② 一致性校验"],
            ["decision-section", "③ 决策与建议"],
          ].map(([id, label]) => (
            <button className={activeReportSection === id ? "active" : ""} key={id} onClick={() => document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" })}>{label}</button>
          ))}
        </nav>

        <div className="unified-score-row">
          <div className="unified-score-cluster">
            <div className="unified-score">
              <span>Trust Score</span>
              <strong>{score}<small>/ 100</small></strong>
              <em>基于 {availableDimensions.length}/4 个维度</em>
              {confidenceLevel === "low" && <p>材料有限，结论仅供参考</p>}
            </div>
            <div className="report-confidence-wrap">
              <button className={`report-confidence confidence-${title === "当前美妆种草内容" ? "low" : confidenceLevel}`} onClick={() => setConfidenceOpen((open) => !open)}>
                <span>置信度</span><strong>{title === "当前美妆种草内容" ? "中" : confidence.label}</strong><i>{[1, 2, 3].map((bar) => <b className={title === "当前美妆种草内容" || bar <= confidence.bars ? "filled" : ""} key={bar} />)}</i>
              </button>
              {confidenceOpen && (
                <div className="report-confidence-popover">
                  <strong>置信度依据</strong>
                  <span>启用维度 <b>{availableDimensions.length}/4</b></span>
                  <span>证据条数 <b>{confidence.evidenceCount}</b></span>
                  <span>交叉验证项 <b>{confidence.crossCheckCount}</b></span>
                  <span>缺失材料 <b>{missingDimensions.length ? missingDimensions.join("、") : "无"}</b></span>
                </div>
              )}
            </div>
          </div>
          <div className="unified-verdict-group">
            <span className="unified-verdict">{status}</span>
            {isCurrentFullReport && <button onClick={() => document.getElementById("cross-check-section")?.scrollIntoView({ behavior: "smooth", block: "center" })}>已完成交叉验证 ↓</button>}
          </div>
        </div>

        <div className="unified-risk-band">
          <div><i style={{ left: `${score}%` }} /></div>
          <span>高风险</span><span>可信</span>
        </div>

        <section className="report-section-block" id="forensics-section">
          <header className="report-section-heading"><span>Multimodal Forensics</span><h2>① 四维结果</h2></header>
        <div className="unified-dimensions">
          <div className="unified-radar">
            <svg aria-label="T R U S 四维核验分布" viewBox="0 0 240 220">
              {[0.25, 0.5, 0.75, 1].map((scale) => {
                const radius = 78 * scale;
                return <polygon className="radar-grid" key={scale} points={`120,${110 - radius} ${120 + radius},110 120,${110 + radius} ${120 - radius},110`} />;
              })}
              <line x1="120" x2="120" y1="32" y2="188" />
              <line x1="42" x2="198" y1="110" y2="110" />
              <polygon className="unified-radar-data" points={radarCoordinates.map(([x, y]) => `${x},${y}`).join(" ")} />
              {[
                ["T", 120, 32, 120, 12, 120, 24],
                ["R", 198, 110, 218, 114, 218, 126],
                ["U", 120, 188, 120, 216, 120, 204],
                ["S", 42, 110, 22, 114, 22, 126],
              ].map(([code, x, y, tx, ty, mx, my]) => (
                <g className={dimensionMap.has(String(code)) ? "" : "missing"} key={code}>
                  <circle cx={x} cy={y} r="10" />
                  <text textAnchor="middle" x={tx} y={ty}>{code}</text>
                  {!dimensionMap.has(String(code)) && <text className="radar-disabled-label" textAnchor="middle" x={mx} y={my}>未启用</text>}
                </g>
              ))}
              {radarCoordinates.map(([x, y], index) => dimensionMap.has(orderedCodes[index]) && <circle className="unified-radar-point" cx={x} cy={y} key={orderedCodes[index]} r="4" />)}
            </svg>
            <small>四维核验分布</small>
          </div>

          <div className="unified-dimension-list">
            {orderedCodes.map((code) => {
              const dimension = dimensionMap.get(code);
              return (
                <button
                  aria-label={dimension ? `查看${dimension.title}评分证据链` : `${code} 维度数据不足`}
                  className={`unified-dimension-row ${dimension ? "" : "missing"}`}
                  disabled={!dimension}
                  key={code}
                  onClick={() => dimension && setOpenEvidence(code as DimensionCode)}
                >
                  <span className={`report-dimension-badge badge-${code.toLowerCase()}`}>{code}</span>
                  <div>
                    <span>
                      <strong>{dimension?.title ?? { T: "账号可信度", R: "图像原生性", U: "评论自然度", S: "文案真实性" }[code as DimensionCode]}</strong>
                      <b>{dimension ? <>{dimension.score}<small>/100 · 权重 {scoreWeights[code]}%</small><i aria-hidden="true">查看证据 →</i></> : "未启用"}</b>
                    </span>
                    <div><i style={{ width: dimension ? `${dimension.score}%` : "0%" }} /></div>
                    <small>{dimension?.text ?? "未提供材料，不参与计分"}</small>
                    <AnimatePresence>
                      {technicalView && dimension && (
                        <motion.p animate={{ opacity: 1, height: "auto" }} className="technical-capability" exit={{ opacity: 0, height: 0 }} initial={{ opacity: 0, height: 0 }}>
                          所用能力 · {technicalConfig.dimensionCapabilities[code as DimensionCode]}
                        </motion.p>
                      )}
                    </AnimatePresence>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
        </section>

        <CrossCheckSection
          activeDimensions={availableDimensions.map((dimension) => dimension.code as DimensionCode)}
          technicalView={technicalView}
        />

        <DecisionSupport
          activeDimensions={availableDimensions.map((dimension) => dimension.code as DimensionCode)}
          confidenceLevel={confidenceLevel}
          continueLabel={continueLabel}
          onContinue={onContinue}
          score={score}
          subtitle={subtitle}
        />
      </article>
      <AnimatePresence>
        {technicalView && (
          <motion.section animate={{ opacity: 1, height: "auto", y: 0 }} className="technical-explanation" exit={{ opacity: 0, height: 0, y: -4 }} initial={{ opacity: 0, height: 0, y: -4 }}>
            <div>
              <section><strong>模型</strong>{technicalConfig.models.map((model) => <span key={model}>{model}</span>)}</section>
              <section><strong>部署</strong><span>{technicalConfig.deployment}</span></section>
            </div>
            <small>{technicalConfig.disclaimer}</small>
          </motion.section>
        )}
      </AnimatePresence>
      <p className="method-note">本报告由 TruLens 根据当前可用信号生成；未提供的模态不参与判断，AI 结论不构成医疗或购买建议。</p>
      {onAddEvidence && availableDimensions.length < allDimensions.length && (
        <EvidenceExpansionPrompt
          availableCodes={availableDimensions.map((dimension) => dimension.code as DimensionCode)}
          onAddEvidence={onAddEvidence}
        />
      )}
      {openEvidence && dimensionMap.get(openEvidence) && (
        <ReportEvidenceModal
          code={openEvidence}
          dimension={dimensionMap.get(openEvidence)!}
          onClose={() => setOpenEvidence(null)}
          showAccountActivity={tone === "trusted"}
          technicalView={technicalView}
        />
      )}
    </div>
  );
}

function ArchivedResult({
  task,
  onBack,
  onTechnicalViewChange,
  technicalView,
}: {
  task: Exclude<RecentTask, "makeup">;
  onBack: () => void;
  onTechnicalViewChange: (enabled: boolean) => void;
  technicalView: boolean;
}) {
  const data = archivedTasks[task];
  return (
    <section className="result archive-result">
      <header className="result-header">
        <button aria-label="返回新鉴别" className="back-button" onClick={onBack} title="返回新鉴别">
          <Icon size={22}><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
        </button>
        <div className="result-actions">
          <TechnicalViewToggle enabled={technicalView} onChange={onTechnicalViewChange} />
          <button onClick={() => window.print()}>
            <Icon size={17}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
            导出 PDF
          </button>
        </div>
      </header>
      <UnifiedReportTemplate
        continueLabel="开始新的鉴别"
        decision={data.decision}
        dimensions={data.dimensions}
        onContinue={onBack}
        score={data.score}
        status={data.status}
        subtitle={data.headline}
        technicalView={technicalView}
        title={data.title}
        tone={data.tone}
      />
    </section>
  );
}

type CreatorIssueSeverity = "must" | "suggest" | "tip";
type CreatorIssueStatus = "accepted" | "ignored";

const SELFCHECK_CANVAS_CJK_FONT = '"Noto Sans SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Source Han Sans SC", "Noto Sans CJK SC", sans-serif';

/** In-memory progress of one 发布前自检 report (kept by the parent while the session lasts). */
export type CreatorSelfCheckProgress = {
  draft: string;
  issueStatus: Record<string, CreatorIssueStatus>;
  imageHandled: boolean;
  latestResult: CreatorCheckRead | null;
  rechecked: boolean;
  acceptedMustIds: string[];
  acceptedSuggestionIds: string[];
};

type CreatorDraftIssue = {
  id: string;
  severity: CreatorIssueSeverity;
  type: string;
  original?: string;
  suggestion: string;
  reason: string;
  remove?: boolean;
};

const creatorDraftIssues: CreatorDraftIssue[] = [
  { id: "most-effective", severity: "must", type: "绝对化比较", original: "最有效", suggestion: "目前用下来我个人觉得挺有效的", reason: "平台和广告规范常见关注点：避免把个人感受表达成适用于所有人的比较结论。" },
  { id: "seven-days", severity: "must", type: "效果承诺", original: "7 天直接变白", suggestion: "我连续用了【X】天，个人感觉【你的真实感受】，效果因人而异", reason: "平台和广告规范常见关注点：短周期确定性效果需要真实使用条件与个人体验边界。" },
  { id: "sensitive-safe", severity: "must", type: "安全性绝对化", original: "敏感肌孕妇都能放心用", suggestion: "敏感肌和孕期人群建议先咨询医生或做局部测试；我自己的肤质是【你的肤质】", reason: "平台和广告规范常见关注点：特殊人群的适用性不宜作统一保证。" },
  { id: "absolute-safe", severity: "must", type: "绝对化", original: "100% 安全无刺激", suggestion: "我用下来没有刺痛感，但每个人情况不同", reason: "平台和广告规范常见关注点：安全和刺激感会受到肤质、用法与个体差异影响。" },
  { id: "dismiss-others", severity: "suggest", type: "贬低同行", original: "别的都是智商税", suggestion: "建议删除", reason: "平台和广告规范常见关注点：减少对其他产品或消费者选择的否定性表达。" , remove: true },
  { id: "disclosure", severity: "tip", type: "披露", suggestion: "如有合作或赠品，请添加披露；如自费购买可写“自费购买”", reason: "平台和广告规范常见关注点：清楚说明内容与品牌、产品之间的关系，更便于读者判断。" },
];

const creatorSeverityLabels: Record<CreatorIssueSeverity, string> = {
  must: "必改",
  suggest: "建议",
  tip: "提示",
};

function CreatorSelfCheckReport({
  error = null,
  input,
  loading = false,
  onContinueAgent,
  onContinueOther,
  onRestart,
  onReturnModify,
  result = null,
  technicalView,
  onRecheck,
  progress,
  onProgressChange,
  onCompletionChange,
}: {
  error?: string | null;
  input: CreatorReportInput;
  loading?: boolean;
  onContinueAgent: () => void;
  onContinueOther: () => void;
  onRestart: () => void;
  onReturnModify: (draft: string) => void;
  result?: CreatorCheckRead | null;
  technicalView: boolean;
  /** Real 再次检测: re-runs checkCreator with the current draft (same arguments as the first check). */
  onRecheck?: (draft: string) => Promise<CreatorCheckRead>;
  /** Progress kept by the parent so leaving and returning to the report keeps it. */
  progress?: CreatorSelfCheckProgress | null;
  onProgressChange?: (progress: CreatorSelfCheckProgress) => void;
  onCompletionChange?: (state: { complete: boolean; reasons: string[] }) => void;
}) {
  const [draft, setDraft] = useState(progress?.draft ?? input.draft);
  const [issueStatus, setIssueStatus] = useState<Record<string, CreatorIssueStatus>>(progress?.issueStatus ?? {});
  // Latest real result from 再次检测 (null until the first recheck) and what the user did.
  const [latestResult, setLatestResult] = useState<CreatorCheckRead | null>(progress?.latestResult ?? null);
  const [rechecked, setRechecked] = useState(progress?.rechecked ?? false);
  const [acceptedMustIds, setAcceptedMustIds] = useState<string[]>(progress?.acceptedMustIds ?? []);
  const [acceptedSuggestionIds, setAcceptedSuggestionIds] = useState<string[]>(progress?.acceptedSuggestionIds ?? []);
  const [recheckError, setRecheckError] = useState<string | null>(null);
  const [hoveredIssue, setHoveredIssue] = useState<string | null>(null);
  const [selectedImage, setSelectedImage] = useState<number | null>(input.images.length ? 0 : null);
  const [imageHandled, setImageHandled] = useState(progress?.imageHandled ?? false);
  const [flashDraft, setFlashDraft] = useState(false);
  const [isRechecking, setIsRechecking] = useState(false);

  const currentResult = latestResult ?? result;
  const activeIssues = currentResult?.issues ?? creatorDraftIssues;
  const unresolvedIssues = activeIssues.filter((issue) => !issueStatus[issue.id]);
  const requiredCount = unresolvedIssues.filter((issue) => issue.severity === "must").length;
  const ignoredCount = Object.values(issueStatus).filter((status) => status === "ignored").length;
  const ignoredRequiredCount = activeIssues.filter((issue) => issue.severity === "must" && issueStatus[issue.id] === "ignored").length;
  const ignoredRequired = activeIssues.some((issue) => issue.severity === "must" && issueStatus[issue.id] === "ignored");
  const checklistSuggestion = /数据|来源|检测|测试/.test(draft) ? 0 : 1;
  const suggestionCount = unresolvedIssues.filter((issue) => issue.severity === "suggest").length + (imageHandled ? 0 : input.images.length ? 1 : 0) + checklistSuggestion;
  const tipCount = unresolvedIssues.filter((issue) => issue.severity === "tip").length;
  const pendingCount = requiredCount + suggestionCount + tipCount;
  const acceptedRequired = activeIssues.filter((issue) => issue.severity === "must" && issueStatus[issue.id] === "accepted").length;
  const baseCopyScore = result?.copy_score ?? 28;
  // Real runs show real numbers only: first check → latest 再次检测. The demo keeps its old preview.
  const copyScore = result
    ? Math.round(currentResult?.copy_score ?? baseCopyScore)
    : Math.min(96, baseCopyScore + acceptedRequired * 10 + (issueStatus.disclosure === "accepted" ? 4 : 0));
  const hasImages = input.images.length > 0 || result?.image_score != null;
  const baseImageScore = result?.image_score ?? (hasImages ? 82 : null);
  const imageScore = result ? (currentResult?.image_score ?? baseImageScore) : (hasImages ? imageHandled ? 90 : 82 : null);
  const imageAfterScore = result ? imageScore : imageScore != null ? (imageHandled ? Math.min(96, imageScore + 8) : imageScore) : null;
  const imageDimension = currentResult?.report.dimensions.find((dimension) => dimension.code === "R");
  const imageNeedsReview = currentResult
    ? Boolean(imageDimension?.assessed && imageDimension.risk_level !== "low")
    : hasImages;
  const imageFinding = imageDimension?.evidence[0]?.reason || imageDimension?.evidence[0]?.evidence;
  const creatorDimensions: DimensionCode[] = hasImages ? ["R", "S"] : ["S"];
  const creatorOverallScore = hasImages && imageScore != null ? Math.round((copyScore + imageScore) / 2) : copyScore;
  const publicationState = ignoredRequired
    ? "hold"
    : requiredCount > 0
      ? result?.publication_state === "hold"
        ? "hold"
        : "revise"
      : "ready";
  const publicationTitle = { ready: "可以发布", revise: "建议修改后发布", hold: "建议暂缓发布" }[publicationState];
  const checkDate = currentResult?.check_date || new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());

  if (loading) {
    return (
      <div className="creator-report-page">
        <article className="creator-report-sheet">
          <section className="creator-recheck-state">
            <span><i className="expert-s">S</i><b>文案检查官</b><small>正在运行真实文案分析</small></span>
            {input.images.length > 0 && <span><i className="expert-r">R</i><b>视觉取证师</b><small>正在运行真实图片分析</small></span>}
          </section>
          <p className="creator-badge-hint">正在调用后端分析与改写建议服务，请稍候。</p>
        </article>
      </div>
    );
  }

  if (error) {
    return (
      <div className="creator-report-page">
        <article className="creator-report-sheet">
          <p className="new-analysis-error">创作者自检失败：{error}</p>
          <div className="creator-report-actions">
            <div><button onClick={() => onReturnModify(draft)}>返回修改</button></div>
          </div>
        </article>
      </div>
    );
  }

  const scrollToIssue = (id: string) => {
    document.getElementById(`creator-issue-${id}`)?.scrollIntoView({ behavior: "smooth", block: "center" });
  };

  const flashUpdatedDraft = () => {
    setFlashDraft(false);
    window.requestAnimationFrame(() => setFlashDraft(true));
    window.setTimeout(() => setFlashDraft(false), 900);
  };

  const acceptIssue = (issue: CreatorDraftIssue) => {
    setDraft((current) => {
      if (issue.id === "disclosure") {
        const disclosure = input.isCollaboration ? "本篇含品牌合作或产品赠送。" : "本产品为自费购买。";
        return current.includes(disclosure) ? current : `${current.trim()}\n${disclosure}`;
      }
      if (!issue.original) return current;
      if (issue.remove) return current.replace(`${issue.original}，`, "").replace(issue.original, "");
      return current.replace(issue.original, issue.suggestion);
    });
    setIssueStatus((current) => ({ ...current, [issue.id]: "accepted" }));
    if (issue.severity === "must") setAcceptedMustIds((current) => (current.includes(issue.id) ? current : [...current, issue.id]));
    else setAcceptedSuggestionIds((current) => (current.includes(issue.id) ? current : [...current, issue.id]));
    // The copy changed, so a previous 再次检测 no longer reflects it.
    setRechecked(false);
    flashUpdatedDraft();
  };

  const acceptImageSuggestion = () => {
    const disclosure = "（图片已做轻度磨皮处理）";
    setDraft((current) => current.includes(disclosure) ? current : `${current.trim()}\n${disclosure}`);
    setImageHandled(true);
    setAcceptedSuggestionIds((current) => (current.includes("image") ? current : [...current, "image"]));
    setRechecked(false);
    flashUpdatedDraft();
  };

  const runRecheck = () => {
    if (isRechecking) return;
    if (onRecheck && result) {
      setIsRechecking(true);
      setRecheckError(null);
      void onRecheck(draft)
        .then((next) => {
          // New result: 必改 must be re-adopted if still flagged; an explicit 忽略 of a
          // 建议 / 提示 carries over when the same item comes back.
          setIssueStatus((previous) => {
            const carried: Record<string, CreatorIssueStatus> = {};
            next.issues.forEach((issue) => {
              if (issue.severity !== "must" && previous[issue.id] === "ignored") carried[issue.id] = "ignored";
            });
            return carried;
          });
          setLatestResult(next);
          setRechecked(true);
        })
        .catch((err: unknown) => setRecheckError(err instanceof Error ? err.message : String(err)))
        .finally(() => setIsRechecking(false));
      return;
    }
    setIsRechecking(true);
    window.setTimeout(() => {
      const nextStatus: Record<string, CreatorIssueStatus> = {};
      activeIssues.forEach((issue) => {
        if (issue.id === "disclosure") {
          if (/品牌合作|产品赠送|自费购买/.test(draft)) nextStatus[issue.id] = "accepted";
          return;
        }
        if (issue.original && !draft.includes(issue.original)) nextStatus[issue.id] = "accepted";
      });
      setIssueStatus(nextStatus);
      setImageHandled(/图片已做轻度磨皮处理/.test(draft));
      setIsRechecking(false);
      onRestart();
    }, 1500);
  };

  const saveBadgeAsPng = async () => {
    if (!selfCheckComplete) return;
    // Canvas text falls back silently: wait for webfonts, and list system CJK fonts so a
    // machine without Noto Sans SC still renders Chinese instead of boxes.
    try {
      await document.fonts?.ready;
    } catch {
      /* drawing with the fallback chain is still fine */
    }
    const canvas = document.createElement("canvas");
    canvas.width = 1200;
    canvas.height = 630;
    const context = canvas.getContext("2d");
    if (!context) return;

    context.fillStyle = "#f9f7fc";
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.strokeStyle = "#cbbde2";
    context.lineWidth = 4;
    context.beginPath();
    context.roundRect(28, 28, 1144, 574, 38);
    context.stroke();

    context.save();
    context.translate(118, 112);
    context.fillStyle = "#e1d9f2";
    context.strokeStyle = "#a999d5";
    context.lineWidth = 3;
    context.beginPath();
    context.moveTo(48, 0);
    context.lineTo(96, 48);
    context.lineTo(48, 96);
    context.lineTo(0, 48);
    context.closePath();
    context.fill();
    context.stroke();
    ["#b9a8de", "#d7a9ae", "#9eb9d3", "#9ebfae"].forEach((color, index) => {
      const dots = [[48, -15], [111, 48], [48, 111], [-15, 48]];
      context.fillStyle = color;
      context.beginPath();
      context.arc(dots[index][0], dots[index][1], 11, 0, Math.PI * 2);
      context.fill();
    });
    context.restore();

    context.fillStyle = "#332d3b";
    context.font = `600 48px ${SELFCHECK_CANVAS_CJK_FONT}`;
    context.fillText("已完成发布前自检", 270, 135);
    context.fillStyle = "#648471";
    context.font = `500 30px ${SELFCHECK_CANVAS_CJK_FONT}`;
    context.fillText(requiredCount ? `仍有 ${requiredCount} 处待处理` : "无必改项", 272, 185);
    context.fillStyle = "#8a8290";
    context.font = `22px ${SELFCHECK_CANVAS_CJK_FONT}`;
    context.fillText(`自检日期  ${checkDate}  ·  ${result ? "真实分析" : "示例数据"}`, 272, 230);

    context.strokeStyle = "#e1dbe8";
    context.lineWidth = 2;
    context.beginPath();
    context.moveTo(88, 310);
    context.lineTo(1112, 310);
    context.stroke();

    const scoreBlocks = [
      { code: "S", label: "文案真实性", before: Math.round(baseCopyScore), after: Math.round(copyScore), x: 88, color: "#e5f0e9" },
      ...(hasImages && imageScore != null ? [{ code: "R", label: "图像原生性", before: Math.round(baseImageScore ?? imageScore), after: Math.round(imageAfterScore ?? imageScore), x: 612, color: "#e6eef7" }] : []),
    ];
    scoreBlocks.forEach((block) => {
      context.fillStyle = block.color;
      context.beginPath();
      context.roundRect(block.x, 360, 78, 78, 18);
      context.fill();
      context.fillStyle = "#675a71";
      context.font = '600 25px ui-monospace, monospace';
      context.fillText(block.code, block.x + 30, 408);
      context.fillStyle = "#746d79";
      context.font = `24px ${SELFCHECK_CANVAS_CJK_FONT}`;
      context.fillText(block.label, block.x + 103, 390);
      context.fillStyle = "#8e8793";
      context.font = '500 40px Georgia, serif';
      context.fillText(String(block.before), block.x + 103, 444);
      context.fillStyle = "#9589a0";
      context.font = `24px ${SELFCHECK_CANVAS_CJK_FONT}`;
      context.fillText("→", block.x + 170, 440);
      context.fillStyle = block.code === "S" ? "#5f806c" : "#5d7b96";
      context.font = '500 52px Georgia, serif';
      context.fillText(String(block.after), block.x + 215, 445);
    });

    context.fillStyle = "#5d5563";
    context.font = `500 23px ${SELFCHECK_CANVAS_CJK_FONT}`;
    context.fillText(`已处理 ${handledMustCount} 处必改  ·  采纳 ${acceptedSuggestions} 条建议`, 88, 500);
    context.fillStyle = "#9a939f";
    context.font = `20px ${SELFCHECK_CANVAS_CJK_FONT}`;
    context.fillText("仅代表自检时点的结果，不代表平台审核或背书。", 88, 555);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `TruLens-发布前自检-${new Intl.DateTimeFormat("sv-SE").format(new Date())}.png`;
      link.click();
      URL.revokeObjectURL(link.href);
    }, "image/png");
  };

  const renderDraft = () => {
    const highlightedIssues = unresolvedIssues.filter((issue) => issue.original && draft.includes(issue.original));
    const tokens = [
      ...highlightedIssues.map((issue) => issue.original!),
      ...Array.from(draft.matchAll(/【[^】]+】/g), (match) => match[0]),
    ].sort((a, b) => b.length - a.length);
    if (!tokens.length) return draft;
    const escaped = tokens.map((token) => token.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    const parts = draft.split(new RegExp(`(${escaped.join("|")})`, "g"));
    return parts.map((part, index) => {
      const issue = highlightedIssues.find((entry) => entry.original === part);
      if (issue) {
        return (
          <button
            className={`creator-copy-hit severity-${issue.severity} ${hoveredIssue === issue.id ? "linked" : ""}`}
            key={`${part}-${index}`}
            onClick={() => scrollToIssue(issue.id)}
            onMouseEnter={() => setHoveredIssue(issue.id)}
            onMouseLeave={() => setHoveredIssue(null)}
          >
            {part}
          </button>
        );
      }
      if (/^【[^】]+】$/.test(part)) {
        return (
          <span
            aria-label={`待填写：${part.slice(1, -1)}`}
            className="creator-copy-placeholder"
            contentEditable
            key={`${part}-${index}`}
            onBlur={(event) => {
              const value = event.currentTarget.textContent?.trim();
              if (value && value !== part) setDraft((current) => current.replace(part, value));
            }}
            suppressContentEditableWarning
          >
            {part}
          </span>
        );
      }
      return <span key={`${index}-${part.slice(0, 5)}`}>{part}</span>;
    });
  };

  const disclosureItems = result
    ? Object.entries(result.disclosures)
    : [
        ["合作或赠品披露", /品牌合作|产品赠送|自费购买/.test(draft)],
        ["修图披露", /轻度磨皮|滤镜|修图/.test(draft)],
        ["使用周期说明", /连续用了|使用了.{0,4}天|使用周期/.test(draft)],
        ["个人体验边界声明", /个人觉得|个人感觉|因人而异|每个人情况不同|我用下来/.test(draft)],
        ["数据来源说明", /数据|来源|检测|测试/.test(draft)],
      ];
  const creatorCrossChecks = result?.report.cross_checks?.map((item) => ({
    id: item.id,
    from: item.from_code,
    to: item.to_code,
    left: item.left,
    right: item.right,
    conclusion: item.conclusion,
    state: item.state,
    dimension: item.dimension,
    detail: item.detail,
    confidence: item.confidence ?? undefined,
    method: item.method,
    label: item.label ?? undefined,
  }));
  const goodPoints = result
    ? result.good_points.length
      ? result.good_points
      : ["暂未识别到明确优点"]
    : ["语气有个人体验色彩", "没有医疗化功效描述"];
  const acceptedSuggestions = result ? acceptedSuggestionIds.length : Object.values(issueStatus).filter((status) => status === "accepted").length;
  const handledMustCount = result ? acceptedMustIds.length : acceptedRequired;

  // 自检完成: nothing to fix on the first check, or — after a real 再次检测 — no 必改 left
  // and every 建议 / 提示 (and the image suggestion) adopted or explicitly ignored.
  const openMust = activeIssues.filter((issue) => issue.severity === "must" && issueStatus[issue.id] !== "accepted").length;
  const openOther = activeIssues.filter((issue) => issue.severity !== "must" && !issueStatus[issue.id]).length + (imageNeedsReview && !imageHandled ? 1 : 0);
  const initiallyClean = Boolean(result) && !rechecked && (result?.issues.length ?? 0) === 0 && !imageNeedsReview;
  const selfCheckComplete = !result ? publicationState === "ready" : initiallyClean || (rechecked && openMust === 0 && openOther === 0);
  const pendingReasons = selfCheckComplete
    ? []
    : [
        ...(openMust ? [`还有 ${openMust} 条必改未处理`] : []),
        ...(openOther ? [`还有 ${openOther} 条建议 / 提示未处理（采用或忽略均可）`] : []),
        ...(!rechecked ? ["尚未再次检测"] : []),
      ];
  const lockedReason = "采用修改建议并再次检测通过后，可保存自检记录";

  useEffect(() => {
    onCompletionChange?.({ complete: selfCheckComplete, reasons: pendingReasons });
  }, [selfCheckComplete, pendingReasons.join("|")]);

  useEffect(() => {
    onProgressChange?.({ draft, issueStatus, imageHandled, latestResult, rechecked, acceptedMustIds, acceptedSuggestionIds });
  }, [draft, issueStatus, imageHandled, latestResult, rechecked, acceptedMustIds, acceptedSuggestionIds]);


  // One layout for both states of the 自检记录 card: label → title → one line → checklist.
  const recordSteps: Array<{ done: boolean; text: string }> = result
    ? [
        { done: openMust === 0, text: openMust === 0 ? "必改项已全部采用修改建议" : `还有 ${openMust} 条必改未处理` },
        { done: openOther === 0, text: openOther === 0 ? "建议 / 提示已全部处理" : `还有 ${openOther} 条建议 / 提示未处理（采用或忽略均可）` },
        {
          done: rechecked || initiallyClean,
          text: initiallyClean ? "首次检测无必改项，无需再次检测" : rechecked ? "已再次检测，无必改项" : "尚未再次检测",
        },
        ...(ignoredRequiredCount > 0 ? [{ done: false, text: `有 ${ignoredRequiredCount} 处必改已忽略，必改需采用修改建议` }] : []),
      ]
    : pendingReasons.map((reason) => ({ done: false, text: reason }));

  const renderSelfCheckRecord = (complete: boolean) => (
    <motion.section
      animate={{ opacity: 1, y: 0 }}
      className={`creator-badge-area creator-record-area ${complete ? "is-complete" : "is-locked"}`}
      initial={{ opacity: 0, y: 10 }}
      key={complete ? "badge" : "locked"}
    >
      <div className="creator-record-column">
        <article aria-disabled={!complete} className={`creator-record-card ${complete ? "is-complete" : "is-locked"}`}>
          <header className="creator-record-card-head">
            <img alt="TruLens" height={44} src="/trulens-selfcheck-logo.png" width={84} />
            <div>
              <span className="creator-record-label">SELF-CHECK RECORD · 自检记录（非认证）{result ? "" : " · 示例数据"}</span>
              <strong className="creator-record-title">{complete ? "已完成发布前自检" : "尚未完成发布前自检"}</strong>
              <p className="creator-record-note">{complete ? `检测日期 ${checkDate}` : lockedReason}</p>
            </div>
          </header>
          {complete && (
            <div className="creator-record-compare">
              <span><i>S</i><small>文案真实性</small><b>{Math.round(baseCopyScore)}</b><em>→</em><strong>{Math.round(copyScore)}</strong></span>
              {hasImages && imageScore != null && (
                <span className="is-image"><i>R</i><small>图像原生性</small><b>{Math.round(baseImageScore ?? imageScore)}</b><em>→</em><strong>{Math.round(imageAfterScore ?? imageScore)}</strong></span>
              )}
            </div>
          )}
          <ul aria-label={complete ? "已完成的步骤" : "还差这几步"} className="creator-record-steps">
            {recordSteps.map((step) => (
              <li className={step.done ? "done" : "pending"} key={step.text}>
                <i aria-hidden="true">{step.done ? "✓" : ""}</i>
                <span>{step.text}</span>
              </li>
            ))}
          </ul>
          {complete && <p className="creator-record-tally">已处理 {handledMustCount} 处必改 · 采纳 {acceptedSuggestions} 条建议</p>}
        </article>
        <small className="creator-record-disclaimer">仅代表自检时点的结果，不代表平台审核或背书。</small>
      </div>
      <div className="creator-badge-actions">
        {complete ? (
          <button onClick={saveBadgeAsPng} type="button">保存为图片</button>
        ) : (
          <span className="creator-locked-action" title={lockedReason}>
            <button aria-describedby="creator-locked-reason" disabled type="button">保存为图片</button>
          </span>
        )}
        <button onClick={onContinueOther} type="button">继续检查其他内容 <Arrow size={15} /></button>
        {!complete && <small className="sr-only" id="creator-locked-reason">{lockedReason}</small>}
      </div>
    </motion.section>
  );

  return (
    <div className="creator-report-page">
      <article className="creator-report-sheet">
        <header className="creator-report-hero">
          <div>
            <span>发布前自检</span>
            <h1 className={`state-${publicationState}`}>{publicationTitle}</h1>
            <p><strong>{requiredCount}</strong> 处必改 · <strong>{suggestionCount}</strong> 处建议 · <strong>{tipCount}</strong> 项提示{ignoredCount > 0 && <> · <strong>{ignoredCount}</strong> 项已忽略</>}</p>
          </div>
          <div className="creator-report-scores">
            <div><span className="badge-s">S</span><small><b>文案真实性</b><em>修改后可提升</em></small><strong>{copyScore}</strong></div>
            {hasImages && <div><span className="badge-r">R</span><small>图像原生性</small><strong>{imageScore}</strong></div>}
          </div>
          <small>{hasImages ? "账号可信度、评论自然度发布前暂无数据，未启用。" : "账号可信度、评论自然度、图像原生性发布前暂无数据，未启用。"}</small>
          {input.isExample && <em>示例草稿</em>}
        </header>

        <AnimatePresence mode="wait">
          {isRechecking ? (
            <motion.section animate={{ opacity: 1, y: 0 }} className="creator-recheck-state" exit={{ opacity: 0, y: -6 }} initial={{ opacity: 0, y: 6 }} key="checking">
              <span><i className="expert-s">S</i><b>文案检查官</b><small>正在重新扫描当前文案</small></span>
              {hasImages && <span><i className="expert-r">R</i><b>视觉取证师</b><small>正在复核图片与披露</small></span>}
            </motion.section>
          ) : (
            renderSelfCheckRecord(selfCheckComplete)
          )}
        </AnimatePresence>

        <div className="creator-report-columns">
          <section className="creator-copy-panel">
            <header><span>YOUR DRAFT</span><h2>你的文案</h2><small>点击标注可定位修改建议</small></header>
            <p className={flashDraft ? "updated" : ""}>{renderDraft()}</p>
          </section>
          <section className="creator-issues-panel">
            <header><span>REVIEW NOTES</span><h2>需要留意的地方</h2><small>{pendingCount} 项待处理</small></header>
            <div>
              {activeIssues.map((issue) => {
                const status = issueStatus[issue.id];
                if (status === "ignored") {
                  return (
                    <button className="creator-issue-collapsed" key={issue.id} onClick={() => setIssueStatus((current) => {
                      const next = { ...current };
                      delete next[issue.id];
                      return next;
                    })}>
                      <span>已忽略</span>{issue.type}<small>点击恢复</small>
                    </button>
                  );
                }
                return (
                  <article
                    className={`creator-issue-card severity-${issue.severity} ${status === "accepted" ? "handled" : ""} ${hoveredIssue === issue.id ? "linked" : ""}`}
                    id={`creator-issue-${issue.id}`}
                    key={issue.id}
                    onMouseEnter={() => setHoveredIssue(issue.id)}
                    onMouseLeave={() => setHoveredIssue(null)}
                  >
                    <header><span>{status === "accepted" ? "✓ 已处理" : creatorSeverityLabels[issue.severity]}</span><em>{issue.type}</em></header>
                    <p>{issue.reason}</p>
                    <div className="creator-rewrite">
                      {issue.original && <span><small>原句</small><del>{issue.original}</del></span>}
                      <span><small>建议</small><strong>{issue.suggestion.split(/(【[^】]+】)/g).map((part) => /^【/.test(part) ? <mark key={part}>{part}</mark> : part)}</strong></span>
                    </div>
                    {!status && <footer><button onClick={() => acceptIssue(issue)}>采用建议</button><button onClick={() => setIssueStatus((current) => ({ ...current, [issue.id]: "ignored" }))}>忽略</button></footer>}
                  </article>
                );
              })}
            </div>
          </section>
        </div>

        <section className="creator-image-review">
          <header><div><span>IMAGE REVIEW</span><h2>配图检查</h2></div><small>{input.images.length} 张配图 · 点击查看建议</small></header>
          {input.images.length ? (
            <>
              <div className="creator-report-thumbnails">
                {input.images.map((image, index) => (
                  <button className={selectedImage === index ? "active" : ""} key={image.id} onClick={() => setSelectedImage(index)}>
                    {index === 0 && image.example ? (
                      <div className="creator-skin-comparison">
                        <span><img alt="使用前手背皮肤纹理" src={image.url} /><b>使用前</b></span>
                        <span><img alt="使用后手背皮肤纹理" src={image.url} /><b>使用后</b></span>
                      </div>
                    ) : <img alt={image.name} src={image.url} />}
                    {index === 0 && imageNeedsReview && !imageHandled && <i>需留意</i>}
                    <span>图 {index + 1}</span>
                  </button>
                ))}
              </div>
              <AnimatePresence mode="wait">
                {selectedImage !== null && (
                  <motion.div animate={{ opacity: 1, y: 0 }} className={`creator-image-note ${selectedImage !== 0 || imageHandled ? "handled" : ""}`} initial={{ opacity: 0, y: 5 }} key={selectedImage}>
                    <span>{result && selectedImage !== 0 ? "未分析" : selectedImage !== 0 ? "✓ 预览" : imageHandled ? "✓ 已处理" : imageNeedsReview ? "图片建议" : "✓ 已分析"}</span>
                    <div>
                      <strong>图 {selectedImage + 1}{result && selectedImage !== 0 ? " 仅作草稿预览" : selectedImage === 0 ? imageNeedsReview ? " 检测到需要说明的图片信号" : " 后端未发现明显图片风险" : " 暂未发现明显异常"}</strong>
                      <p>{result && selectedImage !== 0 ? "本轮后端只分析首张配图；这张图片保留用于草稿预览，未生成真实性评分。" : selectedImage === 0 ? imageFinding || (imageNeedsReview ? "建议注明滤镜或修饰情况，并保留原始素材。" : "图片维度已完成真实分析，当前未返回需要整改的图片证据。") : "主体边缘、纹理和光影关系自然，可保留当前图片。"}</p>
                    </div>
                    {selectedImage === 0 && imageNeedsReview && !imageHandled && <button onClick={acceptImageSuggestion}>采用建议</button>}
                  </motion.div>
                )}
              </AnimatePresence>
            </>
          ) : <p className="creator-no-images">本次没有上传配图，图像原生性未产生额外建议。</p>}
        </section>

        <CrossCheckSection
          activeDimensions={creatorDimensions}
          creatorMode
          items={creatorCrossChecks}
          live={Boolean(result)}
          technicalView={technicalView}
        />

        <DecisionSupport
          activeDimensions={creatorDimensions}
          confidenceLevel={result?.report.confidence?.level ?? "low"}
          continueLabel="返回 Agent 继续追问"
          creatorMode
          liveAdvice={result?.report.decision?.advice}
          onContinue={onContinueAgent}
          recommendations={result?.report.recommendations}
          score={creatorOverallScore}
          sourceLabel={result ? "实时报告" : "示例数据"}
          subtitle={result?.report.decision?.headline ?? publicationTitle}
        />

        <div className="creator-report-extras">
          <section className="creator-disclosure-list">
            <header><span>DISCLOSURE</span><h2>披露清单</h2></header>
            <div>{disclosureItems.map(([label, ready]) => <label className={ready ? "ready" : ""} key={label}><input checked={ready} readOnly type="checkbox" /><span>{ready ? "✓ 已具备" : "△ 建议补充"}</span><strong>{label}</strong></label>)}</div>
          </section>
          <section className="creator-good-points">
            <header><span>WHAT WORKS</span><h2>做得好的地方</h2></header>
            {goodPoints.map((point) => <p key={point}><i>✓</i>{point}</p>)}
          </section>
        </div>

        <footer className="creator-report-actions">
          <small>自检建议用于发布前优化，不构成平台审核结论。</small>
          <div>
            <button onClick={() => onReturnModify(draft)}>返回修改</button>
            <button aria-busy={isRechecking} disabled={isRechecking} onClick={runRecheck}>{isRechecking ? "再次检测中…" : "再次检测"} <Arrow size={16} /></button>
          </div>
        </footer>
        {recheckError && (
          <p className="live-error creator-recheck-error" role="alert">
            再次检测未完成：{recheckError}
            <button className="live-resume-button" disabled={isRechecking} onClick={runRecheck} type="button">重试</button>
          </p>
        )}
      </article>
    </div>
  );
}

function Result({
  onBack,
  onAddEvidence,
  scoreOverride,
  activeDimensions,
  creatorMode = false,
  creatorInput,
  onContinueOther,
  onReturnModify,
  onTechnicalViewChange,
  technicalView,
}: {
  onBack: () => void;
  onAddEvidence: (code: DimensionCode) => void;
  scoreOverride?: number | null;
  activeDimensions: DimensionCode[];
  creatorMode?: boolean;
  creatorInput?: CreatorReportInput | null;
  onContinueOther?: () => void;
  onReturnModify?: (draft: string) => void;
  onTechnicalViewChange: (enabled: boolean) => void;
  technicalView: boolean;
}) {
  const [shareOpen, setShareOpen] = useState(false);
  const reportDimensions = dimensions
    .filter((item) => activeDimensions.includes(item.code as DimensionCode))
    .map((item) => creatorMode && item.code === "S"
      ? { ...item, score: 28, status: "需修改", text: "检测到“7 天直接变白”“100% 安全无刺激”“闭眼入”等绝对化或无依据表达，建议改为可验证的个人体验描述。", evidence: ["绝对化功效表达 3 处", "敏感人群安全承诺缺少依据", "贬损性购买引导"] }
      : creatorMode && item.code === "R"
        ? { ...item, score: 82, text: "配图主体结构自然，但局部质感经过柔化；建议发布时主动注明滤镜或修饰情况。" }
        : item);
  const reportScore = scoreOverride ?? Math.round(reportDimensions.reduce((total, item) => total + item.score, 0) / reportDimensions.length);
  const dimensionName = ["", "单维", "双维", "三维", "四维"][reportDimensions.length];
  const reportHeadline = activeDimensions.includes("R")
    ? "图片主体可信，存在轻度 AI 修饰。"
    : activeDimensions.includes("U")
      ? "评论整体自然，少量话术需留意。"
      : activeDimensions.includes("T")
        ? "账号轨迹稳定，长期行为可信。"
        : "文案表达安全，未见高风险宣称。";
  if (creatorMode && creatorInput) {
    return (
      <section className="result creator-result">
        <header className="result-header">
          <button aria-label="返回过程页" className="back-button" onClick={onBack} title="返回过程页">
            <Icon size={22}><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
          </button>
          <div className="result-actions">
            <button onClick={() => window.print()}>
              <Icon size={17}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" /></Icon>
              导出 PDF
            </button>
          </div>
        </header>
        <CreatorSelfCheckReport input={creatorInput} onContinueAgent={onBack} onContinueOther={onContinueOther ?? onBack} onRestart={() => undefined} onReturnModify={onReturnModify ?? (() => onBack())} technicalView={technicalView} />
      </section>
    );
  }
  return (
    <section className="result">
      <header className="result-header">
        <button aria-label="返回对话" className="back-button" onClick={onBack} title="返回对话">
          <Icon size={22}><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.6" /></Icon>
        </button>
        <div className="result-actions">
          <TechnicalViewToggle enabled={technicalView} onChange={onTechnicalViewChange} />
          <button onClick={() => window.print()}>
            <Icon size={17}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" strokeLinecap="round" strokeWidth="1.5" /></Icon>
            导出 PDF
          </button>
          <div className="share-wrap">
            <button onClick={() => setShareOpen((open) => !open)}>
              <Icon size={17}><circle cx="18" cy="5" r="2" stroke="currentColor" strokeWidth="1.5" /><circle cx="6" cy="12" r="2" stroke="currentColor" strokeWidth="1.5" /><circle cx="18" cy="19" r="2" stroke="currentColor" strokeWidth="1.5" /><path d="m8 11 8-5M8 13l8 5" stroke="currentColor" strokeWidth="1.5" /></Icon>
              分享
            </button>
            {shareOpen && <ShareMenu onClose={() => setShareOpen(false)} />}
          </div>
        </div>
      </header>
      <UnifiedReportTemplate
        continueLabel="向 Agent 继续追问"
        decision={creatorMode
          ? "发布前建议优先修改绝对化功效表达，并补充未经修饰的原图与真实使用条件后再发布。"
          : activeDimensions.length < 4
          ? "当前输入不足以完成四维交叉验证。建议补充账号主页、原始图片或评论区，以获得更完整的可信度判断。"
          : "综合判断：内容整体可信，但图片轻度修饰，账号带货密度较高。可参考，不建议仅凭此内容做购买决策。"}
        dimensions={reportDimensions}
        onAddEvidence={onAddEvidence}
        onContinue={onBack}
        score={reportScore}
        status={reportScore >= 80 ? "高可信" : "需留意"}
        subtitle={creatorMode ? "发布前发现高风险表述，配图存在轻度修饰信号。" : reportHeadline}
        technicalView={technicalView}
        title={creatorMode ? "创作者发布前自检" : activeDimensions.includes("R") ? "当前美妆种草内容" : `${dimensionName}内容核验`}
        tone={reportScore >= 80 ? "trusted" : "warning"}
      />
    </section>
  );
}

type TeamRole = "platform" | "brand";
type TeamRisk = "高风险" | "中风险" | "高可信";
type TeamStatus = "待复核" | "观察中" | "已处理";
type TeamIssueType = "绝对化功效" | "凭证矛盾" | "疑似刷评" | "疑似 AI 生成" | "账号异常" | "无明显问题";
type TeamView = "queue" | "groups";

export type TeamQueueItem = {
  id: string;
  taskId: string;
  title: string;
  author: string;
  score: number;
  risk: TeamRisk;
  confidence: "高" | "中" | "低";
  dimensions: DimensionCode[];
  contradiction: string;
  issueType: TeamIssueType;
  actions: Record<TeamRole, string>;
  status: TeamStatus;
  checks: [string, string][];
};

export type TeamSummary = {
  total: number;
  highRisk: number;
  pending: number;
  trusted: number;
  mediumRisk: number;
  confidenceHigh: number;
  confidenceMedium: number;
  confidenceLow: number;
};

export type TeamRelatedGroup = {
  id: string;
  signals: string[];
  members: Array<{
    id: string;
    taskId: string;
    title: string;
    author: string;
    time: string;
    /** Full ISO timestamp, when the data source provides one. */
    createdAt?: string;
  }>;
};

